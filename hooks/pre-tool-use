#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


# Patterns that are always blocked (no exceptions)
ALWAYS_BLOCKED = [
    r"rm\s+(-[a-zA-Z]*\s+)*-[-a-zA-Z]*f",  # rm with -f flag
    r"git\s+push\s+.*--force",  # git push --force
    r"git\s+push\s+.*-f\b",  # git push -f
    r"DROP\s+TABLE",  # SQL DROP TABLE
    r"TRUNCATE(\s+TABLE)?",  # SQL TRUNCATE
]

# Patterns that require additional checks
CONDITIONAL_PATTERNS = [
    r"DELETE\s+FROM",  # DELETE FROM without WHERE
]


def get_log_path() -> Path:
    """Get the path to the blocked log file."""
    hooks_dir = Path(__file__).parent
    return hooks_dir / "blocked.log"


def get_project_path() -> str:
    """Get the current project path."""
    return os.getcwd()


def log_blocked_attempt(command: str, reason: str) -> None:
    """Log a blocked command attempt to the log file."""
    log_path = get_log_path()
    timestamp = datetime.now().isoformat()
    project = get_project_path()
    
    log_entry = f"{timestamp} | {reason} | {command} | {project}\n"
    
    # Ensure the log directory exists
    log_path.parent.mkdir(parents=True, exist_ok=True)
    
    with open(log_path, "a") as f:
        f.write(log_entry)


def is_dangerous_command(command: str) -> tuple[bool, str]:
    """
    Check if a command is dangerous and should be blocked.
    
    Returns:
        Tuple of (is_blocked, reason)
    """
    command_upper = command.upper()
    command_stripped = command.strip()
    
    # Check always-blocked patterns
    for pattern in ALWAYS_BLOCKED:
        if re.search(pattern, command_stripped, re.IGNORECASE):
            return True, f"Matches blocked pattern: {pattern}"
    
    # Check DELETE FROM without WHERE
    if re.search(r"DELETE\s+FROM", command_stripped, re.IGNORECASE):
        # Check if there's a WHERE clause
        if not re.search(r"WHERE\s+", command_upper):
            return True, "DELETE FROM without WHERE clause"
    
    return False, ""


def main() -> None:
    """Main entry point for the hook."""
    # Read the tool use data from stdin (Claude Code passes JSON)
    try:
        tool_data = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # If not valid JSON, allow the command to proceed
        sys.exit(0)
    
    # Check if this is a bash tool
    tool_name = tool_data.get("tool", "")
    if tool_name != "Bash":
        sys.exit(0)
    
    # Get the command being executed
    command = tool_data.get("command", "")
    
    # Check if the command is dangerous
    is_blocked, reason = is_dangerous_command(command)
    
    if is_blocked:
        log_blocked_attempt(command, reason)
        print(f"🚫 BLOCKED: This command was prevented from running.\nReason: {reason}\nCommand: {command}", file=sys.stderr)
        sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()