#!/usr/bin/env python3

import sys
import os
import json
import re
from datetime import datetime

# Define dangerous patterns to block
DANGEROUS_PATTERNS = [
    r'rm\s+-rf',
    r'DROP\s+TABLE',
    r'git\s+push\s+--force',
    r'TRUNCATE',
    r'DELETE\s+FROM(?!\s+\w+\s+WHERE)',
]

def main():
    # Read the tool call from stdin
    tool_call = json.load(sys.stdin)
    
    # Only intercept bash commands
    if tool_call.get('tool_name') != 'bash':
        # Allow the tool call to proceed
        print(json.dumps(tool_call))
        return
    
    command = tool_call.get('command', '')
    
    # Check if command matches any dangerous pattern
    for pattern in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            # Log the blocked attempt
            log_blocked_command(command)
            
            # Output error message to Claude
            error_msg = {
                "error": {
                    "type": "tool_use_blocked",
                    "message": f"Blocked dangerous command: {command}. This command contains potentially destructive operations and has been blocked for security reasons."
                }
            }
            print(json.dumps(error_msg))
            return
    
    # If no dangerous patterns found, allow the command
    print(json.dumps(tool_call))

def log_blocked_command(command):
    log_file = os.path.expanduser('~/.claude/hooks/blocked.log')
    os.makedirs(os.path.dirname(log_file), exist_ok=True)
    
    timestamp = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    project_path = os.getcwd()
    
    with open(log_file, 'a') as f:
        f.write(f"[{timestamp}] Blocked command: {command} (Project: {project_path})\n")

if __name__ == '__main__':
    main()