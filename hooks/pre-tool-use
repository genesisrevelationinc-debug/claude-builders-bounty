#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or damage.
"""

import json
import os
import re
import sys
from datetime import datetime


HOOKS_DIR = os.path.expanduser("~/.claude/hooks")
BLOCKED_LOG = os.path.join(HOOKS_DIR, "blocked.log")


def log_blocked(command: str, project_path: str):
    """Log a blocked command attempt with timestamp and project path."""
    os.makedirs(HOOKS_DIR, exist_ok=True)
    timestamp = datetime.now().isoformat()
    with open(BLOCKED_LOG, "a") as f:
        f.write(f"{timestamp} | {command} | {project_path}\n")


def is_destructive(command: str) -> tuple[bool, str]:
    """
    Check if a command matches destructive patterns.
    Returns (is_blocked, reason).
    """
    upper = command.upper()
    
    # Pattern: rm -rf (remove recursively and force)
    if re.search(r'\brm\s+-[a-zA-Z]*rf\b|\brm\s+-[a-zA-Z]*r\s+-[a-zA-Z]*f\b', command, re.IGNORECASE):
        return True, "rm -rf is destructive and can delete important files irreversibly"
    
    # Pattern: DROP TABLE
    if re.search(r'\bDROP\s+TABLE\b', upper):
        return True, "DROP TABLE permanently deletes database tables and their data"
    
    # Pattern: git push --force
    if re.search(r'\bgit\s+push\s+.*--force\b|\bgit\s+push\s+.*-f\b', command, re.IGNORECASE):
        return True, "git push --force overwrites remote history and can cause data loss for the team"
    
    # Pattern: TRUNCATE
    if re.search(r'\bTRUNCATE\b', upper):
        return True, "TRUNCATE removes all rows from a table without logging individual row deletions"
    
    # Pattern: DELETE FROM without WHERE
    if re.search(r'\bDELETE\s+FROM\b', upper) and not re.search(r'\bWHERE\b', upper):
        return True, "DELETE FROM without WHERE clause deletes all rows in the table"
    
    return False, ""


def main():
    # Read the tool use request from stdin (Claude Code hook format)
    try:
        input_data = sys.stdin.read()
        if not input_data:
            sys.exit(0)
        
        data = json.loads(input_data)
    except (json.JSONDecodeError, Exception):
        # If we can't parse, let it through (fail open for safety, or fail closed based on preference)
        sys.exit(0)
    
    # Extract command and tool info
    tool_name = data.get("tool", "")
    command = data.get("command", "") or data.get("input", {}).get("command", "")
    project_path = data.get("project_path", os.getcwd())
    
    # Only check bash tool
    if tool_name != "bash" or not command:
        sys.exit(0)
    
    blocked, reason = is_destructive(command)
    if blocked:
        log_blocked(command, project_path)
        print(f"🛡️  BLOCKED: This command was prevented from running.\n\nReason: {reason}\n\nThe command '{command}' has been logged for security review.", file=sys.stderr)
        sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()