#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
and blocks them with a clear explanation.
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
# Each pattern is a tuple: (regex, description)
DESTRUCTIVE_PATTERNS = [
    # rm -rf (and variations like rm -rf /, rm -rf *)
    (r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', "Recursive force remove command"),
    (r'\brm\s+.*\s+-[a-zA-Z]*[rf]', "Remove with force/recursive flags"),
    
    # SQL destructive commands
    (r'\bDROP\s+TABLE\b', "DROP TABLE - deletes an entire table"),
    (r'\bTRUNCATE\b', "TRUNCATE - removes all rows from a table"),
    # DELETE FROM without WHERE clause
    (r'\bDELETE\s+FROM\s+\S+\s*;?\s*$', "DELETE FROM without WHERE clause"),
    (r'\bDELETE\s+FROM\s+\S+\s*(?!.*WHERE\b).*$', "DELETE FROM without WHERE clause"),
    
    # Git destructive commands
    (r'\bgit\s+push\s+.*--force\b', "git push --force overwrites remote history"),
    (r'\bgit\s+push\s+-f\b', "git push -f overwrites remote history"),
]


def log_blocked_attempt(command, project_path):
    """Log a blocked attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    log_entry = f"[{timestamp}] BLOCKED: {command} | Project: {project_path}\n"
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_destructive(command):
    """Check if a command matches any destructive pattern."""
    command_upper = command.upper()
    
    for pattern, description in DESTRUCTIVE_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return description
    
    return None


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        hook_input = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # If not valid JSON, allow the command to proceed
        sys.exit(0)
    
    # Extract command information
    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})
    project_path = hook_input.get("project_path", os.getcwd())
    
    # Only check bash commands
    if tool_name != "bash":
        sys.exit(0)
    
    command = tool_input.get("command", "")
    
    # Check for destructive patterns
    block_reason = is_destructive(command)
    
    if block_reason:
        log_blocked_attempt(command, project_path)
        print(f"🚫 BLOCKED: This command was prevented from running.\n")
        print(f"Reason: {block_reason}")
        print(f"Command: {command}")
        print(f"\nThis is a destructive operation that could cause data loss. Please use a safer alternative or confirm this action is intentional.")
        sys.exit(1)
    
    # Command is safe, allow it to proceed
    sys.exit(0)


if __name__ == "__main__":
    main()