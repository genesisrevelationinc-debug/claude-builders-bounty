#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime


BLOCKED_PATTERNS = [
    # rm -rf (recursive force delete)
    (r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', "rm -rf: recursive force delete"),
    (r'\brm\s+-[a-zA-Z]*\s+.*\s+-[a-zA-Z]*[rf]', "rm -rf: recursive force delete"),
    
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', "DROP TABLE: deletes entire table"),
    
    # git push --force
    (r'\bgit\s+push\s+.*--force\b', "git push --force: overwrites remote history"),
    (r'\bgit\s+push\s+.*-f\b', "git push --force: overwrites remote history"),
    
    # TRUNCATE
    (r'\bTRUNCATE\s+TABLE\b', "TRUNCATE: removes all table data"),
    (r'\bTRUNCATE\b', "TRUNCATE: removes all table data"),
    
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+\s*;?\s*$', "DELETE FROM without WHERE: removes all rows"),
    (r'\bDELETE\s+FROM\s+\S+\s*(?!WHERE\b)', "DELETE FROM without WHERE: removes all rows"),
]


def get_log_path():
    """Get the path to the blocked log file."""
    hooks_dir = os.path.dirname(os.path.abspath(__file__))
    return os.path.join(hooks_dir, "blocked.log")


def log_blocked_attempt(command, project_path):
    """Log a blocked command attempt with timestamp and project path."""
    log_path = get_log_path()
    timestamp = datetime.now().isoformat()
    log_entry = f"[{timestamp}] BLOCKED: {command} | Project: {project_path}\n"
    
    try:
        with open(log_path, "a") as f:
            f.write(log_entry)
    except Exception as e:
        print(f"Warning: Could not write to log file {log_path}: {e}", file=sys.stderr)


def check_command(command, project_path):
    """Check if a command matches any blocked pattern."""
    for pattern, reason in BLOCKED_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            log_blocked_attempt(command, project_path)
            print(f"\n🚫 BLOCKED: This command was prevented from running.\n   Reason: {reason}\n   Command: {command}\n", file=sys.stderr)
            return False
    return True


def main():
    # Read the hook input from stdin (JSON format as per Claude Code hooks)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If not JSON, pass through
        return 0
    
    command = hook_input.get("command", "")
    project_path = hook_input.get("project_path", os.getcwd())
    
    if not check_command(command, project_path):
        return 1
    
    return 0


if __name__ == "__main__":
    sys.exit(main())