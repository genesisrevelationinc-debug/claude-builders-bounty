#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime


# Patterns that should be blocked
DANGEROUS_PATTERNS = [
    # rm -rf (recursive force delete)
    (r'\brm\s+(?:-[a-zA-Z]*\s+)*-?[a-zA-Z]*rf', 'rm -rf: Recursive force deletion'),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', 'DROP TABLE: Database table deletion'),
    # git push --force
    (r'\bgit\s+push\s+(?:-[a-zA-Z]+\s+)*--force\b', 'git push --force: Force push can overwrite remote history'),
    # TRUNCATE
    (r'\bTRUNCATE\b', 'TRUNCATE: Complete table data removal'),
]

# DELETE FROM without WHERE clause
DELETE_FROM_PATTERN = r'\bDELETE\s+FROM\s+\S+\s*;?$'


def log_blocked_attempt(command, reason):
    """Log a blocked command attempt to the log file."""
    log_dir = os.path.expanduser('~/.claude/hooks')
    log_file = os.path.join(log_dir, 'blocked.log')
    
    # Ensure log directory exists
    os.makedirs(log_dir, exist_ok=True)
    
    # Get project path (current working directory)
    project_path = os.getcwd()
    
    # Format: timestamp | attempted command | project path | reason
    timestamp = datetime.now().isoformat()
    log_entry = f"{timestamp} | {command} | {project_path} | {reason}\n"
    
    # Append to log file
    with open(log_file, 'a') as f:
        f.write(log_entry)


def check_command(command):
    """Check if a command is dangerous and should be blocked."""
    command_upper = command.upper()
    
    # Check dangerous patterns
    for pattern, reason in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, reason
    
    # Check DELETE FROM without WHERE
    if re.search(r'\bDELETE\s+FROM\b', command, re.IGNORECASE):
        if not re.search(r'\bWHERE\b', command, re.IGNORECASE):
            return True, 'DELETE FROM without WHERE: Unconditional row deletion'
    
    return False, None


def main():
    # Read the tool use request from stdin (Claude Code hook protocol)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, let it pass
        sys.exit(0)
    
    # Extract the command from the tool use data
    command = data.get('command', '') if isinstance(data, dict) else str(data)
    
    is_dangerous, reason = check_command(command)
    
    if is_dangerous:
        log_blocked_attempt(command, reason)
        print(f"🚫 BLOCKED: {reason}", file=sys.stderr)
        print(f"   Command: {command}", file=sys.stderr)
        print("   This destructive command has been prevented for safety.", file=sys.stderr)
        sys.exit(1)  # Non-zero exit blocks the tool use
    
    sys.exit(0)  # Zero exit allows the tool use to proceed


if __name__ == '__main__':
    main()