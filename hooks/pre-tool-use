#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or destructive operations.
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the blocked attempts log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf variants
    {
        "pattern": r"rm\s+(?:-[a-zA-Z]*f[a-zA-Z]*\s+|\s+)-r",
        "name": "rm -rf",
        "description": "Recursive force delete - can destroy directories and data",
    },
    # DROP TABLE
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "name": "DROP TABLE",
        "description": "Deletes an entire database table and all its data",
    },
    # git push --force
    {
        "pattern": r"(?i)git\s+push\s+.*--force",
        "name": "git push --force",
        "description": "Force push can overwrite remote history and lose commits",
    },
    # TRUNCATE
    {
        "pattern": r"(?i)\bTRUNCATE\b",
        "name": "TRUNCATE",
        "description": "TRUNCATE removes all rows from a table without logging individual row deletions",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)\bDELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b)",
        "name": "DELETE FROM without WHERE",
        "description": "DELETE without WHERE clause removes all rows from a table",
    },
]


def log_blocked_attempt(command: str, pattern_name: str):
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {pattern_name} | Command: {command} | Project: {project_path}\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        hook_input = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # Not JSON, pass through
        sys.exit(0)
    
    # Extract the command being executed
    command = hook_input.get("command", "") or hook_input.get("input", "") or ""
    
    for rule in DANGEROUS_PATTERNS:
        if re.search(rule["pattern"], command):
            log_blocked_attempt(command, rule["name"])
            
            # Output error message for Claude
            print(f"🚫 BLOCKED: {rule['name']}", file=sys.stderr)
            print(f"   Reason: {rule['description']}", file=sys.stderr)
            print(f"   Command: {command}", file=sys.stderr)
            print(f"   This destructive command has been blocked for safety. Please use a safer alternative or confirm the operation explicitly.", file=sys.stderr)
            
            sys.exit(1)  # Non-zero exit blocks the tool use
    
    # Command is safe, allow it
    sys.exit(0)


if __name__ == "__main__":
    main()