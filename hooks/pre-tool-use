#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Blocks destructive bash commands.

Place at: ~/.claude/hooks/pre-tool-use
Make executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone

BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Patterns that are always blocked (case-insensitive)
ALWAYS_BLOCKED = [
    r"rm\s+(-[a-zA-Z]*f|.*\s-f|--force)",  # rm with force
    r"rm\s+(-[a-zA-Z]*r|.*\s-r|--recursive)\s+.*(-[a-zA-Z]*f|.*\s-f|--force)",  # rm -rf
    r"rm\s+.*\\-rf",  # rm with escaped -rf
    r"DROP\s+TABLE",  # SQL DROP TABLE
    r"TRUNCATE\s+TABLE?",  # SQL TRUNCATE
    r"git\s+push\s+.*(--force|-f)\b",  # git push --force
]

# Patterns that require WHERE clause check
DANGEROUS_SQL = [
    r"DELETE\s+FROM\s+(\w+)",
]


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat()
    project_path = os.getcwd()
    
    log_entry = (
        f"[{timestamp}] BLOCKED: {reason}\n"
        f"  Command: {command}\n"
        f"  Project: {project_path}\n"
        f"{'=' * 60}\n"
    )
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_blocked(command: str) -> tuple[bool, str]:
    """Check if a command should be blocked. Returns (blocked, reason)."""
    upper = command.upper()
    
    # Check always-blocked patterns
    for pattern in ALWAYS_BLOCKED:
        if re.search(pattern, command, re.IGNORECASE):
            return True, f"Matches blocked pattern: {pattern}"
    
    # Check DELETE FROM without WHERE
    delete_match = re.search(r"DELETE\s+FROM\s+(\w+)", command, re.IGNORECASE)
    if delete_match:
        if "WHERE" not in upper:
            return True, "DELETE FROM without WHERE clause"
    
    return False, ""


def main():
    # Read the tool use JSON from stdin
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)
    
    # Only intercept bash tool
    if data.get("tool_name") != "bash":
        sys.exit(0)
    
    command = data.get("tool_input", {}).get("command", "")
    
    blocked, reason = is_blocked(command)
    if blocked:
        log_blocked(command, reason)
        print(f"🛡️  BLOCKED: This command was prevented from running for safety reasons.\n   Reason: {reason}\n   Command: {command}", file=sys.stderr)
        sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()