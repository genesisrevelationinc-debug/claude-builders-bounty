#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime


BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")


DESTRUCTIVE_PATTERNS = [
    # rm -rf / rm -r / rm -f with any flags containing -r or -f
    {
        "pattern": r"^\s*rm\s+.*-[a-zA-Z]*[rf]",
        "name": "rm -rf (recursive force delete)",
    },
    {
        "pattern": r"^\s*rm\s+.*--recursive",
        "name": "rm --recursive (recursive delete)",
    },
    # DROP TABLE
    {
        "pattern": r"(?i)^\s*(?:.*;\s*)?DROP\s+TABLE",
        "name": "DROP TABLE (delete database table)",
    },
    # git push --force
    {
        "pattern": r"^\s*git\s+push\s+.*--force",
        "name": "git push --force (force overwrite remote)",
    },
    {
        "pattern": r"^\s*git\s+push\s+.*-f",
        "name": "git push -f (force overwrite remote)",
    },
    # TRUNCATE
    {
        "pattern": r"(?i)^\s*(?:.*;\s*)?TRUNCATE\s+",
        "name": "TRUNCATE (delete all table data)",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)^\s*(?:.*;\s*)?DELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b)",
        "name": "DELETE FROM without WHERE (delete all rows)",
    },
]


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt to the blocked log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"{timestamp} | {reason} | {project_path} | {command}\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If not valid JSON, allow the command to proceed
        sys.exit(0)
    
    # Only intercept bash tool uses
    tool_name = hook_input.get("tool_name", "")
    if tool_name != "bash":
        sys.exit(0)
    
    command = hook_input.get("tool_input", {}).get("command", "")
    
    for blocked in DESTRUCTIVE_PATTERNS:
        if re.search(blocked["pattern"], command):
            log_blocked(command, blocked["name"])
            
            print(f"\n🚫 BLOCKED: Destructive command detected", file=sys.stderr)
            print(f"   Command: {command}", file=sys.stderr)
            print(f"   Reason:  {blocked['name']}", file=sys.stderr)
            print(f"\nThis command could cause irreversible data loss. "
                  f"If you're sure you want to run it, please use a safer alternative or run it manually.", file=sys.stderr)
            
            sys.exit(1)
    
    # Command is safe, allow it to proceed
    sys.exit(0)


if __name__ == "__main__":
    main()