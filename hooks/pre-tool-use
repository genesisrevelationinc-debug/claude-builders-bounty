#!/bin/bash

# pre-tool-use hook to block destructive bash commands

HOOKS_DIR="$HOME/.claude/hooks"
LOG_FILE="$HOOKS_DIR/blocked.log"

# Create log file if it doesn't exist
touch "$LOG_FILE"

# Function to log blocked commands
log_blocked() {
    local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    local project_path=$(pwd)
    echo "[$timestamp] Blocked command: $1 (Project: $project_path)" >> "$LOG_FILE"
}

# List of destructive patterns to check
patterns=(
    "rm -rf"
    "DROP TABLE"
    "git push --force"
    "TRUNCATE"
    "DELETE FROM"
)

# Check if any destructive pattern exists in the command
for pattern in "${patterns[@]}"; do
    if [[ "$1" == *"$pattern"* ]]; then
        # Special handling for DELETE and TRUNCATE to check for missing WHERE clause
        if [[ "$pattern" == "DELETE FROM" ]] || [[ "$pattern" == "TRUNCATE" ]]; then
            # If it's a DELETE or TRUNCATE, make sure it has a WHERE clause or is explicitly allowed
            if [[ "$1" != *"WHERE"* ]] && [[ "$1" != *"where"* ]]; then
                log_blocked "$1"
                echo "BLOCKED: '$1' - Destructive command blocked for security. (Logged to $LOG_FILE)"
                exit 1
            fi
        else
            # For other patterns, block directly
            log_blocked "$1"
            echo "BLOCKED: '$1' - Destructive command blocked for security. (Logged to $LOG_FILE)"
            exit 1
        fi
    fi
done

# Special handling for DELETE and TRUNCATE with WHERE clause
if [[ "$1" == *"DELETE FROM"* ]] || [[ "$1" == *"TRUNCATE"* ]]; then
    if [[ "$1" != *"WHERE"* ]] && [[ "$1" != *"where"* ]]; then
        log_blocked "$1"
        echo "BLOCKED: '$1' - Destructive command blocked for security. (Logged to $LOG_FILE)"
        exit 1
    fi
fi