#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the blocked log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf (recursive force delete)
    (r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', 'rm -rf: Recursive force deletion'),
    (r'\brm\s+.*-[a-zA-Z]*rf[a-zA-Z]*', 'rm -rf: Recursive force deletion'),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', 'DROP TABLE: Database table deletion'),
    # git push --force
    (r'\bgit\s+push\s+.*--force\b', 'git push --force: Force push can overwrite remote history'),
    (r'\bgit\s+push\s+-f\b', 'git push --force: Force push can overwrite remote history'),
    # TRUNCATE
    (r'\bTRUNCATE\s+TABLE\b', 'TRUNCATE: Table data removal'),
    (r'\bTRUNCATE\s+\w+', 'TRUNCATE: Table data removal'),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b)', 'DELETE FROM without WHERE: Unconditional row deletion'),
]


def log_blocked_attempt(command, reason, project_path):
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    log_entry = f"[{timestamp}] BLOCKED: {reason}\n  Command: {command}\n  Project: {project_path}\n\n"
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command, project_path):
    """Check if a command matches any dangerous pattern."""
    command_upper = command.upper()
    
    for pattern, reason in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            # Special check for DELETE FROM: ensure no WHERE clause
            if 'DELETE FROM' in command_upper:
                # Check if WHERE exists after DELETE FROM
                delete_match = re.search(r'DELETE\s+FROM\s+(\S+)(.*)', command, re.IGNORECASE)
                if delete_match:
                    after_table = delete_match.group(2)
                    if after_table and re.search(r'\bWHERE\b', after_table, re.IGNORECASE):
                        continue  # Has WHERE clause, allow it
            
            log_blocked_attempt(command, reason, project_path)
            return reason
    
    return None


def main():
    # Read the hook input from stdin (JSON)
    try:
        hook_input = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        sys.exit(0)  # Allow if we can't parse
    
    # Only check Bash tool
    tool_name = hook_input.get('tool_name', '')
    if tool_name != 'Bash':
        sys.exit(0)
    
    command = hook_input.get('tool_input', {}).get('command', '')
    project_path = hook_input.get('project_path', os.getcwd())
    
    block_reason = check_command(command, project_path)
    if block_reason:
        print(f"🚫 BLOCKED: {block_reason}", file=sys.stderr)
        print(f"   The command '{command}' was prevented from executing.", file=sys.stderr)
        print(f"   This is a destructive operation that could cause data loss.", file=sys.stderr)
        sys.exit(1)  # Non-zero exit blocks the tool


if __name__ == '__main__':
    main()