#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
# Each pattern is a tuple: (regex, description)
DANGEROUS_PATTERNS = [
    # rm -rf / rm -r -f variants
    (r"rm\s+(?:-[a-zA-Z]*[rf]\w*\s+|.*-[a-zA-Z]*[rf]\w*)", "rm -rf: Recursive force delete"),
    # DROP TABLE
    (r"(?i)\bDROP\s+TABLE\b", "DROP TABLE: Database table deletion"),
    # git push --force / git push -f
    (r"(?i)git\s+push\s+.*(--force|-f)", "git push --force: Force push to remote"),
    # TRUNCATE
    (r"(?i)\bTRUNCATE\b", "TRUNCATE: Table data removal"),
    # DELETE FROM without WHERE
    (r"(?i)^\s*DELETE\s+FROM\s+\S+\s*$", "DELETE FROM without WHERE: Unconditional row deletion"),
]


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason} | Command: {command.strip()} | Project: {project_path}\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """Check if a command matches any dangerous pattern.
    
    Returns:
        tuple of (is_blocked, reason)
    """
    for pattern, description in DANGEROUS_PATTERNS:
        if re.search(pattern, command):
            return True, description
    return False, ""


def main():
    # Read the tool use request from stdin (JSON format per Claude Code hooks)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a JSON input, pass through
        sys.exit(0)
    
    # Only check bash tool
    if data.get("tool_name") != "bash":
        sys.exit(0)
    
    command = data.get("command", "")
    
    is_blocked, reason = check_command(command)
    
    if is_blocked:
        log_blocked_attempt(command, reason)
        print(f"🛡️  BLOCKED: This command has been prevented from executing.\n\nReason: {reason}\nCommand: {command.strip()}\n\nThis destructive operation could cause irreversible data loss. If you are certain this is safe, please review the command and consider running it manually with appropriate safeguards.", file=sys.stderr)
        sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()
# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code/) that intercepts and blocks dangerous bash commands before they execute.

## What It Blocks

| Pattern | Example | Why |
|---------|---------|-----|
| `rm -rf` | `rm -rf /important/data` | Irreversible recursive deletion |
| `DROP TABLE` | `DROP TABLE users;` | Database table destruction |
| `git push --force` | `git push --force origin main` | Overwrites remote history |
| `TRUNCATE` | `TRUNCATE TABLE orders;` | Bulk data removal |
| `DELETE FROM` (no WHERE) | `DELETE FROM users;` | Deletes all rows unconditionally |

