#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone

# Path to the blocked log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
# Each pattern is a tuple: (regex, description)
DESTRUCTIVE_PATTERNS = [
    # rm -rf / rm -r / rm -f with any target
    (r'\brm\s+-(?:[a-zA-Z]*r[a-zA-Z]*f|f[a-zA-Z]*r)[a-zA-Z]*\b', "rm -rf (recursive force delete)"),
    # Standalone rm -rf
    (r'\brm\s+-rf\b', "rm -rf (recursive force delete)"),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', "DROP TABLE (deletes entire table)"),
    # TRUNCATE
    (r'\bTRUNCATE\b', "TRUNCATE (removes all data from table)"),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+(?!\s+WHERE)\b', "DELETE FROM without WHERE (deletes all rows)"),
    # git push --force or git push -f
    (r'\bgit\s+push\s+.*--force\b', "git push --force (overwrites remote history)"),
    (r'\bgit\s+push\s+.*-f\b', "git push -f (overwrites remote history)"),
]


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt to the log file."""
    timestamp = datetime.now(timezone.utc).isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason} | Command: {command.strip()!r} | Project: {project_path}\n"
    
    # Ensure the log directory exists
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """
    Check if a command matches any destructive pattern.
    Returns (is_blocked, reason).
    """
    upper_command = command.upper()
    
    for pattern, description in DESTRUCTIVE_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, description
    
    return False, ""


def main():
    # Read the hook payload from stdin (Claude Code passes tool info as JSON)
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If not valid JSON, allow the command to proceed
        sys.exit(0)
    
    # Only intercept bash tool calls
    if payload.get("tool_name") != "bash":
        sys.exit(0)
    
    command = payload.get("command", "")
    
    is_blocked, reason = check_command(command)
    if is_blocked:
        log_blocked_attempt(command, reason)
        print(f"🛡️  BLOCKED: This command was prevented from running for safety reasons.\n\nReason: {reason}\n\nThe command '{command.strip()}' has been blocked to prevent accidental data loss or destructive operations. Please review your command and use a safer alternative if needed.", file=sys.stderr)
        sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()
# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code) that intercepts and blocks dangerous bash commands before they execute.

## What It Blocks

| Pattern | Reason |
|---------|--------|
| `rm -rf` | Recursive force deletion |
| `DROP TABLE` | Deletes entire database table |
| `TRUNCATE` | Removes all data from table |
| `DELETE FROM` without `WHERE` | Deletes all rows |
| `git push --force` / `git push -f` | Overwrites remote git history |

