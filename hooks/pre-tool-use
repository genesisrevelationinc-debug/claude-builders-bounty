#!/usr/bin/env python3

import os
import sys
import json
import re
from datetime import datetime
from pathlib import Path

def log_blocked_command(command: str, project_path: str):
    """Log blocked commands to the blocked.log file"""
    log_file = Path.home() / ".claude" / "hooks" / "blocked.log"
    log_file.parent.mkdir(parents=True, exist_ok=True)
    
    with open(log_file, "a") as f:
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        f.write(f"[{timestamp}] Blocked command: {command} | Project: {project_path}\n")

def main():
    # Read the tool call from stdin
    tool_call = json.load(sys.stdin)
    
    # Extract command and project path
    command = tool_call.get("tool", {}).get("bash", "")
    project_path = tool_call.get("task", {}).get("path", "Unknown")
    
    # Destructive patterns to block
    destructive_patterns = [
        r"rm\s+-rf",
        r"DROP\s+TABLE",
        r"git\s+push\s+--force",
        r"TRUNCATE",
        r"DELETE\s+FROM(?:(?!\s+WHERE).)*$"
    ]
    
    # Check if command matches any destructive pattern
    for pattern in destructive_patterns:
        if re.search(pattern, command, re.IGNORECASE):
            # Log the blocked command
            log_blocked_command(command, project_path)
            
            # Print explanation for Claude
            print(f"❌ BLOCKED: The command '{command}' has been blocked for security reasons.", file=sys.stderr)
            print("Reason: This command contains potentially destructive operations that are not allowed.", file=sys.stderr)
            print("Blocked patterns: rm -rf, DROP TABLE, git push --force, TRUNCATE, DELETE FROM without WHERE clause", file=sys.stderr)
            sys.exit(1)
    
    # If we get here, the command is safe
    print(json.dumps(tool_call))
    sys.exit(0)

if __name__ == "__main__":
    main()