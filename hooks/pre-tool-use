#!/bin/bash

# Pre-tool-use hook to block destructive bash commands
# Blocks: rm -rf, DROP TABLE, git push --force, TRUNCATE, DELETE FROM (without WHERE)

set -euo pipefail

# Log file for blocked commands
LOG_FILE="$HOME/.claude/hooks/blocked.log"

# Ensure log directory exists
mkdir -p "$(dirname "$LOG_FILE")"

# Get the command being executed
TOOL_NAME="$1"
shift
COMMAND_ARGS=("$@")

# Only check bash commands
if [[ "$TOOL_NAME" != "bash" && "$TOOL_NAME" != "sh" ]]; function check_bash_command() {
    local cmd="$1"
    
    # Check for destructive patterns
    if [[ $cmd == *"rm -rf"* ]] || 
       [[ $cmd == *"DROP TABLE"* ]] || 
       [[ $cmd == *"git push --force"* ]] || 
       [[ $cmd == *"TRUNCATE"* ]] || 
       [[ $cmd == *"DELETE FROM"* && $cmd != *WHERE* ]] ; then
        return 0  # Pattern found
    fi
    return 1  # No destructive pattern found
}

function log_blocked_command() {
    local timestamp=$(date -Iseconds)
    local project_path=$(pwd)
    echo "[$timestamp] Blocked command: $TOOL_NAME ${COMMAND_ARGS[*]}" >> "$LOG_FILE"
    echo "Project path: $project_path" >> "$LOG_FILE"
}

# Main execution
if [ "$TOOL_NAME" = "bash" ] || [ "$TOOL_NAME" = "sh" ]; then
    # Join all arguments into a single command string for pattern matching
    FULL_COMMAND="$*"
    
    # Check if destructive command
    if check_bash_command "$FULL_COMMAND"; then
        # Log the blocked command
        log_blocked_command
        
        # Output error message for Claude
        echo "ERROR: Destructive command blocked by security hook" >&2
        echo "Reason: Command contains destructive patterns" >&2
        echo "Blocked command: $TOOL_NAME ${COMMAND_ARGS[*]}" >&2
        echo "See ~/.claude/hooks/blocked.log for details" >&2
        exit 1
    fi
fi

# If we get here, the command is safe to execute
exit 0
}