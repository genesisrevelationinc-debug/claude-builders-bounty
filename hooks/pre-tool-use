#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


BLOCKED_PATTERNS = [
    # rm -rf (and variations like rm -rf /, rm -rf *)
    (r'\brm\s+(-[a-zA-Z]*\s+)?-rf(\s+|$)', 'rm -rf: recursively and forcefully removes files/directories'),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', 'DROP TABLE: deletes database tables'),
    # git push --force (and -f)
    (r'\bgit\s+push\s+.*--force\b', 'git push --force: overwrites remote history'),
    (r'\bgit\s+push\s+.*-f\b', 'git push -f: overwrites remote history'),
    # TRUNCATE
    (r'\bTRUNCATE\s+TABLE?\b', 'TRUNCATE: removes all data from a table'),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b)', 'DELETE FROM without WHERE: removes all rows from table'),
]

LOG_FILE = Path.home() / '.claude' / 'hooks' / 'blocked.log'


def get_project_path() -> str:
    """Get the current project path from environment or cwd."""
    return os.environ.get('PWD', os.getcwd())


def log_blocked_attempt(command: str, reason: str) -> None:
    """Log a blocked command attempt to the log file."""
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now().isoformat()
    project = get_project_path()
    with open(LOG_FILE, 'a') as f:
        f.write(f"{timestamp} | {project} | {command} | {reason}\n")


def check_command(command: str) -> tuple[bool, str]:
    """
    Check if a command matches any blocked pattern.
    Returns (is_blocked, reason).
    """
    upper = command.upper()
    for pattern, reason in BLOCKED_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, reason
    return False, ""


def main():
    # Read the hook input from stdin (Claude Code passes JSON)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)

    # Only intercept bash tool usage
    tool_name = data.get('tool_name', '')
    if tool_name != 'bash':
        sys.exit(0)

    command = data.get('tool_input', {}).get('command', '')
    if not command:
        sys.exit(0)

    is_blocked, reason = check_command(command)
    if is_blocked:
        log_blocked_attempt(command, reason)
        print(f"\n🚫 BLOCKED: This command was prevented from running.\n", file=sys.stderr)
        print(f"   Reason: {reason}\n", file=sys.stderr)
        print(f"   Command: {command}\n", file=sys.stderr)
        print(f"   This hook protects against destructive operations. If you need to run this command, disable the hook temporarily or run it manually.\n", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()

# Claude Code Pre-Tool-Use Hook: Block Destructive Bash Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code) that intercepts and blocks dangerous bash commands before they execute.

## What It Blocks

| Pattern | Reason |
|---------|--------|
| `rm -rf` | Recursively and forcefully removes files/directories |
| `DROP TABLE` | Deletes database tables |
| `git push --force` / `git push -f` | Overwrites remote history |
| `TRUNCATE` | Removes all data from a table |
| `DELETE FROM` without `WHERE` | Removes all rows from a table |

