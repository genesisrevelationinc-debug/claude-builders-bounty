#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook that blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Patterns that are always blocked (no exceptions)
ALWAYS_BLOCKED = [
    r"rm\s+-rf",
    r"rm\s+--recursive\s+--force",
    r"git\s+push\s+.*--force",
    r"git\s+push\s+.*-f\b",
    r"DROP\s+TABLE",
    r"TRUNCATE\s+",
]

# Patterns that are blocked only without a WHERE clause
DELETE_NO_WHERE = r"DELETE\s+FROM\s+"


def log_blocked(command: str, project_path: str):
    """Log a blocked command attempt to the blocked log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    log_entry = f"[{timestamp}] project={project_path} command={command}\n"
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_blocked(command: str) -> tuple[bool, str]:
    """
    Check if a command should be blocked.
    Returns (is_blocked, reason).
    """
    upper = command.upper()

    # Check always-blocked patterns
    for pattern in ALWAYS_BLOCKED:
        if re.search(pattern, command, re.IGNORECASE):
            return True, f"Matched blocked pattern: {pattern}"

    # Check DELETE FROM without WHERE
    if re.search(DELETE_NO_WHERE, command, re.IGNORECASE):
        if not re.search(r"WHERE\s+", command, re.IGNORECASE):
            return True, "DELETE FROM without a WHERE clause is not allowed"

    return False, ""


def main():
    # Claude Code passes hook input as JSON via stdin
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If not valid JSON, allow the tool use to proceed
        sys.exit(0)

    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})

    # Only intercept bash tool
    if tool_name != "bash":
        sys.exit(0)

    command = tool_input.get("command", "")
    project_path = hook_input.get("project_path", "unknown")

    blocked, reason = is_blocked(command)
    if blocked:
        log_blocked(command, project_path)
        print(f"🛡️  BLOCKED: This command was prevented from running for safety reasons.", file=sys.stderr)
        print(f"   Reason: {reason}", file=sys.stderr)
        print(f"   Command: {command}", file=sys.stderr)
        print(f"   If you believe this is safe, you can run it manually in a terminal.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()