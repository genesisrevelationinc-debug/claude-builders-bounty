#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook that blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


BLOCKED_PATTERNS = [
    # rm -rf (recursive force delete)
    (r'\brm\s+(?:-\S*\s+)?-rf?\b|\brm\s+-[a-z]*f[a-z]*r[a-z]*\b', 'rm -rf: Recursive force deletion is dangerous and can destroy data irreversibly.'),
    
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', 'DROP TABLE: This will permanently delete a database table and all its data.'),
    
    # git push --force
    (r'\bgit\s+push\s+(?:-\S*\s+)?--force\b|\bgit\s+push\s+-[a-z]*f[a-z]*\b', 'git push --force: Force pushing can overwrite remote history and cause data loss for collaborators.'),
    
    # TRUNCATE
    (r'\bTRUNCATE\b', 'TRUNCATE: This will delete all rows from a table without logging individual row deletions.'),
    
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+\s*;?\s*$', 'DELETE FROM without WHERE: This will delete ALL rows from the table. Add a WHERE clause to limit the scope.'),
]


def get_log_path():
    """Get the path to the blocked log file."""
    hooks_dir = Path.home() / '.claude' / 'hooks'
    return hooks_dir / 'blocked.log'


def log_blocked_attempt(command, project_path):
    """Log a blocked command attempt to the log file."""
    log_path = get_log_path()
    log_path.parent.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    log_entry = f"{timestamp} | {project_path} | {command}\n"
    
    with open(log_path, 'a') as f:
        f.write(log_entry)


def check_command(command):
    """Check if a command matches any blocked pattern. Returns (is_blocked, reason)."""
    command_upper = command.upper()
    
    for pattern, reason in BLOCKED_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, reason
    
    return False, None


def main():
    # Read the hook input from stdin (Claude Code passes JSON)
    try:
        hook_input = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        sys.exit(0)  # If we can't parse, let it through
    
    # Extract the command from the tool use
    command = hook_input.get('command', '') or hook_input.get('input', '') or ''
    project_path = hook_input.get('project_path', os.getcwd())
    
    is_blocked, reason = check_command(command)
    
    if is_blocked:
        log_blocked_attempt(command, project_path)
        
        # Output the block message for Claude
        print(f"\n🚫 BLOCKED: Destructive command detected!\n\nReason: {reason}\n\nCommand: {command}\n\nThis command has been blocked to prevent accidental data loss. If you need to run this command, please review it carefully and consider a safer alternative.", file=sys.stderr)
        sys.exit(1)  # Non-zero exit blocks the tool use
    
    sys.exit(0)  # Zero exit allows the tool use to proceed


if __name__ == '__main__':
    main()