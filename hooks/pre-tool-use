#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook that blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path

# Path to the log file
LOG_FILE = Path.home() / ".claude" / "hooks" / "blocked.log"

# Destructive patterns to block
# Each tuple: (pattern, description, requires_where_check)
DESTRUCTIVE_PATTERNS = [
    # rm -rf / rm -rfv / rm -fr etc.
    (r'\brm\s+(-[a-zA-Z]*[rf]|--recursive)\s+', "Recursive force remove (rm -rf)"),
    
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', "DROP TABLE - deletes entire database table"),
    
    # git push --force / git push -f
    (r'\bgit\s+push\s+.*(--force\b|-f\b)', "Force git push (overwrites remote history)"),
    
    # TRUNCATE
    (r'\bTRUNCATE\s+TABLE\b', "TRUNCATE TABLE - deletes all table data"),
    
    # DELETE FROM without WHERE (checked separately)
    (r'\bDELETE\s+FROM\b', "DELETE FROM without WHERE clause - deletes all rows"),
]


def log_blocked_attempt(command: str, reason: str, project_path: str):
    """Log a blocked command attempt to the log file."""
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    log_entry = f"[{timestamp}] BLOCKED: {reason} | Command: {command.strip()!r} | Project: {project_path}\n"
    
    with open(LOG_FILE, "a") as f:
        f.write(log_entry)


def check_delete_without_where(command: str) -> bool:
    """Check if a DELETE FROM statement lacks a WHERE clause."""
    # Match DELETE FROM ... that doesn't have WHERE before a semicolon or end of string
    delete_pattern = re.compile(r'\bDELETE\s+FROM\s+[^\s;]+(?:\s+[^;]*)?$', re.IGNORECASE)
    if not delete_pattern.search(command):
        return False
    
    # Check if WHERE is present (case insensitive)
    return not re.search(r'\bWHERE\b', command, re.IGNORECASE)


def main():
    # Read the hook payload from stdin
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)
    
    # Only intercept bash tool usage
    tool_name = payload.get("tool_name", "")
    if tool_name != "bash":
        sys.exit(0)
    
    command = payload.get("tool_input", {}).get("command", "")
    project_path = payload.get("project_path", "unknown")
    
    # Check each destructive pattern
    for pattern, description in DESTRUCTIVE_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            # Special case: DELETE FROM without WHERE
            if "DELETE FROM" in description and not check_delete_without_where(command):
                continue
            
            log_blocked_attempt(command, description, project_path)
            print(f"\n🚫 BLOCKED: {description}\n\nThe following command was prevented from running:\n  {command.strip()}\n\nThis command could cause irreversible data loss. If you need to run it, use a different method or disable the hook temporarily.", file=sys.stderr)
            sys.exit(1)
    
    # Allow the command
    sys.exit(0)


if __name__ == "__main__":
    main()