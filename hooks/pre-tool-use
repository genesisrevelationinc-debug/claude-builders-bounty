#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
and blocks them with a clear explanation.
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
# Each pattern is a tuple: (regex, description)
DANGEROUS_PATTERNS = [
    # rm -rf (and variants like rm -rf /, rm -rf *, etc.)
    (r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', "rm -rf: recursively and forcefully removes files/directories"),
    (r'\brm\s+.*\s+-[a-zA-Z]*rf', "rm -rf: recursively and forcefully removes files/directories"),
    
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', "DROP TABLE: permanently deletes a database table"),
    
    # git push --force
    (r'\bgit\s+push\s+.*--force\b', "git push --force: overwrites remote history, potentially losing work"),
    (r'\bgit\s+push\s+-[a-zA-Z]*f', "git push --force: overwrites remote history, potentially losing work"),
    
    # TRUNCATE
    (r'\bTRUNCATE\s+TABLE\b', "TRUNCATE TABLE: quickly removes all rows from a table (cannot be rolled back in some DBs)"),
    (r'\bTRUNCATE\b', "TRUNCATE: quickly removes all data (cannot be rolled back in some DBs)"),
    
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+\s*(?!WHERE\b)', "DELETE FROM without WHERE: deletes all rows from a table"),
]


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason} | Command: {command} | Project: {project_path}\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """
    Check if a command matches any dangerous pattern.
    Returns (is_dangerous, reason) tuple.
    """
    for pattern, description in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, description
    return False, ""


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        input_data = sys.stdin.read()
        if not input_data:
            sys.exit(0)
        
        data = json.loads(input_data)
        
        # Check if this is a bash tool use
        if data.get("tool_name") == "bash" or data.get("tool") == "bash":
            command = data.get("command", "")
            if not command:
                command = data.get("input", {}).get("command", "")
            
            is_dangerous, reason = check_command(command)
            if is_dangerous:
                log_blocked_attempt(command, reason)
                print(f"🚫 BLOCKED: This command was prevented from running.\n\nReason: {reason}\nCommand: {command}\n\nThis destructive operation has been blocked for safety. If you need to perform this action, please do it manually outside of Claude Code.", file=sys.stderr)
                sys.exit(1)
    
    except (json.JSONDecodeError, KeyError):
        pass


if __name__ == "__main__":
    main()
    sys.exit(0)


--- /dev/null
# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code/) that intercepts and blocks dangerous bash commands before they execute.

## What It Blocks

| Pattern | Why It's Blocked |
|---------|-----------------|
| `rm -rf` | Recursively and forcefully deletes files/directories |
| `DROP TABLE` | Permanently deletes database tables |
| `git push --force` | Overwrites remote git history, potentially losing work |
| `TRUNCATE` | Quickly removes all data (often non-transactional) |
| `DELETE FROM` without `WHERE` | Deletes all rows from a table |

