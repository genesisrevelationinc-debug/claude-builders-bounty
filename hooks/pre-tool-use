#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime


BLOCKED_PATTERNS = [
    # rm -rf pattern (removes directories forcefully)
    r"rm\s+(?:-[a-zA-Z]*f[a-zA-Z]*\s+|\s*-f\s+|\s+)+\s*",
    r"rm\s+.*\s+-[a-zA-Z]*f",
    
    # DROP TABLE - destructive SQL
    r"DROP\s+TABLE\s+",
    r"DROP\s+TABLE\s+IF\s+EXISTS\s+",
    
    # TRUNCATE - removes all data from table
    r"TRUNCATE\s+(TABLE\s+)?",
    
    # DELETE FROM without WHERE clause
    r"DELETE\s+FROM\s+\S+\s*$",
    r"DELETE\s+FROM\s+\S+\s+(?!WHERE\s+)",
    
    # git push --force
    r"git\s+push\s+.*--force",
    r"git\s+push\s+.*-f\s",
    r"git\s+push\s+-f",
]

LOG_FILE = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked_attempt(command: str, project_path: str):
    """Log a blocked command attempt with timestamp and project path."""
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    timestamp = datetime.now().isoformat()
    log_entry = f"{timestamp} | {project_path} | {command}\n"
    with open(LOG_FILE, "a") as f:
        f.write(log_entry)


def is_destructive(command: str) -> tuple[bool, str | None]:
    """Check if a command matches any destructive pattern."""
    upper = command.upper()
    for pattern in BLOCKED_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, pattern
    return False, None


def main():
    # Read the hook payload from stdin
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If we can't parse the payload, allow it through
        sys.exit(0)

    tool_name = payload.get("tool_name", "")
    tool_input = payload.get("tool_input", {})

    # Only intercept bash tool
    if tool_name != "bash":
        sys.exit(0)

    command = tool_input.get("command", "")
    project_path = payload.get("project_path", "unknown")

    is_bad, matched_pattern = is_destructive(command)
    if is_bad:
        log_blocked_attempt(command, project_path)
        print(f"🚫 BLOCKED: This command was prevented from running: `{command}`")
        print(f"   Reason: Matches destructive pattern: {matched_pattern}")
        print(f"   If you need to run this, use a different approach or disable the hook.")
        sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()