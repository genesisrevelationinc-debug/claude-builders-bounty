#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Blocks destructive bash commands.

Place at: ~/.claude/hooks/pre-tool-use
Make executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone

# Path to the blocked log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf (recursive force delete)
    (r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', "rm -rf: Recursive force delete"),
    (r'\brm\s+-[a-zA-Z]*r[a-zA-Z]*\s+.*-[a-zA-Z]*f', "rm -rf: Recursive force delete"),
    
    # SQL destructive commands
    (r'(?i)\bDROP\s+TABLE\b', "DROP TABLE: Database table deletion"),
    (r'(?i)\bTRUNCATE\b', "TRUNCATE: Table data deletion"),
    # DELETE FROM without WHERE
    (r'(?i)\bDELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b)', "DELETE FROM without WHERE: Unconditional data deletion"),
    
    # Git destructive commands
    (r'\bgit\s+push\s+.*--force\b', "git push --force: Force push can overwrite remote history"),
    (r'\bgit\s+push\s+-f\b', "git push -f: Force push can overwrite remote history"),
]


def log_blocked(command, reason, project_path):
    """Log a blocked command attempt to the log file."""
    timestamp = datetime.now(timezone.utc).isoformat()
    log_entry = f"{timestamp} | {reason} | Command: {command.strip()[:200]} | Project: {project_path}\n"
    
    # Ensure the directory exists
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command, project_path):
    """Check if a command matches any dangerous pattern."""
    for pattern, reason in DANGEROUS_PATTERNS:
        if re.search(pattern, command):
            return reason
    return None


def main():
    # Read the hook input from stdin (Claude Code passes JSON)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)
    
    # Extract tool name and input
    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})
    
    # Only check bash commands
    if tool_name != "Bash":
        sys.exit(0)
    
    command = tool_input.get("command", "")
    project_path = tool_input.get("project_path", os.getcwd())
    
    # Check for dangerous patterns
    block_reason = check_command(command, project_path)
    
    if block_reason:
        # Log the blocked attempt
        log_blocked(command, block_reason, project_path)
        
        # Print clear message to Claude (stderr so it appears in the conversation)
        print(f"\n🛡️  SECURITY HOOK BLOCKED: {block_reason}\n", file=sys.stderr)
        print(f"   Command: {command.strip()[:100]}", file=sys.stderr)
        print(f"   This destructive command was prevented from executing.\n", file=sys.stderr)
        sys.exit(1)  # Non-zero exit blocks the tool use


if __name__ == "__main__":
    main()