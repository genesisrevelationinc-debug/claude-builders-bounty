#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or destructive operations.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


HOOKS_DIR = Path.home() / ".claude" / "hooks"
BLOCKED_LOG = HOOKS_DIR / "blocked.log"

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf variants
    r"rm\s+(?:-[a-zA-Z]*f[a-zA-Z]*\s+|\s+-[a-zA-Z]*[a-zA-Z]*\s+.*-f.*\s+)?-?r\s+(?:-[a-zA-Z]*f[a-zA-Z]*\s+)?\S+",
    r"rm\s+(?:-[a-zA-Z]*\s+)*-rf\s+",
    r"rm\s+(?:-[a-zA-Z]*\s+)*-fr\s+",
    # DROP TABLE
    r"(?i)\bDROP\s+TABLE\b",
    # git push --force variants
    r"(?i)git\s+push\s+.*--force",
    r"(?i)git\s+push\s+-f\b",
    # TRUNCATE
    r"(?i)\bTRUNCATE\s+(?:TABLE\s+)?\S+",
    # DELETE FROM without WHERE
    r"(?i)\bDELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b)",
]


def get_project_path() -> str:
    """Get the current project path from environment or cwd."""
    return os.environ.get("PWD", os.getcwd())


def log_blocked_attempt(command: str) -> None:
    """Log a blocked command attempt to the blocked log file."""
    HOOKS_DIR.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now().isoformat()
    project = get_project_path()
    
    log_entry = f"{timestamp} | {project} | {command}\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_dangerous(command: str) -> tuple[bool, str]:
    """Check if a command matches dangerous patterns. Returns (is_dangerous, reason)."""
    for pattern in DANGEROUS_PATTERNS:
        if re.search(pattern, command):
            return True, f"Matched dangerous pattern: {pattern}"
    return False, ""


def main():
    # Read the tool use request from stdin
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        sys.exit(0)  # Allow if we can't parse
    
    # Only intercept bash tool
    if data.get("tool_name") != "bash":
        sys.exit(0)
    
    command = data.get("tool_input", {}).get("command", "")
    
    dangerous, reason = is_dangerous(command)
    if dangerous:
        log_blocked_attempt(command)
        print(f"🚫 BLOCKED: This command was prevented from running for safety reasons.", file=sys.stderr)
        print(f"   Command: {command}", file=sys.stderr)
        print(f"   Reason: Destructive operations like this can cause irreversible data loss.", file=sys.stderr)
        print(f"   If you need to run this, please do so manually outside of Claude Code.", file=sys.stderr)
        sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()