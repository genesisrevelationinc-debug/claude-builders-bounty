#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


BLOCKED_LOG_PATH = Path.home() / ".claude" / "hooks" / "blocked.log"


# Patterns that are always blocked (no exceptions)
ALWAYS_BLOCKED_PATTERNS = [
    (r"rm\s+(-[a-zA-Z]*\s+)*-?[a-zA-Z]*rf", "rm -rf: recursively and forcefully removes files/directories"),
    (r"git\s+push\s+.*--force", "git push --force: overwrites remote history, potentially losing work"),
    (r"DROP\s+TABLE", "DROP TABLE: permanently deletes a database table"),
    (r"TRUNCATE\s+", "TRUNCATE: quickly removes all rows from a table (cannot be rolled back in some DBs)"),
]

# Patterns that require a WHERE clause to be safe
DANGEROUS_WITHOUT_WHERE = [
    (r"DELETE\s+FROM\s+\w+\s*$", "DELETE FROM without WHERE: deletes all rows from table"),
]


def log_blocked_attempt(command: str, reason: str, project_path: str):
    """Log a blocked command attempt to the blocked log file."""
    BLOCKED_LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    log_entry = f"{timestamp} | PROJECT: {project_path} | COMMAND: {command} | REASON: {reason}\n"
    
    with open(BLOCKED_LOG_PATH, "a") as f:
        f.write(log_entry)


def check_command(command: str, project_path: str) -> tuple[bool, str]:
    """
    Check if a command should be blocked.
    Returns (should_block, reason).
    """
    command_upper = command.upper()
    
    # Check always-blocked patterns
    for pattern, reason in ALWAYS_BLOCKED_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, reason
    
    # Check patterns that need WHERE clause
    for pattern, reason in DANGEROUS_WITHOUT_WHERE:
        if re.search(pattern, command, re.IGNORECASE):
            return True, reason
    
    return False, ""


def main():
    # Read the hook input from stdin (JSON format per Claude Code hooks spec)
    try:
        hook_input = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # If not valid JSON, allow the command to proceed
        sys.exit(0)
    
    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})
    
    # Only intercept bash tool
    if tool_name != "bash":
        sys.exit(0)
    
    command = tool_input.get("command", "")
    project_path = hook_input.get("project_path", os.getcwd())
    
    should_block, reason = check_command(command, project_path)
    
    if should_block:
        log_blocked_attempt(command, reason, project_path)
        print(f"🛡️  BLOCKED: This command was prevented from running.\n\nReason: {reason}\nCommand: {command}\n\nIf you believe this is safe, you can run it manually or modify the hook at ~/.claude/hooks/pre-tool-use", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()