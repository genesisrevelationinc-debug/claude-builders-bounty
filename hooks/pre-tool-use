#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone


# Patterns that are always blocked (no exceptions)
ALWAYS_BLOCKED = [
    r"rm\s+(-[a-zA-Z]*\s+)*-rf",  # rm -rf (with any flag combination)
    r"git\s+push\s+.*--force",     # git push --force
    r"git\s+push\s+-f",             # git push -f
    r"DROP\s+TABLE",                # DROP TABLE
    r"TRUNCATE(\s+TABLE)?",         # TRUNCATE [TABLE]
]

# Patterns that are blocked only without a WHERE clause
DANGEROUS_WITHOUT_WHERE = [
    r"DELETE\s+FROM\s+\S+",        # DELETE FROM <table>
]

# Log file path
LOG_FILE = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt with timestamp and project path."""
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] REASON: {reason} | COMMAND: {command} | PROJECT: {project_path}\n"
    
    with open(LOG_FILE, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """
    Check if a command should be blocked.
    
    Returns:
        tuple of (is_blocked, reason_message)
    """
    command_upper = command.upper()
    command_stripped = command.strip()
    
    # Check always-blocked patterns
    for pattern in ALWAYS_BLOCKED:
        if re.search(pattern, command_stripped, re.IGNORECASE):
            return True, f"Destructive command blocked: matches pattern '{pattern}'"
    
    # Check DELETE FROM without WHERE
    for pattern in DANGEROUS_WITHOUT_WHERE:
        if re.search(pattern, command_stripped, re.IGNORECASE):
            # Check if there's a WHERE clause
            if not re.search(r"WHERE\s+", command_upper):
                return True, "Destructive command blocked: DELETE FROM without WHERE clause"
    
    return False, ""


def main():
    # Read the hook input from stdin (JSON)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If not valid JSON, allow the command to proceed
        sys.exit(0)
    
    # Extract the tool use details
    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})
    
    # Only intercept bash tool
    if tool_name != "bash":
        sys.exit(0)
    
    command = tool_input.get("command", "")
    
    is_blocked, reason = check_command(command)
    
    if is_blocked:
        log_blocked(command, reason)
        print(f"\n🚫 COMMAND BLOCKED by pre-tool-use hook\n   Reason: {reason}\n   Command: {command}\n", file=sys.stderr)
        sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()