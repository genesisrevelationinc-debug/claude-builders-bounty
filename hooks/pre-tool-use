#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Installation:
    cp hooks/pre-tool-use ~/.claude/hooks/pre-tool-use
    chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime


BLOCKED_PATTERNS = [
    # rm -rf (any variant)
    (r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', 'rm -rf: recursive force delete'),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', 'DROP TABLE: destructive SQL operation'),
    # git push --force
    (r'\bgit\s+push\s+.*--force\b', 'git push --force: force push can overwrite remote history'),
    # TRUNCATE
    (r'\bTRUNCATE\b', 'TRUNCATE: destructive SQL operation that removes all table data'),
]

# DELETE FROM without WHERE
DELETE_FROM_PATTERN = re.compile(r'\bDELETE\s+FROM\s+\w+', re.IGNORECASE)
WHERE_PATTERN = re.compile(r'\bWHERE\b', re.IGNORECASE)


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt to the blocked log file."""
    log_dir = os.path.expanduser('~/.claude/hooks')
    log_file = os.path.join(log_dir, 'blocked.log')
    
    os.makedirs(log_dir, exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f'[{timestamp}] BLOCKED: {reason}\n  Command: {command}\n  Project: {project_path}\n\n'
    
    with open(log_file, 'a') as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """Check if a command is destructive. Returns (is_blocked, reason)."""
    for pattern, reason in BLOCKED_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, reason
    
    # Check for DELETE FROM without WHERE
    if DELETE_FROM_PATTERN.search(command):
        if not WHERE_PATTERN.search(command):
            return True, 'DELETE FROM without WHERE: will delete all rows in table'
    
    return False, ''


def main():
    # Read the hook input from stdin (JSON format per Claude Code hooks spec)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON input, pass through
        return
    
    # Extract the command from the tool use
    command = hook_input.get('command', '') or hook_input.get('input', '') or str(hook_input)
    
    is_blocked, reason = check_command(command)
    
    if is_blocked:
        log_blocked_attempt(command, reason)
        
        print(f'🚫 BLOCKED: {reason}', file=sys.stderr)
        print(f'Command: {command}', file=sys.stderr)
        print('This destructive command has been blocked by the pre-tool-use hook.', file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()