#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
and blocks them with a clear explanation.
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf (recursive force delete)
    (r'\brm\s+(?:-[a-zA-Z]*r[a-zA-Z]*f|-[a-zA-Z]*f[a-zA-Z]*r)\b', 'rm -rf: Recursive force deletion'),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', 'DROP TABLE: Database table deletion'),
    # git push --force or git push -f
    (r'\bgit\s+push\s+(?:--force|-f)\b', 'git push --force: Force push can overwrite remote history'),
    # TRUNCATE
    (r'\bTRUNCATE\b', 'TRUNCATE: Complete table data removal'),
]

# DELETE FROM without WHERE clause
DELETE_FROM_PATTERN = r'\bDELETE\s+FROM\s+(\w+)'


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"{timestamp} | {reason} | Command: {command} | Project: {project_path}\n"
    
    with open(BLOCKED_LOG, 'a') as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """
    Check if a command is destructive.
    
    Returns:
        tuple of (is_blocked, reason)
    """
    # Check dangerous patterns
    for pattern, reason in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, reason
    
    # Check DELETE FROM without WHERE
    if re.search(DELETE_FROM_PATTERN, command, re.IGNORECASE):
        # Check if WHERE clause exists after DELETE FROM
        if not re.search(r'\bDELETE\s+FROM\s+\w+\s+WHERE\b', command, re.IGNORECASE):
            return True, 'DELETE FROM without WHERE: Unqualified row deletion'
    
    return False, ""


def main():
    # Read the tool use request from stdin
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If not valid JSON, allow to proceed
        sys.exit(0)
    
    # Check if this is a bash tool use
    if data.get("tool_name") == "bash":
        command = data.get("tool_input", {}).get("command", "")
        
        is_blocked, reason = check_command(command)
        if is_blocked:
            log_blocked_attempt(command, reason)
            print(f"🚫 BLOCKED: {reason}", file=sys.stderr)
            print(f"   Command: {command}", file=sys.stderr)
            print("   This destructive command has been blocked for safety.", file=sys.stderr)
            sys.exit(1)
    
    # Allow the tool use to proceed
    sys.exit(0)


if __name__ == "__main__":
    main()