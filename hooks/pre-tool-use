#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf (recursive force delete)
    (r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', "rm -rf: Recursive force deletion"),
    (r'\brm\s+-[a-zA-Z]*\s+.*-[a-zA-Z]*r[a-zA-Z]*\s', "rm -rf: Recursive force deletion"),
    
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', "DROP TABLE: Database table deletion"),
    
    # git push --force
    (r'\bgit\s+push\s+.*--force\b', "git push --force: Force push can overwrite remote history"),
    (r'\bgit\s+push\s+-f\b', "git push --force: Force push can overwrite remote history"),
    
    # TRUNCATE
    (r'\bTRUNCATE\s+TABLE\b', "TRUNCATE TABLE: Complete table data removal"),
    (r'\bTRUNCATE\s+\b', "TRUNCATE: Complete data removal"),
    
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+(?!\s+WHERE\b)', "DELETE FROM without WHERE: Deletes all rows in table"),
]


def log_blocked_attempt(command, reason, project_path):
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    log_entry = f"[{timestamp}] BLOCKED: {reason}\n"
    log_entry += f"  Command: {command}\n"
    log_entry += f"  Project: {project_path}\n"
    log_entry += "-" * 60 + "\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def main():
    # Read the hook input from stdin (JSON)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If we can't parse, let it through (fail open for safety, or fail closed - we choose to let unknown through)
        sys.exit(0)
    
    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})
    
    # Only intercept bash commands
    if tool_name != "bash":
        sys.exit(0)
    
    command = tool_input.get("command", "")
    project_path = hook_input.get("project_path", os.getcwd())
    
    # Check against dangerous patterns
    for pattern, reason in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            log_blocked_attempt(command, reason, project_path)
            print(f"🚫 BLOCKED: {reason}", file=sys.stderr)
            print(f"   Command: {command}", file=sys.stderr)
            print(f"   This command has been blocked to prevent data loss. Please use a safer alternative or review your intent.", file=sys.stderr)
            sys.exit(1)  # Non-zero exit blocks the tool use
    
    # Command is safe
    sys.exit(0)


if __name__ == "__main__":
    main()