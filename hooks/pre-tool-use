#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone


BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked(command: str, project_path: str):
    """Log a blocked command attempt with timestamp and project path."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat()
    with open(BLOCKED_LOG, "a") as f:
        f.write(f"{timestamp} | {project_path} | {command}\n")


def is_destructive(command: str) -> tuple[bool, str]:
    """
    Check if a command matches destructive patterns.
    Returns (is_blocked, reason).
    """
    upper = command.upper()
    lower = command.lower()

    # Pattern: rm -rf (and variants like rm -rf /, rm -rf *)
    if re.search(r'\brm\s+(-[a-zA-Z]*f|f[a-zA-Z]*)\b', lower):
        return True, "Command blocked: `rm -rf` and similar destructive remove patterns are not allowed."

    # Pattern: DROP TABLE
    if re.search(r'\bDROP\s+TABLE\b', upper):
        return True, "Command blocked: `DROP TABLE` is a destructive database operation and is not allowed."

    # Pattern: git push --force (and -f)
    if re.search(r'\bgit\s+push\s+.*(--force|-f)\b', lower):
        return True, "Command blocked: `git push --force` can overwrite remote history and is not allowed."

    # Pattern: TRUNCATE
    if re.search(r'\bTRUNCATE\b', upper):
        return True, "Command blocked: `TRUNCATE` is a destructive database operation and is not allowed."

    # Pattern: DELETE FROM without WHERE
    if re.search(r'\bDELETE\s+FROM\b', upper) and not re.search(r'\bWHERE\b', upper):
        return True, "Command blocked: `DELETE FROM` without a WHERE clause is dangerous and not allowed."

    return False, ""


def main():
    # Read the tool-use payload from stdin
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON payload, allow to proceed
        sys.exit(0)

    # Only intercept bash tool
    tool_name = payload.get("tool_name", "")
    if tool_name != "Bash":
        sys.exit(0)

    # Get the command being executed
    command = payload.get("tool_input", {}).get("command", "")
    if not command:
        sys.exit(0)

    # Check for destructive patterns
    blocked, reason = is_destructive(command)
    if blocked:
        # Get project path from environment or current directory
        project_path = os.environ.get("CLAUDE_PROJECT_PATH", os.getcwd())

        # Log the blocked attempt
        log_blocked(command, project_path)

        # Print reason and exit with error to block execution
        print(f"\n🛡️  {reason}\n", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()