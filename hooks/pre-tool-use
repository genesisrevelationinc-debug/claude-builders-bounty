#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime


BLOCKED_PATTERNS = [
    # rm -rf (recursive force delete)
    {
        "pattern": r"rm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+",
        "name": "rm -rf",
        "description": "Recursive force deletion of files/directories",
    },
    # DROP TABLE
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "name": "DROP TABLE",
        "description": "Dropping database tables",
    },
    # git push --force
    {
        "pattern": r"(?i)git\s+push\s+.*--force",
        "name": "git push --force",
        "description": "Force pushing to git repository",
    },
    # TRUNCATE
    {
        "pattern": r"(?i)\bTRUNCATE\s+TABLE\b",
        "name": "TRUNCATE",
        "description": "Truncating database tables",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)\bDELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b)",
        "name": "DELETE FROM without WHERE",
        "description": "Deleting all rows from a table without a WHERE clause",
    },
]

LOG_FILE = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt with timestamp and project path."""
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    log_entry = f"[{timestamp}] BLOCKED: {reason} | Command: {command} | Project: {project_path}\n"
    
    with open(LOG_FILE, "a") as f:
        f.write(log_entry)


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        input_data = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        sys.exit(0)  # If we can't parse, let it through

    # Only check bash tool invocations
    if input_data.get("tool_name") != "bash":
        sys.exit(0)

    command = input_data.get("command", "")

    for blocked in BLOCKED_PATTERNS:
        if re.search(blocked["pattern"], command):
            log_blocked_attempt(command, blocked["name"])
            print(
                f"\n🚫 BLOCKED: This command was prevented from running.\n"
                f"   Reason: {blocked['description']} ({blocked['name']})\n"
                f"   Command: {command}\n"
                f"   If you need to run this, please use a different method or review the command.\n"
            )
            sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()