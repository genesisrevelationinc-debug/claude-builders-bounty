#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or damage.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


HOOKS_DIR = Path.home() / ".claude" / "hooks"
BLOCKED_LOG = HOOKS_DIR / "blocked.log"


def log_blocked(command: str, project_path: str):
    """Log a blocked command attempt with timestamp and project path."""
    HOOKS_DIR.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now().isoformat()
    with open(BLOCKED_LOG, "a") as f:
        f.write(f"{timestamp} | {command} | {project_path}\n")


def is_destructive_bash(command: str) -> tuple[bool, str]:
    """
    Check if a bash command contains destructive patterns.
    
    Returns:
        Tuple of (is_blocked, reason_message)
    """
    command_upper = command.upper()
    command_lower = command.lower().strip()
    
    # Pattern 1: rm -rf (recursive force delete)
    if re.search(r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', command_lower) or \
       re.search(r'\brm\s+-\w*f\w*r\w*\s+', command_lower) or \
       re.search(r'\brm\s+.*\s+-rf(\s|$)', command_lower) or \
       re.search(r'\brm\s+-rf\s', command_lower):
        # More precise check for rm -rf
        if re.search(r'\brm\s+(-[a-zA-Z]*r[a-zA-Z]*f[a-zA-Z]*|-[a-zA-Z]*f[a-zA-Z]*r[a-zA-Z]*)\s', command_lower):
            return True, "Command 'rm -rf' is blocked to prevent accidental deletion of directories."
    
    # Check rm with -rf more carefully
    rm_match = re.search(r'\brm\s+(.+)', command_lower)
    if rm_match:
        flags = rm_match.group(1).split()[0] if rm_match.group(1) else ""
        if 'r' in flags and 'f' in flags and flags.startswith('-'):
            return True, "Command 'rm -rf' is blocked to prevent accidental deletion of directories."
    
    # Pattern 2: DROP TABLE (SQL destructive)
    if re.search(r'\bDROP\s+TABLE\b', command_upper):
        return True, "Command 'DROP TABLE' is blocked to prevent accidental table deletion."
    
    # Pattern 3: git push --force
    if re.search(r'\bgit\s+push\s+.*--force\b', command_lower) or \
       re.search(r'\bgit\s+push\s+.*-f\b', command_lower):
        return True, "Command 'git push --force' is blocked to prevent accidental overwrite of remote history."
    
    # Pattern 4: TRUNCATE (SQL destructive)
    if re.search(r'\bTRUNCATE\s+TABLE\b', command_upper) or \
       re.search(r'\bTRUNCATE\s+\b', command_upper):
        return True, "Command 'TRUNCATE' is blocked to prevent accidental data deletion."
    
    # Pattern 5: DELETE FROM without WHERE clause
    if re.search(r'\bDELETE\s+FROM\b', command_upper):
        # Check if there's no WHERE clause
        after_from = command_upper.split('FROM', 1)[-1]
        if 'WHERE' not in after_from:
            return True, "Command 'DELETE FROM' without a WHERE clause is blocked to prevent accidental deletion of all rows."
    
    return False, ""


def main():
    """Main entry point for the pre-tool-use hook."""
    # Read the tool use data from stdin
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If not valid JSON, allow the command to proceed
        sys.exit(0)
    
    # Only check bash tool calls
    if data.get("tool_name") != "bash":
        sys.exit(0)
    
    command = data.get("tool_input", {}).get("command", "")
    project_path = data.get("project_path", os.getcwd())
    
    is_blocked, reason = is_destructive_bash(command)
    
    if is_blocked:
        log_blocked(command, project_path)
        print(f"🚫 BLOCKED: {reason}", file=sys.stderr)
        print(f"   Attempted command: {command}", file=sys.stderr)
        print(f"   This command has been logged to {BLOCKED_LOG}", file=sys.stderr)
        sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()