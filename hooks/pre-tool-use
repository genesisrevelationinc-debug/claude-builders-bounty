#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the blocked log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
# Each pattern is a tuple: (regex, description)
DESTRUCTIVE_PATTERNS = [
    # rm -rf / rm -rf *
    (r"\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+|-f\s+).*", "rm -rf: Recursive force delete"),
    # DROP TABLE
    (r"\bDROP\s+TABLE\b", "DROP TABLE: Deletes an entire table"),
    # git push --force or git push -f
    (r"\bgit\s+push\s+.*(--force\b|-f\b)", "git push --force: Force push can overwrite remote history"),
    # TRUNCATE
    (r"\bTRUNCATE\b", "TRUNCATE: Removes all rows from a table without logging individual row deletions"),
    # DELETE FROM without WHERE
    (r"\bDELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b)", "DELETE FROM without WHERE: Deletes all rows in a table"),
]


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason} | Command: {command} | Project: {project_path}\n"
 log_entry = f"[{timestamp}] BLOCKED: {reason} | Command: {command} | Project: {project_path}\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """Check if a command matches any destructive pattern.
    
    Returns:
        (is_blocked, reason)
    """
    for pattern, reason in DESTRUCTIVE_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, reason
    return False, ""


def main():
    # Read the tool use data from stdin (Claude Code passes JSON)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a JSON input, allow it through
        sys.exit(0)
    
    # Check if this is a bash tool
    tool_name = data.get("tool", "")
    if tool_name != "bash":
        sys.exit(0)
    
    command = data.get("command", "")
    
    is_blocked, reason = check_command(command)
    if is_blocked:
        log_blocked_attempt(command, reason)
        print(f"🛡️  BLOCKED: This command was prevented from running.\n\nReason: {reason}\nCommand: {command}\n\nThis destructive operation has been logged. If you believe this is a mistake, please review the command and try a safer alternative.", file=sys.stderr)
        sysARF
        sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()