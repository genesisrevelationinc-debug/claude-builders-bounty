#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the blocked log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf (recursive force delete)
    (r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', "rm -rf: Recursive force delete"),
    (r'\brm\s+-[a-zA-Z]*r[a-zA-Z]*\s+.*\s+-[a-zA-Z]*f', "rm -rf: Recursive force delete"),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', "DROP TABLE: Destructive SQL operation"),
    # TRUNCATE
    (r'\bTRUNCATE\b', "TRUNCATE: Destructive SQL operation"),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b)', "DELETE FROM without WHERE: Unqualified delete"),
    # git push --force
    (r'\bgit\s+push\s+.*--force\b', "git push --force: Force push can overwrite history"),
    (r'\bgit\s+push\s+-f\b', "git push --force: Force push can overwrite history"),
]


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt to the log file."""
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason}\n  Command: {command}\n  Project: {project_path}\n\n"
    
    # Ensure the log directory exists
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """Check if a command is destructive. Returns (is_blocked, reason)."""
    for pattern, reason in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, reason
    return False, ""


def main():
    # Claude Code passes hook context as JSON via stdin
    try:
        hook_input = sys.stdin.read()
        if not hook_input.strip():
            sys.exit(0)
        
        context = json.loads(hook_input)
        tool_name = context.get("tool_name", "")
        tool_input = context.get("tool_input", {})
        
        # Only intercept bash tool
        if tool_name != "bash":
            sys.exit(0)
        
        command = tool_input.get("command", "")
        if not command:
            sys.exit(0)
        
        is_blocked, reason = check_command(command)
        if is_blocked:
            log_blocked_attempt(command, reason)
            print(f"\n🛡️  SECURITY BLOCK: This command was prevented from running.\n", file=sys.stderr)
            print(f"   Reason: {reason}\n", file=sys.stderr)
            print(f"   If you need to run this, please review the command manually.\n", file=sys.stderr)
            sys.exit(1)  # Non-zero exit blocks the tool execution
    
    except (json.JSONDecodeError, KeyError):
        sys.exit(0)


if __name__ == "__main__":
    main()