#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place at: ~/.claude/hooks/pre-tool-use
Make executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone

# Path to the blocked log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf (recursive force delete)
    {
        "pattern": r"rm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-?[a-zA-Z]*r[a-zA-Z]*\s+",
        "name": "rm -rf (recursive force deletion)",
    },
    # DROP TABLE
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "name": "DROP TABLE (database table deletion)",
    },
    # git push --force
    {
        "pattern": r"(?i)git\s+push\s+.*(--force|-f)\b",
        "name": "git push --force (force push)",
    },
    # TRUNCATE
    {
        "pattern": r"(?i)\bTRUNCATE\b",
        "name": "TRUNCATE (table data removal)",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b)",
        "name": "DELETE FROM without WHERE (unconditional deletion)",
    },
]


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat()
    project_path = os.getcwd()

    log_entry = f"{timestamp} | BLOCKED: {reason} | COMMAND: {command} | PROJECT: {project_path}\n"

    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_dangerous(command: str) -> tuple[bool, str]:
    """
    Check if a command matches any dangerous pattern.
    Returns (is_dangerous, reason).
    """
    for rule in DANGEROUS_PATTERNS:
        if re.search(rule["pattern"], command):
            return True, rule["name"]
    return False, ""


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        input_data = sys.stdin.read()
        if not input_data:
            sys.exit(0)

        data = json.loads(input_data)
    except (json.JSONDecodeError, Exception):
        # If we can't parse, let it through
        sys.exit(0)

    # Check if this is a bash tool use
    tool_name = data.get("tool_name", "")
    if tool_name != "bash":
        sys.exit(0)

    command = data.get("tool_input", {}).get("command", "")
    if not command:
        sys.exit(0)

    dangerous, reason = is_dangerous(command)
    if dangerous:
        log_blocked_attempt(command, reason)

        # Print clear message to Claude (stderr so it appears in Claude's context)
        print(
            f"\n🛡️  SECURITY HOOK BLOCKED: This command was prevented from running.\n"
            f"   Reason: {reason}\n"
            f"   Blocked command: {command}\n"
            f"   If you need to run this, please ask the user for explicit confirmation.\n",
            file=sys.stderr,
        )
        sys.exit(1)


if __name__ == "__main__":
    main()