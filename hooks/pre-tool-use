#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or destructive operations.
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the blocked attempts log file
BLOCKED_LOG = os.path.expanduser(" ~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf (recursive force delete)
    {
        "pattern": r"rm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+.*",
        "name": "rm -rf",
        "description": "Recursive force deletion of files/directories"
    },
    # DROP TABLE
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "name": "DROP TABLE",
        "description": "Drops (deletes) an entire database table"
    },
    # git push --force
    {
        "pattern": r"(?i)git\s+push\s+.*--force",
        "name": "git push --force",
        "description": "Force push that overwrites remote history"
    },
    # TRUNCATE
    {
        "pattern": r"(?i)\bTRUNCATE\s+TABLE?\b",
        "name": "TRUNCATE",
        "description": "Removes all rows from a table (cannot be rolled back in some DBs)"
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)\bDELETE\s+FROM\s+\w+\s*;?\s*$",
        "name": "DELETE FROM without WHERE",
        "description": "Deletes all rows from a table without a WHERE clause"
    },
]


def log_blocked_attempt(command: str, pattern_name: str):
    """Log a blocked attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {pattern_name} | Command: {command.strip()} | Project: {project_path}\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def main():
    # Read the tool use data from stdin (Claude Code hook protocol)
    try:
        tool_data = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # Not JSON, pass through
        sys.exit(0)
    
    # Only check bash tool
    if tool_data.get("tool") != "bash":
        sys.exit(0)
    
    command = tool_data.get("command", "")
    
    for rule in DANGEROUS_PATTERNS:
        if re.search(rule["pattern"], command):
            log_blocked_attempt(command, rule["name"])
            print(f"🚫 BLOCKED: {rule['name']}", file=sys.stderr)
            print(f"   Reason: {rule['description']}", file=sys.stderr)
            print(f"   Command: {command.strip()}", file=sys.stderr)
            print(f"\nThis command has been blocked by the pre-tool-use hook to prevent destructive operations.", file=sys.stderr)
            print(f"If you need to run this command, disable the hook or modify ~/.claude/hooks/pre-tool-use.", file=sys.stderr)
            sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()