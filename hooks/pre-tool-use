#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


# Patterns that are always blocked (destructive operations)
BLOCKED_PATTERNS = [
    # rm -rf variants
    r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+.*',
    r'\brm\s+.*\s+-[a-zA-Z]*rf[a-zA-Z]*\b',
    r'\brm\s+-[a-zA-Z]*f[a-zA-Z]*r[a-zA-Z]*\s+',
    
    # SQL destructive operations
    r'(?i)\bDROP\s+TABLE\b',
    r'(?i)\bTRUNCATE\b',
    
    # DELETE without WHERE
    r'(?i)^\s*DELETE\s+FROM\s+\S+\s*;?\s*$',
    r'(?i)^\s*DELETE\s+FROM\s+\S+\s+(?!WHERE\b).*$',
    
    # Git force push
    r'\bgit\s+push\s+.*--force\b',
    r'\bgit\s+push\s+.*-f\b',
]

# Compile patterns for efficiency
COMPILED_PATTERNS = [re.compile(p) for p in BLOCKED_PATTERNS]


def get_log_path() -> Path:
    """Get the path to the blocked attempts log file."""
    hooks_dir = Path.home() / ".claude" / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    return hooks_dir / "blocked.log"


def log_blocked_attempt(command: str, project_path: str) -> None:
    """Log a blocked command attempt with timestamp and project path."""
    log_path = get_log_path()
    timestamp = datetime.now().isoformat()
    log_entry = f"{timestamp} | {project_path} | {command}\n"
    
    with open(log_path, "a") as f:
        f.write(log_entry)


def is_command_blocked(command: str) -> bool:
    """Check if a command matches any blocked pattern."""
    for pattern in COMPILED_PATTERNS:
        if pattern.search(command):
            return True
    return False


def main() -> int:
    """Main entry point for the hook."""
    # Read the tool use data from stdin (Claude Code hook protocol)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If we can't parse the input, let it through (fail open for safety)
        return 0
    
    # Extract command from the tool use data
    command = data.get("command", "") if isinstance(data, dict) else ""
    
    if is_command_blocked(command):
        project_path = data.get("project_path", os.getcwd()) if isinstance(data, dict) else os.getcwd()
        log_blocked_attempt(command, project_path)
        
        # Print clear message to stderr (Claude will see this)
        print(f"\n🛡️  BLOCKED: Destructive command detected and prevented.\n", file=sys.stderr)
        print(f"   Command: {command}", file=sys.stderr)
        print(f"\n   This command matches a known destructive pattern (e.g., rm -rf, DROP TABLE, force push).", file=sys.stderr)
        print(f"   If you need to run this, please use a safer alternative or run it manually.\n", file=sys.stderr)
        return 1  # Non-zero exit blocks the tool use
    
    return 0  # Zero exit allows the tool use


if __name__ == "__main__":
    sys.exit(main())