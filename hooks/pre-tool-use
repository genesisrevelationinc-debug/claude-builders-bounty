#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Patterns to block with their descriptions
DANGEROUS_PATTERNS = [
    (
        re.compile(r"\brm\s+(-[a-zA-Z]*f|--force)\s+(-[a-zA-Z]*r|--recursive)\b|\brm\s+(-[a-zA-Z]*r|--recursive)\s+(-[a-zA-Z]*f|--force)\b", re.IGNORECASE),
        "rm -rf: Recursive force delete can destroy directories irreversibly"
    ),
    (
        re.compile(r"\bDROP\s+TABLE\b", re.IGNORECASE),
        "DROP TABLE: Permanently deletes database tables and all their data"
    ),
    (
        re.compile(r"\bgit\s+push\s+.*(--force|-f)\b", re.IGNORECASE),
        "git push --force: Can overwrite remote history and cause data loss"
    ),
    (
        re.compile(r"\bTRUNCATE\b", re.IGNORECASE),
        "TRUNCATE: Quickly removes all rows from a table without logging individual row deletions"
    ),
    (
        re.compile(r"\bDELETE\s+FROM\b", re.IGNORECASE),
        "DELETE FROM without WHERE: Deletes all rows from a table"
    ),
]


def log_blocked(command, reason, project_path):
    """Log a blocked command to the blocked log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.utcnow().isoformat() + "Z"
    log_entry = f"{timestamp} | {project_path} | BLOCKED: {reason} | Command: {command}\n"
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command):
    """Check if a command contains dangerous patterns."""
    for pattern, description in DANGEROUS_PATTERNS:
        if pattern.search(command):
            return description
    return None


def main():
    # Read the hook payload from stdin
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If not valid JSON, allow the tool use to proceed
        sys.exit(0)

    tool_name = payload.get("tool_name", "")
    tool_input = payload.get("tool_input", {})
    project_path = payload.get("project_path", os.getcwd())

    # Only intercept Bash tool
    if tool_name == "Bash":
        command = tool_input.get("command", "")
        block_reason = check_command(command)
        if block_reason:
            log_blocked(command, block_reason, project_path)
            print(f"\n🚫 BLOCKED: This command was prevented from running.\n   Reason: {block_reason}\n   Command: {command}\n", file=sys.stderr)
            sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()