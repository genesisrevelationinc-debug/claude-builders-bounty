#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone


BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked(command: str, project_path: str):
    """Log a blocked command attempt with timestamp and project path."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat()
    with open(BLOCKED_LOG, "a") as f:
        f.write(f"{timestamp} | {command} | {project_path}\n")


def is_destructive(command: str) -> tuple[bool, str]:
    """
    Check if a command matches destructive patterns.
    Returns (is_blocked, reason).
    """
    upper = command.upper()
    lower = command.lower()

    # Pattern: rm -rf (and variants like rm -rf /, rm -rf ., etc.)
    if re.search(r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-?[a-zA-Z]*f[a-zA-Z]*\s+\S', lower):
        # More specifically check for rm with -r and -f flags
        if re.search(r'\brm\s+(-[a-zA-Z]*[rf][a-zA-Z]*\s+)', lower) or re.search(r'\brm\s+-[rf]\s+', lower):
            return True, "Command blocked: `rm -rf` and variants are destructive and can delete files irreversibly."

    # Pattern: DROP TABLE
    if re.search(r'\bDROP\s+TABLE\b', upper):
        return True, "Command blocked: `DROP TABLE` is destructive and will delete database tables permanently."

    # Pattern: git push --force
    if re.search(r'\bgit\s+push\s+.*--force\b', lower) or re.search(r'\bgit\s+push\s+.*-f\b', lower):
        return True, "Command blocked: `git push --force` can overwrite remote history and cause data loss."

    # Pattern: TRUNCATE
    if re.search(r'\bTRUNCATE\b', upper):
        return True, "Command blocked: `TRUNCATE` removes all rows from a table and cannot be rolled back in some databases."

    # Pattern: DELETE FROM without WHERE
    if re.search(r'\bDELETE\s+FROM\b', upper):
        if not re.search(r'\bWHERE\b', upper):
            return True, "Command blocked: `DELETE FROM` without a WHERE clause would delete all rows from the table."

    return False, ""


def main():
    # Read the tool use JSON from stdin
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)

    # Only intercept bash tool
    if data.get("tool_name") != "bash":
        sys.exit(0)

    command = data.get("tool_input", {}).get("command", "")
    if not command:
        sys.exit(0)

    blocked, reason = is_destructive(command)
    if blocked:
        project_path = data.get("project_path", os.getcwd())
        log_blocked(command, project_path)

        # Print the blocking message to stderr so Claude sees it
        print(f"\n🛡️  SECURITY HOOK BLOCKED: {reason}", file=sys.stderr)
        print(f"   Attempted command: {command}\n", file=sys.stderr)
        sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()