#!/bin/bash

# Pre-tool-use hook to block destructive commands

set -e

# List of destructive patterns to block (case insensitive)
DESTRUCTIVE_PATTERNS=(
    "rm -rf"
    "DROP TABLE"
    "git push --force"
    "TRUNCATE"
    "DELETE FROM"
)

# Get the command being executed
TOOL_USE_CMD=$(cat)

# Check if command matches any destructive pattern
for PATTERN in "${DESTRUCTIVE_PATTERS[@]}"; do
    if [[ "$TOOL_USE_CMD" == *"$PATTERN"* ]]; then
        echo "Claude, this command has been blocked as it contains a potentially destructive pattern: $PATTERN" >&2
        
        # Log the blocked command
        LOG_FILE="$HOME/.claude/hooks/blocked.log"
        touch "$LOG_FILE"
        echo "$(date): $TOOL_USE_CMD" >> "$LOG_FILE"
        
        exit 1
    fi
done

echo "Blocked destructive command execution" >&2
exit 1

