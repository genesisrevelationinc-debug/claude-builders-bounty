#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone

BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Patterns that are always blocked (case-insensitive)
ALWAYS_BLOCKED = [
    re.compile(r"rm\s+(-[a-zA-Z]*\s+)*-rf", re.IGNORECASE),
    re.compile(r"git\s+push\s+.*--force", re.IGNORECASE),
    re.compile(r"git\s+push\s+.*-f\b", re.IGNORECASE),
    re.compile(r"\bDROP\s+TABLE\b", re.IGNORECASE),
    re.compile(r"\bTRUNCATE\b", re.IGNORECASE),
]

# Patterns that require a WHERE clause to be safe
DANGEROUS_WITHOUT_WHERE = [
    re.compile(r"\bDELETE\s+FROM\b", re.IGNORECASE),
]


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt with timestamp and project path."""
    timestamp = datetime.now(timezone.utc).isoformat()
    project_path = os.getcwd()
    log_entry = f"[{timestamp}] BLOCKED: {reason} | Command: {command} | Project: {project_path}\n"
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_blocked(command: str) -> tuple[bool, str]:
    """Check if a command should be blocked. Returns (is_blocked, reason)."""
    # Check always-blocked patterns
    for pattern in ALWAYS_BLOCKED:
        if pattern.search(command):
            return True, f"Matched dangerous pattern: {pattern.pattern}"

    # Check DELETE FROM without WHERE
    for pattern in DANGEROUS_WITHOUT_WHERE:
        if pattern.search(command):
            # Check if there's a WHERE clause after the DELETE FROM
            # Simple heuristic: look for WHERE after the match
            match = pattern.search(command)
            if match:
                after_match = command[match.end():]
                if not re.search(r"\bWHERE\b", after_match, re.IGNORECASE):
                    return True, "DELETE FROM without WHERE clause"

    return False, ""


def main():
    # Read the tool use request from stdin (JSON)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, let it pass
        sys.exit(0)

    # Only intercept bash tool
    if data.get("tool_name") != "bash":
        sys.exit(0)

    command = data.get("command", "")

    blocked, reason = is_blocked(command)
    if blocked:
        log_blocked(command, reason)
        print(
            f"🛡️  SECURITY HOOK BLOCKED: This command was prevented from running.\n"
            f"   Reason: {reason}\n"
            f"   Command: {command}\n\n"
            f"   If you believe this is safe, please review the command manually or adjust your approach.",
            file=sys.stderr,
        )
        sys.exit(1)


if __name__ == "__main__":
    main()