#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Blocks:
- rm -rf
- DROP TABLE
- git push --force
- TRUNCATE
- DELETE FROM without WHERE
"""

import json
import os
import re
import sys
from datetime import datetime

BLOCKED_PATTERNS = [
    (r"\brm\s+-rf?\b", "rm -rf: recursive force delete"),
    (r"\bDROP\s+TABLE\b", "DROP TABLE: destructive DDL"),
    (r"\bgit\s+push\s+--force\b", "git push --force: force push"),
    (r"\bTRUNCATE\b", "TRUNCATE: table data destruction"),
]

LOG_PATH = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked(command: str, reason: str):
    os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    with open(LOG_PATH, "a") as f:
        f.write(f"{timestamp} | {reason} | {command} | {project_path}\n")


def is_delete_without_where(command: str) -> bool:
    delete_match = re.search(r"\bDELETE\s+FROM\b", command, re.IGNORECASE)
    where_match = re.search(r"\bWHERE\b", command, re.IGNORECASE)
    return delete_match is not None and where_match is None


def check_command(command: str) -> str | None:
    for pattern, reason in BLOCKED_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return reason
    if is_delete_without_where(command):
        return "DELETE FROM without WHERE: unqualified delete"
    return None


def main():
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        print(json.dumps({"error": "Invalid JSON input"}))
        sys.exit(1)

    if data.get("tool_name") != "bash":
        print(json.dumps(data))
        return

    command = data.get("tool_input", {}).get("command", "")
    reason = check_command(command)

    if reason:
        log_blocked(command, reason)
        print(
            json.dumps(
                {
                    "error": f"🛡️ Command blocked by pre-tool-use hook: {reason}\n\nAttempted: {command}\n\nThis destructive operation has been prevented for safety. If you need to proceed, ask the user to run it manually."
                }
            )
        )
        return

    print(json.dumps(data))


if __name__ == "__main__":
    main()

# Claude Code Pre-Tool-Use Hook: Block Destructive Bash Commands

A `pre-tool-use` hook for Claude Code that intercepts and blocks dangerous bash commands before they execute.

## Blocked Patterns

- `rm -rf` — recursive force delete
- `DROP TABLE` — destructive DDL
- `git push --force` — force push
- `TRUNCATE` — table data destruction
- `DELETE FROM` without a `WHERE` clause — unqualified delete

