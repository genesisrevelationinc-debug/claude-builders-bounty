#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone

LOG_FILE = os.path.expanduser("~/.claude/hooks/blocked.log")

# Patterns that are always blocked (case-insensitive)
ALWAYS_BLOCKED = [
    re.compile(r"rm\s+(-[a-zA-Z]*\s+)*-rf", re.IGNORECASE),
    re.compile(r"git\s+push\s+.*--force", re.IGNORECASE),
    re.compile(r"git\s+push\s+.*-f\b", re.IGNORECASE),
    re.compile(r"DROP\s+TABLE", re.IGNORECASE),
    re.compile(r"TRUNCATE(\s+TABLE)?", re.IGNORECASE),
]

# Patterns that require WHERE clause (case-insensitive)
WHERE_REQUIRED = [
    re.compile(r"DELETE\s+FROM\s+\w+", re.IGNORECASE),
]


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt with timestamp and project path."""
    timestamp = datetime.now(timezone.utc).isoformat()
    project_path = os.getcwd()

    log_entry = (
        f"[{timestamp}] BLOCKED: {reason}\n"
        f"  Command: {command}\n"
        f"  Project: {project_path}\n"
        f"{'=' * 60}\n"
    )

    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    with open(LOG_FILE, "a") as f:
        f.write(log_entry)


def is_blocked(command: str) -> tuple[bool, str]:
    """Check if a command should be blocked. Returns (blocked, reason)."""
    for pattern in ALWAYS_BLOCKED:
        if pattern.search(command):
            return True, f"Destructive pattern detected: {pattern.pattern}"

    for pattern in WHERE_REQUIRED:
        if pattern.search(command):
            # Check if WHERE clause is present
            if not re.search(r"\bWHERE\b", command, re.IGNORECASE):
                return True, "DELETE FROM without WHERE clause is not allowed"

    return False, ""


def main():
    # Read the tool use request from stdin
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, let it pass
        sys.exit(0)

    tool_name = data.get("tool", "")
    command = data.get("input", {}).get("command", "")

    # Only intercept bash tool
    if tool_name != "bash":
        sys.exit(0)

    blocked, reason = is_blocked(command)
    if blocked:
        log_blocked(command, reason)
        print(f"🚫 BLOCKED: This command was intercepted by the pre-tool-use hook.\n", file=sys.stderr)
        print(f"Reason: {reason}", file=sys.stderr)
        print(f"Command: {command}", file=sys.stderr)
        print(f"\nIf you believe this is safe, you can run it manually or adjust the hook at ~/.claude/hooks/pre-tool-use", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()

# Pre-Tool-Use Hook: Block Destructive Bash Commands

A Claude Code `pre-tool-use` hook that intercepts and blocks dangerous bash commands before they are executed.

