#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or destructive operations.
"""

import json
import os
import re
import sys
from datetime import datetime


# Patterns that should be blocked
DANGEROUS_PATTERNS = [
    # rm -rf pattern (removes directories recursively and forcefully)
    (r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', "rm -rf: Recursive force removal can delete critical files"),
    
    # DROP TABLE pattern (deletes database tables)
    (r'\bDROP\s+TABLE\b', "DROP TABLE: Destructive database operation that deletes tables"),
    
    # git push --force pattern (force overwrites remote history)
    (r'\bgit\s+push\s+.*--force\b', "git push --force: Overwrites remote history, can cause data loss for team"),
    
    # TRUNCATE pattern (removes all data from a table)
    (r'\bTRUNCATE\b', "TRUNCATE: Removes all data from a table without logging individual row deletions"),
    
    # DELETE FROM without WHERE clause
    (r'\bDELETE\s+FROM\s+\S+\s*;?\s*$', "DELETE FROM without WHERE: Deletes all rows in a table"),
    (r'\bDELETE\s+FROM\s+\S+\s+(?!WHERE\b)', "DELETE FROM without WHERE: Deletes all rows in a table"),
]

# Log file path
LOG_FILE = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked_attempt(command, project_path):
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    log_entry = f"[{timestamp}] BLOCKED: {command} | Project: {project_path}\n"
    
    with open(LOG_FILE,a") as f:
        f.write(log_entry)


def check_command(command, project_path):
    """Check if a command matches any dangerous pattern."""
    for pattern, reason in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return reason
    return None


def main():
    # Read the hook input from stdin (JSON format per Claude Code hooks spec)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If not valid JSON, allow the command to proceed
        sys.exit(0)
    
    # Extract command details
    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})
    project_path = hook_input.get("project_path", os.getcwd())
    
    # Only check bash tool
    if tool_name != "bash":
        sys.exit(0)
    
    # Get the command
    command = tool_input.get("command", "")
    
    # Check for dangerous patterns
    block_reason = check_command(command, project_path)
    
    if block_reason:
        log_blocked_attempt(command, project_path)
        print(f"🚫 BLOCKED: This command was prevented from running.\n\nReason: {block_reason}\n\nCommand: {command}", file=sys.stderr)
        sys.exit(1)
    
    # Command is safe, allow it to proceed
    sys.exit(0)


if __name__ == "__main__":
    main()