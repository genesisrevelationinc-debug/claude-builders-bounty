#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook that blocks destructive bash commands.
"""

import sys
import os
import re
import datetime

def main():
    if len(sys.argv) < 3:
        # If not enough arguments, this is probably not a tool call
        sys.exit(0)
    
    tool_name = sys.argv[1]
    tool_args = sys.argv[2:]
    
    # Only check bash tools
    if tool_name != 'bash':
        sys.exit(0)
    
    # Join the command for checking
    command = ' '.join(tool_args)
    
    # Destructive patterns to block
    destructive_patterns = [
        r'rm\s+-rf',
        r'DROP\s+TABLE',
        r'git\s+push\s+--force',
        r'TRUNCATE',
        r'DELETE\s+FROM\s+\w+\s*$',  # DELETE without WHERE
    ]
    
    # Check if command matches any destructive pattern
    for pattern in destructive_patterns:
        if re.search(pattern, command, re.IGNORECASE):
            # Log the blocked command
            log_entry = f"[{datetime.datetime.now().isoformat()}] Blocked command: {command}"
            if 'PROJECT_PATH' in os.environ:
                log_entry += f" in project {os.environ['PROJECT_PATH']}"
            log_entry += "\n"
            
            # Ensure log directory exists
            log_file = os.path.expanduser('~/.claude/hooks/blocked.log')
            os.makedirs(os.path.dirname(log_file), exist_ok=True)
            
            # Write to log
            with open(log_file, 'a') as f:
                f.write(log_entry)
            
            # Print explanation and exit with error
            print(f"❌ Blocked potentially destructive command: {command}")
            print("Reason: This command was blocked for safety.")
            sys.exit(1)
    
    # If we get here, the command is safe to proceed
    sys.exit(0)

if __name__ == '__main__':
    main()