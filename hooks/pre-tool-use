#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or destructive operations.
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the log file
BLOCKED_LOG_PATH = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    {
        " pattern": r"rm\s+(-[a-zA-Z]*\s+)*-r\s+.*-f|rm\s+(-[a-zA-Z]*\s+)*-f\s+.*-r|rm\s+-rf\s+|rm\s+-fr\s+",
        "name": "rm -rf",
        "description": "Recursive force deletion of files/directories",
    },
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "name": "DROP TABLE",
        "description": "Drops (deletes) a database table and all its data",
    },
    {
        "pattern": r"(?i)git\s+push\s+.*--force|git\s+push\s+-f",
        "name": "git push --force",
        "description": "Force pushes to a remote repository, potentially overwriting others' work",
    },
    {
        "pattern": r"(?i)\bTRUNCATE\b",
        "name": "TRUNCATE",
        "description": "Removes all rows from a table (cannot be rolled back in some databases)",
    },
    {
        "pattern": r"(?i)\bDELETE\s+FROM\b(?!.*\bWHERE\b)",
        "name": "DELETE FROM without WHERE",
        "description": "Deletes all rows from a table without a WHERE clause",
    },
]


def log_blocked_attempt(command, project_path, pattern_name):
    """Log a blocked attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG_PATH), exist_ok=True)
    timestamp = datetime.now().isoformat()
    log_entry = f"[{timestamp}] BLOCKED: {pattern_name} | Command: {command} | Project: {project_path}\n"
    with open(BLOCKED_LOG_PATH, "a") as f:
        f.write(log_entry)


def main():
    # Read the hook input from stdin (JSON format per Claude Code hooks spec)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If not valid JSON, allow the command to proceed
        sys.exit(0)

    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})

    # Only intercept bash commands
    if tool_name != "bash":
        sys.exit(0)

    command = tool_input.get("command", "")
    project_path = hook_input.get("project_path", os.getcwd())

    # Check against dangerous patterns
    for pattern_info in DANGEROUS_PATTERNS:
        if re.search(pattern_info["pattern"], command):
            # Log the blocked attempt
            log_blocked_attempt(command, project_path, pattern_info["name"])

            # Print clear message to Claude
            print(f"🚫 BLOCKED: {pattern_info['name']}", file=sys.stderr)
            print(f"   Reason: {pattern_info['description']}", file=sys.stderr)
            print(f"   Command: {command}", file=sys.stderr)
            print(f"   This destructive command has been blocked to prevent accidental data loss.", file=sys.stderr)
            sys.exit(1)

    # Allow normal commands to proceed
    sys.exit(0)


if __name__ == "__main__":
    main()