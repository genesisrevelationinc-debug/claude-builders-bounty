#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


BLOCKED_PATTERNS = [
    # rm -rf / rm -r / rm -rf (any variation with -r or -R)
    (r'\brm\s+(?:-[a-zA-Z]*[rR][a-zA-Z]*\s+|\s*-+[a-zA-Z]*[rR]\S*\s+)', 'rm -rf / recursive rm'),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', 'DROP TABLE'),
    # git push --force or git push -f
    (r'\bgit\s+push\s+(?:--force|-f)\b', 'git push --force'),
    # TRUNCATE
    (r'\bTRUNCATE\b', 'TRUNCATE'),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b)', 'DELETE FROM without WHERE'),
]

LOG_FILE = Path.home() / '.claude' / 'hooks' / 'blocked.log'


def log_blocked_attempt(command: str, reason: str, project_path: str):
    """Log a blocked command attempt to the log file."""
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.utcnow().isoformat() + 'Z'
    log_entry = {
        'timestamp': timestamp,
        'attempted_command': command,
        'project_path': project_path,
        'blocked_reason': reason,
    }
    
    with open(LOG_FILE, 'a') as f:
        f.write(json.dumps(log_entry) + '\n')


def is_destructive(command: str) -> tuple[bool, str]:
    """Check if a command matches any destructive pattern."""
    command_upper = command.upper()
    
    for pattern, reason in BLOCKED_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, reason
    
    return False, ''


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON input, allow to proceed
        sys.exit(0)
    
    # Extract tool information
    tool_name = hook_input.get('tool_name', '')
    tool_input = hook_input.get('tool_input', {})
    
    # Only intercept bash tool
    if tool_name != 'bash':
        sys.exit(0)
    
    command = tool_input.get('command', '')
    project_path = hook_input.get('project_path', os.getcwd())
    
    is_blocked, reason = is_destructive(command)
    
    if is_blocked:
        log_blocked_attempt(command, reason, project_path)
        
        # Output error message for Claude
        print(f"🚫 BLOCKED: This command was prevented from running.", file=sys.stderr)
        print(f"   Reason: {reason}", file=sys.stderr)
        print(f"   Command: {command}", file=sys.stderr)
        print(f"   This destructive operation has been blocked for safety. "
              f"If you need to perform this action, please use a different method "
              f"or review the command carefully.", file=sys.stderr)
        
        sys.exit(1)
    
    sys.exit(0)


if __name__ == '__main__':
    main()