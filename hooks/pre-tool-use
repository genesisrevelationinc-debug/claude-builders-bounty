#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone


BLOCKED_PATTERNS = [
    # rm -rf (destructive recursive force remove)
    (r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', "rm -rf: recursive force delete"),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', "DROP TABLE: deletes entire table"),
    # git push --force
    (r'\bgit\s+push\s+.*--force\b', "git push --force: overwrites remote history"),
    (r'\bgit\s+push\s+-f\b', "git push -f: overwrites remote history"),
    # TRUNCATE
    (r'\bTRUNCATE\s+', "TRUNCATE: removes all table data"),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+[^;]+\s*;?\s*$', "DELETE FROM without WHERE: removes all rows"),
    (r'\bDELETE\s+FROM\s+[^;]+\s*(?!.*\bWHERE\b).*;?\s*$', "DELETE FROM without WHERE: removes all rows"),
]

# Simpler, more reliable DELETE FROM check
DELETE_FROM_PATTERN = re.compile(r'\bDELETE\s+FROM\s+(\w+)', re.IGNORECASE)


def get_log_path():
    """Get the path to the blocked log file."""
    hooks_dir = os.path.dirname(os.path.abspath(__file__))
    return os.path.join(hooks_dir, 'blocked.log')


def log_blocked_attempt(command, reason, project_path):
    """Log a blocked command attempt."""
    log_path = get_log_path()
    timestamp = datetime.now(timezone.utc).isoformat()
    log_entry = f"{timestamp} | {reason} | Command: {command} | Project: {project_path}\n"
    
    try:
        with open(log_path, 'a') as f:
            f.write(log_entry)
    except Exception as e:
        print(f"Warning: Could not write to log file {log_path}: {e}", file=sys.stderr)


def check_command(command):
    """Check if a command is destructive. Returns (is_blocked, reason)."""
    command_upper = command.upper()
    
    for pattern, reason in BLOCKED_PATTERNS[:5]:
        if re.search(pattern, command, re.IGNORECASE):
            return True, reason
    
    # Special check for DELETE FROM without WHERE
    if 'DELETE' in command_upper and 'FROM' in command_upper:
        if 'WHERE' not in command_upper:
            return True, "DELETE FROM without WHERE: removes all rows"
    
    return False, None


def main():
    # Read the tool use JSON from stdin
    try:
        tool_data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)
    
    # Only check bash tool
    if tool_data.get('tool') == 'bash':
        command = tool_data.get('command', '')
        is_blocked, reason = check_command(command)
        
        if is_blocked:
            project_path = os.getcwd()
            log_blocked_attempt(command, reason, project_path)
            print(f"\n🚫 BLOCKED: {reason}\nCommand: {command}\nThis destructive72 command could cause data loss or destruction. Please use a safer alternative or confirm you understand the risks.", file=sys.stderr)
            sys.exit(1)
    
    sys.exit(0)


if __name__ == '__main__':
    main()

# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code/hooks) that intercepts and blocks dangerous bash commands before they execute.

## What It Blocks

- `rm -rf` — recursive force deletion
- `DROP TABLE` — SQL table deletion
- `git push --force` / `git push -f` — force push overwriting history
- `TRUNCATE` — table data removal
- `DELETE FROM` without a `WHERE` clause — unqualified row deletion

