#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook that intercepts dangerous bash commands.

Blocks destructive patterns like rm -rf, DROP TABLE, git push --force,
TRUNCATE, and DELETE FROM without a WHERE clause.

Installation:
    mkdir -p ~/.claude/hooks
    cp hooks/pre-tool-use ~/.claude/hooks/pre-tool-use
    chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone

LOG_FILE = os.path.expanduser("~/.claude/hooks/blocked.log")

DANGEROUS_PATTERNS = [
    # rm -rf variations
    (re.compile(r'\brm\s+.*-rf\b', re.IGNORECASE),
     "rm -rf is destructive and can permanently delete files"),
    (re.compile(r'\brm\s+.*--recursive\b', re.IGNORECASE),
     "rm --recursive is destructive and can permanently delete files"),

    # SQL destructive commands
    (re.compile(r'\bDROP\s+TABLE\b', re.IGNORECASE),
     "DROP TABLE permanently deletes a database table and all its data"),
    (re.compile(r'\bTRUNCATE\b', re.IGNORECASE),
     "TRUNCATE removes all rows from a table without logging individual deletions"),
    (re.compile(r'\bDELETE\s+FROM\b(?!.*\bWHERE\b)', re.IGNORECASE),
     "DELETE FROM without a WHERE clause removes all rows from a table"),

    # Git destructive commands
    (re.compile(r'\bgit\s+push\s+.*--force\b', re.IGNORECASE),
     "git push --force overwrites remote history and can cause data loss"),
    (re.compile(r'\bgit\s+push\s+.*-f\b', re.IGNORECASE),
     "git push -f overwrites remote history and can cause data loss"),
]


def log_blocked(command: str, project_path: str) -> None:
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat()
    log_entry = (
        f"[{timestamp}] BLOCKED\n"
        f"  Command: {command}\n"
        f"  Project: {project_path}\n"
        f"{'-' * 60}\n"
    )
    with open(LOG_FILE, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """
    Check if a command matches any dangerous patterns.

    Returns:
        (is_dangerous, reason) tuple
    """
    for pattern, reason in DANGEROUS_PATTERNS:
        if pattern.search(command):
            return True, reason
    return False, ""


def main():
    """Main hook entry point."""
    try:
        input_data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If we can't parse input, allow the command through
        sys.exit(0)

    tool_name = input_data.get("tool_name", "")
    tool_input = input_data.get("tool_input", {})

    # Only intercept bash commands
    if tool_name != "bash":
        sys.exit(0)

    command = tool_input.get("command", "")
    if not command:
        sys.exit(0)

    project_path = os.getcwd()

    is_dangerous, reason = check_command(command)

    if is_dangerous:
        log_blocked(command, project_path)

        # Output a clear message to Claude explaining the block
        response = {
            "decision": "block",
            "reason": (
                f"🚫 BLOCKED: {reason}\n\n"
                f"Command: {command}\n\n"
                "This command was blocked by the pre-tool-use safety hook. "
                "If you believe this is a false positive, you can:\n"
                "1. Review the command and remove the dangerous pattern\n"
                "2. Temporarily disable the hook if you're certain it's safe\n"
                "3. Use a safer alternative (e.g., 'git push --force-with-lease' "
                "instead of 'git push --force')\n\n"
                f"Blocked attempts are logged to: {LOG_FILE}"
            ),
        }
        print(json.dumps(response))
        sys.exit(2)

    # Allow the command
    sys.exit(0)


if __name__ == "__main__":
    main()
