#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Blocks destructive bash commands.

Place this file at ~/.claude/hooks/pre-tool-use and make it executable:
    chmod +x ~/.claude/hooks/pre-tool-use

This hook intercepts dangerous bash commands before they are executed
and blocks them with a clear explanation.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


def log_blocked(command: str, project_path: str):
    """Log a blocked command to the blocked.log file."""
    log_dir = Path.home() / ".claude" / "hooks"
    log_dir.mkdir(parents=True, exist_ok=True)
    log_file = log_dir / "blocked.log"
    
    timestamp = datetime.now().isoformat()
    log_entry = f"[{timestamp}] project={project_path} command={command}\n"
    
    with open(log_file, "a") as f:
        f.write(log_entry)


def is_destructive(command: str) -> tuple[bool, str]:
    """
    Check if a command is destructive.
    
    Returns:
        Tuple of (is_blocked, reason)
    """
    command_lower = command.lower().strip()
    
    # Pattern: rm -rf (remove recursively and force)
    if re.search(r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', command_lower) or \
       re.search(r'\brm\s+.*-[a-zA-Z]*rf', command_lower):
        return True, "Blocked: `rm -rf` can recursively and forcefully delete files/directories without confirmation."
    
    # Pattern: DROP TABLE
    if re.search(r'\bdrop\s+table\b', command_lower):
        return True, "Blocked: `DROP TABLE` permanently deletes database tables and all their data."
    
    # Pattern: git push --force
    if re.search(r'\bgit\s+push\s+.*--force\b', command_lower) or \
       re.search(r'\bgit\s+push\s+.*-f\b', command_lower):
        return True, "Blocked: `git push --force` can overwrite remote history and cause data loss for the team."
    
    # Pattern: TRUNCATE
    if re.search(r'\btruncate\b', command_lower):
        return True, "Blocked: `TRUNCATE` quickly removes all rows from a table without logging individual row deletions."
    
    # Pattern: DELETE FROM without WHERE
    if re.search(r'\bdelete\s+from\b', command_lower) and not re.search(r'\bwhere\b', command_lower):
        return True, "Blocked: `DELETE FROM` without a WHERE clause would delete all rows in the table."
    
    return False, ""


def main():
    # Read the hook input from stdin (JSON format per Claude Code hooks spec)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)
    
    # Extract the tool name and input
    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})
    
    # Only intercept Bash tool
    if tool_name != "Bash":
        sys.exit(0)
    
    command = tool_input.get("command", "")
    project_path = tool_input.get("project_path", os.getcwd())
    
    blocked, reason = is_destructive(command)
    if blocked:
        log_blocked(command, project_path)
        print(f"🛡️  SECURITY HOOK: {reason}", file=sys.stderr)
        print(f"   Attempted command: {command}", file=sys.stderr)
        print(f"   If you need to run this, use a different tool or disable the hook.", file=sys.stderr)
        sys.exit(1)
    
    # Command is safe, allow it
    sys.exit(0)


if __name__ == "__main__":
    main()