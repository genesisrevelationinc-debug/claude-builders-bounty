#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Installation:
    cp hooks/pre-tool-use ~/.claude/hooks/pre-tool-use
    chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime


BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked(command: str, project_path: str):
    """Log a blocked command attempt with timestamp and project path."""
    timestamp = datetime.utcnow().isoformat() + "Z"
    log_entry = f"[{timestamp}] BLOCKED: {command} | project: {project_path}\n"
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_destructive(command: str) -> tuple[bool, str]:
    """
    Check if a command matches destructive patterns.
    Returns (is_blocked, reason).
    """
    upper = command.upper()

    # Pattern: rm -rf (or rm -r -f, rm -fr, etc.)
    if re.search(r'\brm\s+(-[a-zA-Z]*[rf]\S*|[a-zA-Z]*\s+)*', command, re.IGNORECASE):
        # More specific check for rm with -r and -f flags
        rm_match = re.search(r'\brm\s+(-[a-zA-Z]*[rf][a-zA-Z]*|-[a-zA-Z]*\s+-[a-zA-Z]*[rf])', command, re.IGNORECASE)
        if rm_match:
            return True, "Destructive file deletion: `rm -rf` is blocked to prevent accidental data loss."

    # Pattern: DROP TABLE
    if re.search(r'\bDROP\s+TABLE\b', upper):
        return True, "Destructive SQL: `DROP TABLE` is blocked to prevent data loss."

    # Pattern: git push --force
    if re.search(r'\bgit\s+push\s+.*--force\b', command, re.IGNORECASE) or \
       re.search(r'\bgit\s+push\s+.*-f\b', command, re.IGNORECASE):
        return True, "Destructive git operation: `git push --force` is blocked to prevent overwriting remote history."

    # Pattern: TRUNCATE
    if re.search(r'\bTRUNCATE\b', upper):
        return True, "Destructive SQL: `TRUNCATE` is blocked to prevent data loss."

    # Pattern: DELETE FROM without WHERE
    if re.search(r'\bDELETE\s+FROM\b', upper) and not re.search(r'\bWHERE\b', upper):
        return True, "Destructive SQL: `DELETE FROM` without a `WHERE` clause is blocked to prevent accidental deletion of all rows."

    return False, ""


def main():
    # Read the hook input from stdin (JSON)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, let it pass
        sys.exit(0)

    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})

    # Only intercept bash tool
    if tool_name != "bash":
        sys.exit(0)

    command = tool_input.get("command", "")
    project_path = hook_input.get("project_path", os.getcwd())

    blocked, reason = is_destructive(command)
    if blocked:
        log_blocked(command, project_path)
        print(f"🛡️  BLOCKED: {reason}", file=sys.stderr)
        print(f"   Attempted command: {command}", file=sys.stderr)
        print(f"   See log: {BLOCKED_LOG}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()

# Claude Code Pre-Tool-Use Hook: Block Destructive Bash Commands

A `pre-tool-use` hook for [Claude Code](https://docs.anthropic.com/claude-code/hooks) that intercepts and blocks dangerous bash commands before they are executed.

## What it blocks

| Pattern | Reason |
|---------|--------|
| `rm -rf` | Prevents accidental recursive file deletion |
| `DROP TABLE` | Prevents destructive SQL |
| `git push --force` | Prevents force-pushing and overwriting remote history |
| `TRUNCATE` | Prevents destructive SQL |
| `DELETE FROM` without `WHERE` | Prevents accidental deletion of all table rows |

