#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime


# Patterns that are always blocked (destructive commands)
BLOCKED_PATTERNS = [
    # rm -rf (recursive force delete)
    r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+.*',
    r'\brm\s+.*\s+-[a-zA-Z]*rf[a-zA-Z]*\b',
    
    # git push --force
    r'\bgit\s+push\s+.*--force\b',
    r'\bgit\s+push\s+.*-f\b',
    
    # SQL DROP TABLE
    r'\bDROP\s+TABLE\b',
    
    # SQL TRUNCATE
    r'\bTRUNCATE\s+TABLE?\b',
]

# Patterns that require WHERE clause validation
DANGEROUS_SQL_PATTERNS = [
    r'\bDELETE\s+FROM\s+\w+\s*$',  # DELETE FROM without WHERE
]


def get_log_path():
    """Get the path to the blocked log file."""
    hooks_dir = os.path.dirname(os.path.abspath(__file__))
    return os.path.join(hooks_dir, 'blocked.log')


def log_blocked_attempt(command, project_path):
    """Log a blocked attempt to the log file."""
    log_path = get_log_path()
    timestamp = datetime.now().isoformat()
    
    log_entry = f"{timestamp} | {project_path} | {command}\n"
    
    try:
        with open(log_path, 'a') as f:
            f.write(log_entry)
    except Exception as e:
        print(f"Warning: Could not write to log file: {e}", file=sys.stderr)


def is_command_blocked(command):
    """
    Check if a command should be blocked.
    
    Returns (is_blocked, reason) tuple.
    """
    # Check always-blocked patterns
    for pattern in BLOCKED_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, f"Command matches blocked pattern: {pattern}"
    
    # Check dangerous SQL patterns (DELETE FROM without WHERE)
    for pattern in DANGEROUS_SQL_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, "DELETE FROM without a WHERE clause is not allowed"
    
    return False, None


def main():
    """Main entry point for the hook."""
    # Read the tool use request from stdin (Claude Code hook format)
    try:
        input_data = sys.stdin.read()
        tool_request = json.loads(input_data)
    except (json.JSONDecodeError, ValueError):
        # If we can't parse the input, let it through (fail open for safety)
        return 0
    
    # Extract command from the tool request
    command = tool_request.get('command', '')
    tool_name = tool_request.get('tool', '')
    
    # Only check bash tool commands
    if tool_name != 'bash' and not command:
        return 0
    
    # Check if the command should be blocked
    is_blocked, reason = is_command_blocked(command)
    
    if is_blocked:
        project_path = os.getcwd()
        log_blocked_attempt(command, project_path)
        
        print(f"\n🚫 BLOCKED: This command has been prevented from executing.\n")
        print(f"Reason: {reason}")
        print(f"Command: {command}\n")
        print("If you need to run this command, please do so manually outside of Claude Code.\n")
        
        return 1
    
    return 0


if __name__ == '__main__':
    sys.exit(main())
# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A security hook for Claude Code that intercepts and blocks dangerous bash commands before they can execute.

## What It Blocks

- `rm -rf` — recursive force deletion
- `git push --force` / `git push -f` — force pushes
- `DROP TABLE` — SQL table deletion
- `TRUNCATE` — SQL table truncation
- `DELETE FROM` without a `WHERE` clause — unbounded SQL deletion

