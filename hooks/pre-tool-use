#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone


BLOCKED_LOG_PATH = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked_attempt(command: str, project_path: str):
    """Log a blocked command attempt with timestamp and project path."""
    os.makedirs(os.path.dirname(BLOCKED_LOG_PATH), exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat()
    log_entry = f"{timestamp} | {project_path} | {command}\n"
    with open(BLOCKED_LOG_PATH, "a") as f:
        f.write(log_entry)


def is_destructive_bash(command: str) -> tuple[bool, str]:
    """
    Check if a bash command is destructive.
    Returns (is_blocked, reason).
    """
    upper = command.upper()
    stripped = command.strip()

    # Pattern: rm -rf (and variants like rm -rfv, rm -fr)
    if re.search(r'\brm\s+-(?:[a-zA-Z]*[rf])', stripped, re.IGNORECASE):
        return True, "Destructive file deletion (rm -rf) is blocked to prevent accidental data loss."

    # Pattern: DROP TABLE
    if re.search(r'\bDROP\s+TABLE\b', upper):
        return True, "DROP TABLE is blocked to prevent accidental database table deletion."

    # Pattern: git push --force (and -f)
    if re.search(r'\bgit\s+push\s+.*--?f', stripped, re.IGNORECASE):
        return True, "git push --force is blocked to prevent overwriting remote history."

    # Pattern: TRUNCATE
    if re.search(r'\bTRUNCATE\b', upper):
        return True, "TRUNCATE is blocked to prevent accidental data removal."

    # Pattern: DELETE FROM without WHERE
    if re.search(r'\bDELETE\s+FROM\b', upper) and not re.search(r'\bWHERE\b', upper):
        return True, "DELETE FROM without a WHERE clause is blocked to prevent deleting all table rows."

    return False, ""


def main():
    # Read stdin for the tool use JSON
    try:
        tool_input = sys.stdin.read()
        tool_data = json.loads(tool_input)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)

    # Only intercept bash tool
    if tool_data.get("tool_name") != "bash":
        sys.exit(0)

    command = tool_data.get("command", "")
    project_path = tool_data.get("project_path", os.getcwd())

    is_blocked, reason = is_destructive_bash(command)

    if is_blocked:
        log_blocked_attempt(command, project_path)
        print(f"🛡️  BLOCKED: {reason}", file=sys.stderr)
        print(f"   Command: {command}", file=sys.stderr)
        print(f"   This command has been prevented from executing.", file=sys.stderr)
        print(f"   Logged to: {BLOCKED_LOG_PATH}", file=sys.stderr)
        sys.exit(1)

    # Command is safe, allow it
    sys.exit(0)


if __name__ == "__main__":
    main()