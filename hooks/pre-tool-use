#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Patterns to block with their descriptions
DANGEROUS_PATTERNS = [
    # rm -rf / rm -r / rm -f with any path
    (r'\brm\s+(?:-[a-zA-Z]*[rf]\S*\s+|\s+-\S*[rf]\S*\s+)', "rm -rf or similar recursive force delete"),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', "DROP TABLE - destructive SQL operation"),
    # TRUNCATE
    (r'\bTRUNCATE\b', "TRUNCATE - destructive SQL operation"),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b)', "DELETE FROM without WHERE clause"),
    # git push --force or git push -f
    (r'\bgit\s+push\s+.*--force\b', "git push --force - destructive git operation"),
    (r'\bgit\s+push\s+.*-f\b', "git push -f - destructive git operation"),
]


def log_blocked(command: str, reason: str):
    """Log a blocked command to the blocked.log file."""
    timestamp = datetime.utcnow().isoformat() + "Z"
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason} | Command: {command!r} | Project: {project_path}\n"
    
    # Ensure the hooks directory exists
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """Check if a command is dangerous. Returns (is_blocked, reason)."""
    for pattern, description in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, description
    return False, ""


def main():
    # Read the tool use JSON from stdin
    try:
        tool_data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)
    
    # Only check bash tool
    if not isinstance(tool_data, dict):
        sys.exit(0)
    
    tool_name = tool_data.get("tool", tool_data.get("name", ""))
    if tool_name not in ("bash", "Bash"):
        sys.exit(0)
    
    command = tool_data.get("command", "")
    
    is_blocked, reason = check_command(command)
    if is_blocked:
        log_blocked(command, reason)
        print(f"\n🛡️  SECURITY HOOK BLOCKED: This command was prevented from running.\n", file=sys.stderr)
        print(f"   Reason: {reason}\n", file=sys.stderr)
        print(f"   Command: {command}\n", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()