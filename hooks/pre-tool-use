#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


HOOKS_DIR = Path.home() / ".claude" / "hooks"
BLOCKED_LOG = HOOKS_DIR / "blocked.log"

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf (recursive force delete)
    {
        "pattern": r"rm\s+(?:-[a-zA-Z]*f[a-zA-Z]*\s+)?-?[a-zA-Z]*r[a-zA-Z]*\s+(?:-[a-zA-Z]*f[a-zA-Z]*\s+)?",
        "name": "rm -rf (recursive force delete)",
        "check": lambda cmd: re.search(r"rm\s+(?:-[a-zA-Z]*f[a-zA-Z]*\s+)?-?[a-zA-Z]*r[a-zA-Z]*\s+(?:-[a-zA-Z]*f[a-zA-Z]*\s+)?", cmd) is not None,
    },
    # DROP TABLE
    {
        "pattern": r"DROP\s+TABLE",
        "name": "DROP TABLE (deletes entire database table)",
        "check": lambda cmd: re.search(r"(?i)\bDROP\s+TABLE\b", cmd) is not None,
    },
    # git push --force
    {
        "pattern": r"git\s+push\s+.*--force",
        "name": "git push --force (overwrites remote history)",
        "check": lambda cmd: re.search(r"git\s+push\s+.*--force", cmd) is not None,
    },
    # TRUNCATE
    {
        "pattern": r"TRUNCATE",
        "name": "TRUNCATE (removes all rows from table)",
        "check": lambda cmd: re.search(r"(?i)\bTRUNCATE\b", cmd) is not None,
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"DELETE\s+FROM\s+\S+(?!.*WHERE)",
        "name": "DELETE FROM without WHERE (deletes all rows)",
        "check": lambda cmd: _is_delete_without_where(cmd),
    },
]


def _is_delete_without_where(command: str) -> bool:
    """Check if command is a DELETE FROM without a WHERE clause."""
    # Match DELETE FROM table_name (optionally with other clauses but no WHERE)
    match = re.search(r"(?i)\bDELETE\s+FROM\s+(\S+)", command)
    if not match:
        return False
    # Check if WHERE is present after the table name
    after_table = command[match.end():]
    return not re.search(r"(?i)\bWHERE\b", after_table)


def log_blocked_attempt(command: str, project_path: str, reason: str):
    """Log a blocked command attempt to the log file."""
    HOOKS_DIR.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now().isoformat()
    log_entry = f"{timestamp} | BLOCKED: {reason} | Command: {command.strip()} | Project: {project_path}\n"
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        hook_input = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        sys.exit(0)  # If we can't parse, let it through

    # Only check bash tool
    if hook_input.get("tool_name") != "bash":
        sys.exit(0)

    command = hook_input.get("command", "")
    project_path = hook_input.get("project_path", os.getcwd())

    for pattern in DANGEROUS_PATTERNS:
        if pattern["check"](command):
            log_blocked_attempt(command, project_path, pattern["name"])
            print(f"\n🚫 BLOCKED: This command was prevented from running.\n", file=sys.stderr)
            print(f"   Reason: {pattern['name']}\n", file=sys.stderr)
            print(f"   Command: {command.strip()}\n", file=sys.stderr)
            print(f"   This destructive operation could cause irreversible data loss.", file=sys.stderr)
            print(f"   If you're sure, run it manually or modify the command to be safe.\n", file=sys.stderr)
            sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()