#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
in Claude Code, preventing accidental data loss.

Installation:
    mkdir -p ~/.claude/hooks
    cp pre-tool-use ~/.claude/hooks/pre-tool-use
    chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path

# Configuration
BLOCKED_LOG_PATH = Path.home() / ".claude" / "hooks" / "blocked.log"
DANGEROUS_PATTERNS = [
    # rm -rf (recursive force delete)
    r"\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+.*",
    r"\brm\s+.*\s+-[a-zA-Z]*rf[a-zA-Z]*",
    # DROP TABLE
    r"\bDROP\s+TABLE\b",
    # git push --force
    r"\bgit\s+push\s+.*(--force|-f)\b",
    # TRUNCATE
    r"\bTRUNCATE\s+TABLE\b",
    # DELETE FROM without WHERE
    r"\bDELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b)",
]


def get_project_path() -> str:
    """Get the current project path from environment or current directory."""
    return os.environ.get("PWD", os.getcwd())


def log_blocked_attempt(command: str, reason: str) -> None:
    """Log a blocked command attempt to the log file."""
    BLOCKED_LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    project_path = get_project_path()
    
    log_entry = (
        f"[{timestamp}] BLOCKED: {reason}\n"
        f"  Command: {command}\n"
        f"  Project: {project_path}\n"
        f"{'=' * 60}\n"
    )
    
    with open(BLOCKED_LOG_PATH, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """Check if a command matches dangerous patterns."""
    for pattern in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, pattern
    return False, ""


def main() -> None:
    """Main entry point for the pre-tool-use hook."""
    # Read the tool use request from stdin
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If not valid JSON, allow the command to proceed
        sys.exit(0)
    
    # Extract the command from the tool use data
    command = data.get("command", "") if isinstance(data, dict) else ""
    if not command and isinstance(data, dict):
        # Try to get command from nested structure
        command = str(data)
    
    is_dangerous, matched_pattern = check_command(command)
    
    if is_dangerous:
        log_blocked_attempt(command, f"Matched pattern: {matched_pattern}")
        print(f"🚫 BLOCKED: This command was prevented from executing.\n\n"
              f"Command: {command}\n\n"
              f"Reason: This command matches a dangerous pattern that could cause "
              f"irreversible data loss. Please review your request and use safer alternatives.", file=sys.stderr)
        sys.exit(1)
    
    # Allow the command to proceed
    sys.exit(0)


if __name__ == "__main__":
    main()
# Pre-Tool-Use Hook: Block Destructive Bash Commands

A Claude Code `pre-tool-use` hook that intercepts and blocks dangerous bash commands before they can be executed.

## What It Blocks

| Pattern | Example | Risk |
|---------|---------|------|
| `rm -rf` | `rm -rf /important/data` | Irreversible data deletion |
| `DROP TABLE` | `DROP TABLE users` | Database table destruction |
| `git push --force` | `git push --force origin main` | Overwrites remote history |
| `TRUNCATE` | `TRUNCATE TABLE orders` | Bulk data removal |
| `DELETE FROM` (no WHERE) | `DELETE FROM users` | Deletes all table rows |

## Installation

