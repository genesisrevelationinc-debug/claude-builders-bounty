#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Patterns that are always blocked (case-insensitive)
ALWAYS_BLOCKED = [
    r"rm\s+(-[a-zA-Z]*\s+)*-([a-zA-Z]*r[a-zA-Z]*f|f[a-zA-Z]*r)\S*",  # rm -rf, rm -fr, etc.
    r"git\s+push\s+.*--force",  # git push --force
    r"git\s+push\s+-f\b",  # git push -f
    r"\bDROP\s+TABLE\b",  # DROP TABLE
    r"\bTRUNCATE\b",  # TRUNCATE
]

# Patterns that require a WHERE clause
REQUIRES_WHERE = [
    r"\bDELETE\s+FROM\b",  # DELETE FROM without WHERE
]


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt to the blocked log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] REASON: {reason} | COMMAND: {command} | PROJECT: {project_path}\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """
    Check if a command should be blocked.
    Returns (should_block, reason).
    """
    upper = command.upper()
    
    # Check always-blocked patterns
    for pattern in ALWAYS_BLOCKED:
        if re.search(pattern, command, re.IGNORECASE):
            return True, f"Matched blocked pattern: {pattern}"
    
    # Check DELETE FROM without WHERE
    if re.search(REQUIRES_WHERE[0], command, re.IGNORECASE):
        # Check if WHERE exists in the command (simple check)
        if not re.search(r"\bWHERE\b", upper):
            return True, "DELETE FROM without WHERE clause is not allowed"
    
    return False, ""


def main():
    # Read the hook input from stdin (JSON)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)
    
    # Only intercept bash tool usage
    tool_name = data.get("tool_name", "")
    if tool_name != "bash":
        sys.exit(0)
    
    command = data.get("tool_input", {}).get("command", "")
    if not command:
        sys.exit(0)
    
    should_block, reason = check_command(command)
    if should_block:
        log_blocked(command, reason)
        print(f"🚫 BLOCKED: This command was prevented from running for safety reasons.\n   Reason: {reason}\n   Command: {command}", file=sys.stderr)
        sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()