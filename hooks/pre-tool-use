#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


# Path to the blocked log file
BLOCKED_LOG = Path.home() / ".claude" / "hooks" / "blocked.log"

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    {
        "pattern": r"rm\s+(-[a-zA-Z]*\s+)?-rf?\s+",
        "name": "rm -rf",
        "description": "Force recursive deletion of files/directories",
    },
    {
        "pattern": r"rm\s+.*\s+-rf",
        "name": "rm -rf",
        "description": "Force recursive deletion of files/directories",
    },
    {
        "pattern": r"DROP\s+TABLE",
        "name": "DROP TABLE",
        "description": "Drops (deletes) a database table",
        "case_sensitive": False,
    },
    {
        "pattern": r"git\s+push\s+.*--force",
        "name": "git push --force",
        "description": "Force pushes to git repository, potentially overwriting history",
    },
    {
        "pattern": r"git\s+push\s+-f",
        "name": "git push --force",
        "description": "Force pushes to git repository, potentially overwriting history",
    },
    {
        "pattern": r"TRUNCATE\s+",
        "name": "TRUNCATE",
        "description": "Removes all rows from a table without logging individual row deletions",
        "case_sensitive": False,
    },
    {
        "pattern": r"DELETE\s+FROM\s+[^W][^H][^E][^R][^E]",
        "name": "DELETE FROM without WHERE",
        "description": "Deletes all rows from a table without a WHERE clause",
        "case_sensitive": False,
    },
]


def log_blocked_attempt(command: str, project_path: str):
    """Log a blocked command attempt to the log file."""
    BLOCKED_LOG.parent.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now().isoformat()
    with open(BLOCKED_LOG, "a") as f:
        f.write(f"{timestamp} | {project_path} | {command}\n")


def check_command(command: str, project_path: str) -> tuple[bool, str]:
    """Check if a command matches any dangerous pattern. Returns (is_blocked, reason)."""
    for rule in DANGEROUS_PATTERNS:
        flags = 0 if rule.get("case_sensitive", True) else re.IGNORECASE
        if re.search(rule["pattern"], command, flags):
            reason = f"Blocked destructive command: {rule['name']} ({rule['description']})"
            return True, reason
    return False, ""


def main():
    # Read the tool use payload from stdin
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If we can't parse the input, let it through (fail open for safety)
        sys.exit(0)

    # Only check bash tool
    if payload.get("tool_name") != "bash":
        sys.exit(0)

    command = payload.get("command", "")
    project_path = payload.get("project_path", "unknown")

    is_blocked, reason = check_command(command, project_path)
    if is_blocked:
        log_blocked_attempt(command, project_path)
        print(f"🛡️  SECURITY BLOCKED: {reason}", file=sys.stderr)
        print(f"   Command: {command}", file=sys.stderr)
        print(f"   This command has been blocked to prevent accidental data loss. If you need to run this command, please do so manually outside of Claude Code.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()

# Claude Code Pre-Tool-Use Hook: Block Destructive Bash Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code) that intercepts and blocks dangerous bash commands before they can execute.

## What It Blocks

| Pattern | Description |
|---------|-------------|
| `rm -rf` | Force recursive deletion of files/directories |
| `DROP TABLE` | Drops (deletes) a database table |
| `git push --force` / `git push -f` | Force pushes to git repository, potentially overwriting history |
| `TRUNCATE` | Removes all rows from a table without logging individual row deletions |
| `DELETE FROM` without `WHERE` | Deletes all rows from a table without a WHERE clause |

## Installation

