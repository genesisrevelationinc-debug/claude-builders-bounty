#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
and blocks them with a clear explanation.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


HOOKS_DIR = Path.home() / ".claude" / "hooks"
BLOCKED_LOG = HOOKS_DIR / "blocked.log"


# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf (and variants like rm -r -f, rm -rfv, etc.)
    {
        "pattern": r"rm\s+(?:-[a-zA-Z]*[rf]|--recursive|--force|\s+)*\s*-?[a-zA-Z]*[rf]",
        "name": "rm -rf",
        "description": "Recursively and forcefully removes files/directories",
    },
    # DROP TABLE
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "name": "DROP TABLE",
        "description": "Permanently deletes a database table and all its data",
    },
    # git push --force
    {
        "pattern": r"(?i)git\s+push\s+.*--force\b",
        "name": "git push --force",
        "description": "Forcefully overwrites remote history, potentially losing work",
    },
    # TRUNCATE
    {
        "pattern": r"(?i)\bTRUNCATE\s+TABLE?\b",
        "name": "TRUNCATE",
        "description": "Quickly deletes all rows from a table without logging individual deletions",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)\bDELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b)",
        "name": "DELETE FROM without WHERE",
        "description": "Deletes all rows from a table without a WHERE clause",
    },
]


def log_blocked_attempt(command: str, pattern_name: str, project_path: str):
    """Log a blocked command attempt to the blocked log file."""
    HOOKS_DIR.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now().isoformat()
    log_entry = f"{timestamp} | {pattern_name} | {command} | {project_path}\n"
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command: str, project_path: str) -> tuple[bool, str]:
    """Check if a command matches any dangerous pattern. Returns (is_blocked, reason)."""
    for rule in DANGEROUS_PATTERNS:
        if re.search(rule["pattern"], command):
            log_blocked_attempt(command, rule["name"], project_path)
            reason = (
                f"🚫 BLOCKED: Destructive command detected: {rule['name']}\n"
                f"   Reason: {rule['description']}\n"
                f"   Command: {command}\n\n"
                f"This command has been blocked to prevent accidental data loss. "
                f"If you need to run this command, please review it carefully and "
                f"use an alternative safe approach."
            )
            return True, reason
    return False, ""


def main():
    # Claude Code hooks receive JSON on stdin
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON input, pass through
        sys.exit(0)

    # Extract tool use information
    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})

    # Only check bash tool
    if tool_name != "bash":
        sys.exit(0)

    command = tool_input.get("command", "")
    project_path = hook_input.get("project_path", str(Path.cwd()))

    is_blocked, reason = check_command(command, project_path)
    if is_blocked:
        print(reason, file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()