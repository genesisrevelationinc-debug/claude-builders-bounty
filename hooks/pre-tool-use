#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone


BLOCKED_PATTERNS = [
    # rm -rf (any variant)
    (r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', "rm -rf: recursive force delete"),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', "DROP TABLE: database table deletion"),
    # git push --force
    (r'\bgit\s+push\s+.*--force\b', "git push --force: force push can overwrite history"),
    # TRUNCATE
    (r'\bTRUNCATE\b', "TRUNCATE: removes all data from table"),
]

# DELETE FROM without WHERE
DELETE_FROM_PATTERN = re.compile(r'\bDELETE\s+FROM\s+\S+', re.IGNORECASE)
WHERE_PATTERN = re.compile(r'\bWHERE\b', re.IGNORECASE)


def get_log_path():
    """Get the path to the blocked log file."""
    hooks_dir = os.path.dirname(os.path.abspath(__file__))
    return os.path.join(hooks_dir, 'blocked.log')


def log_blocked(command, reason):
    """Log a blocked command to the log file."""
    log_path = get_log_path()
    timestamp = datetime.now(timezone.utc).isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason}\n  Command: {command}\n  Project: {project_path}\n\n"
    
    try:
        with open(log_path, 'a') as f:
            f.write(log_entry)
    except Exception as e:
        print(f"Warning: Could not write to log file {log_path}: {e}", file=sys.stderr)


def check_command(command):
    """Check if a command is destructive. Returns (is_blocked, reason)."""
    command_upper = command.upper()
    
    # Check explicit blocked patterns
    for pattern, reason in BLOCKED_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, reason
    
    # Check DELETE FROM without WHERE
    if DELETE_FROM_PATTERN.search(command):
        # Extract the part after DELETE FROM to check for WHERE
        if not WHERE_PATTERN.search(command):
            return True, "DELETE FROM without WHERE: deletes all rows without filtering"
    
    return False, None


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        input_data = sys.stdin.read()
        if not input_data:
            sys.exit(0)
        
        data = json.loads(input_data)
        command = data.get('command', '') or data.get('input', '') or str(data)
        
        is_blocked, reason = check_command(command)
        
        if is_blocked:
            log_blocked(command, reason)
            print(f"\n🚫 BLOCKED: This command was prevented from running.\n   Reason: {reason}\n   Command: {command}\n", file=sys.stderr)
            sys.exit(1)
    
    except json.JSONDecodeError:
        # Not JSON input, treat as plain text command
        pass
    except Exception:
        # If anything goes wrong, don't block the command
        pass


if __name__ == '__main__':
    main()
# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code/) that intercepts and blocks dangerous bash commands before they execute.

## What It Blocks

| Pattern | Why It's Blocked |
|---------|-----------------|
| `rm -rf` | Irreversible recursive deletion |
| `DROP TABLE` | Permanent database table removal |
| `git push --force` | Can overwrite remote history |
| `TRUNCATE` | Removes all data from a table |
| `DELETE FROM` without `WHERE` | Deletes all rows accidentally |

