#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: blocks destructive bash commands.

Place at: ~/.claude/hooks/pre-tool-use
Make executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Patterns that are always blocked
ALWAYS_BLOCKED = [
    r"rm\s *-rf",
    r"rm +-rf",
    r"DROP\s+TABLE",
    r"git\s+push\s+.*--force",
    r"git\s+push\s+.*-f",
    r"TRUNCATE\s+",
]

# Patterns that require a WHERE clause
REQUIRES_WHERE = [
    r"DELETE\s+FROM",
]


def log_blocked(command: str, project_path: str):
    """Log a blocked command attempt to the blocked log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    with open(BLOCKED_LOG, "a") as f:
        f.write(f"{timestamp} | {project_path} | {command}\n")


def is_blocked(command: str) -> tuple[bool, str]:
    """Check if a command is blocked. Returns (blocked, reason)."""
    upper = command.upper()

    for pattern in ALWAYS_BLOCKED:
        if re.search(pattern, command, re.IGNORECASE):
            return True, f"Destructive pattern detected: '{pattern.strip()}'"

    for pattern in REQUIRES_WHERE:
        if re.search(pattern, command, re.IGNORECASE):
            # Check if WHERE clause is present
            if not re.search(r"\bWHERE\b", upper):
                return True, f"DELETE FROM without WHERE clause is not allowed"

    return False, ""


def main():
    # Read the hook payload from stdin
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON payload, pass through
        sys.exit(0)

    tool_name = payload.get("tool_name", "")
    tool_input = payload.get("tool_input", {})

    # Only intercept bash tool
    if tool_name != "bash":
        sys.exit(0)

    command = tool_input.get("command", "")
    project_path = payload.get("project_path", "unknown")

    blocked, reason = is_blocked(command)
    if blocked:
        log_blocked(command, project_path)
        print(f"🚫 BLOCKED: {reason}", file=sys.stderr)
        print(f"Command: {command}", file=sys.stderr)
        print("This command has been blocked for safety. Please use a safer alternative or review the command.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A `pre-tool-use` hook for [Claude Code](https://docs.anthropic.com/claude-code/hooks) that intercepts and blocks dangerous bash commands before they execute.

## What it blocks

- `rm -rf` / `rm -rf *`
- `DROP TABLE`
- `git push --force` / `git push -f`
- `TRUNCATE`
- `DELETE FROM` without a `WHERE` clause

