#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook that blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone

BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Patterns that are always blocked (case-insensitive)
ALWAYS_BLOCKED = [
    r"rm\s+(-[a-zA-Z]*\s+)*-[-a-zA-Z]*f",  # rm -rf or variants
    r"git\s+push\s+.*--force",  # git push --force
    r"git\s+push\s+.*-f\b",  # git push -f
    r"\bDROP\s+TABLE\b",  # DROP TABLE
    r"\bTRUNCATE\b",  # TRUNCATE
]

# Patterns that require a WHERE clause (case-insensitive)
DELETE_PATTERN = r"\bDELETE\s+FROM\b"


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt to the log file."""
    timestamp = datetime.now(timezone.utc).isoformat()
    project_path = os.getcwd()

    log_entry = (
        f"[{timestamp}] BLOCKED: {reason}\n"
        f"  Command: {command}\n"
        f"  Project: {project_path}\n"
        f"  {'=' * 60}\n"
    )

    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_blocked(command: str) -> tuple[bool, str]:
    """
    Check if a command should be blocked.

    Returns:
        Tuple of (is_blocked, reason)
    """
    upper_command = command.upper()

    # Check always-blocked patterns
    for pattern in ALWAYS_BLOCKED:
        if re.search(pattern, command, re.IGNORECASE):
            return True, f"Destructive command pattern detected: matches '{pattern}'"

    # Check DELETE FROM without WHERE
    if re.search(DELETE_PATTERN, upper_command):
        if "WHERE" not in upper_command:
            return True, "DELETE FROM without a WHERE clause is not allowed"

    return False, ""


def main():
    # Read the tool use request from stdin (JSON)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If not valid JSON, allow the command
        sys.exit(0)

    # Only intercept bash tool
    if data.get("tool_name") != "bash":
        sys.exit(0)

    command = data.get("tool_input", {}).get("command", "")
    if not command:
        sys.exit(0)

    blocked, reason = is_blocked(command)

    if blocked:
        log_blocked(command, reason)

        # Print clear message to Claude (stderr)
        print(
            f"\n🛡️  SECURITY HOOK BLOCKED: This command was prevented from running.\n"
            f"\n"
            f"Reason: {reason}\n"
            f"Command: {command}\n"
            f"\n"
            f"If you need to run this command, please review it carefully and "
            f"consider using a safer alternative or running it manually.",
            file=sys.stderr,
        )
        sys.exit(1)

    # Command is safe, allow it
    sys.exit(0)


if __name__ == "__main__":
    main()
# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code/) that intercepts and blocks dangerous bash commands before they execute.

## What It Blocks

| Pattern | Example |
|---------|---------|
| `rm -rf` | `rm -rf /important` |
| `git push --force` | `git push --force origin main` |
| `DROP TABLE` | `DROP TABLE users;` |
| `TRUNCATE` | `TRUNCATE TABLE orders;` |
| `DELETE FROM` (no WHERE) | `DELETE FROM users;` |

