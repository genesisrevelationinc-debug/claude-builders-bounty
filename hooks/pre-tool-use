#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the blocked attempts log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
# Each pattern is a tuple of (regex, description)
DANGEROUS_PATTERNS = [
    # rm -rf / rm -rf *
    (r'\brm\s+(-[a-zA-Z]*f|f[a-zA-Z]*)\s+(-[a-zA-Z]*r|r[a-zA-Z]*)', 'rm -rf: Recursive force delete'),
    (r'\brm\s+(-[a-zA-Z]*r|r[a-zA-Z]*)\s+(-[a-zA-Z]*f|f[a-zA-Z]*)', 'rm -rf: Recursive force delete'),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', 'DROP TABLE: Deletes entire database table'),
    # git push --force
    (r'\bgit\s+push\s+.*--force\b', 'git push --force: Overwrites remote history'),
    (r'\bgit\s+push\s+-f\b', 'git push --force: Overwrites remote history'),
    # TRUNCATE
    (r'\bTRUNCATE\s+TABLE\b', 'TRUNCATE TABLE: Removes all table data'),
    (r'\bTRUNCATE\b', 'TRUNCATE: Removes all data from table'),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\w+\s*(?!.*\bWHERE\b)', 'DELETE FROM without WHERE: Deletes all rows'),
]


def log_blocked_attempt(command, tool_name):
    """Log a blocked attempt to the log file."""
    timestamp = datetime.utcnow().isoformat() + "Z"
    project_path = os.getcwd()
    
    log_entry = {
        "timestamp": timestamp,
        "attempted_command": command,
        "project_path": project_path,
        "tool": tool_name,
    }
    
    # Ensure the directory exists
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(json.dumps(log_entry) + "\n")


def check_command(command):
    """Check if a command matches any dangerous pattern."""
    command_upper = command.upper()
    
    for pattern, description in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return description
    
    return None


def main():
    # Read the hook input from stdin (Claude Code passes JSON)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If not valid JSON, allow the tool use
        sys.exit(0)
    
    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})
    
    # Only check bash commands
    if tool_name == "bash" and "command" in tool_input:
        command = tool_input["command"]
        block_reason = check_command(command)
        
        if block_reason:
            log_blocked_attempt(command, tool_name)
            print(f"🚫 BLOCKED: {block_reason}", file=sys.stderr)
            print(f"   Command: {command}", file=sys.stderr)
            print(f"   This destructive command has been blocked for safety. Please use a safer alternative or confirm the operation is intentional.", file=sys.stderr)
            sys.exit(1)
    
    # Allow the tool use
    sys.exit(0)


if __name__ == "__main__":
    main()