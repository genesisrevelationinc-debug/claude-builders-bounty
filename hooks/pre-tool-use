#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


BLOCKED_LOG = Path.home() / ".claude" / "hooks" / "blocked.log"


def get_project_path() -> str:
    """Get the current project path from environment or current directory."""
    return os.environ.get("PWD", os.getcwd())


def log_blocked_attempt(command: str, reason: str) -> None:
    """Log a blocked command attempt to the log file."""
    BLOCKED_LOG.parent.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now().isoformat()
    project = get_project_path()
    with open(BLOCKED_LOG, "a") as f:
        f.write(f"{timestamp} | {project} | {reason} | {command}\n")


def is_destructive_bash(command: str) -> tuple[bool, str]:
    """
    Check if a bash command contains destructive patterns.
    Returns (is_blocked, reason).
    """
    upper = command.upper()

    # Pattern: rm -rf (and variants like rm -rf /, rm -rf *)
    if re.search(r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-?[a-zA-Z]*r[a-zA-Z]*\s+\S', command):
        return True, "Blocked: 'rm -rf' and recursive force removal patterns are not allowed"

    # Pattern: DROP TABLE
    if re.search(r'\bDROP\s+TABLE\b', upper):
        return True, "Blocked: DROP TABLE is a destructive SQL operation"

    # Pattern: git push --force (and variants like -f)
    if re.search(r'\bgit\s+push\s+.*(--force\b|-f\b)', command):
        return True, "Blocked: 'git push --force' can overwrite remote history and is not allowed"

    # Pattern: TRUNCATE
    if re.search(r'\bTRUNCATE\b', upper):
        return True, "Blocked: TRUNCATE is a destructive SQL operation"

    # Pattern: DELETE FROM without WHERE
    if re.search(r'\bDELETE\s+FROM\b', upper) and not re.search(r'\bWHERE\b', upper):
        return True, "Blocked: DELETE FROM without a WHERE clause is not allowed"

    return False, ""


def main() -> None:
    """Main entry point for the pre-tool-use hook."""
    # Read the tool use request from stdin
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If we can't parse the input, let it through
        sys.exit(0)

    # Only intercept bash tool
    if data.get("tool_name") != "bash":
        sys.exit(0)

    command = data.get("tool_input", {}).get("command", "")
    if not command:
        sys.exit(0)

    is_blocked, reason = is_destructive_bash(command)
    if is_blocked:
        log_blocked_attempt(command, reason)
        print(f"\n🛡️  SECURITY BLOCKED: {reason}", file=sys.stderr)
        print(f"   Attempted command: {command}\n", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()