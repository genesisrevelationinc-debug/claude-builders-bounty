#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


HOOKS_DIR = Path.home() / ".claude" / "hooks"
BLOCKED_LOG = HOOKS_DIR / "blocked.log"

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf / rm -r / rm -rfv etc.
    {
        "pattern": r"rm\s+(?:-[a-zA-Z]*[rf]|[rf])\s+",
        "name": "recursive force delete (rm -rf)",
    },
    # DROP TABLE
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "name": "DROP TABLE",
    },
    # git push --force
    {
        "pattern": r"(?i)git\s+push\s+.*--force",
        "name": "git push --force",
    },
    # TRUNCATE
    {
        "pattern": r"(?i)\bTRUNCATE\b",
        "name": "TRUNCATE",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b)",
        "name": "DELETE FROM without WHERE",
    },
]


def log_blocked_attempt(command: str, project_path: str):
    """Log a blocked command attempt to the log file."""
    HOOKS_DIR.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now().isoformat()
    log_entry = f"{timestamp} | {project_path} | {command}\n"
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_dangerous(command: str) -> tuple[bool, str]:
    """Check if a command matches any dangerous pattern. Returns (is_dangerous, reason)."""
    for rule in DANGEROUS_PATTERNS:
        if re.search(rule["pattern"], command):
            return True, rule["name"]
    return False, ""


def main():
    # Read the tool use request from stdin (Claude Code hook protocol)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)

    # Only intercept bash tool
    if data.get("tool_name") != "bash":
        sys.exit(0)

    command = data.get("tool_input", {}).get("command", "")
    if not command:
        sys.exit(0)

    dangerous, reason = is_dangerous(command)
    if dangerous:
        project_path = data.get("project_path", os.getcwd())
        log_blocked_attempt(command, project_path)

        # Output the error message for Claude
        error_message = (
            f"\n🛡️  SECURITY HOOK BLOCKED: This command was prevented from executing.\n"
            f"\n"
            f"   Reason: Destructive pattern detected — {reason}\n"
            f"   Command: {command}\n"
            f"\n"
            f"   This hook protects against accidental data loss. If you need to run\n"
            f"   this command, you can disable the hook temporarily or run it manually.\n"
            f"\n"
            f"   Blocked attempts are logged to: {BLOCKED_LOG}\n"
        )
        print(error_message, file=sys.stderr)
        sys.exit(1)

    # Safe command, allow it
    sys.exit(0)


if __name__ == "__main__":
    main()