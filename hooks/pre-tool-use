#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
and blocks them with a clear explanation.
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the blocked log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    {
        "pattern": r"rm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-?[a-zA-Z]*\s+-?r\s*\S+|rm\s+-[a-zA-Z]*r[a-zA-Z]*\s*\S+",
        "name": "rm -rf (recursive force delete)",
    },
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "name": "DROP TABLE (deletes entire table)",
    },
    {
        "pattern": r"(?i)\bTRUNCATE\b",
        "name": "TRUNCATE (removes all table data)",
    },
    {
        "pattern": r"(?i)\bDELETE\s+FROM\b(?!.*\bWHERE\b)",
        "name": "DELETE FROM without WHERE (deletes all rows)",
    },
    {
        "pattern": r"(?i)git\s+push\s+.*--force",
        "name": "git push --force (overwrites remote history)",
    },
]


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason}\n  Command: {command}\n  Project: {project_path}\n\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def main():
    # Read the hook input from stdin (Claude Code passes tool info as JSON)
    try:
        hook_input = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # If not valid JSON, allow the command to proceed
        sys.exit(0)
    
    # Only check bash tool calls
    if hook_input.get("tool_name") != "bash":
        sys.exit(0)
    
    command = hook_input.get("tool_input", {}).get("command", "")
    
    if not command:
        sys.exit(0)
    
    # Check against dangerous patterns
    for pattern_info in DANGEROUS_PATTERNS:
        if re.search(pattern_info["pattern"], command):
            log_blocked_attempt(command, pattern_info["name"])
            
            # Print clear message to Claude
            print(f"\n🚫 BLOCKED: Destructive command detected", file=sys.stderr)
            print(f"   Reason: {pattern_info['name']}", file=sys.stderr)
            print(f"   Command: {command}", file=sys.stderr)
            print(f"\n   This command has been blocked to prevent accidental data loss.", file=sys.stderr)
            print(f"   If you need to run this command, please do so manually outside of Claude Code.", file=sys.stderr)
            print(f"   Blocked attempt logged to: {BLOCKED_LOG}\n", file=sys.stderr)
            
            # Exit with non-zero to block the command
            sys.exit(1)
    
    # Command is safe, allow it
    sys.exit(0)


if __name__ == "__main__":
    main()