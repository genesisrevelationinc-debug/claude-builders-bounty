#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


# Patterns that indicate destructive commands
DANGEROUS_PATTERNS = [
    # rm -rf (recursive force delete)
    (r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', "rm -rf (recursive force deletion)"),
    
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', "DROP TABLE (deletes entire table)"),
    
    # git push --force
    (r'\bgit\s+push\s+.*--force\b', "git push --force (overwrites remote history)"),
    (r'\bgit\s+push\s+.*-f\b', "git push --force (overwrites remote history)"),
    
    # TRUNCATE
    (r'\bTRUNCATE\s+', "TRUNCATE (removes all table data)"),
    
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b)', "DELETE FROM without WHERE (deletes all rows)"),
]


def get_log_path():
    """Get the path to the blocked log file."""
    hooks_dir = Path.home() / ".claude" / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    return hooks_dir / "blocked.log"


def log_blocked_attempt(command, reason):
    """Log a blocked attempt to the log file."""
    log_path = get_log_path()
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason} | Command: {command} | Project: {project_path}\n"
    
    with open(log_path, "a") as f:
        f.write(log_entry)


def check_command(command):
    """Check if a command matches any dangerous pattern."""
    command_upper = command.upper()
    
    for pattern, description in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return description
    
    return None


def main():
    # Read the tool use data from stdin (Claude Code passes JSON)
    try:
        data = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # Not a JSON input, allow to proceed
        sys.exit(0)
    
    # Only check bash tool
    if data.get("tool_name") != "bash":
        sys.exit(0)
    
    command = data.get("tool_input", {}).get("command", "")
    
    reason = check_command(command)
    if reason:
        log_blocked_attempt(command, reason)
        print(f"🚫 BLOCKED: This command was prevented from running.\n\nReason: {reason}\nCommand: {command}\n\nThis destructive operation has been logged. If you believe this is a mistake, please review the command and try a safer alternative.", file=sys.stderr)
        sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()