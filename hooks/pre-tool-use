#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or destructive operations.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


# Patterns that are considered destructive
DESTRUCTIVE_PATTERNS = [
    # rm -rf (recursive force delete)
    (r'\brm\s+(?:-[a-zA-Z]*[rf]\S*\s+|\s+)*', "rm -rf: Recursive force deletion is blocked"),
    
    # DROP TABLE (SQL)
    (r'\bDROP\s+TABLE\b', "DROP TABLE: Dropping database tables is blocked"),
    
    # git push --force
    (r'\bgit\s+push\s+.*--force\b', "git push --force: Force pushing is blocked"),
    (r'\bgit\s+push\s+.*-f\b', "git push --force: Force pushing is blocked"),
    
    # TRUNCATE (SQL)
    (r'\bTRUNCATE\b', "TRUNCATE: Truncating tables is blocked"),
    
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b)', "DELETE FROM without WHERE: Unqualified deletes are blocked"),
]


def get_log_path() -> Path:
    """Get the path to the blocked log file."""
    hooks_dir = Path(__file__).parent
    return hooks_dir / "blocked.log"


def log_blocked_attempt(command: str, reason: str) -> None:
    """Log a blocked command attempt to the log file."""
    log_path = get_log_path()
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason} | Command: {command} | Project: {project_path}\n"
    
    try:
        with open(log_path, "a") as f:
            f.write(log_entry)
    except Exception:
        pass  # Best effort logging


def check_command(command: str) -> tuple[bool, str]:
    """Check if a command matches any destructive pattern."""
    command_upper = command.upper()
    
    for pattern, reason in DESTRUCTIVE_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, reason
    
    return False, ""


def main() -> None:
    """Main entry point for the hook."""
    # Read the tool use data from stdin (Claude Code hook protocol)
    try:
        data = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        sys.exit(0)  # Allow if we can't parse
    
    command = data.get("command", "") or data.get("input", "") or ""
    
    is_blocked, reason = check_command(command)
    if is_blocked:
        log_blocked_attempt(command, reason)
        print(f"🛡️  BLOCKED: {reason}", file=sys.stderr)
        print(f"   Attempted command: {command}", file=sys.stderr)
        print(f"   This command has been blocked to prevent destructive operations.", file=sys.stderr)
        sys.exit(1)  # Block the command
    
    sys.exit(0)  # Allow the command


if __name__ == "__main__":
    main()
# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code) that intercepts and blocks dangerous bash commands before they can execute.

## What It Blocks

| Pattern | Example | Why |
|---------|---------|-----|
| `rm -rf` | `rm -rf /important` | Irreversible recursive deletion |
| `DROP TABLE` | `DROP TABLE users;` | Destroys database tables |
| `git push --force` | `git push --force origin main` | Overwrites remote history |
| `TRUNCATE` | `TRUNCATE TABLE orders;` | Bulk deletes all table data |
| `DELETE FROM` (no WHERE) | `DELETE FROM users;` | Deletes all rows accidentally |

