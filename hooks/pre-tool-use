#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or destructive operations.
"""

import json
import os
import re
import sys
from datetime import datetime


BLOCKED_PATTERNS = [
    # rm -rf / rm -r / rm -f (destructive file removal)
    (r'\brm\s+-(r[fw]?|[fw]r?)\b', 'rm -rf: recursive/force file removal'),
    # DROP TABLE (SQL destructive)
    (r'\bDROP\s+TABLE\b', 'DROP TABLE: destructive SQL operation'),
    # git push --force
    (r'\bgit\s+push\s+.*--force\b', 'git push --force: force push to remote'),
    (r'\bgit\s+push\s+-f\b', 'git push -f: force push to remote'),
    # TRUNCATE (SQL destructive)
    (r'\bTRUNCATE\s+TABLE?\b', 'TRUNCATE: destructive SQL operation'),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b)', 'DELETE FROM without WHERE: unconditional SQL deletion'),
]


def get_log_path():
    """Get the path to the blocked log file."""
    hooks_dir = os.path.expanduser('~/.claude/hooks')
    os.makedirs(hooks_dir, exist_ok=True)
    return os.path.join(hooks_dir, 'blocked.log', 'blocked.log')


def log_blocked_attempt(command, reason, project_path):
    """Log a blocked command attempt to the log file."""
    log_path = get_log_path()
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    log_entry = f"[{timestamp}] BLOCKED: {reason}\n  Command: {command}\n  Project: {project_path}\n\n"
    
    with open(log_path, 'a') as f:
        f.write(log_entry)


def check_command(command):
    """Check if a command matches any blocked pattern. Returns (is_blocked, reason)."""
    command_upper = command.upper()
    
    for pattern, reason in BLOCKED_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, reason
    
    return False, None


def main():
   ucha    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        input_data = sys.stdin.read()
        if not input_data:
            sys.exit(0)
        
        data = json.loads(input_data)
        
        # Extract command from the tool use data
        command = data.get('command', '') or data.get('input', {}).get('command', '')
        project_path = data.get('project_path', os.getcwd())
        
        if not command:
            sys.exit(0)
        
        is_blocked, reason = check_command(command)
        
        if is_blocked:
            log_blocked_attempt(command, reason, project_path)
            print(f"🚫 BLOCKED: This command has been prevented from running.\nReason: {reason}\n\nThe command '{command}' matches a known destructive pattern. If you need to run this command, please do so manually outside of Claude Code.", file=sys.stderr)
            sys.exit(1)
        
    except (json.JSONDecodeError, KeyError):
        sys.exit(0)


if __name__ == '__main__':
    main()