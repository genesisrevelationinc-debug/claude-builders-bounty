#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Block destructive bash commands.

Place at: ~/.claude/hooks/pre-tool-use
Make executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path


BLOCKED_PATTERNS = [
    # rm -rf (any variant with -rf or -fr flags)
    {
        "pattern": r"rm\s+(?:-\w*[rf]\w*\s+|\s+-\w*[rf]\w*)",
        "name": "rm -rf",
        "description": "Recursive force delete - can destroy directories irreversibly",
    },
    # DROP TABLE
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "name": "DROP TABLE",
        "description": "Deletes an entire database table and all its data",
    },
    # git push --force or git push -f
    {
        "pattern": r"git\s+push\s+(?:--force\b|-f\b)",
        "name": "git push --force",
        "description": "Force push can overwrite remote history and cause data loss",
    },
    # TRUNCATE
    {
        "pattern": r"(?i)\bTRUNCATE\b",
        "name": "TRUNCATE",
        "description": "Removes all rows from a table without logging individual row deletions",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b)",
        "name": "DELETE FROM without WHERE",
        "description": "Deletes all rows from a table without a WHERE clause",
    },
]


def get_log_path() -> Path:
    hooks_dir = Path(__file__).parent
    return hooks_dir / "blocked.log"


def log_blocked_attempt(command: str, pattern_name: str) -> None:
    log_path = get_log_path()
    project_path = os.getcwd()
    timestamp = datetime.now(timezone.utc).isoformat()

    log_entry = f"{timestamp} | {pattern_name} | {project_path} | {command}\n"

    # Ensure log file exists
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with open(log_path, "a") as f:
        f.write(log_entry)


def main() -> None:
    # Read the hook payload from stdin
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        sys.exit(0)

    tool_name = payload.get("tool_name", "")
    tool_input = payload.get("tool_input", {})

    if tool_name != "bash":
        sys.exit(0)

    command = tool_input.get("command", "")

    for blocked in BLOCKED_PATTERNS:
        if re.search(blocked["pattern"], command):
            log_blocked_attempt(command, blocked["name"])
            print(f"🛡️  BLOCKED: {blocked['name']}", file=sys.stderr)
            print(f"   Reason: {blocked['description']}", file=sys.stderr)
            print(f"   Command: {command}", file=sys.stderr)
            print(f"\nThis destructive command was intercepted by the pre-tool-use hook.", file=sys.stderr)
            print("If you need to run this command, disable the hook or modify the pattern list.", file=sys.stderr)
            sys.exit(1)


if __name__ == "__main__":
    main()