#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the blocked log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf (recursive force delete)
    (r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', "rm -rf: Recursive force delete"),
    (r'\brm\s+.*\s+-[a-zA-Z]*rf', "rm -rf: Recursive force delete"),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', "DROP TABLE: Database table deletion"),
    # git push --force
    (r'\bgit\s+push\s+.*--force\b', "git push --force: Force push to remote"),
    (r'\bgit\s+push\s+-f\b', "git push --force: Force push to remote"),
    # TRUNCATE
    (r'\bTRUNCATE\s+TABLE\b', "TRUNCATE TABLE: Table data deletion"),
    (r'\bTRUNCATE\s+\w+', "TRUNCATE: Table data deletion"),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\w+\s*$', "DELETE FROM without WHERE: Unconditional row deletion"),
    (r'\bDELETE\s+FROM\s+\w+\s+(?!WHERE\b)', "DELETE FROM without WHERE: Unconditional row deletion"),
]


def log_blocked_attempt(command, reason, project_path):
    """Log a blocked command attempt to the log file."""
    timestamp = datetime.now().isoformat()
    log_entry = f"[{timestamp}] BLOCKED: {reason}\n  Command: {command}\n  Project: {project_path}\n\n"
    
    # Ensure the hooks directory exists
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command, project_path):
    """Check if a command matches any dangerous pattern."""
    for pattern, description in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return description
    return None


def main():
    # Read the hook input from stdin (Claude Code passes tool info as JSON)
    try:
        hook_input = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # If not valid JSON, allow the tool use to proceed
        sys.exit(0)
    
    # Extract tool information
    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})
    
    # Only intercept bash tool
    if tool_name != "bash":
        sys.exit(0)
    
    command = tool_input.get("command", "")
    project_path = hook_input.get("project_path", os.getcwd())
    
    # Check for dangerous patterns
    block_reason = check_command(command, project_path)
    
    if block_reason:
        log_blocked_attempt(command, block_reason, project_path)
        
        # Output the block message to stderr for Claude to see
        print(f"\n🚫 BLOCKED: {block_reason}\n", file=sys.stderr)
        print(f"The command was blocked for safety: {command}\n", file=sys.stderr)
        sys.exit(1)  # Non-zero exit code blocks the tool use
    
    # Allow the command to proceed
    sys.exit(0)


if __name__ == "__main__":
    main()