#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or damage.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


# Patterns that are always blocked (unconditional destructive commands)
ALWAYS_BLOCKED = [
    # rm -rf (recursive force delete)
    r'\brm\s+(?:-[a-zA-Z]*[rf]|[a-zA-Z]*\s+)*\s*-?[a-zA-Z]*[rf]\b',
    r'\brm\s+-[a-zA-Z]*r[a-zA-Z]*f[a-zA-Z]*\b',
    r'\brm\s+(?:-[a-zA-Z]*\s+)*-rf\b',
    r'\brm\s+-rf\b',
    # git push --force
    r'\bgit\s+push\s+(?:-[a-zA-Z]*\s+)*--force\b',
    r'\bgit\s+push\s+(?:-[a-zA-Z]*\s+)*-[a-zA-Z]*f\b',
    # DROP TABLE
    r'\bDROP\s+TABLE\b',
    # TRUNCATE
    r'\bTRUNCATE\s+TABLE\b',
    r'\bTRUNCATE\b',
]

# Patterns for DELETE FROM that require WHERE clause check
DELETE_PATTERN = r'\bDELETE\s+FROM\b'


def get_log_path() -> Path:
    """Get the path to the blocked log file."""
    hooks_dir = Path(__file__).parent
    return hooks_dir / "blocked.log"


def log_blocked_attempt(command: str, reason: str) -> None:
    """Log a blocked command attempt with timestamp and project path."""
    log_path = get_log_path()
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] REASON: {reason} | COMMAND: {command} | PROJECT: {project_path}\n"
    
    # Ensure the log file exists
    log_path.parent.mkdir(parents=True, exist_ok=True)
    
    with open(log_path, "a") as f:
        f.write(log_entry)


def is_blocked(command: str) -> tuple[bool, str]:
    """
    Check if a command should be blocked.
    
    Returns:
        Tuple of (is_blocked, reason)
    """
    # Check always-blocked patterns
    for pattern in ALWAYS_BLOCKED:
        if re.search(pattern, command, re.IGNORECASE):
            return True, f"Matches blocked pattern: {pattern}"
    
    # Check DELETE FROM without WHERE
    if re.search(DELETE_PATTERN, command, re.IGNORECASE):
        if not re.search(r'\bWHERE\b', command, re.IGNORECASE):
            return True, "DELETE FROM without WHERE clause"
    
    return False, ""


def main() -> None:
    """Main entry point for the hook."""
    # Read the tool use data from stdin (Claude Code hook format)
    try:
        tool_data = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # Not JSON, pass through
        sys.exit(0)
    
    # Extract the command from the tool data
    command = tool_data.get("command", "")
    if not command:
        command = tool_data.get("input", "")
    
    if not command:
        sys.exit(0)
    
    # Check if the command should be blocked
    blocked, reason = is_blocked(command)
    
    if blocked:
        log_blocked_attempt(command, reason)
        print(f"🚫 BLOCKED: This command was prevented from executing.\nReason: {reason}\nCommand: {command}", file=sys.stderr)
        sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()