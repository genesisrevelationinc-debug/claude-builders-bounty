#!/bin/bash

# Pre-tool-use hook to block destructive bash commands
# Installation: Save as ~/.claude/hooks/pre-tool-use and make executable

set -euo pipefail

# Configuration
HOOKS_DIR="$HOME/.claude/hooks"
BLOCKED_LOG="$HOOKS_DIR/blocked.log"

# Ensure log directory exists
mkdir -p "$HOOKS_DIR"

# Function to log blocked commands
log_blocked() {
    local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    local command="$1"
    local project_path="${2:-$(pwd)}"
    echo "[$timestamp] Blocked command: $command (Project: $project_path)" >> "$BLOCKED_LOG"
}

# Only process bash commands
if [ "${TOOL_NAME:-}" != "bash" ]; then
    exit 0
fi

# Get the command from Claude's input
input_command="${TOOL_INPUT:-}"

# Skip if no input
if [ -z "$input_command" ]; then
    exit 0
fi

# Normalize command (remove extra spaces, handle newlines)
normalized_command=$(echo "$input_command" | tr '\n' ' ' | tr -s ' ' | xargs)

# Define dangerous patterns (case insensitive)
dangerous_patterns=(
    "rm -rf"
    "rm -fr"
    "DROP TABLE"
    "git push --force"
    "TRUNCATE"
    "DELETE FROM"
)

# Check for DELETE without WHERE clause (special handling)
if [[ "$normalized_command" =~ DELETE[[:space:]]+FROM ]] && ! [[ "$normalized_command" =~ WHERE ]]; then
    echo "❌ BLOCKED: Dangerous command detected"
    echo "Command: $normalized_command"
    echo "Reason: DELETE statements must include a WHERE clause for safety"
    log_blocked "$normalized_command" "$(pwd)"
    exit 1
fi

# Check for other dangerous patterns
for pattern in "${dangerous_patterns[@]}"; do
    if [[ "${normalized_command,,}" == *"${pattern,,}"* ]]; then
        case "${pattern,,}" in
            "rm -rf"|"rm -fr")
                reason="Recursive deletion commands are blocked for safety"
                ;;
            "drop table")
                reason="DROP TABLE statements are blocked for safety"
                ;;
            "git push --force")
                reason="Force pushes are blocked to prevent history rewriting"
                ;;
            "truncate")
                reason="TRUNCATE statements are blocked for safety"
                ;;
        esac
        
        echo "❌ BLOCKED: Dangerous command detected"
        echo "Command: $normalized_command"
        echo "Reason: $reason"
        log_blocked "$normalized_command" "$(pwd)"
        exit 1
    fi
done

# If we get here, the command is safe
exit 0