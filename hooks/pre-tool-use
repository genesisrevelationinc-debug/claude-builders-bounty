#!/bin/bash

# Pre-tool-use hook to block destructive bash commands
# This script should be placed in ~/.claude/hooks/pre-tool-use

set -e

# Function to log blocked commands
log_blocked() {
    local timestamp=$(date -Iseconds)
    local log_file="$HOME/.claude/hooks/blocked.log"
    local project_path=$(pwd)
    echo "[$timestamp] BLOCKED: $*" >> "$log_file"
    echo "[$timestamp] PROJECT: $project_path" >> "$log_file"
}

# Check if we're running in Claude Code environment
if [ -z "$CLAUDE_HOOK" ]; then
    # Not in Claude Code, skip hook
    exit 0
fi

# Only check bash commands
if [ "$1" != "bash" ]; then
    exit 0
fi

# Check for destructive patterns
command_to_check="$2"

case "$command_to_check" in
    *'rm -rf'*)
        echo "BLOCKED: 'rm -rf' commands are not allowed"
        echo "Reason: This command could cause irreversible data loss"
        log_blocked "$command_to_check"
        exit 1
        ;;
    *'DROP TABLE'*)
        echo "BLOCKED: 'DROP TABLE' commands are not allowed"
        echo "Reason: This command could cause irreversible database loss"
        log_blocked "$command_to_check"
        exit 1
        ;;
    *'git push --force'*)
        echo "BLOCKED: 'git push --force' commands are not allowed"
        echo "Reason: This command could overwrite remote history"
        log_blocked "$command_to_check"
        exit 1
        ;;
    *'TRUNCATE'*)
        echo "BLOCKED: 'TRUNCATE' commands are not allowed"
        echo "Reason: This command could cause irreversible data loss"
        log_blocked "$command_to_check"
        exit 1
        ;;
    *'DELETE FROM'*'WHERE'*)
        # This is a valid DELETE with WHERE clause, allow it
        exit 0
        ;;
    *'DELETE FROM'*)
        echo "BLOCKED: 'DELETE FROM' without WHERE clause is not allowed"
        echo "Reason: This command could cause irreversible data loss"
        log_blocked "$command_to_check"
        exit 1
        ;;
    *)
        # No destructive patterns found, allow command
        exit 0
        ;;
esac