#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


HOOKS_DIR = Path.home() / ".claude" / "hooks"
BLOCKED_LOG = HOOKS_DIR / "blocked.log"

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf / rm -r -f / rm -rfv etc.
    {
        "pattern": r"rm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+|\s+-\w*|\s+)+\s*-?r\s+.*|rm\s+.*-rf",
        "name": "rm -rf (recursive force delete)",
    },
    # DROP TABLE
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "name": "DROP TABLE (delete database table)",
    },
    # git push --force / git push -f
    {
        "pattern": r"git\s+push\s+.*(--force|-f)(\s|$)",
        "name": "git push --force (force push)",
    },
    # TRUNCATE
    {
        "pattern": r"(?i)\bTRUNCATE\s+TABLE?\b",
        "name": "TRUNCATE (delete all table data)",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)^\s*DELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b).*$",
        "name": "DELETE FROM without WHERE (delete all rows)",
    },
]


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt to the log file."""
    HOOKS_DIR.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason}\n  Command: {command}\n  Project: {project_path}\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """Check if a command is dangerous. Returns (is_blocked, reason)."""
    for rule in DANGEROUS_PATTERNS:
        if re.search(rule["pattern"], command):
            return True, rule["name"]
    return False, ""


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, let it pass
        sys.exit(0)
    
    # Only check bash tool
    if hook_input.get("tool_name") != "bash":
        sys.exit(0)
    
    command = hook_input.get("tool_input", {}).get("command", "")
    
    if not command:
        sys.exit(0)
    
    is_blocked, reason = check_command(command)
    
    if is_blocked:
        log_blocked_attempt(command, reason)
        
        # Print error message for Claude
        print(f"\n🛡️  SECURITY HOOK BLOCKED: {reason}\n", file=sys.stderr)
        print(f"   Command: {command}\n", file=sys.stderr)
        print("   This destructive command has been blocked to prevent accidental data loss.\n", file=sys.stderr)
        print("   If you intended to run this, please review the command and consider a safer alternative.\n", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()