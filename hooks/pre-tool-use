#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or destructive operations.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


HOOKS_DIR = Path.home() / ".claude" / "hooks"
LOG_FILE = HOOKS_DIR / "blocked.log"


# Patterns that are always blocked (no exceptions)
ALWAYS_BLOCKED = [
    r"rm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+.*",  # rm -rf ...
    r"git\s+push\s+.*--force",  # git push --force
    r"git\s+push\s+.*-f\b",  # git push -f
    r"\bDROP\s+TABLE\b",  # DROP TABLE
    r"\bTRUNCATE\b",  # TRUNCATE
]

# Patterns that require a WHERE clause
REQUIRES_WHERE = [
    r"\bDELETE\s+FROM\b",
]


def get_project_path() -> str:
    """Get the current project path from environment or working directory."""
    return os.getcwd()


def log_blocked_attempt(command: str, reason: str) -> None:
    """Log a blocked command attempt to the log file."""
    HOOKS_DIR.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    project_path = get_project_path()
    
    log_entry = (
        f"[{timestamp}] "
        f"BLOCKED: {reason} | "
        f"Command: {command} | "
        f"Project: {project_path}\n"
    )
    
    with open(LOG_FILE, "a") as f:
        f.write(log_entry)


def is_destructive(command: str) -> tuple[bool, str]:
    """
    Check if a command is destructive.
    
    Returns:
        Tuple of (is_blocked, reason)
    """
    command_upper = command.upper()
    command_stripped = command.strip()
    
    # Check always-blocked patterns
    for pattern in ALWAYS_BLOCKED:
        if re.search(pattern, command_stripped, re.IGNORECASE):
            return True, f"Command matches blocked pattern: {pattern}"
    
    # Check DELETE FROM without WHERE
    for pattern in REQUIRES_WHERE:
        if re.search(pattern, command_stripped, re.IGNORECASE):
            # Check if there's a WHERE clause
            if not re.search(r"\bWHERE\b", command_upper):
                return True, "DELETE FROM without a WHERE clause is not allowed"
    
    return False, ""


def main():
    # Read the tool use data from stdin (Claude Code hook format)
    try:
        tool_data = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)
    
    # Only intercept bash tool
    if tool_data.get("tool_name") != "bash":
        sys.exit(0)
    
    command = tool_data.get("params", {}).get("command", "")
    
    is_blocked, reason = is_destructive(command)
    
    if is_blocked:
        log_blocked_attempt(command, reason)
        print(f"🚫 BLOCKED: This command has been prevented from running.\n", file=sys.stderr)
        print(f"Reason: {reason}\n", file=sys.stderr)
        print(f"Command: {command}\n", file=sys.stderr)
        print("If you need to run this command, please do so manually outside of Claude Code.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()