#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path


BLOCKED_LOG = Path.home() / ".claude" / "hooks" / "blocked.log"


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt with timestamp and project path."""
    BLOCKED_LOG.parent.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat()
    project_path = os.getcwd()
    with open(BLOCKED_LOG, "a") as f:
        f.write(f"{timestamp} | {project_path} | {reason} | {command}\n")


def is_destructive_bash(command: str) -> tuple[bool, str]:
    """
    Check if a bash command is destructive.
    Returns (is_blocked, reason).
    """
    upper = command.upper()
    lower = command.lower()

    # Pattern: rm -rf (and variants like rm -rf /, rm -rf *)
    if re.search(r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\b', lower):
        return True, "Destructive file deletion: `rm -rf` is blocked to prevent data loss"

    # Pattern: rm with recursive and force flags in any order
    if re.search(r'\brm\s+.*-[a-zA-Z]*r[a-zA-Z]*.*-[a-zA-Z]*f[a-zA-Z]*', lower):
        return True, "Destructive file deletion: `rm -rf` is blocked to prevent data loss"

    # Pattern: DROP TABLE
    if re.search(r'\bDROP\s+TABLE\b', upper):
        return True, "Destructive SQL: `DROP TABLE` is blocked to prevent data loss"

    # Pattern: git push --force (and -f)
    if re.search(r'\bgit\s+push\s+.*--force\b', lower) or re.search(r'\bgit\s+push\s+.*\s-f(?:\s|$)', lower):
        return True, "Destructive git operation: `git push --force` is blocked to prevent history loss"

    # Pattern: TRUNCATE
    if re.search(r'\bTRUNCATE\b', upper):
        return True, "Destructive SQL: `TRUNCATE` is blocked to prevent data loss"

    # Pattern: DELETE FROM without WHERE
    if re.search(r'\bDELETE\s+FROM\b', upper) and not re.search(r'\bWHERE\b', upper):
        return True, "Destructive SQL: `DELETE FROM` without `WHERE` clause is blocked to prevent data loss"

    return False, ""


def main():
    # Read the hook input from stdin (JSON)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)

    tool_name = data.get("tool_name", "")
    tool_input = data.get("tool_input", {})

    # Only intercept bash tool
    if tool_name != "bash":
        sys.exit(0)

    command = tool_input.get("command", "")

    blocked, reason = is_destructive_bash(command)
    if blocked:
        log_blocked(command, reason)
        print(f"🚫 BLOCKED: {reason}", file=sys.stderr)
        print(f"   Command: {command}", file=sys.stderr)
        print(f"   This command has been blocked for safety. If you need to run it, use a different terminal or disable the hook.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()

# Claude Code Pre-Tool-Use Hook: Block Destructive Bash Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code/) that intercepts and blocks dangerous bash commands before they execute.

## What it blocks

- `rm -rf` and variants
- `DROP TABLE`
- `git push --force` / `git push -f`
- `TRUNCATE`
- `DELETE FROM` without a `WHERE` clause

## Installation

