#!/usr/bin/env bash

set -e

# Default Claude Code configuration
CLAUDE_CONFIG_DIR="$HOME/.claude"
CLAUDE_HOOKS_DIR="$CLAUDE_CONFIG_DIR/hooks"

# Create hooks directory if it doesn't exist
mkdir -p "$CLAUDE_HOOKS_DIR"

# Create log file if it doesn't exist
touch "$CLAUDE_HOOKS_DIR/blocked.log"

BLOCKED_CMDS=(
    "rm -rf"
    "DROP TABLE"
    "TRUNCATE"
    "DELETE FROM"
    "git push --force"
)

for cmd in "${BLOCKED_CMDS[@]}"; do
    if [[ $cmd == "rm -rf" ]]; then
        if [[ $INPUT == *"rm -r"* ]] || [[ $INPUT == *"rm -rf"* ]] || [[ $INPUT == *"rm -d"* ]] || [[ $INPUT == *"rm -f"* ]]; then
            echo "Error: Destructive command blocked: $INPUT" >&2
            exit 1
        fi
    done
    if [[ $INPUT == *"rm -r"* ]] || [[ $INPUT == *"rm -rf"* ]] || [[ $INPUT == *"rm -d"* ]] || [[ $INPUT == *"rm -f"* ]]; then
        echo "Error: Destructive command blocked: $INPUT" >&2
        exit 1
    fi
done

for cmd in "${BLOCKED_CMDS[@]}"; do
    if [[ $INPUT == *"$cmd"* ]]; then
        echo "Error: Destructive command blocked: $INPUT" >&2
        exit 1
    fi
done
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: Destructive command blocked: $INPUT" >&2
exit 1
fi
echo "Error: D0.0