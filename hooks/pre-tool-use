#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Patterns that are always blocked
ALWAYS_BLOCKED = [
    r"rm\s+(-[a-zA-Z]*\s+)*-?[a-zA-Z]*f[a-zA-Z]*\s+.*",  # rm with -f or -rf
    r"git\s+push\s+.*--force",  # git push --force
    r"git\s+push\s+.*-f",  # git push -f
    r"DROP\s+TABLE",  # DROP TABLE (case insensitive)
    r"TRUNCATE\s+",  # TRUNCATE (case insensitive)
]

# Patterns that require a WHERE clause
REQUIRES_WHERE = [
    r"DELETE\s+FROM\s+\S+\s*$",  # DELETE FROM without WHERE
]


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt."""
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {command} | Reason: {reason} | Project: {project_path}\n"
    
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_blocked(command: str) -> tuple[bool, str]:
    """Check if a command should be blocked. Returns (is_blocked, reason)."""
    # Check always blocked patterns
    for pattern in ALWAYS_BLOCKED:
        if re.search(pattern, command, re.IGNORECASE):
            return True, f"Command matches blocked pattern: {pattern}"
    
    # Check patterns that require WHERE clause
    for pattern in REQUIRES_WHERE:
        if re.search(pattern, command, re.IGNORECASE):
            return True, "DELETE FROM without WHERE clause is not allowed"
    
    return False, ""


def main():
    # Read the tool use request from stdin
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, let it pass
        return
    
    # Only check bash tool
    if data.get("tool_name") == "bash":
        command = data.get("tool_input", {}).get("command", "")
        
        blocked, reason = is_blocked(command)
        if blocked:
            log_blocked(command, reason)
            print(f"🚫 BLOCKED: This command was prevented from running.\n   Reason: {reason}\n   Command: {command}", file=sys.stderr)
            sys.exit(1)


if __name__ == "__main__":
    main()