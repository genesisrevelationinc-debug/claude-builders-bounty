#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook that blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


BLOCKED_LOG_PATH = Path.home() / ".claude" / "hooks" / "blocked.log"


DESTRUCTIVE_PATTERNS = [
    # rm -rf / rm -rf /
    (r"rm\s+(?:-[a-zA-Z]*f[a-zA-Z]*\s+|\s+-\S*f\S*\s+).*", "rm -rf: recursively and forcefully removing files/directories"),
    # DROP TABLE
    (r"(?i)\bDROP\s+TABLE\b", "DROP TABLE: deleting an entire database table"),
    # git push --force or git push -f
    (r"(?i)git\s+push\s+.*(--force|-f)\b", "git push --force: forcefully overwriting remote history"),
    # TRUNCATE
    (r"(?i)\bTRUNCATE\b", "TRUNCATE: removing all data from a table"),
    # DELETE FROM without WHERE
    (r"(?i)^\s*DELETE\s+FROM\s+\S+\s*$", "DELETE FROM without WHERE: deleting all rows from a table"),
]


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt with timestamp and project path."""
    BLOCKED_LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason} | Command: {command!r} | Project: {project_path}\n"
    
    with open(BLOCKED_LOG_PATH, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """Check if a command matches any destructive pattern. Returns (is_blocked, reason)."""
    for pattern, reason in DESTRUCTIVE_PATTERNS:
        if re.search(pattern, command):
            return True, reason
    return False, ""


def main():
    # Read the hook input from stdin (JSON)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        return 0
    
    # Only intercept Bash tool
    if hook_input.get("tool_name") != "Bash":
        return 0
    
    command = hook_input.get("tool_input", {}).get("command", "")
    
    is_blocked, reason = check_command(command)
    
    if is_blocked:
        log_blocked_attempt(command, reason)
        
        # Print clear message to Claude
        print(f"\n🛡️  SECURITY HOOK BLOCKED: {reason}", file=sys.stderr)
        print(f"   Attempted command: {command}", file=sys.stderr)
        print(f"   This destructive command has been prevented from executing.", file=sys.stderr)
        print(f"   If you need to run this, please use a safer alternative or ask the user for confirmation.\n", file=sys.stderr)
        
        # Exit with non-zero to block the tool execution
        return 1
    
    return 0


if __name__ == "__main__":
    sys.exit(main())

# Pre-Tool-Use Hook: Block Destructiveputed Commands

A Claude Code `pre-tool-use` hook that intercepts and blocks dangerous bash commands before they execute.

## Installation

