#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Block destructive bash commands.

Place at: ~/.claude/hooks/pre-tool-use
Make executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path

# Path to the blocked log file
BLOCKED_LOG = Path.home() / ".claude" / "hooks" / "blocked.log"

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf (any variant with -rf flag)
    {
        "pattern": r"rm\s+(?:-[a-zA-Z]*r[a-zA-Z]*f|.*\s+-[a-zA-Z]*r[a-zA-Z]*f)",
        "name": "rm -rf (recursive force delete)",
    },
    # DROP TABLE
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "name": "DROP TABLE (deletes entire table)",
    },
    # git push --force
    {
        "pattern": r"(?i)git\s+push\s+.*--force\b",
        "name": "git push --force (overwrites remote history)",
    },
    # TRUNCATE
    {
        "pattern": r"(?i)\bTRUNCATE\b",
        "name": "TRUNCATE (removes all table data)",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b).*",
        "name": "DELETE FROM without WHERE (deletes all rows)",
    },
]


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt to the log file."""
    BLOCKED_LOG.parent.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason}\n  Command: {command}\n  Project: {project_path}\n\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def main():
    # Read the hook input from Claude Code
    try:
        hook_input = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)
    
    # Only intercept bash tool usage
    tool_name = hook_input.get("tool_name", "")
    if tool_name != "bash":
        sys.exit(0)
    
    command = hook_input.get("tool_input", {}).get("command", "")
    
    for rule in DANGEROUS_PATTERNS:
        if re.search(rule["pattern"], command):
            log_blocked_attempt(command, rule["name"])
            print(f"🚫 BLOCKED: This command was prevented from running.", file=sys.stderr)
            print(f"   Reason: {rule['name']}", file=sys.stderr)
            print(f"   Command: {command}", file=sys.stderr)
            print(f"   If you need to run this, use --no-hooks or modify the hook.", file=sys.stderr)
            sys.exit(1)
    
    # Command is safe, allow it
    sys.exit(0)


if __name__ == "__main__":
    main()

# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code) that intercepts and blocks dangerous bash commands before they can execute.

## What It Blocks

| Pattern | Why It's Blocked |
|---------|-----------------|
| `rm -rf` | Irreversible recursive deletion |
| `DROP TABLE` | Destroys database tables |
| `git push --force` | Overwrites remote git history |
| `TRUNCATE` | Removes all data from a table |
| `DELETE FROM` without `WHERE` | Deletes all rows in a table |

