#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or damage.
"""

import json
import os
import re
import sys
from datetime import datetime


BLOCKED_PATTERNS = [
    # rm -rf / rm -r / rm -f with any path
    (r'\brm\s+(?:-[a-zA-Z]*[rf]\S*\s+|\s+-\S*[rf]\S*\s+|\s+-\S+\s+)*\S+', 'rm -rf / recursive delete'),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', 'DROP TABLE'),
    # TRUNCATE
    (r'\bTRUNCATE\b', 'TRUNCATE'),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b).*', 'DELETE FROM without WHERE'),
    # git push --force
    (r'\bgit\s+push\s+.*--force\b', 'git push --force'),
    (r'\bgit\s+push\s+.*-f\b', 'git push --force'),
]

LOG_FILE = os.path.expanduser('~/.claude/hooks/blocked.log')


def log_blocked_attempt(command: str, reason: str, project_path: str):
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    timestamp = datetime.now().isoformat()
    log_entry = f"{timestamp} | BLOCKED: {reason} | Command: {command} | Project: {project_path}\n"
    with open(LOG_FILE, 'a') as f:
        f.write(log_entry)


def check_command(command: str, project_path: str) -> tuple[bool, str]:
    """
    Check if a command matches any blocked pattern.
    
    Returns:
        tuple of (is_blocked, reason)
    """
    for pattern, reason in BLOCKED_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, reason
    return False, ""


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        hook_input = sys.stdin.read()
        data = json.loads(hook_input) if hook_input.strip() else {}
    except json.JSONDecodeError:
        data = {}
    
    # Extract command and project path from the hook data
    command = data.get('command', '') or data.get('input', {}).get('command', '')
    project_path = data.get('project_path', os.getcwd())
    
    # Also check in case the command is passed differently
    if not command:
        command = data.get('tool_input', {}).get('command', '')
    
    if not command:
        # No command to check, allow to proceed
        sys.exit(0)
    
    is_blocked, reason = check_command(command, project_path)
    
    if is_blocked:
        log_blocked_attempt(command, reason, project_path)
        print(f"🚫 BLOCKED: This command was prevented from executing.", file=sys.stderr)
        print(f"   Reason: {reason}", file=sys.stderr)
        print(f"   Command: {command}", file=sys.stderr)
        print(f"   This destructive operation could cause irreversible data loss. If you need to proceed, please review the command carefully and consider using safer alternatives.", file=sys.stderr)
        sys.exit(1)
    
    # Command is safe, allow to proceed
    sys.exit(0)


if __name__ == '__main__':
    main()