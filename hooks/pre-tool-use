#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or destructive operations.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path

# Path to the log file for blocked commands
BLOCKED_LOG = Path.home() / ".claude" / "hooks" / "blocked.log"

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf pattern (removes directories recursively and forcefully)
    {
        "pattern": r"rm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?(-[a-zA-Z]*r[a-zA-Z]*\s+)?-?[a-zA-Z]*\s*-?[a-zA-Z]*\s*\S+",
        "simple_pattern": r"rm\s+.*-[a-zA-Z]*[rf][a-zA-Z]*",
        "name": "rm -rf",
        "description": "Forcefully and recursively removes files/directories"
    },
    # DROP TABLE pattern
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "name": "DROP TABLE",
        "description": "Deletes an entire database table and all its data"
    },
    # git push --force pattern
    {
        "pattern": r"(?i)git\s+push\s+.*--force",
        "name": "git push --force",
        "description": "Forcefully overwrites remote git history, potentially destroying others' work"
    },
    # TRUNCATE pattern
    {
        "pattern": r"(?i)\bTRUNCATE\b",
        "name": "TRUNCATE",
        "description": "Quickly removes all rows from a table (cannot be rolled back in some DBs)"
    },
    # DELETE FROM without WHERE clause
    {
        "pattern": r"(?i)\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b)",
        "name": "DELETE FROM without WHERE",
        "description": "Deletes all rows from a table without filtering (missing WHERE clause)"
    },
]


def log_blocked_command(command: str, reason: str):
    """Log a blocked command to the blocked.log file."""
    BLOCKED_LOG.parent.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason}\n  Command: {command}\n  Project: {project_path}\n\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """Check if a command matches any dangerous pattern. Returns (is_blocked, reason)."""
    for pattern_info in DANGEROUS_PATTERNS:
        pattern = pattern_info.get("simple_pattern", pattern_info["pattern"])
        if re.search(pattern_info["pattern"], command) or re.search(pattern, command):
            return True, f"{pattern_info['name']}: {pattern_info['description']}"
    return False, ""


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        hook_input = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # If not valid JSON, allow the command to proceed
        sys.exit(0)
    
    # Extract the command from the hook input
    command = hook_input.get("command", "") or hook_input.get("input", "")
    
    if not command:
        sys.exit(0)
    
    is_blocked, reason = check_command(command)
    
    if is_blocked:
        log_blocked_command(command, reason)
        print(f"\n🚫 BLOCKED: This command has been prevented from running.\n", file=sys.stderr)
        print(f"   Reason: {reason}\n", file=sys.stderr)
        print(f"   Command: {command}\n", file=sys.stderr)
        sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()