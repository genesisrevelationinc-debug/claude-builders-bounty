#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Installation:
    mkdir -p ~/.claude/hooks
    cp pre-tool-use ~/.claude/hooks/pre-tool-use
    chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

LOG_FILE = os.path.expanduser("~/.claude/hooks/blocked.log")

# Patterns that are always blocked
BLOCKED_PATTERNS = [
    # rm -rf (and variants like rm -rf /, rm -rf ., etc.)
    r"rm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+",
    r"rm\s+-[a-zA-Z]*\s+.*\s+-[a-zA-Z]*r[a-zA-Z]*\s+.*\s+-[a-zA-Z]*f",
    # git push --force
    r"git\s+push\s+.*--force",
    r"git\s+push\s+-f\b",
    # SQL destructive commands
    r"(?i)DROP\s+TABLE",
    r"(?i)TRUNCATE\s+",
    r"(?i)DELETE\s+FROM\s+[^W]*(?!.*WHERE)",
]

# Compiled patterns for efficiency
COMPILED_PATTERNS = [re.compile(p) for p in BLOCKED_PATTERNS]


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt."""
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"{timestamp} | BLOCKED: {reason} | Command: {command} | Project: {project_path}\n"
    
    with open(LOG_FILE, "a") as f:
        f.write(log_entry)


def is_destructive(command: str) -> tuple[bool, str]:
    """Check if a command matches any destructive pattern."""
    for pattern in COMPILED_PATTERNS:
        if pattern.search(command):
            return True, pattern.pattern
    return False, ""


def main():
    # Claude Code hooks receive JSON on stdin
    try:
        hook_input = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # Not a valid JSON input, pass through
        sys.exit(0)
    
    # Only intercept bash tool usage
    tool_name = hook_input.get("tool_name", "")
    if tool_name != "bash":
        sys.exit(0)
    
    command = hook_input.get("tool_input", {}).get("command", "")
    if not command:
        sys.exit(0)
    
    is_blocked, pattern = is_destructive(command)
    if is_blocked:
        log_blocked(command, pattern)
        print(f"🚫 BLOCKED: This command was prevented from running for safety reasons.", file=sys.stderr)
        print(f"   Command: {command}", file=sys.stderr)
        print(f"   Reason: Destructive operation detected (matches pattern: {pattern})", file=sys.stderr)
        print(f"   If you need to run this, please do so manually outside of Claude Code.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()