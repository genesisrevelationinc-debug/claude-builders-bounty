#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone


BLOCKED_PATTERNS = [
    # rm -rf / rm -rf /path
    (r'\brm\s+(?:-\S*\s+)*-[^\s]*f', 'rm -rf: recursive force delete'),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', 'DROP TABLE: destructive SQL operation'),
    # git push --force or git push -f
    (r'\bgit\s+push\s+(?:-\S*\s+)*--force\b', 'git push --force: force push'),
    (r'\bgit\s+push\s+(?:-\S*\s+)*-[a-zA-Z]*f', 'git push -f: force push'),
    # TRUNCATE
    (r'\bTRUNCATE\s+(?:TABLE\s+)?\w+', 'TRUNCATE: destructive SQL operation'),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b).*$', 'DELETE FROM without WHERE: unconditional delete'),
]

LOG_FILE = os.path.expanduser('~/.claude/hooks/blocked.log')


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt with timestamp and project path."""
    timestamp = datetime.now(timezone.utc).isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason} | Command: {command!r} | Project: {project_path}\n"
    
    try:
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        with open(LOG_FILE, 'a') as f:
            f.write(log_entry)
    except OSError as e:
        print(f"Warning: Could not write to log file: {e}", file=sys.stderr)


def check_command(command: str) -> tuple[bool, str]:
    """Check if a command matches any blocked pattern. Returns (is_blocked, reason)."""
    upper_command = command.upper()
    
    for pattern, reason in BLOCKED_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE | re.MULTILINE):
            # Special check for DELETE FROM without WHERE
            if 'DELETE FROM' in upper_command and 'WHERE' in upper_command:
                continue
            return True, reason
    
    return False, ""


def main():
    # Read the hook input from stdin (Claude Code passes JSON)
    try:
        input_data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a JSON input, pass through silently
        sys.exit(0)
    
    # Extract the command/tool use details
    command = input_data.get('command', '') or input_data.get('input', '') or str(input_data)
    
    is_blocked, reason = check_command(command)
    
    if is_blocked:
        log_blocked_attempt(command, reason)
        
        # Output the block message for Claude
        print(f"\n🛡️  SECURITY HOOK BLOCKED: {reason}\n")
        print(f"   Command: {command[:100]}{'...' if len(command) > 100 else ''}\n")
        print("   This destructive operation was prevented for safety.")
        print("   If you need to run this, please use a different method or disable the hook.\n")
        sys.exit(1)


if __name__ == '__main__':
    main()