#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


# Patterns that are always blocked (no exceptions)
ALWAYS_BLOCKED = [
    r"rm\s+(-[a-zA-Z]*\s+)*-([a-zA-Z]*r[a-zA-Z]*f|f[a-zA-Z]*r)[a-zA-Z]*\s",  # rm -rf variants
    r"git\s+push\s+.*--force",  # git push --force
    r"git\s+push\s+-f\b",  # git push -f
    r"\bDROP\s+TABLE\b",  # DROP TABLE
    r"\bTRUNCATE\b",  # TRUNCATE
]

# Patterns that require a WHERE clause
REQUIRES_WHERE = [
    r"\bDELETE\s+FROM\b",  # DELETE FROM without WHERE
]


def get_blocked_log_path() -> Path:
    """Get the path to the blocked log file."""
    hooks_dir = Path.home() / ".claude" / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    return hooks_dir / "blocked.log"


def log_blocked_attempt(command: str, reason: str) -> None:
    """Log a blocked command attempt with timestamp and project path."""
    log_path = get_blocked_log_path()
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"{timestamp} | REASON: {reason} | CMD: {command} | PROJECT: {project_path}\n"
    
    with open(log_path, "a") as f:
        f.write(log_entry)


def is_dangerous_command(command: str) -> tuple[bool, str]:
    """
    Check if a command is dangerous and should be blocked.
    
    Returns:
        Tuple of (is_blocked, reason)
    """
    command_upper = command.upper()
    
    # Check always-blocked patterns
    for pattern in ALWAYS_BLOCKED:
        if re.search(pattern, command, re.IGNORECASE):
            return True, f"Matched dangerous pattern: {pattern}"
    
    # Check DELETE FROM without WHERE
    for pattern in REQUIRES_WHERE:
        if re.search(pattern, command, re.IGNORECASE):
            # Check if WHERE clause exists
            if not re.search(r"\bWHERE\b", command_upper):
                return True, "DELETE FROM without WHERE clause"
    
    return False, ""


def main() -> None:
    """Main entry point for the hook."""
    # Read the tool use request from stdin
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, let it pass
        sys.exit(0)
    
    # Extract the command from the tool use data
    command = data.get("command", "") if isinstance(data, dict) else ""
    
    if not command:
        sys.exit(0)
    
    is_blocked, reason = is_dangerous_command(command)
    
    if is_blocked:
        log_blocked_attempt(command, reason)
        print(f"🛡️  BLOCKED: This command was prevented from running.\n   Reason: {reason}\n   Command: {command}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()