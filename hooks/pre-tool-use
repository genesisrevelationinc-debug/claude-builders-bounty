#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path

# Path to the blocked attempts log file
BLOCKED_LOG = Path.home() / ".claude" / "hooks" / "blocked.log"

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf / rm -r -f / rm --force --recursive variations
    {
        "pattern": r"rm\s+(-[rf]+\s+|-\w*[rf]\w*\s+)*\s*",
        "name": "rm -rf (recursive force delete)",
    },
    # DROP TABLE
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "name": "DROP TABLE (delete database table)",
    },
    # git push --force / git push -f
    {
        "pattern": r"git\s+push\s+.*(--force|-f)(\s|$)",
        "name": "git push --force (force push)",
    },
    # TRUNCATE
    {
        "pattern": r"(?i)\bTRUNCATE\s+",
        "name": "TRUNCATE (delete all table data)",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b).*$",
        "name": "DELETE FROM without WHERE (delete all rows)",
    },
]


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt to the log file."""
    BLOCKED_LOG.parent.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = (
        f"[{timestamp}] BLOCKED: {reason}\n"
        f"  Command: {command}\n"
        f"  Project: {project_path}\n"
        f"{'=' * 60}\n"
    )
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        input_data = sys.stdin.read()
        if not input_data:
            sys.exit(0)
        
        tool_info = json.loads(input_data)
    except (json.JSONDecodeError, Exception):
        # If we can't parse, let it through (fail open for safety)
        sys.exit(0)
    
    # Check if this is a bash tool use
    tool_name = tool_info.get("tool_name", "")
    if tool_name != "Bash":
        sys.exit(0)
    
    # Get the command being executed
    command = tool_info.get("tool_input", {}).get("command", "")
    if not command:
        sys.exit(0)
    
    # Check against dangerous patterns
    for rule in DANGEROUS_PATTERNS:
        if re.search(rule["pattern"], command):
            # Log the blocked attempt
            log_blocked_attempt(command, rule["name"])
            
            # Print clear message to Claude
            print(
                f"\n🛡️  SECURITY BLOCK: This command was prevented from running.\n"
                f"   Reason: {rule['name']}\n"
                f"   Command: {command}\n\n"
                f"   This destructive operation could cause irreversible data loss. "
                f"   If you need to run this command, ask the user for explicit confirmation.\n",
                file=sys.stderr,
            )
            sys.exit(1)
    
    # Command is safe, allow it
    sys.exit(0)


if __name__ == "__main__":
    main()