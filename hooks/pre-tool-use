#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or destructive operations.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path

# Path to the log file for blocked commands
BLOCKED_LOG = Path.home() / ".claude" / "hooks" / "blocked.log"

# Destructive patterns to block
# Each tuple: (pattern, description)
DANGEROUS_PATTERNS = [
    # rm -rf / rm -r / rm -R (recursive deletion)
    (r'\brm\s+-(r\S*\s+)?-?\S*r', "Recursive file deletion (rm -rf)"),
    
    # DROP TABLE (SQL)
    (r'\bDROP\s+TABLE\b', "SQL DROP TABLE statement"),
    
    # git push --force / git push -f
    (r'\bgit\s+push\s+.*--force\b', "Force git push (git push --force)"),
    (r'\bgit\s+push\s+.*-f\b', "Force git push (git push -f)"),
    
    # TRUNCATE (SQL)
    (r'\bTRUNCATE\b', "SQL TRUNCATE statement"),
    
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+(?!.*WHERE)', "SQL DELETE without WHERE clause"),
]


def log_blocked_command(command: str, project_path: str) -> None:
    """Log a blocked command attempt to the log file."""
    BLOCKED_LOG.parent.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    log_entry = f"{timestamp} | {project_path} | {command}\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """
    Check if a command matches any dangerous patterns.
    
    Returns:
        tuple of (is_blocked, reason)
    """
    for pattern, description in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, description
    return False, ""


def main():
    # Read the tool use request from stdin (JSON format per Claude Code hooks)
    try:
        input_data = sys.stdin.read()
        tool_request = json.loads(input_data)
    except (json.JSONDecodeError, Exception):
        # If we can't parse the input, allow it to proceed
        sys.exit(0)
    
    # Extract the command from the tool request
    command = tool_request.get("command", "") or tool_request.get("input", "")
    project_path = tool_request.get("project_path", os.getcwd())
    
    # Check if this is a bash tool and contains dangerous patterns
    tool_name = tool_request.get("tool", "")
    if tool_name in ("bash", "shell", "Bash") or "bash" in command.lower():
        is_blocked, reason = check_command(command)
        
        if is_blocked:
            # Log the blocked attempt
            log_blocked_command(command, project_path)
            
            # Print error message to stderr (shown to Claude)
            print(f"\n🚫 BLOCKED: Destructive command detected!\n", file=sys.stderr)
            print(f"   Reason: {reason}\n", file=sys.stderr)
            print(f"   Command: {command}\n", file=sys.stderr)
            print(f"   This command has been blocked to prevent accidental data loss.", file=sys.stderr)
            print(f"   If you intended this action, please review and run it manually.\n", file=sys.stderr)
            
            # Exit with non-zero to block the command
            sys.exit(1)
    
    # Allow the command to proceed
    sys.exit(0)


if __name__ == "__main__":
    main()
--- /dev/null
# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code/) that intercepts and blocks dangerous bash commands before they can be executed.

## What It Blocks

| Pattern | Example |
|---------|---------|
| `rm -rf` | `rm -rf /important/data` |
| `DROP TABLE` | `DROP TABLE users;` |
| `git push --force` | `git push --force origin main` |
| `TRUNCATE` | `TRUNCATE TABLE orders;` |
| `DELETE FROM` (no WHERE) | `DELETE FROM users;` |

