#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone


BLOCKED_PATTERNS = [
    # rm -rf (any variant with -r and -f flags)
    {
        "pattern": r"rm\s+(?:-[a-zA-Z]*[rf][a-zA-Z]*\s+|\s+).+",
        "description": "Recursive force delete (rm -rf)",
    },
    # DROP TABLE
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "description": "SQL DROP TABLE statement",
    },
    # git push --force
    {
        "pattern": r"(?i)git\s+push\s+.*--force\b",
        "description": "Force git push",
    },
    {
        "pattern": r"(?i)git\s+push\s+.*-f\b",
        "description": "Force git push",
    },
    # TRUNCATE
    {
        "pattern": r"(?i)\bTRUNCATE\b",
        "description": "SQL TRUNCATE statement",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)^\s*DELETE\s+FROM\s+\S+\s*$",
        "description": "SQL DELETE FROM without WHERE clause",
    },
    {
        "pattern": r"(?i)^\s*DELETE\s+FROM\s+\S+\s+(?!WHERE\b)\S",
        "description": "SQL DELETE FROM without WHERE clause",
    },
]

LOG_FILE = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt."""
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat()
    project_path = os.getcwd()
    with open(LOG_FILE, "a") as f:
        f.write(f"[{timestamp}] BLOCKED: {reason} | Command: {command} | Project: {project_path}\n")


def main():
    # Read the hook input from stdin (Claude Code passes JSON)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not JSON, pass through
        return 0

    # Extract the command being executed
    command = data.get("command", "") or data.get("tool_input", {}).get("command", "")
    if not command and "input" in data:
        command = data.get("input", "")

    if not command:
        return 0

    for blocked in BLOCKED_PATTERNS:
        if re.search(blocked["pattern"], command):
            log_blocked(command, blocked["description"])
            print(f"🚫 BLOCKED: {blocked['description']}", file=sys.stderr)
            print(f"   Command: {command}", file=sys.stderr)
            print("   This destructive command has been prevented for safety.", file=sys.stderr)
            return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())