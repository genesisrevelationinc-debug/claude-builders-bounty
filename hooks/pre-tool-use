#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone


BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked(command: str, project_path: str):
    """Log a blocked command attempt to the blocked log file."""
    timestamp = datetime.now(timezone.utc).isoformat()
    log_entry = f"[{timestamp}] project={project_path} command={command}\n"
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_destructive(command: str) -> tuple[bool, str]:
    """
    Check if a command matches destructive patterns.
    Returns (is_blocked, reason).
    """
    upper = command.upper()
    
    # Pattern: rm -rf (and variants like rm -rf /, rm -rf *)
    if re.search(r'\brm\s+(-[a-zA-Z]*f|f[a-zA-Z]*)\b', command, re.IGNORECASE):
        return True, "Destructive file removal: `rm -rf` is blocked to prevent accidental data loss."
    
    # Pattern: DROP TABLE
    if re.search(r'\bDROP\s+TABLE\b', upper):
        return True, "Destructive SQL: `DROP TABLE` is blocked to prevent data loss."
    
    # Pattern: git push --force (and -f)
    if re.search(r'\bgit\s+push\s+.*(--force\b|-f\b)', command, re.IGNORECASE):
        return True, "Destructive git operation: `git push --force` is blocked to prevent overwriting remote history."
    
    # Pattern: TRUNCATE
    if re.search(r'\bTRUNCATE\b', upper):
        return True, "Destructive SQL: `TRUNCATE` is blocked to prevent data loss."
    
    # Pattern: DELETE FROM without WHERE
    if re.search(r'\bDELETE\s+FROM\b', upper) and not re.search(r'\bWHERE\b', upper):
        return True, "Destructive SQL: `DELETE FROM` without a WHERE clause is blocked to prevent accidental data deletion."
    
    return False, ""


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, let it pass
        sys.exit(0)
    
    # Only intercept bash tool
    if hook_input.get("tool_name") != "bash":
        sys.exit(0)
    
    command = hook_input.get("tool_input", {}).get("command", "")
    if not command:
        sys.exitunnels)
    
    blocked, reason = is_destructive(command)
    if blocked:
        project_path = hook_input.get("project_path", os.getcwd())
        log_blocked(command, project_path)
        
        # Output the block message to stderr so Claude sees it
        print(f"\n🚫 BLOCKED: {reason}", file=sys.stderr)
        print(f"   Attempted command: {command}", file=sys.stderr)
        print(f"   This command has been logged to {BLOCKED_LOG}", file=sys.stderr)
        print(f"   Please use a safer alternative or modify the command.\n", file=sys.stderr)
        
        # Exit with non-zero to block the tool execution
        sys.exit(1)


if __name__ == "__main__":
    main()
# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code/) that intercepts and blocks dangerous bash commands before they execute.

## What It Blocks

| Pattern | Example | Why Blocked |
|---------|---------|-------------|
| `rm -rf` | `rm -rf /important` | Irreversible file deletion |
| `DROP TABLE` | `DROP TABLE users` | Irreversible data loss |
| `git push --force` | `git push --force origin main` | Overwrites remote history |
| `TRUNCATE` | `TRUNCATE TABLE orders` | Bulk data deletion |
| `DELETE FROM` (no WHERE) | `DELETE FROM users` | Accidental full table wipe |

