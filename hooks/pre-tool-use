#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the log file for blocked commands
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf / rm -r / rm --recursive (destructive recursive removal)
    {
        "pattern": r"^\s*rm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+",
        "name": "rm -rf (recursive force delete)",
    },
    {
        "pattern": r"^\s*rm\s+.*\s+-[a-zA-Z]*r[a-zA-Z]*f[a-zA-Z]*",
        "name": "rm -rf (recursive force delete)",
    },
    # DROP TABLE
    {
        "pattern": r"(?i)^\s*(?:.*;\s*)?DROP\s+TABLE\s+",
        "name": "DROP TABLE (deletes entire table)",
    },
    # git push --force
    {
        "pattern": r"(?i)^\s*git\s+push\s+.*--force",
        "name": "git push --force (overwrites remote history)",
    },
    {
        "pattern": r"(?i)^\s*git\s+push\s+-f",
        "name": "git push --force (overwrites remote history)",
    },
    # TRUNCATE
    {
        "pattern": r"(?i)^\s*(?:.*;\s*)?TRUNCATE\s+",
        "name": "TRUNCATE (removes all table data)",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)^\s*(?:.*;\s*)?DELETE\s+FROM\s+\S+\s*$",
        "name": "DELETE FROM without WHERE (deletes all rows)",
    },
]


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt with timestamp and project path."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    with open(BLOCKED_LOG, "a") as f:
        f.write(f"{timestamp} | {reason} | {command} | {project_path}\n")


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a JSON payload, allow to pass through
        return

    # Only check bash tool uses
    if data.get("tool_name") != "bash":
        return

    command = data.get("tool_input", {}).get("command", "")

    for rule in DANGEROUS_PATTERNS:
        if re.search(rule["pattern"], command):
            log_blocked(command, rule["name"])
            print(
                f"🚫 BLOCKED: This command was prevented from running.\n"
                f"   Reason: {rule['name']}\n"
                f"   Command: {command}\n"
                f"   If you need to run this, please use your local terminal or disable the hook.",
                file=sys.stderr,
            )
            sys.exit(1)


if __name__ == "__main__":
    main()