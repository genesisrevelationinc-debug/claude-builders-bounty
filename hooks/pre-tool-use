#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
and blocks them with a clear explanation.

Installation:
    mkdir -p ~/.claude/hooks
    cp pre-tool-use ~/.claude/hooks/pre-tool-use
    chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone


# Patterns that are always blocked (case-insensitive)
ALWAYS_BLOCKED = [
    r"rm\s+.*-rf",
    r"rm\s+.*-fr",
    r"rm\s+-[a-z]*r[a-z]*f",
    r"git\s+push\s+.*--force",
    r"git\s+push\s+.*-f",
    r"DROP\s+TABLE",
    r"TRUNCATE\s+",
]

# Patterns that require a WHERE clause
REQUIRES_WHERE = [
    r"DELETE\s+FROM\s+",
]

LOG_FILE = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt with timestamp and project path."""
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] REASON: {reason} | COMMAND: {command} | PATH: {project_path}\n"
    
    with open(LOG_FILE, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """
    Check if a command should be blocked.
    
    Returns:
        tuple of (should_block, reason)
    """
    upper = command.upper()
    
    # Check always-blocked patterns
    for pattern in ALWAYS_BLOCKED:
        if re.search(pattern, command, re.IGNORECASE):
            return True, f"Destructive pattern detected: matches '{pattern}'"
    
    # Check DELETE FROM without WHERE
    for pattern in REQUIRES_WHERE:
        if re.search(pattern, command, re.IGNORECASE):
            # Check if WHERE clause exists
            if not re.search(r"\bWHERE\b", command, re.IGNORECASE):
                return True, "DELETE FROM without WHERE clause is dangerous"
    
    return False, ""


def main():
    # Read the hook input from stdin (Claude Code passes JSON)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        return
    
    # Extract the command from the tool use
    command = data.get("command", "") or data.get("input", "") or str(data)
    
    should_block, reason = check_command(command)
    
    if should_block:
        log_blocked(command, reason)
        print(f"🚫 BLOCKED: This command was prevented from executing.", file=sys.stderr)
        print(f"   Reason: {reason}", file=sys.stderr)
        print(f"   Command: {command}", file=sys.stderr)
        print(f"   If you need to run this, please review the command and use a safer alternative.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()