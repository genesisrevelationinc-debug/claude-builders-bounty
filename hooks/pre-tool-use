#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Blocks destructive bash commands.

Place at: ~/.claude/hooks/pre-tool-use
Make executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone
from typing import Optional

# Path to the blocked log file
BLOCKED_LOG_PATH = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
# Each tuple: (pattern_name, compiled_regex, description)
DESTRUCTIVE_PATTERNS = [
    (
        "rm -rf",
        re.compile(r"rm\s+(?:-[a-zA-Z]*f[a-zA-Z]*\s+|\s+)-?r?\s*(?:[a-zA-Z/]|\.+)", re.IGNORECASE),
        "Recursive force removal of files/directories",
    ),
    (
        "DROP TABLE",
        re.compile(r"\bDROP\s+TABLE\b", re.IGNORECASE),
        "Dropping database tables",
    ),
    (
        "git push --force",
        re.compile(r"git\s+push\s+(?:-[a-zA-Z]*f[a-zA-Z]*|--force)\b", re.IGNORECASE),
        "Force pushing to git repository (overwrites remote history)",
    ),
    (
        "TRUNCATE",
        re.compile(r"\bTRUNCATE\s+TABLE?\b", re.IGNORECASE),
        "Truncating database tables (removes all data)",
    ),
    (
        "DELETE FROM without WHERE",
        re.compile(r"\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b)", re.IGNORECASE),
        "DELETE without WHERE clause (removes all rows)",
    ),
]


def log_blocked_attempt(command: str, project_path: str, pattern_name: str, description: str) -> None:
    """Log a blocked command attempt to the log file."""
    timestamp = datetime.now(timezone.utc).isoformat()
    log_entry = (
        f"[{timestamp}] BLOCKED: {pattern_name}\n"
        f"  Command: {command}\n"
        f"  Project: {project_path}\n"
        f"  Reason: {description}\n"
        f"  {'=' * 60}\n"
    )
    
    # Ensure the directory exists
    os.makedirs(os.path.dirname(BLOCKED_LOG_PATH), exist_ok=True)
    
    with open(BLOCKED_LOG_PATH, "a") as f:
        f.write(log_entry)


def check_command(command: str, project_path: str) -> Optional[str]:
    """Check if a command matches any destructive pattern. Returns block reason or None."""
    for pattern_name, pattern_regex, description in DESTRUCTIVE_PATTERNS:
        if pattern_regex.search(command):
            log_blocked_attempt(command, project_path, pattern_name, description)
            return f"🛡️  BLOCKED: '{pattern_name}' — {description}"
    return None


def main():
    # Read the tool use data from stdin (Claude Code passes JSON)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a JSON input, pass through
        sys.exit(0)
    
    # Only intercept bash tool
    if data.get("tool_name") != "bash":
        sys.exit(0)
    
    command = data.get("command", "")
    project_path = data.get("project_path", os.getcwd())
    
    block_reason = check_command(command, project_path)
    
    if block_reason:
        print(block_reason, file=sys.stderr)
        print(
            "\n💡 This command has been blocked for safety. If you need to run it, "
            "use a different tool or disable the hook temporarily.",
            file=sys.stderr,
        )
        sys.exit(1)


if __name__ == "__main__":
    main()