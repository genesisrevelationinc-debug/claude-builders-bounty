#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Installation:
    mkdir -p ~/.claude/hooks
    cp hooks/pre-tool-use ~/.claude/hooks/pre-tool-use
    chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Patterns that should be blocked
DANGEROUS_PATTERNS = [
    # rm -rf / rm -rf *
    re.compile(r"rm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-?[a-zA-Z]*\s+-?rf?\s+", re.IGNORECASE),
    re.compile(r"rm\s+.*-rf", re.IGNORECASE),
    # DROP TABLE
    re.compile(r"DROP\s+TABLE", re.IGNORECASE),
    # git push --force
    re.compile(r"git\s+push\s+.*--force", re.IGNORECASE),
    re.compile(r"git\s+push\s+.*-f\b", re.IGNORECASE),
    # TRUNCATE
    re.compile(r"TRUNCATE\s+(TABLE\s+)?", re.IGNORECASE),
    # DELETE FROM without WHERE
    re.compile(r"DELETE\s+FROM\s+[^;]+\s*;?\s*$", re.IGNORECASE),
]

# DELETE FROM without WHERE needs special handling
DELETE_PATTERN = re.compile(r"DELETE\s+FROM\s+(.+)", re.IGNORECASE)


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    with open(BLOCKED_LOG, "a") as f:
        f.write(f"{timestamp} | {reason} | {command} | {project_path}\n")


def is_dangerous(command: str) -> tuple[bool, str]:
    """Check if a command is dangerous. Returns (is_dangerous, reason)."""
    # Check DELETE FROM without WHERE
    delete_match = DELETE_PATTERN.search(command)
    if delete_match:
        after_from = command[delete_match.end():]
        # Check if WHERE is present after DELETE FROM
        if not re.search(r"\bWHERE\b", after_from, re.IGNORECASE):
            return True, "DELETE FROM without WHERE clause"

    # Check other dangerous patterns
    for pattern in DANGEROUS_PATTERNS:
        if pattern.search(command):
            pattern_name = pattern.pattern[:50] + "..." if len(pattern.pattern) > 50 else pattern.pattern
            return True, f"Matches dangerous pattern: {pattern_name}"

    return False, ""


def main():
    # Read the tool use request from stdin
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, allow it through
        sys.exit(0)

    # Only intercept bash tool
    if data.get("tool_name") != "bash":
        sys.exit(0)

    command = data.get("tool_input", {}).get("command", "")

    dangerous, reason = is_dangerous(command)
    if dangerous:
        log_blocked(command, reason)
        print(f"🚫 BLOCKED: This command was prevented from running.\n\nReason: {reason}\nCommand: {command}\n\nThis destructive operation has been blocked for safety. Please use a safer alternative or confirm the operation is intentional.", file=sys.stderr)
        sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()