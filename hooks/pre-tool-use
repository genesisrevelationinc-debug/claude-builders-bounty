#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the blocked log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf (any variant)
    (r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-?[a-zA-Z]*\s+-[a-zA-Z]*r[a-zA-Z]*\s+', "rm -rf: Recursive force delete"),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', "DROP TABLE: Database table deletion"),
    # git push --force or git push -f
    (r'\bgit\s+push\s+.*(--force|-f)\b', "git push --force: Force push can overwrite history"),
    # TRUNCATE
    (r'\bTRUNCATE\b', "TRUNCATE: Complete table data removal"),
]

# DELETE FROM without WHERE
DELETE_FROM_PATTERN = re.compile(r'\bDELETE\s+FROM\s+\w+', re.IGNORECASE)
WHERE_PATTERN = re.compile(r'\bWHERE\b', re.IGNORECASE)


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt."""
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason} | Command: {command} | Project: {project_path}\n"
    
    # Ensure the directory exists
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """Check if a command is destructive. Returns (is_blocked, reason)."""
    # Check against dangerous patterns
    for pattern, reason in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, reason
    
    # Special check: DELETE FROM without WHERE
    if DELETE_FROM_PATTERN.search(command):
        if not WHERE_PATTERN.search(command):
            return True, "DELETE FROM without WHERE: Unqualified deletion"
    
    return False, ""


def main():
    # Read the hook input from stdin (Claude Code passes JSON)
    try:
        input_data = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # If not valid JSON, allow the command to proceed
        sys.exit(0)
    
    # Extract the tool name and input
    tool_name = input_data.get("tool_name", "")
    tool_input = input_data.get("tool_input", {})
    
    # Only intercept bash tool
    if tool_name != "bash":
        sys.exit(0)
    
    command = tool_input.get("command", "")
    
    is_blocked, reason = check_command(command)
    
    if is_blocked:
        log_blocked(command, reason)
        print(f"🛡️  BLOCKED: {reason}", file=sys.stderr)
        print(f"   Command: {command}", file=sys.stderr)
        print(f"   This destructive command has been blocked for safety. If you need to run this command, use the --no-hooks flag or modify the command to be non-destructive.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()