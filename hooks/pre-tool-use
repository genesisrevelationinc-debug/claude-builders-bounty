#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or destructive operations.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path

# Path to the log file for blocked attempts
LOG_FILE = Path.home() / ".claude" / "hooks" / "blocked.log"

# Destructive patterns to block
# Each pattern is a tuple of (regex, description)
DANGEROUS_PATTERNS = [
    # rm -rf / rm -r / rm -f with wildcards or root paths
    (
        r"rm\s+(?:-\w*[rf]\w*\s+|\s+)(?:/|[\w/]*\*|.+)",
        "rm -rf or similar recursive/force remove command",
    ),
    # DROP TABLE - SQL destructive operation
    (
        r"(?i)\bDROP\s+TABLE\b",
        "DROP TABLE - deletes an entire database table",
    ),
    # git push --force or git push -f
    (
        r"git\s+push\s+.*(--force|-f)",
        "git push --force - overwrites remote history destructively",
    ),
    # TRUNCATE TABLE - removes all data
    (
        r"(?i)\bTRUNCATE\b",
        "TRUNCATE - removes all data from a table without logging",
    ),
    # DELETE FROM without WHERE clause
    (
        r"(?i)DELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b).*",
        "DELETE FROM without WHERE - deletes all rows in a table",
    ),
]


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt to the log file."""
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason}\n  Command: {command}\n  Project: {project_path}\n\n"
    
    with open(LOG_FILE, "a") as f:
        f.write(log_entry)


def is_dangerous(command: str) -> tuple[bool, str]:
    """Check if a command matches any dangerous pattern."""
    for pattern, description in DANGEROUS_PATTERNS:
        if re.search(pattern, command):
            return True, description
    return False, ""


def main():
    """Main entry point for the hook."""
    # Read the tool use request from stdin (Claude Code hook protocol)
    try:
        input_data = sys.stdin.read()
        tool_request = json.loads(input_data)
    except (json.JSONDecodeError, Exception):
        # If we can't parse the input, allow it through (fail open for safety)
        print("Warning: Could not parse tool request, allowing execution", file=sys.stderr)
        sys.exit(0)
    
    # Extract the command from the tool request
    command = tool_request.get("command", "") or tool_request.get("input", {}).get("command", "")
    
    if not command:
        # Not a bash tool or no command, allow through
        sys.exit(0)
    
    dangerous, reason = is_dangerous(command)
    
    if dangerous:
        log_blocked_attempt(command, reason)
        
        # Print clear message to Claude (stdout is shown to Claude)
        print(f"\n🛡️  SECURITY HOOK BLOCKED: This command was prevented from executing.\n", file=sys.stderr)
        print(f"   Reason: {reason}\n", file=sys.stderr)
        print(f"   Command: {command}\n", file=sys.stderr)
        print(f"   This operation is destructive and could cause irreversible data loss.\n", file=sys.stderr)
        print(f"   If you truly need to run this, please use a safer alternative or confirm with the user.\n", file=sys.stderr)
        
        # Exit with non-zero to block the command
        sys.exit(1)
    
    # Command is safe, allow execution
    sys.exit(0)


if __name__ == "__main__":
    main()