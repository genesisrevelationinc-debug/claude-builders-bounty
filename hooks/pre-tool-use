#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook that blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone

# Path to the blocked log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf (recursive force delete)
    (r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', "rm -rf (recursive force delete)"),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', "DROP TABLE (deletes database table)"),
    # git push --force
    (r'\bgit\s+push\s+.*--force\b', "git push --force (overwrites remote history)"),
    (r'\bgit\s+push\s+-f\b', "git push -f (overwrites remote history)"),
    # TRUNCATE
    (r'\bTRUNCATE\b', "TRUNCATE (removes all table data)"),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\b', "DELETE FROM without WHERE (deletes all rows)"),
]


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason}\n  Command: {command}\n  Project: {project_path}\n\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """Check if a command is dangerous. Returns (is_blocked, reason)."""
    for pattern, reason in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            # Special case: DELETE FROM without WHERE
            if "DELETE FROM" in reason.upper():
                if not re.search(r'\bWHERE\b', command, re.IGNORECASE):
                    return True, reason
                continue
            return True, reason
    return False, ""


def main():
    # Read the hook input from stdin (Claude Code passes JSON)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        return
    
    # Extract the command from the tool use
    command = data.get("command", "") if isinstance(data, dict) else ""
    
    if command:
        is_blocked, reason = check_command(command)
        if is_blocked:
            log_blocked_attempt(command, reason)
            print(f"🛡️  BLOCKED: This command was prevented from running.\n\nReason: {reason}\n\nThis is a destructive operation that could cause data loss. If you're sure you want to proceed, please review the command carefully and consider using a safer alternative.", file=sys.stderr)
            sys.exit(1)


if __name__ == "__main__":
    main()