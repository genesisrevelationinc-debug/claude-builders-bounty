#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
and blocks them with a clear explanation.
"""

import json
import os
import re
import sys
from datetime import datetime


BLOCKED_PATTERNS = [
    # rm -rf / rm -r / rm -f variants
    (r'\brm\s+-(?:[a-zA-Z]*r[a-zA-Z]*f|f[a-zA-Z]*r)[a-zA-Z]*\b', 'rm -rf: Recursive force deletion can destroy data irreversibly'),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', 'DROP TABLE: Destructive SQL that deletes table structure and data'),
    # git push --force / git push -f
    (r'\bgit\s+push\s+.*--force\b', 'git push --force: Force push can overwrite remote history and cause data loss'),
    (r'\bgit\s+push\s+.*-f\b', 'git push -f: Force push can overwrite remote history and cause data loss'),
    # TRUNCATE
    (r'\bTRUNCATE\b', 'TRUNCATE: Instantly removes all data from a table without logging individual row deletions'),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b)', 'DELETE FROM without WHERE: Deletes all rows in a table without a filter clause'),
]


def get_log_path():
    """Get the path to the blocked log file."""
    hooks_dir = os.path.dirname(os.path.abspath(__file__))
    return os.path.join(hooks_dir, 'blocked.log')


def log_blocked_attempt(command, reason, project_path):
    """Log a blocked command attempt with timestamp."""
    log_path = get_log_path()
    timestamp = datetime.now().isoformat()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason} | Command: {command} | Project: {project_path}\n"
    
    try:
        with open(log_path, 'a') as f:
            f.write(log_entry)
    except Exception as e:
        print(f"Warning: Could not write to blocked log: {e}", file=sys.stderr)


def check_command(command, project_path):
    """Check if a command matches any blocked pattern."""
    for pattern, reason in BLOCKED_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return reason
    return None


def main():
    # Read the hook input from stdin (Claude Code passes JSON)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)
    
    # Extract tool use information
    tool_name = hook_input.get('tool_name', '')
    tool_input = hook_input.get('tool_input', {})
    
    # Only check bash tool
    if tool_name != 'bash':
        sys.exit(0)
    
    command = tool_input.get('command', '')
    project_path = hook_input.get('project_path', os.getcwd())
    
    block_reason = check_command(command, project_path)
    if block_reason:
        log_blocked_attempt(command, block_reason, project_path)
        print(f"\n🛡️  SECURITY BLOCK: This command was prevented from executing.\n   Reason: {block_reason}\n   Command: {command}\n\nTo proceed, please modify the command to avoid the destructive pattern, or run it manually after careful review.", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()