#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook that blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Patterns that are always blocked (case-insensitive)
ALWAYS_BLOCKED = [
    r"rm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?(-[a-zA-Z]*r[a-zA-Z]*\s+)?-?[a-zA-Z]*\s*\S+",  # rm -rf or variants
    r"git\s+push\s+.*--force",  # git push --force
    r"git\s+push\s+.*-f",  # git push -f
]

# Patterns that require a WHERE clause
REQUIRES_WHERE = [
    r"DELETE\s+FROM\s+\w+",  # DELETE FROM without WHERE
]

# Patterns that are always blocked (SQL)
SQL_BLOCKED = [
    r"DROP\s+TABLE",  # DROP TABLE
    r"TRUNCATE\s+",  # TRUNCATE
]


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt."""
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] REASON: {reason} | COMMAND: {command} | PROJECT: {project_path}\n"
    
    # Ensure the hooks directory exists
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_destructive(command: str) -> tuple[bool, str]:
    """Check if a command is destructive. Returns (is_blocked, reason)."""
    upper = command.upper()
    
    # Check always blocked patterns
    for pattern in ALWAYS_BLOCKED:
        if re.search(pattern, command, re.IGNORECASE):
            return True, f"Destructive file operation detected: matches pattern '{pattern}'"
    
    # Check SQL blocked patterns
    for pattern in SQL_BLOCKED:
        if re.search(pattern, upper):
            return True, f"Destructive SQL operation detected: matches pattern '{pattern}'"
    
    # Check DELETE FROM without WHERE
    for pattern in REQUIRES_WHERE:
        if re.search(pattern, upper) and "WHERE" not in upper:
            return True, "DELETE FROM without WHERE clause is not allowed"
    
    return False, ""


def main():
    # Read the hook input from stdin
    hook_input = sys.stdin.read()
    
    # Parse the tool use information
    # The hook receives JSON with tool information
    try:
        data = json.loads(hook_input) if hook_input.strip() else {}
    except json.JSONDecodeError:
        data = {}
    
    # For pre-tool-use hooks, we check the command being executed
    # The actual command is passed via the hook protocol
    # This hook will be called before any tool use
    
    # Since we can't easily parse the exact command from the hook format,
    # we'll check the stdin content for dangerous patterns
    content_to_check = hook_input
    
