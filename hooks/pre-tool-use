#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone


BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked(command: str, project_path: str):
    """Log a blocked command attempt with timestamp and project path."""
    timestamp = datetime.now(timezone.utc).isoformat()
    log_entry = f"[{timestamp}] BLOCKED: {command!r} | Project: {project_path}\n"
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_destructive(command: str) -> tuple[bool, str]:
    """
    Check if a bash command is destructive.
    Returns (is_blocked, reason).
    """
    upper = command.upper()

    # Pattern: rm -rf (remove recursively and force)
    if re.search(r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', command) or \
       re.search(r'\brm\s+(-[a-zA-Z]*r[a-zA-Z]*\s+)?-[a-zA-Z]*f', command):
        return True, "Destructive file deletion: `rm -rf` is blocked to prevent accidental data loss."

    # Pattern: DROP TABLE
    if re.search(r'\bDROP\s+TABLE\b', upper):
        return True, "Destructive SQL: `DROP TABLE` is blocked to prevent data loss."

    # Pattern: git push --force
    if re.search(r'\bgit\s+push\s+.*--force\b', command) or \
       re.search(r'\bgit\s+push\s+.*-f\b', command):
        return True, "Destructive git operation: `git push --force` is blocked to prevent overwriting remote history."

    # Pattern: TRUNCATE
    if re.search(r'\bTRUNCATE\b', upper):
        return True, "Destructive SQL: `TRUNCATE` is blocked to prevent data loss."

    # Pattern: DELETE FROM without WHERE
    if re.search(r'\bDELETE\s+FROM\b', upper) and not re.search(r'\bWHERE\b', upper):
        return True, "Destructive SQL: `DELETE FROM` without a `WHERE` clause is blocked to prevent accidental data deletion."

    return False, ""


def main():
    # Read the hook payload from stdin
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        sys.exit(0)  # Allow if we can't parse

    tool_name = payload.get("tool_name", "")
    tool_input = payload.get("tool_input", {})

    # Only intercept bash tool
    if tool_name != "bash":
        sys.exit(0)

    command = tool_input.get("command", "")
    project_path = payload.get("project_path", os.getcwd())

    blocked, reason = is_destructive(command)
    if blocked:
        log_blocked(command, project_path)
        print(f"\n🛡️  Command blocked by pre-tool-use hook:\n   {reason}\n", file=sys.stderr)
        sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()