#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook that blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import re
import sys
from datetime import datetime
from pathlib import Path


HOOKS_DIR = Path.home() / ".claude" / "hooks"
BLOCKED_LOG = HOOKS_DIR / "blocked.log"


def get_project_path() -> str:
    """Get the current project path from environment or default to cwd."""
    import os
    return os.environ.get("PWD", str(Path.cwd()))


def log_blocked_attempt(command: str, reason: str) -> None:
    """Log a blocked command attempt to the blocked log file."""
    HOOKS_DIR.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    project_path = get_project_path()
    
    log_entry = f"{timestamp} | {reason} | {command} | {project_path}\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_destructive_bash(command: str) -> tuple[bool, str]:
    """
    Check if a bash command is destructive.
    Returns (is_blocked, reason).
    """
    upper = command.upper()
    lower = command.lower()
    
    # Pattern: rm -rf (and variants like rm -rfv, rm -fr, etc.)
    if re.search(r'\brm\s+-(?:[a-zA-Z]*[rf]|[a-zA-Z]*fr)', lower):
        return True, "Destructive file deletion (rm -rf)"
    
    # Pattern: DROP TABLE
    if re.search(r'\bDROP\s+TABLE\b', upper):
        return True, "Destructive SQL (DROP TABLE)"
    
    # Pattern: git push --force (and variants like -f, --force-with-lease)
    if re.search(r'\bgit\s+push\s+.*--force\b', lower) or re.search(r'\bgit\s+push\s+.*\s-f(?:\s|$)', lower):
        return True, "Destructive git operation (git push --force)"
    
    # Pattern: TRUNCATE
    if re.search(r'\bTRUNCATE\b', upper):
        return True, "Destructive SQL (TRUNCATE)"
    
    # Pattern: DELETE FROM without WHERE
    if re.search(r'\bDELETE\s+FROM\b', upper) and not re.search(r'\bWHERE\b', upper):
        return True, "Destructive SQL (DELETE FROM without WHERE)"
    
    return False, ""


def main() -> None:
    """Main entry point for the pre-tool-use hook."""
    # Read the tool use data from stdin
    data = json.load(sys.stdin)
    
    # Only intercept bash tool
    if data.get("tool_name") == "bash":
        command = data.get("tool_input", {}).get("command", "")
        
        is_blocked, reason = is_destructive_bash(command)
        if is_blocked:
            log_blocked_attempt(command, reason)
            print(f"🛡️ BLOCKED: {reason}", file=sys.stderr)
            print(f"Command: {command}", file=sys.stderr)
            print("This destructive command has been blocked for safety. Please use a safer alternative or confirm the operation manually.", file=sys.stderr)
            sys.exit(1)


if __name__ == "__main__":
    main()