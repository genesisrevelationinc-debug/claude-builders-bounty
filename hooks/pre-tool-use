#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone


# Path to the blocked log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked(command: str, project_path: str):
    """Log a blocked command attempt with timestamp and project path."""
    timestamp = datetime.now(timezone.utc).isoformat()
    log_entry = f"[{timestamp}] project={project_path} command={command}\n"
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_destructive(command: str) -> tuple[bool, str]:
    """
    Check if a command matches destructive patterns.
    Returns (is_blocked, reason).
    """
    upper = command.upper()
    lower = command.lower()

    # Pattern 1: rm -rf (recursive force delete)
    if re.search(r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', lower) or \
       re.search(r'\brm\s+-\w*[rf]\w*\s+', lower) or \
       re.search(r'\brm\s+(-\w+\s+)*-rf\s', lower) or \
       re.search(r'\brm\s.*\s-rf\b', lower) or \
       re.search(r'\brm\s+-rf\s', lower):
        return True, "rm -rf detected: recursively and forcefully deleting files is dangerous and can destroy data irreversibly."

    # Pattern 2: DROP TABLE
    if re.search(r'\bDROP\s+TABLE\b', upper):
        return True, "DROP TABLE detected: this permanently deletes a database table and all its data."

    # Pattern 3: git push --force
    if re.search(r'\bgit\s+push\s+.*(--force\b|-f\b)', lower):
        return True, "git push --force detected: force pushing can overwrite remote history and cause data loss for collaborators."

    # Pattern 4: TRUNCATE
    if re.search(r'\bTRUNCATE\b', upper):
        return True, "TRUNCATE detected: this immediately removes all rows from a table without logging individual row deletions."

    # Pattern 5: DELETE FROM without WHERE
    if re.search(r'\bDELETE\s+FROM\b', upper) and not re.search(r'\bWHERE\b', upper):
        return True, "DELETE FROM without WHERE detected: this deletes all rows from a table without a filter condition."

    return False, ""


def main():
    # Read the hook payload from stdin
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If not valid JSON, allow the tool use to proceed
        sys.exit(0)

    # Only intercept Bash tool
    tool_name = payload.get("tool_name", "")
    if tool_name != "Bash":
        sys.exit(0)

    # Get the command being executed
    command = payload.get("tool_input", {}).get("command", "")
    if not command:
        sys.exit(0)

    # Check if the command is destructive
    blocked, reason = is_destructive(command)
    if blocked:
        # Get project path from payload or use current directory
        project_path = payload.get("project_path", os.getcwd())

        # Log the blocked attempt
        log_blocked(command, project_path)

        # Print clear message to Claude (stderr)
        print(f"\n🛡️  SECURITY HOOK BLOCKED: {reason}", file=sys.stderr)
        print(f"   Attempted command: {command}", file=sys.stderr)
        print(f"   This command has been prevented from executing to protect your system.\n", file=sys.stderr)

        # Exit with non-zero to block the tool use
        sys.exit(1)

    # Allow the tool use to proceed
    sys.exit(0)


if __name__ == "__main__":
    main()