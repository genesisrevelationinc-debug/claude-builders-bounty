#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime


# Patterns that are always blocked (case-insensitive)
ALWAYS_BLOCKED = [
    r"rm\s+(-[a-zA-Z]*\s+)*-[^\s]*r[^\s]*f",  # rm -rf variants
    r"git\s+push\s+.*--force",  # git push --force variants
    r"drop\s+table",  # DROP TABLE
    r"truncate\s+",  # TRUNCATE
]

# Patterns that require a WHERE clause
REQUIRES_WHERE = [
    r"delete\s+from\s+\w+",  # DELETE FROM without WHERE
]

# Combined pattern for quick checking
ALWAYS_BLOCKED_PATTERN = re.compile(
    "|".join(f"(?i:{p})" for p in ALWAYS_BLOCKED),
    re.IGNORECASE,
)

REQUIRES_WHERE_PATTERN = re.compile(
    "|".join(f"(?i:{p})" for p in REQUIRES_WHERE),
    re.IGNORECASE,
)


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt to the blocked log file."""
    log_dir = os.path.expanduser("~/.claude/hooks")
    log_file = os.path.join(log_dir, "blocked.log")
    project_path = os.getcwd()
    timestamp = datetime.now().isoformat()

    # Ensure log directory exists
    os.makedirs(log_dir, exist_ok=True)

    with open(log_file, "a") as f:
        f.write(f"[{timestamp}] BLOCKED: {command}\n")
        f.write(f"  Project: {project_path}\n")
        f.write(f"  Reason: {reason}\n")
        f.write("-" * 60 + "\n")


def main():
    # Read the hook input from stdin (JSON format per Claude Code hooks spec)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)

    # Only intercept bash tool usage
    tool_name = hook_input.get("tool_name", "")
    if tool_name != "bash":
        sys.exit(0)

    command = hook_input.get("tool_input", {}).get("command", "")
    if not command:
        sys.exit(0)

    # Check for always-blocked patterns
    if ALWAYS_BLOCKED_PATTERN.search(command):
        reason = "Destructive command pattern detected (e.g., rm -rf, DROP TABLE, git push --force, TRUNCATE)"
        log_blocked(command, reason)
        print(f"🚫 BLOCKED: This command was prevented from running.\nReason: {reason}\nAttempted: {command}", file=sys.stderr)
        sys.exit(1)

    # Check for DELETE FROM without WHERE
    if REQUIRES_WHERE_PATTERN.search(command) and "where" not in command.lower():
        reason = "DELETE FROM without a WHERE clause is not allowed"
        log_blocked(command, reason)
        print(f"🚫 BLOCKED: This command was prevented from running.\nReason: {reason}\nAttempted: {command}", file=sys.stderr)
        sys.exit(1)

    # Allow the command to proceed
    sys.exit(0)


if __name__ == "__main__":
    main()

# Pre-Tool-Use Hook: Block Destructive Bash Commands

A Claude Code `pre-tool-use` hook that intercepts and blocks dangerous bash commands before they can be executed.

## What It Blocks

- `rm -rf` and similar recursive force delete patterns
- `DROP TABLE` SQL statements
- `git push --force`
- `TRUNCATE` SQL statements
- `DELETE FROM` without a `WHERE` clause

