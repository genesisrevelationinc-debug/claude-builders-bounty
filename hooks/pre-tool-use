#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
and blocks them with a clear explanation.

Installation:
    mkdir -p ~/.claude/hooks
    cp pre-tool-use ~/.claude/hooks/
    chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


BLOCKED_PATTERNS = [
    # rm -rf / rm -r / rm -rfv etc.
    {
        "pattern": r"rm\s+(?:-\S*\s+)?-r\S*(?:\s+\S+)?",
        "message": "Destructive file removal (rm -rf) is blocked to prevent accidental data loss.",
    },
    # DROP TABLE
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "message": "DROP TABLE is blocked to prevent accidental database table deletion.",
    },
    # git push --force / git push -f
    {
        "pattern": r"git\s+push\s+(?:.*\s)?--force(?:\s|$)",
        "message": "git push --force is blocked to prevent overwriting remote history.",
    },
    {
        "pattern": r"git\s+push\s+(?:.*\s)?-f(?:\s|$)",
        "message": "git push -f is blocked to prevent overwriting remote history.",
    },
    # TRUNCATE
    {
        "pattern": r"(?i)\bTRUNCATE\b",
        "message": "TRUNCATE is blocked to prevent accidental data deletion.",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)\bDELETE\s+FROM\s+\S+(?:\s+JOIN\s+\S+)*\s*$",
        "message": "DELETE FROM without a WHERE clause is blocked to prevent deleting all rows.",
    },
]


def log_blocked_attempt(command: str, project_path: str):
    """Log a blocked command attempt to the log file."""
    log_dir = Path.home() / ".claude" / "hooks"
    log_file = log_dir / "blocked.log"
    
    timestamp = datetime.now().isoformat()
    log_entry = f"[{timestamp}] command={command!r} project={project_path}\n"
    
    try:
        log_dir.mkdir(parents=True, exist_ok=True)
        with open(log_file, "a") as f:
            f.write(log_entry)
    except Exception as e:
        print(f"Warning: Could not write to log file: {e}", file=sys.stderr)


def main():
    # Read the hook input from stdin (JSON)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        sys.exit(0)  # If we can't parse, let it through
    
    command = data.get("command", "")
    project_path = data.get("project_path", os.getcwd())
    
    for blocked in BLOCKED_PATTERNS:
        if re.search(blocked["pattern"], command):
            log_blocked_attempt(command, project_path)
            print(f"\n🚫 BLOCKED: {blocked['message']}", file=sys.stderr)
            print(f"   Command: {command}", file=sys.stderr)
            print(f"   If you need to run this, use a different method or disable the hook.\n", file=sys.stderr)
            sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()
# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code/) that intercepts and blocks dangerous bash commands before they execute.

## What It Blocks

| Pattern | Reason |
|---------|--------|
| `rm -rf` | Prevents accidental file/folder deletion |
| `DROP TABLE` | Prevents database table deletion |
| `git push --force` / `git push -f` | Prevents overwriting remote git history |
| `TRUNCATE` | Prevents table data wipe |
| `DELETE FROM` without `WHERE` | Prevents deleting all rows in a table |

