#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Installation:
    mkdir -p ~/.claude/hooks
    cp pre-tool-use ~/.claude/hooks/pre-tool-use
    chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone


BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked(command: str, project_path: str):
    """Log a blocked command attempt with timestamp and project path."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat()
    with open(BLOCKED_LOG, "a") as f:
        f.write(f"{timestamp} | {project_path} | {command}\n")


def is_destructive(command: str) -> tuple[bool, str]:
    """
    Check if a command matches destructive patterns.
    Returns (is_blocked, reason).
    """
    upper = command.upper()

    # Pattern: rm -rf (and variants like rm -rf /, rm -rf *)
    if re.search(r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+|\s+-\w*f\w*\s+|\s+)(-rf|rf|-r\s+-f|--recursive\s+--force)', command, re.IGNORECASE):
        return True, "rm -rf detected — recursive force deletion is blocked"

    # Pattern: DROP TABLE
    if re.search(r'\bDROP\s+TABLE\b', upper):
        return True, "DROP TABLE detected — destructive SQL is blocked"

    # Pattern: git push --force (and variants)
    if re.search(r'\bgit\s+push\s+.*--force\b', command, re.IGNORECASE) or \
       re.search(r'\bgit\s+push\s+.*-f\b', command, re.IGNORECASE):
        return True, "git push --force detected — force push is blocked"

    # Pattern: TRUNCATE
    if re.search(r'\bTRUNCATE\b', upper):
        return True, "TRUNCATE detected — destructive SQL is blocked"

    # Pattern: DELETE FROM without WHERE
    if re.search(r'\bDELETE\s+FROM\b', upper) and not re.search(r'\bWHERE\b', upper):
        return True, "DELETE FROM without WHERE detected — unqualified deletion is blocked"

    return False, ""


def main():
    # Read the tool use request from stdin
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)

    # Only intercept bash tool
    if data.get("tool_name") != "bash":
        sys.exit(0)

    command = data.get("tool_input", {}).get("command", "")
    if not command:
        sys.exit(0)

    blocked, reason = is_destructive(command)
    if blocked:
        project_path = data.get("tool_input", {}).get("working_dir", os.getcwd())
        log_blocked(command, project_path)

        print(f"🚫 BLOCKED: {reason}", file=sys.stderr)
        print(f"   Command: {command}", file=sys.stderr)
        print(f"   This command has been blocked to prevent accidental data loss.", file=sys.stderr)
        sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()