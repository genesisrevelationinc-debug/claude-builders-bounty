#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or destructive operations.
"""

import json
import os
import re
import sys
from datetime import datetime


HOOKS_DIR = os.path.expanduser("~/.claude/hooks")
BLOCKED_LOG = os.path.join(HOOKS_DIR, "blocked.log")


def log_blocked_attempt(command: str, project_path: str):
    """Log a blocked command attempt to the blocked log file."""
    os.makedirs(HOOKS_DIR, exist_ok=True)
    timestamp = datetime.now().isoformat()
    log_entry = f"{timestamp} | project={project_path} | command={command}\n"
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_destructive_bash(command: str) -> tuple[bool, str]:
    """
    Check if a bash command is destructive.
    
    Returns:
        Tuple of (is_blocked, reason)
    """
    # Normalize the command for checking
    normalized = command.strip()
    upper = normalized.upper()
    
    # Pattern 1: rm -rf (recursive force remove)
    if re.search(r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', normalized) or \
       re.search(r'\brm\s+(-[a-zA-Z]*r[a-zA-Z]*\s+)?-[a-zA-Z]*f[a-zA-Z]*\s+', normalized) or \
       re.search(r'\brm\s+.*-[a-zA-Z]*[rf][a-zA-Z]*\s+', normalized):
        return True, "rm -rf detected: recursive force deletion is blocked to prevent data loss"
    
    # Also catch rm -rf without trailing space (e.g., rm -rf /)
    if re.search(r'\brm\s+(-[a-zA-Z]*r[a-zA-Z]*f[a-zA-Z]*|-[a-zA-Z]*f[a-zA-Z]*r[a-zA-Z]*)\b', normalized):
        return True, "rm -rf detected: recursive force deletion is blocked to prevent data loss"
    
    # Pattern 2: DROP TABLE
    if re.search(r'\bDROP\s+TABLE\b', upper):
        return True, "DROP TABLE detected: dropping tables is blocked to prevent data loss"
    
    # Pattern 3: git push --force
    if re.search(r'\bgit\s+push\s+.*--force\b', normalized) or \
       re.search(r'\bgit\s+push\s+.*-f\b', normalized):
        return True, "git push --force detected: force pushing is blocked to prevent overwriting remote history"
    
    # Pattern 4: TRUNCATE
    if re.search(r'\bTRUNCATE\b', upper):
        return True, "TRUNCATE detected: truncating tables is blocked to prevent data loss"
    
    # Pattern 5: DELETE FROM without WHERE clause
    delete_match = re.search(r'\bDELETE\s+FROM\b', upper)
    if delete_match:
        # Check if there's a WHERE clause after DELETE FROM
        after_delete = upper[delete_match.end():]
        if not re.search(r'\bWHERE\b', after_delete):
            return True, "DELETE FROM without WHERE detected: unconditional deletes are blocked to prevent data loss"
    
    return False, ""


def main():
    # Read the hook input from stdin (JSON format per Claude Code hooks spec)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If not valid JSON, allow the tool use to proceed
        sys.exit(0)
    
    # Extract tool name and input parameters
    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})
    
    # Only check bash tool
    if tool_name != "bash":
        sys.exit(0)
    
    # Get the command being executed
    command = tool_input.get("command", "")
    project_path = tool_input.get("project_path", os.getcwd())
    
    # Check if the command is destructive
    is_blocked, reason = is_destructive_bash(command)
    
    if is_blocked:
        log_blocked_attempt(command, project_path)
        print(f"🚫 BLOCKED: {reason}", file=sys.stderr)
        print(f"Attempted command: {command}", file=sys.stderr)
        print("If you need to run this command, please do so manually outside of Claude Code.", file=sys.stderr)
        sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()