#!/usr/bin/env python3
"""Claude Code pre-tool-use hook that blocks destructive bash commands."""

import json
import os
import re
import sys
from datetime import datetime, timezone

LOG_FILE = os.path.expanduser("~/.claude/hooks/blocked.log")

DESTRUCTIVE_PATTERNS = [
    # rm -rf variations
    (re.compile(r'\brm\s+.*-rf\b', re.IGNORECASE),
     "Destructive deletion: 'rm -rf' can irreversibly delete files/directories"),
    (re.compile(r'\brm\s+.*--recursive.*--force\b', re.IGNORECASE),
     "Destructive deletion: 'rm --recursive --force' can irreversibly delete files/directories"),
    (re.compile(r'\brm\s+.*-r\s+.*-f\b', re.IGNORECASE),
     "Destructive deletion: 'rm -r -f' can irreversibly delete files/directories"),
    # DROP TABLE
    (re.compile(r'\bDROP\s+TABLE\b', re.IGNORECASE),
     "Database destruction: 'DROP TABLE' permanently deletes a table and all its data"),
    # TRUNCATE
    (re.compile(r'\bTRUNCATE\s+(TABLE\s+)?\w+\b', re.IGNORECASE),
     "Database destruction: 'TRUNCATE' removes all rows from a table without logging individual deletions"),
    # DELETE FROM without WHERE
    (re.compile(r'\bDELETE\s+FROM\s+\w+\s*(?:;|$)', re.IGNORECASE),
     "Database destruction: 'DELETE FROM' without a WHERE clause removes all rows from the table"),
    (re.compile(r'\bDELETE\s+FROM\s+\w+\s+WHERE\s*$', re.IGNORECASE),
     "Database destruction: 'DELETE FROM' with an empty/incomplete WHERE clause"),
    # git push --force variations
    (re.compile(r'\bgit\s+push\s+.*--force\b', re.IGNORECASE),
     "Destructive git operation: 'git push --force' overwrites remote history and can lose commits"),
    (re.compile(r'\bgit\s+push\s+.*-f\b', re.IGNORECASE),
     "Destructive git operation: 'git push -f' overwrites remote history and can lose commits"),
    (re.compile(r'\bgit\s+push\s+.*--force-with-lease\b', re.IGNORECASE),
     "Potentially destructive git operation: 'git push --force-with-lease' can still overwrite remote history"),
]


def log_blocked(attempted_command: str, project_path: str, reason: str) -> None:
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat()
    entry = (
        f"[{timestamp}] BLOCKED\n"
        f"  Project: {project_path}\n"
        f"  Command: {attempted_command}\n"
        f"  Reason:  {reason}\n"
        f"{'-' * 60}\n"
    )
    with open(LOG_FILE, "a") as f:
        f.write(entry)


def check_command(command: str) -> tuple[bool, str | None]:
    """Check if a command matches any destructive pattern.

    Returns (is_destructive, reason_string).
    """
    for pattern, reason in DESTRUCTIVE_PATTERNS:
        if pattern.search(command):
            return True, reason
    return False, None


def main() -> None:
    """Main entry point: read hook input from stdin, check command, and respond."""
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If we can't parse input, allow the tool to proceed
        sys.exit(0)

    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})

    # Only intercept Bash commands
    if tool_name != "Bash":
        # Allow all other tools to proceed
        print(json.dumps({"continue": True}))
        sys.exit(0)

    command = tool_input.get("command", "")
    if not command:
        print(json.dumps({"continue": True}))
        sys.exit(0)

    project_path = hook_input.get("cwd", os.getcwd())

    is_destructive, reason = check_command(command)

    if is_destructive:
        log_blocked(command, project_path, reason)
        response = {
            "continue": False,
            "reason": reason,
            "message": (
                f"⚠️  BLOCKED DESTRUCTIVE COMMAND\n\n"
                f"The following command was blocked because it could cause irreversible damage:\n\n"
                f"  {command}\n\n"
                f"Reason: {reason}\n\n"
                f"If you are absolutely certain this command is safe and intentional, "
                f"please run it manually outside of Claude Code.\n\n"
                f"This attempt has been logged to: {LOG_FILE}"
            ),
        }
        print(json.dumps(response))
        sys.exit(2)

    # Command is safe — allow it
    print(json.dumps({"continue": True}))
    sys.exit(0)


if __name__ == "__main__":
    main()