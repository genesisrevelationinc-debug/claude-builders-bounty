#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or damage.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


# Path to the log file for blocked commands
BLOCKED_LOG = Path.home() / ".claude" / "hooks" / "blocked.log"

# Destructive patterns to block
# Each pattern is a tuple of (regex, description)
DANGEROUS_PATTERNS = [
    # rm -rf / rm -r -f / rm --recursive --force
    (
        r"rm\s+(?:-\w*[rf]\w*\s+|-+\w+\—recursive\s+\w*\—force\s+|\w*\s+)*",
        "Recursive force delete (rm -rf) - can destroy directories irreversibly",
    ),
    # DROP TABLE
    (
        r"(?i)\bDROP\s+TABLE\b",
        "DROP TABLE - will permanently delete a database table",
    ),
    # git push --force / git push -f
    (
        r"(?i)git\s+push\s+.*(?:--force|-f)\b",
        "Force git push - can overwrite remote history and cause data loss",
    ),
    # TRUNCATE
    (
        r"(?i)\bTRUNCATE\b",
        "TRUNCATE - will permanently delete all rows from a table",
    ),
    # DELETE FROM without WHERE
    (
        r"(?i)\bDELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b)",
        "DELETE FROM without WHERE - will delete all rows from the table",
    ),
]


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt to the log file."""
    BLOCKED_LOG.parent.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = (
        f"[{timestamp}] BLOCKED: {reason}\n"
        f"  Command: {command}\n"
        f"  Project: {project_path}\n"
        f"{'=' * 60}\n"
    )
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """Check if a command matches any dangerous pattern.
    
    Returns:
        tuple of (is_blocked, reason)
    """
    for pattern, description in DANGEROUS_PATTERNS:
        if re.search(pattern, command):
            return True, description
    return False, ""


def main():
    # Read the hook input from stdin (Claude Code passes JSON)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)
    
    # Extract the tool use information
    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})
    
    # Only check bash tool
    if tool_name != "bash":
        sys.exit(0)
    
    command = tool_input.get("command", "")
    
    is_blocked, reason = check_command(command)
    
    if is_blocked:
        log_blocked_attempt(command, reason)
        print(f"🚫 BLOCKED: This command was prevented from running.\n\nReason: {reason}\n\nCommand: {command}", file=sys.stderr)
        sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()