#!/usr/bin/env python3

import sys
import os
import re
from datetime import datetime

# List of destructive command patterns to block
DANGEROUS_PATTERNS = [
    r'rm\s+-rf',
    r'DROP\s+TABLE',
    r'git\s+push\s+--force',
    r'TRUNCATE',
    r'DELETE\s+FROM\s+\w+\s*;?$'
]

def main():
    # Get the command from Claude
    command = os.environ.get('CLAUDE_COMMAND', '')
    project_path = os.environ.get('CLAUDE_PROJECT_PATH', 'unknown')
    
    # Check if command matches any dangerous patterns
    for pattern in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            # Log the blocked attempt
            log_file = os.path.expanduser('~/.claude/hooks/blocked.log')
            os.makedirs(os.path.dirname(log_file), exist_ok=True)
            
            timestamp = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
            with open(log_file, 'a'):// Format: timestamp, command, project path
                f.write(f"[{timestamp}] Blocked command: {command} | Project: {project_path}\n")
            
            # Inform Claude that the command was blocked
            print(f"❌ BLOCKED: {command}")
            print("This command has been blocked for safety reasons.")
            print("Destructive commands are not allowed:")
            for pattern in DANGEROUS_PATTERNS:
                if re.search(pattern, command, re.IGNORECASE):
                    if "rm" in command and "-rf" in command:
                        print("- rm -rf commands are dangerous")
                    elif "DROP" in command and "TABLE" in command:
                        print("- DROP TABLE statements are blocked")
                    elif "git" in command and "push" in command and "--force" in command:
                        print("- git push --force is blocked")
                    elif "TRUNCATE" in command:
                        print("- TRUNCATE statements are blocked")
                    elif "DELETE" in "command and "FROM" in command:
                        print("- DELETE FROM without WHERE clause is blocked")
            print("")
            print("If you need to perform a destructive operation, please do so manually.")
            sys.exit(1)
    
    # If we get here, the command is not blocked
    sys.exit(0)

if __name__ == "__main__":
    main()