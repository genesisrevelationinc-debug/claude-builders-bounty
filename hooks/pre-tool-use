#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or destructive operations.
"""

import json
import os
import re
import sys
from datetime import datetime


# Patterns that should be blocked
DANGEROUS_PATTERNS = [
    # rm -rf pattern (removes directories forcefully and recursively)
    (r'\brm\s+(?:-\S*\s+)?-[^\s]*f', 'rm -rf: Force recursive deletion can destroy data irreversibly'),
    
    # DROP TABLE pattern (deletes entire database tables)
    (r'\bDROP\s+TABLE\b', 'DROP TABLE: This will permanently delete a database table and all its data'),
    
    # git push --force pattern (force overwrites remote history)
    (r'\bgit\s+push\s+(?:-\S*\s+)?--force\b', 'git push --force: This can overwrite remote history and cause data loss for collaborators'),
    
    # TRUNCATE pattern (removes all data from a table)
    (r'\bTRUNCATE\b', 'TRUNCATE: This will delete all data from the table without logging individual row deletions'),
    
    # DELETE FROM without WHERE clause
    (r'\bDELETE\s+FROM\b', 'DELETE FROM without WHERE: This will delete all rows from the table'),
]

# Log file path
LOG_FILE = os.path.expanduser('~/.claude/hooks/blocked.log')


def log_blocked_attempt(command, reason, project_path):
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    log_entry = f"{timestamp} | BLOCKED | Project: {project_path} | Command: {command} | Reason: {reason}\n"
    
    with open(LOG_FILE, 'a') as f:
        f.write(log_entry)


def check_command(command):
    """Check if a command matches any dangerous pattern."""
    command_upper = command.upper()
    
    for pattern, reason in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            # Special check for DELETE FROM without WHERE
            if 'DELETE FROM' in command_upper:
                if 'WHERE' not in command_upper:
                    return reason
            elif 'DELETE' in command_upper and 'FROM' in command_upper:
                if 'WHERE' not in command_upper:
                    return reason
            else:
                return reason
    
    return None


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        hook_input = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # If not valid JSON, allow the command to proceed
        sys.exit(0)
    
    # Extract command from the hook input
    command = hook_input.get('command', '') or hook_input.get('tool_input', {}).get('command', '')
    project_path = hook_input.get('project_path', os.getcwd())
    
    # Check if the command is dangerous
    block_reason = check_command(command)
    if block_reason:
        log_blocked_attempt(command, block_reason, project_path)
        print(f"🛡️  BLOCKED: {block_reason}", file=sys.stderr)
        print(f"Command: {command}", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()