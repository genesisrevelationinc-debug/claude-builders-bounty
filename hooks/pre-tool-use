#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or destructive operations.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


# Patterns that are always blocked (no exceptions)
ALWAYS_BLOCKED = [
    r"rm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+|\s*-)[a-zA-Z0-9/]*",  # rm -rf or rm -f
    r"git\s+push\s+.*--force",  # git push --force
    r"git\s+push\s+.*-f",  # git push -f
    r"DROP\s+TABLE",  # SQL DROP TABLE
    r"TRUNCATE\s+",  # SQL TRUNCATE
]

# Patterns that require a WHERE clause to be safe
DANGEROUS_WITHOUT_WHERE = [
    r"DELETE\s+FROM\s+(\w+)",  # DELETE FROM without WHERE
]


def get_log_file():
    """Get the path to the blocked log file."""
    hooks_dir = Path.home() / ".claude" / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    return hooks_dir / "blocked.log"


def log_blocked_attempt(command, reason):
    """Log a blocked command attempt to the log file."""
    log_file = get_log_file()
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"{timestamp} | BLOCKED: {reason} | Command: {command} | Project: {project_path}\n"
    
    with open(log_file, "a") as f:
        f.write(log_entry)


def is_blocked(command):
    """
    Check if a command should be blocked.
    
    Returns (is_blocked, reason) tuple.
    """
    command_upper = command.upper()
    command_stripped = command.strip()
    
    # Check always blocked patterns
    for pattern in ALWAYS_BLOCKED:
        if re.search(pattern, command, re.IGNORECASE):
            return True, f"Destructive command pattern detected: {pattern}"
    
    # Check DELETE FROM without WHERE
    if re.search(r"DELETE\s+FROM", command, re.IGNORECASE):
        if not re.search(r"WHERE\s+", command, re.IGNORECASE):
            return True, "DELETE FROM without WHERE clause"
    
    return False, None


def main():
    """
    Main entry point for the hook.
    
    Reads the tool use request from stdin and either allows it or blocks it.
    """
    try:
        # Read the tool use request from stdin
        input_data = sys.stdin.read()
        
        # Parse the input as JSON
        try:
            tool_request = json.loads(input_data)
        except json.JSONDecodeError:
            # If not JSON, check the raw string
            tool_request = {"command": input_data}
        
        # Extract the command - handle different possible structures
        command = tool_request.get("command", "")
        if not command and "input" in tool_request:
            command = tool_request["input"].get("command", "")
        
        # Check if the command is blocked
        blocked, reason = is_blocked(command)
        
        if blocked:
            log_blocked_attempt(command, reason)
            print(f"🚫 BLOCKED: This command has been prevented from executing.\n\nReason: {reason}\n\nCommand: {command}\n\nThis is a destructive operation that could cause data loss. If you need to perform this action, please do so manually and with caution.", file=sys.stderr)
            sys.exit(1)
        
    except Exception as e:
        # If anything goes wrong, allow the command to proceed
        # (fail open for safety, but log the error)
        print(f"Warning: Hook error ({e}), allowing command to proceed", file=sys.stderr)
        sys.exit(0)


if __name__ == "__main__":
    main()
--- /dev/null
# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A security hook for Claude Code that intercepts and blocks dangerous bash commands before they can execute.

## What It Blocks

- `rm -rf` / `rm -f` — Recursive/force file deletion
- `git push --force` / `git push -f` — Force git push
- `DROP TABLE` — SQL table deletion
- `TRUNCATE` — SQL table truncation
- `DELETE FROM` without a `WHERE` clause — Unqualified SQL deletion

