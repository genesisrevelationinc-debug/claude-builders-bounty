#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
in Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf (recursive force delete)
    r"rm\s+(?:-\w*[rf]\w*\s+|\s*-r\s+-f\s+|\s*-f\s+-r\s+)",
    r"rm\s+-[a-zA-Z]*[rf]",
    
    # DROP TABLE
    r"(?i)\bDROP\s+TABLE\b",
    
    # git push --force
    r"(?i)git\s+push\s+.*--force",
    r"(?i)git\s+push\s+-f\b",
    
    # TRUNCATE
    r"(?i)\bTRUNCATE\b",
    
    # DELETE FROM without WHERE
    r"(?i)\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b).*",
]


def log_blocked_attempt(command: str, project_path: str):
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    log_entry = f"{timestamp} | {project_path} | {command}\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_dangerous(command: str) -> tuple[bool, str]:
    """Check if a command matches any dangerous pattern."""
    for pattern in DANGEROUS_PATTERNS:
        if re.search(pattern, command):
            return True, pattern
    return False, ""


def main():
    # Read the hook input from stdin (Claude Code hook format)
    try:
        hook_input = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # If we can't parse the input, let it pass through
        sys.exit(0)
    
    # Extract the tool use information
    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})
    
    # Only check bash commands offenses
    if tool_name != "bash" or "command" not in tool_input:
        sys.exit(0)
    
    command = tool_input["command"]
    project_path = hook_input.get("project_path", "unknown")
    
    dangerous, pattern = is_dangerous(command)
    if dangerous:
        log_blocked_attempt(command, project_path)
        print(f"🚫 BLOCKED: This command contains a destructive pattern and has been prevented from executing.\n\nCommand: {command}\n\nReason: This command matches a dangerous pattern that could cause irreversible data loss. If you need to run this command, please do so manually outside of Claude Code.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()