#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime


BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked(command: str, project_path: str):
    """Log a blocked command attempt to the blocked log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    with open(BLOCKED_LOG, "a") as f:
        f.write(f"{timestamp} | {command} | {project_path}\n")


def is_destructive(command: str) -> tuple[bool, str]:
    """
    Check if a command is destructive.
    Returns (is_blocked, reason).
    """
    upper = command.upper()
    lower = command.lower()

    # Pattern: rm -rf (and variants like rm -rfv, rm -fr, etc.)
    if re.search(r'\brm\s+-(?:[a-zA-Z]*[rf])', lower):
        return True, "Blocked: `rm -rf` and variants are destructive and can delete entire directories irreversibly."

    # Pattern: DROP TABLE
    if re.search(r'\bDROP\s+TABLE\b', upper):
        return True, "Blocked: `DROP TABLE` permanently deletes database tables and their data."

    # Pattern: git push --force (and --force-with-lease)
    if re.search(r'\bgit\s+push\s+.*--force', lower):
        return True, "Blocked: `git push --force` overwrites remote history and can cause data loss for the team."

    # Pattern: TRUNCATE
    if re.search(r'\bTRUNCATE\b', upper):
        return True, "Blocked: `TRUNCATE` immediately removes all rows from a table without logging individual row deletions."

    # Pattern: DELETE FROM without WHERE
    if re.search(r'\bDELETE\s+FROM\b', upper) and not re.search(r'\bWHERE\b', upper):
        return True, "Blocked: `DELETE FROM` without a `WHERE` clause deletes all rows in a table."

    return False, ""


def main():
    # Read the hook input from stdin (JSON)
    hook_input = sys.stdin.read()
    
    try:
        data = json.loads(hook_input)
    except json.JSONDecodeError:
        # Not JSON, allow to pass through
        print(hook_input)
        return

    tool_name = data.get("tool_name", "")
    tool_input = data.get("tool_input", {})

    # Only intercept bash tool
    if tool_name != "bash":
        print(hook_input)
        return

    command = tool_input.get("command", "")
    project_path = data.get("project_path", os.getcwd())

    blocked, reason = is_destructive(command)
    if blocked:
        log_blocked(command, project_path)
        print(json.dumps({"error": reason, "blocked": True}))
        sys.exit(1)

    print(hook_input)


if __name__ == "__main__":
    main()