#!/bin/bash

# Pre-tool-use hook to block destructive bash commands

# Configuration
HOOK_DIR="$HOME/.claude/hooks"
LOG_FILE="$HOOK_DIR/blocked.log"

# Create log file if it doesn't exist
touch "$LOG_FILE" 2>/dev/null || true

# Log format: timestamp, command, project path
log_blocked() {
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local command="$1"
    local project_path="${CLAUDE_CODE_PROJECT_PATH:-unknown}"
    echo "[$timestamp] BLOCKED: $command in project: $project_path" >> "$LOG_FILE"
}

# Check for destructive command patterns
is_destructive() {
    local cmd="$1"
    case "$cmd" in
        *"rm -rf"*)
            log_blocked "$cmd"
            echo "Destructive command 'rm -rf' blocked for safety."
            exit 1
            ;;
        *"DROP TABLE"*)
            log_blocked "$cmd"
            echo "Destructive SQL command 'DROP TABLE' blocked for safety."
            exit 1
            ;;
        *"TRUNCATE"*)
            # Check if it's a TRUNCATE command without a WHERE clause
            if [[ "$cmd" != *"WHERE"* ]]; then
                log_blocked "$cmd"
                echo "Destructive SQL command 'TRUNCATE' without WHERE clause blocked for safety."
                exit 1
            fi
            ;;
        *"DELETE FROM"*)
            # Check if it's a DELETE command without a WHERE clause
            if [[ "$cmd" != *"WHERE"* ]]; ] && [[ "$cmd" != *"where"* ]]; then
                log_blocked "$cmd"
                echo "Destructive SQL command 'DELETE' without WHERE clause blocked for safety."
                exit 1
            fi
            ;;
        *"git push --force"*)
            log_blocked "$cmd"
            echo "Destructive command 'git push --force' blocked for safety."
            exit 1
            ;;
        *)
            # No match, allow command to proceed
            echo "$cmd"
            exit 0
            ;;
    esac
}

is_destructive "$1"