#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
and blocks them with a clear explanation.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path

# Path to the log file
BLOCKED_LOG = Path.home() / ".claude" / "hooks" / "blocked.log"

# Destructive patterns to block
# Each pattern is a tuple of (regex, description)
DANGEROUS_PATTERNS = [
    # rm -rf (any variant)
    (
        r"rm\s+(?:-[a-zA-Z]*f[a-zA-Z]*\s+|\s+)*-?[a-zA-Z]*r[a-zA-Z]*\s+",
        "rm -rf: Recursive force delete can destroy directories irreversibly"
    ),
    # DROP TABLE
    (
        r"(?i)\bDROP\s+TABLE\b",
        "DROP TABLE: Permanently deletes a database table and all its data"
    ),
    # git push --force
    (
        r"(?i)git\s+push\s+.*--force",
        "git push --force: Overwrites remote history, potentially losing work"
    ),
    # TRUNCATE
    (
        r"(?i)\bTRUNCATE\b",
        "TRUNCATE: Quickly removes all rows from a table (cannot be rolled back in some DBs)"
    ),
    # DELETE FROM without WHERE
    (
        r"(?i)\bDELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b)",
        "DELETE FROM without WHERE: Deletes all rows from a table without filtering"
    ),
]


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked attempt to the log file."""
    BLOCKED_LOG.parent.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"{timestamp} | {reason} | Command: {command.strip()[:200]} | Project: {project_path}\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def main():
    # Read the hook input from stdin (JSON)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If we can't parse, let it through (fail open for safety)
        sys.exit(0)
    
    # Get the tool use details
    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})
    
    # Only check bash tool
    if tool_name != "bash":
        sys.exit(0)
    
    command = tool_input.get("command", "")
    
(truncated)
    
    # Check against dangerous patterns
    for pattern, description in DANGEROUS_PATTERNS:
        if re.search(pattern, command):
            log_blocked_attempt(command, description)
            print(f"\n⛔ BLOCKED: {description}\n")
            print(f"The following command was prevented from running:\n  {command.strip()}\n")
            print("If you believe this is safe, modify the command or disable the hook temporarily.\n")
            sys.exit(1)
    
    # Command is safe, allow it
    sys.exit(0)


if __name__ == "__main__":
    main()