#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
and blocks them with a clear explanation.
"""

import json
import os
import re
import sys
from datetime import datetime

BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Patterns that are always blocked (destructive operations)
DANGEROUS_PATTERNS = [
    # rm -rf pattern (recursive force delete)
    {
        "pattern": r"rm\s+(?:-[a-zA-Z]*f[a-zA-Z]*\s+)?(?:-[a-zA-Z]*r[a-zA-Z]*\s+)?.*",
        "message": "Blocked: 'rm -rf' or similar force recursive delete. This can irreversibly delete files and directories. Use 'rm' without -rf, or manually review what you're deleting.",
    },
    # DROP TABLE
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "message": "Blocked: 'DROP TABLE' detected. This permanently deletes a database table and all its data. Use ALTER TABLE or backup first if you really need this.",
    },
    # git push --force
    {
        "pattern": r"(?i)git\s+push\s+.*(--force|-f)",
        "message": "Blocked: 'git push --force' detected. Force pushing can overwrite remote history and cause data loss for your team. Use git push without --force, or use --force-with-lease instead.",
    },
    # TRUNCATE
    {
        "pattern": r"(?i)\bTRUNCATE\b",
        "message": "Blocked: 'TRUNCATE' detected. TRUNCATE immediately removes all rows from a table and cannot be rolled back in some databases. Use DELETE with a WHERE clause, or use TRUNCATE only after explicit confirmation.",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)\bDELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b).*",
        "message": "Blocked: 'DELETE FROM' without a WHERE clause. This deletes ALL rows from a table. Add a WHERE clause to specify which rows to delete.",
    },
]


def log_blocked_attempt(command: str, project_path: str):
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    log_entry = f"{timestamp} | project={project_path} | command={command}\n"
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def main():
    # Read the hook input from stdin (JSON format per Claude Code hooks spec)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)

    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})

    # Only intercept Bash tool
    if tool_name != "Bash":
        sys.exit(0)

    command = tool_input.get("command", "")
    project_path = hook_input.get("project_path", os.getcwd())

    for rule in DANGEROUS_PATTERNS:
        if re.search(rule["pattern"], command):
            log_blocked_attempt(command, project_path)
            # Print the blocking message to stderr so Claude sees it
            print(f"\n🛡️  SECURITY HOOK BLOCKED: {rule['message']}\n", file=sys.stderr)
            print(
                f"Attempt logged to: {BLOCKED_LOG}\n",
                file=sys.stderr,
            )
            sys.exit(1)

    # Command is safe, allow it
    SCM sys.exit(0)


if __name__ == "__main__":
    main()

# Claude Code Pre-Tool-Use Hook: Block Destructive Bash Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code/) that intercepts and blocks dangerous bash commands before they execute.

## What It Blocks‑Blocks

| Pattern | Why It's Blocked |
|---|---|
| `rm -rf` / `rm -f` with recursion | Irreversible mass deletion |
| `DROP TABLE` | Permanent table removal |
| `git push --force` | Overwrites remote history, can lose team work |
| `TRUNCATE` | Wipes all table data instantly, often unrecoverable |
| `DELETE FROM` without `WHERE` | Deletes every row in a table |

