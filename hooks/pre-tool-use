#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone

# Path to the blocked log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DESTRUCTIVE_PATTERNS = [
    # rm -rf (recursive force delete)
    {
        "pattern": r"\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+",
        "name": "rm -rf",
        "description": "Recursive force deletion of files/directories",
    },
    # DROP TABLE
    {
        "pattern": r"\bDROP\s+TABLE\b",
        "name": "DROP TABLE",
        "description": "Drops (deletes) a database table",
    },
    # git push --force
    {
        "pattern": r"\bgit\s+push\s+.*--force\b",
        "name": "git push --force",
        "description": "Force pushes to a git repository, overwriting remote history",
    },
    # TRUNCATE
    {
        "pattern": r"\bTRUNCATE\b",
        "name": "TRUNCATE",
        "description": "Removes all rows from a table (cannot be rolled back in some DBs)",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"\bDELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b)",
        "name": "DELETE FROM without WHERE",
        "description": "Deletes all rows from a table without a WHERE clause",
    },
]


def log_blocked_attempt(command: str, project_path: str):
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat()
    log_entry = f"{timestamp} | project={project_path} | command={command}\n"
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def main():
    # Read the hook input from stdin (Claude Code passes JSON)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        sys.exit(0)  # Allow if we can't parse

    # Only check bash tool usage
    if hook_input.get("tool_name") != "bash":
        sys.exit(0)

    command = hook_input.get("tool_input", {}).get("command", "")
    project_path = hook_input.get("project_path", "unknown")

    for rule in DESTRUCTIVE_PATTERNS:
        if re.search(rule["pattern"], command, re.IGNORECASE):
            log_blocked_attempt(command, project_path)
            print(
                f"\n🛡️  BLOCKED: This command was prevented from running.\n"
                f"   Pattern detected: {rule['name']}\n"
                f"   Reason: {rule['description']}\n"
                f"   Command: {command}\n\n"
                f"   If you need to run this command, please use a more specific or safer alternative, "
                f"or disable the hook temporarily by renaming ~/.claude/hooks/pre-tool-use\n",
                file=sys.stderr,
            )
            sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()
# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A `pre-tool-use` hook for [Claude Code](https://docs.anthropic.com/claude-code/) that intercepts and blocks dangerous bash commands before they can execute.

## What it blocks

| Pattern | Why it's blocked |
|---------|-----------------|
| `rm -rf` | Irreversible recursive deletion |
| `DROP TABLE` | Destroys database tables |
| `git push --force` | Overwrites remote git history |
| `TRUNCATE` | Wipes all table data instantly |
| `DELETE FROM` without `WHERE` | Deletes all rows accidentally |

