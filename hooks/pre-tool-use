#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts tool use requests and blocks dangerous bash commands
before they can be executed.
"""

import json
import os
import re
import sys
from datetime import datetime


BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked(command: str, project_path: str):
    """Log a blocked command attempt with timestamp and project path."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    with open(BLOCKED_LOG, "a") as f:
        f.write(f"{timestamp} | {project_path} | {command}\n")


def is_destructive(command: str) -> tuple[bool, str]:
    """
    Check if a bash command is destructive.
    Returns (is_blocked, reason).
    """
    # Pattern: rm -rf (remove recursively and force)
    if re.search(r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', command) or re.search(r'\brm\s+.*\s+-[a-zA-Z]*rf', command):
        if re.search(r'\brm\s+', command):
            return True, "Command 'rm -rf' is blocked to prevent accidental deletion of files/directories."

    # Pattern: DROP TABLE
    if re.search(r'\bDROP\s+TABLE\b', command, re.IGNORECASE):
        return True, "Command 'DROP TABLE' is blocked to prevent accidental deletion of database tables."

    # Pattern: git push --force
    if re.search(r'\bgit\s+push\s+.*--force\b', command) or re.search(r'\bgit\s+push\s+-f\b', command):
        return True, "Command 'git push --force' is blocked to prevent accidental overwrite of remote history."

    # Pattern: TRUNCATE
    if re.search(r'\bTRUNCATE\b', command, re.IGNORECASE):
        return True, "Command 'TRUNCATE' is blocked to prevent accidental deletion of table data."

    # Pattern: DELETE FROM without WHERE
    if re.search(r'\bDELETE\s+FROM\b', command, re.IGNORECASE) and not re.search(r'\bWHERE\b', command, re.IGNORECASE):
        return True, "Command 'DELETE FROM' without a WHERE clause is blocked to prevent accidental deletion of all rows."

    return False, ""


def main():
    # Read the tool use request from stdin
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If not valid JSON, allow through
        sys.exit(0)

    tool_name = data.get("tool_name", "")
    tool_input = data.get("tool_input", {})

    # Only intercept bash tool
    if tool_name == "bash":
        command = tool_input.get("command", "")
        project_path = data.get("project_path", os.getcwd())

        blocked, reason = is_destructive(command)
        if blocked:
            log_blocked(command, project_path)
            print(f"🛡️  BLOCKED: {reason}", file=sys.stderr)
            print(f"Attempted command: {command}", file=sys.stderr)
            sys.exit(1)


if __name__ == "__main__":
    main()