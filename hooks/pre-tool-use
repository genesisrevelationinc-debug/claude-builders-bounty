#!/usr/bin/env python3
"""Claude Code pre-tool-use hook that blocks destructive bash commands."""

import json
import os
import re
import sys
from datetime import datetime, timezone

LOG_FILE = os.path.expanduser("~/.claude/hooks/blocked.log")

DESTRUCTIVE_PATTERNS = [
    (r"rm\s+-rf\b", "rm -rf"),
    (r"DROP\s+TABLE\b", "DROP TABLE"),
    (r"git\s+push\s+--force\b", "git push --force"),
    (r"git\s+push\s+-f\b", "git push --force"),
    (r"TRUNCATE\b", "TRUNCATE"),
    (r"DELETE\s+FROM\b(?!.*\bWHERE\b)", "DELETE FROM without WHERE"),
]


def log_blocked(command: str, project_path: str) -> None:
    """Append a blocked attempt to the log file."""
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat()
    entry = (
        f"[{timestamp}] BLOCKED\n"
        f"  Command: {command}\n"
        f"  Project: {project_path}\n"
        f"{'-' * 60}\n"
    )
    with open(LOG_FILE, "a") as f:
        f.write(entry)


def main() -> None:
    """Read hook input from stdin, check for destructive commands, and respond."""
    try:
        raw = sys.stdin.read()
        if not raw.strip():
            sys.exit(0)

        hook_input = json.loads(raw)
    except json.JSONDecodeError:
        sys.exit(0)

    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})

    # Only intercept Bash commands
    if tool_name != "Bash":
        # Allow all other tools
        print(json.dumps({"continue": True}))
        sys.exit(0)

    command = tool_input.get("command", "")
    project_path = hook_input.get("cwd", os.getcwd())

    for pattern, label in DESTRUCTIVE_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            log_blocked(command, project_path)

            message = (
                f"🚫 BLOCKED: Destructive command detected ({label})\n\n"
                f"Your command was blocked by the pre-tool-use security hook.\n"
                f"The pattern '{label}' was matched in:\n"
                f"  {command}\n\n"
                f"This attempt has been logged to {LOG_FILE}.\n"
                f"Please revise your command to avoid destructive operations."
            )

            # Tell Claude Code to block the tool call and show the message
            print(json.dumps({
                "continue": False,
                "reason": message,
            }))
            sys.exit(0)

    # Command is safe — allow it
    print(json.dumps({"continue": True}))


if __name__ == "__main__":
    main()