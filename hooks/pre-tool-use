#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or destructive operations.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


# Patterns that are always blocked (destructive operations)
BLOCKED_PATTERNS = [
    # rm -rf (recursive force delete)
    r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+.*',
    r'\brm\s+.*\s+-[a-zA-Z]*rf[a-zA-Z]*\b',
    
    # DROP TABLE
    r'(?i)\bDROP\s+TABLE\b',
    
    # git push --force
    r'\bgit\s+push\s+.*--force\b',
    r'\bgit\s+push\s+.*-f\b',
    
    # TRUNCATE
    r'(?i)\bTRUNCATE\b',
    
    # DELETE FROM without WHERE
    r'(?i)\bDELETE\s+FROM\s+\S+\s*;?\s*$',
    r'(?i)\bDELETE\s+FROM\s+\S+\s+(?!WHERE\b).*$',
]

# Compiled patterns for efficiency
COMPILED_PATTERNS = [re.compile(p) for p in BLOCKED_PATTERNS]


def get_log_path() -> Path:
    """Get the path to the blocked attempts log file."""
    hooks_dir = Path(__file__).parent
    return hooks_dir / "blocked.log"


def log_blocked_attempt(command: str, project_path: str) -> None:
    """Log a blocked command attempt with timestamp and project path."""
    log_path = get_log_path()
    timestamp = datetime.now().isoformat()
    
    log_entry = f"[{timestamp}] BLOCKED: {command} | Project: {project_path}\n"
    
    # Append to log file
    with open(log_path, "a") as f:
        f.write(log_entry)


def is_command_blocked(command: str) -> tuple[bool, str]:
    """
    Check if a command matches any blocked pattern.
    Returns (is_blocked, reason).
    """
    for pattern in COMPILED_PATTERNS:
        if pattern.search(command):
            return True, f"Command matches blocked pattern: {pattern.pattern}"
    return False, ""


def main() -> int:
    """Main entry point for the pre-tool-use hook."""
    # Read the tool use request from stdin (Claude Code hook protocol)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If not valid JSON, allow the command to proceed
        return 0
    
    # Extract command from the tool use data
    command = data.get("command", "") if isinstance(data, dict) else ""
    if not command and isinstance(data, dict):
        # Try alternative fields that might contain the command
        command = data.get("input", {}).get("command", "")
    
    if not command:
        return 0
    
    blocked, reason = is_command_blocked(command)
    if blocked:
        project_path = os.getcwd()
        log_blocked_attempt(command, project_path)
        
        # Print clear message to stderr (Claude will see this)
        print(f"\n🛡️  SECURITY HOOK BLOCKED: This command was prevented from executing.\n   Reason: Destructive operation detected ({reason})\n   To override, modify the command or disable the hook.\n", file=sys.stderr)
        return 1  # Non-zero exit code blocks the command
    
    return 0  # Allow the command to proceed


if __name__ == "__main__":
    sys.exit(main())