#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or damage.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path

# Patterns that are considered destructive and should be blocked
DESTRUCTIVE_PATTERNS = [
    # rm -rf / rm -rf *
    {
        "pattern": r"rm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-?[a-zA-Z]*\s+-?rf?\s+|rm\s+(-[a-zA-Z]*r[a-zA-Z]*\s+)?-?[a-zA-Z]*\s+-?rf?\s+|rm\s+-[a-zA-Z]*[rf][a-zA-Z]*\s+",
        "simple_pattern": r"rm\s+.*-[a-zA-Z]*[rf]",
        "name": "rm -rf (recursive force delete)",
    },
    # DROP TABLE
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "name": "DROP TABLE (deletes entire table)",
    },
    # git push --force
    {
        "pattern": r"(?i)git\s+push\s+.*--force\b|git\s+push\s+.*-f\b",
        "name": "git push --force (overwrites remote history)",
    },
    # TRUNCATE
    {
        "pattern": r"(?i)\bTRUNCATE\b",
        "name": "TRUNCATE (removes all table data)",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b).*",
        "name": "DELETE FROM without WHERE (deletes all rows)",
    },
]


def get_log_file():
    """Get the path to the blocked log file."""
    hooks_dir = Path(__file__).parent
    return hooks_dir / "blocked.log"


def log_blocked_attempt(command, project_path):
    """Log a blocked command attempt to the log file."""
    log_file = get_log_file()
    timestamp = datetime.now().isoformat()
    
    log_entry = f"[{timestamp}] COMMAND: {command.strip()} | PROJECT: {project_path}\n"
    
    try:
        with open(log_file, "a") as f:
            f.write(log_entry)
    except Exception as e:
        print(f"Warning: Could not write to log file {log_file}: {e}", file=sys.stderr)


def is_destructive(command):
    """Check if a command matches any destructive pattern."""
    for rule in DESTRUCTIVE_PATTERNS:
        pattern = rule.get("simple_pattern", rule["pattern"])
        if re.search(rule["pattern"], command) or re.search(pattern, command):
            return rule["name"]
    return None


def main():
    # Read the hook input from stdin (Claude Code passes JSON)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        return 0
    
    # Extract the tool use information
    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})
    
    # Only check bash commands
    if tool_name != "bash":
        return 0
    
    command = tool_input.get("command", "")
    project_path = hook_input.get("project_path", os.getcwd())
    
    # Check if the command is destructive
    blocked_reason = is_destructive(command)
    if blocked_reason:
        log_blocked_attempt(command, project_path)
        print(f"\n🚫 BLOCKED: This command was prevented from running.\n", file=sys.stderr)
        print(f"   Reason: {blocked_reason}\n", file=sys.stderr)
        print(f"   Command: {command.strip()}\n", file=sys.stderr)
        print(f"   This hook protects against destructive operations. If you need to run this command, please do so manually outside of Claude Code.\n", file=sys.stderr)
        return 1
    
    return 0


if __name__ == "__main__":
    sys.exit(main())