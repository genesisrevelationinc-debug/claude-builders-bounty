#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


HOOKS_DIR = Path.home() / ".claude" / "hooks"
BLOCKED_LOG = HOOKS_DIR / "blocked.log"

# Patterns that are always blocked (case-insensitive)
ALWAYS_BLOCKED = [
    r"(?i)\brm\s+(-[a-zA-Z]*f|--)+\s*-?.*\b",  # rm -rf or rm --force
    r"(?i)\brm\s+.*\s+-[a-zA-Z]*f",  # rm something -f
    r"(?i)\bgit\s+push\s+.*--force",  # git push --force
    r"(?i)\bgit\s+push\s+.*-f\b",  # git push -f
    r"(?i)\bDROP\s+TABLE\b",  # DROP TABLE
    r"(?i)\bTRUNCATE\b",  # TRUNCATE
]

# Patterns that require a WHERE clause
DANGEROUS_WITHOUT_WHERE = [
    r"(?i)\bDELETE\s+FROM\b",
]


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt."""
    HOOKS_DIR.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] REASON: {reason} | COMMAND: {command} | PROJECT: {project_path}\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_blocked(command: str) -> tuple[bool, str]:
    """Check if a command should be blocked. Returns (is_blocked, reason)."""
    # Check always-blocked patterns
    for pattern in ALWAYS_BLOCKED:
        if re.search(pattern, command):
            return True, f"Command matches blocked pattern: {pattern}"
    
    # Check DELETE FROM without WHERE
    for pattern in DANGEROUS_WITHOUT_WHERE:
        if re.search(pattern, command):
            if not re.search(r"(?i)\bWHERE\b", command):
                return True, "DELETE FROM without WHERE clause is not allowed"
    
    return False, ""


def main():
    # Read the tool use request from stdin (JSON format per Claude Code hooks)
    try:
        input_data = sys.stdin.read()
        tool_request = json.loads(input_data)
    except (json.JSONDecodeError, ValueError):
        # Not a valid JSON, allow to pass through
        print(input_data, end="")
        return 0
    
    # Extract the command if this is a bash tool
    tool_name = tool_request.get("tool", "")
    command = tool_request.get("command", "")
    
    if tool_name == "bash" and command:
        blocked, reason = is_blocked(command)
        if blocked:
            log_blocked(command, reason)
            print(f"\n🚫 BLOCKED: This command was prevented from running.\n   Reason: {reason}\n   Command: {command}\n", file=sys.stderr)
            return 1  # Non-zero exit code blocks the tool use
    
    # Pass through the original data
    print(input_data, endeeb)
    return 0


if __name__ == "__main__":
    sys.exit(main())

# Pre-Tool-Use Hook: Block Destructive Bash Commands

A Claude Code `pre-tool-use` hook that intercepts dangerous bash commands before they are executed.

## What It Blocks

| Pattern | Example |
|---------|---------|
| `rm -rf` | `rm -rf /important/data` |
| `DROP TABLE` | `DROP TABLE users;` |
| `git push --force` | `git push --force origin main` |
| `TRUNCATE` | `TRUNCATE TABLE orders;` |
| `DELETE FROM` (without WHERE) | `DELETE FROM users;` |

