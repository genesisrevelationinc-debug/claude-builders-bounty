#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone

# Patterns that indicate destructive commands
DESTRUCTIVE_PATTERNS = [
    # rm -rf (recursive force delete)
    (r'\brm\s+(-[a-zA-Z]*\s+)*-?[a-zA-Z]*rf', 'rm -rf: Recursive force deletion'),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', 'DROP TABLE: Database table deletion'),
    # git push --force
    (r'\bgit\s+push\s+.*--force\b', 'git push --force: Force push to remote'),
    (r'\bg\s+push\s+.*--force\b', 'git push --force: Force push to remote'),
    # TRUNCATE
    (r'\bTRUNCATE\b', 'TRUNCATE: Table data removal'),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+(?!\s+WHERE\b)', 'DELETE FROM without WHERE: Unconditional data deletion'),
]

def get_log_path():
    """Get the path for the blocked log file."""
    hooks_dir = os.path.dirname(os.path.abspath(__file__))
    return os.path.join(hooks_dir, 'blocked.log')

def log_blocked_attempt(command, reason, project_path):
    """Log a blocked command attempt to the log file."""
    log_path = get_log_path()
    timestamp = datetime.now(timezone.utc).isoformat()
    
    log_entry = (
        f"[{timestamp}] BLOCKED: {reason}\n"
        f"  Command: {command}\n"
        f"  Project: {project_path}\n"
        f"{'=' * 60}\n"
    )
    
    # Ensure log file exists
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    
    with open(log_path, 'a') as f:
        f.write(log_entry)

def check_command(command):
    """Check if a command matches any destructive pattern."""
    command_upper = command.upper()
    
    for pattern, reason in DESTRUCTIVE_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return reason
    
    return None

def main():
    # Read the hook input from stdin (JSON)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, let it pass
        sys.exit(0)
    
    # Only check bash tool usage
    tool_name = hook_input.get('tool_name', '')
    if tool_name != 'bash':
        sys.exit(0)
    
    command = hook_input.get('tool_input', {}).get('command', '')
    project_path = hook_input.get('project_path', os.getcwd())
    
    # Check for destructive patterns
    block_reason = check_command(command)
    if block_reason:
        log_blocked_attempt(command, block_reason, project_path)
        print(f"🛡️  BLOCKED: {block_reason}", file=sys.stderr)
        print(f"   Command: {command}", file=sys.stderr)
        print(f"   This destructive command has been blocked for safety. Please use a safer alternative or confirm your intent.", file=sys.stderr)
        sys.exit(1)

if __name__ == '__main__':
    main()