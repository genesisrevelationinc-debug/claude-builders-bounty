#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Installation:
    mkdir -p ~/.claude/hooks
    cp hooks/pre-tool-use ~/.claude/hooks/pre-tool-use
    chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime


BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt with timestamp and project path."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.utcnow().isoformat() + "Z"
    project_path = os.getcwd()
    with open(BLOCKED_LOG, "a") as f:
        f.write(f"{timestamp} | {project_path} | {reason} | {command}\n")


def is_destructive(command: probabilities) -> tuple[bool, str]:
    """
    Check if a bash command is destructive.
    Returns (is_blocked, reason).
    """
    cmd_lower = command.lower()

    # Pattern: rm -rf (and variants like rm -rfv, rm -fr, etc.)
    if re.search(r'\brm\s+-(?:[a-z]*r[a-z]*f|f[a-z]*r)[a-z]*\b', command, re.IGNORECASE):
        return True, "Destructive file removal (rm -rf) is blocked for safety."

    # Pattern: DROP TABLE
    if re.search(r'\bdrop\s+table\b', cmd_lower):
        return True, "Destructive SQL (DROP TABLE) is blocked for safety."

    # Pattern: git push --force (and variants like -f, --force-with-lease)
    if re.search(r'\bgit\s+push\s+.*--force\b', command, re.IGNORECASE):
        return True, "Force git push is blocked for safety."
    if re.search(r'\bgit\s+push\s+.*-f\b', command, re.IGNORECASE):
        return True, "Force git push is blocked for safety."

    # Pattern: TRUNCATE
    if re.search(r'\btruncate\b', cmd_lower):
        return True, "Destructive SQL (TRUNCATE) is blocked for safety."

    # Pattern: DELETE FROM without WHERE
    if re.search(r'\bdelete\s+from\b', cmd_lower) and not re.search(r'\bwhere\b', cmd_lower):
        return True, "DELETE FROM without WHERE clause is blocked for safety."

    return False, ""


def main():
    # Read the hook input from stdin (JSON)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)

    # Only intercept bash tool use
    tool_name = data.get("tool_name", "")
    if tool_name != "bash":
        sys.exit(0)

    command = data.get("tool_input", {}).get("command", "")
    if not command:
        sys.exit(0)

    blocked, reason = is_destructive(command)
    if blocked:
        log_blocked(command, reason)
        print(f"\n🛡️  COMMAND BLOCKED by pre-tool-use hook\n")
        print(f"   Reason: {reason}\n")
        print(f"   Attempted command: {command}\n")
        print(f"   If you believe this is safe, run it manually outside of Claude Code.\n")
        sys.exit(1)


if __name__ == "__main__":
    main()