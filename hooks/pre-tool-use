#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Patterns that are always blocked
ALWAYS_BLOCKED = [
    r"rm\s+(-[a-zA-Z]*\s+)*-?[a-zA-Z]*f[a-zA-Z]*\s+.*",  # rm -rf or similar
    r"git\s+push\s+.*(--force|-f)\b",  # git push --force
    r"\bDROP\s+TABLE\b",  # DROP TABLE
    r"\bTRUNCATE\b",  # TRUNCATE
]

# Patterns that require a WHERE clause
DANGEROUS_WITHOUT_WHERE = [
    r"\bDELETE\s+FROM\b",
]


def log_blocked(command: str, reason: str):
    """Log a blocked command attempt."""
    timestamp = datetime.utcnow().isoformat() + "Z"
    project_path = os.getcwd()
    
    log_entry = f"{timestamp} | {reason} | {command} | {project_path}\n"
    
    # Ensure the log directory exists
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def is_blocked(command: str) -> tuple[bool, str]:
    """Check if a command should be blocked. Returns (is_blocked, reason)."""
    command_upper = command.upper()
    
    # Check always-blocked patterns
    for pattern in ALWAYS_BLOCKED:
        if re.search(pattern, command, re.IGNORECASE):
            return True, f"Destructive command pattern detected: matches '{pattern}'"
    
    # Check DELETE FROM without WHERE
    for pattern in DANGEROUS_WITHOUT_WHERE:
        if re.search(pattern, command, re.IGNORECASE):
            # Check if there's a WHERE clause
            if not re.search(r"\bWHERE\b", command_upper):
                return True, "DELETE FROM without WHERE clause is dangerous and blocked"
    
    return False, ""


def main():
    # Read the hook payload from stdin
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If we can't parse the input, let it through
        sys.exit(0)
    
    # Only intercept bash tool usage
    tool_name = payload.get("tool_name", "")
    if tool_name != "bash":
        sys.exit(0)
    
    command = payload.get("tool_input", {}).get("command", "")
    if not command:
        sys.exit(0)
    
    blocked, reason = is_blocked(command)
    if blocked:
        log_blocked(command, reason)
        print(f"🛡️  BLOCKED: This command was prevented from running.\n\nReason: {reason}\n\nCommand: {command}", file=sys.stderr)
        sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()

# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code) that intercepts and blocks dangerous bash commands before they execute.

## What It Blocks

| Pattern | Example |
|---------|---------|
| `rm -rf` | `rm -rf /important` |
| `DROP TABLE` | `DROP TABLE users;` |
| `TRUNCATE` | `TRUNCATE TABLE orders;` |
| `DELETE FROM` (without `WHERE`) | `DELETE FROM users;` |
| `git push --force` | `git push --force origin main` |

