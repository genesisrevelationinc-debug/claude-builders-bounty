#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the blocked log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf (recursive force delete)
    (r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', "rm -rf: Recursive force deletion is dangerous"),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', "DROP TABLE: Dropping tables is destructive"),
    # git push --force
    (r'\bgit\s+push\s+.*--force\b', "git push --force: Force pushing can overwrite remote history"),
    (r'\bgit\s+push\s+.*-f\b', "git push --force: Force pushing can overwrite remote history"),
    # TRUNCATE
    (r'\bTRUNCATE\s+', "TRUNCATE: Truncating tables is destructive"),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+\s*;?\s*$', "DELETE FROM without WHERE: Deleting all rows without a WHERE clause is destructive"),
    (r'\bDELETE\s+FROM\s+\S+\s+(?!WHERE\b)', "DELETE FROM without WHERE: Deleting all rows without a WHERE clause is destructive"),
]


def log_blocked(command, reason):
    """Log a blocked command to the blocked log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason}\n  Command: {command}\n  Project: {project_path}\n"
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command):
    """Check if a command matches any dangerous pattern."""
    command_upper = command.upper()
    
    for pattern, reason in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return reason
    
    return None


def main():
    # Read the tool use data from stdin (Claude Code hook format)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not JSON, pass through
        return 0
    
    # Check if this is a bash tool
    tool_name = data.get("tool_name", "")
    if tool_name != "bash":
        return 0
    
    command = data.get("command", "")
    
    # Check for dangerous patterns
    block_reason = check_command(command)
    if block_reason:
        log_blocked(command, block_reason)
        print(f"🚫 BLOCKED: {block_reason}", file=sys.stderr)
        print(f"   Command: {command}", file=sys.stderr)
        print(f"   This destructive command has been blocked for safety.", file=sys.stderr)
        return 1
    
    return 0


if __name__ == "__main__":
    sys.exit(main())