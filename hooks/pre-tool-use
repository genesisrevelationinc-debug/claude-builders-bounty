#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss.
"""

import json
import os
import re
import sys
from datetime import datetime, timezone

# Path to the log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf (recursive force delete)
    r"rm\s+(?:-[a-zA-Z]*r[a-zA-Z]*\s+.*-[a-zA-Z]*f|-[a-zA-Z]*f[a-zA-Z]*\s+.*-[a-zA-Z]*r|--recursive\s+.*--force|--force\s+.*--recursive)\s",
    r"rm\s+-[a-zA-Z]*[rf][a-zA-Z]*\s",
    r"rm\s+.*-rf\s",
    r"rm\suniq\s+-rf\s",
    # DROP TABLE
    r"(?i)\bDROP\s+TABLE\b",
    # git push --force
    r"(?i)git\s+push\s+.*--force",
    r"(?i)git\s+push\s+-f\b",
    # TRUNCATE
    r"(?i)\bTRUNCATE\s+",
    # DELETE FROM without WHERE
    r"(?i)\bDELETE\s+FROM\s+.+((?!WHERE).)*$",
]


def log_blocked(command: str, project_path: str):
    """Log a blocked command attempt."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat()
    with open(BLOCKED_LOG, "a") as f:
        f.write(f"{timestamp} | {project_path} | {command}\n")


def is_dangerous(command: str) -> tuple[bool, str]:
    """Check if a command matches any dangerous pattern."""
    for pattern in DANGEROUS_PATTERNS:
        if re.search(pattern, command):
            return True, pattern
    return False, ""


def main():
    # Read the hook input from stdin (JSON format per Claude Code hooks spec)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)

    # Extract the command being executed
    command = data.get("command", "") or data.get("tool_input", {}).get("command", "")
    project_path = data.get("project_path", os.getcwd())

    if not command:
        sys.exit(0)

    dangerous, pattern = is_dangerous(command)
    if dangerous:
        log_blocked(command, project_path)
        print(f"🚫 BLOCKED: This command was prevented from running.", file=sys.stderr)
        print(f"   Command: {command}", file=sys.stderr)
        print(f"   Reason: Matches dangerous pattern '{pattern}'", file=sys.stderr)
        print(f"   This hook protects against destructive operations like rm -rf, DROP TABLE, git push --force, TRUNCATE, and DELETE without WHERE.", file=sys.stderr)
        sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()