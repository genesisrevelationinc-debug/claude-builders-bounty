#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook that blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import re
import sys
from datetime import datetime
from pathlib import Path


BLOCKED_PATTERNS = [
    # rm -rf (destructive recursive force remove)
    {
        "pattern": r"rm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?(-[a-zA-Z]*r[a-zA-Z]*\s+)?-?[a-zA-Z]*rf",
        "description": "rm -rf: Recursive force delete that can destroy directories and data",
    },
    # DROP TABLE
    {
        "pattern": r"(?i)\bdrop\s+table\b",
        "description": "DROP TABLE: Permanently deletes a database table and all its data",
    },
    # git push --force
    {
        "pattern": r"git\s+push\s+.*(--force|-f)(\s|$)",
        "description": "git push --force: Overwrites remote history, potentially deleting others' work",
    },
    # TRUNCATE
    {
        "pattern": r"(?i)\btruncate\b",
        "description": "TRUNCATE: Quickly removes all rows from a table (often non-transactional)",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)delete\s+from\s+\S+\s*(?!.*\bwhere\b)",
        "description": "DELETE FROM without WHERE: Deletes all rows from a table without filtering",
    },
]


def get_log_path():
    """Get the path to the blocked attempts log file."""
    return Path.home() / ".claude" / "hooks" / "blocked.log"


def log_blocked_attempt(command, project_path):
    """Log a blocked command attempt with timestamp and project path."""
    log_path = get_log_path()
    log_path.parent.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    log_entry = f"[{timestamp}] project={project_path} command={command}\n"
    
    with open(log_path, "a") as f:
        f.write(log_entry)


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        hook_input = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # Not a valid JSON input, allow to proceed
        sys.exit(0)
    
    # Extract the command from the tool use
    command = hook_input.get("command", "") or hook_input.get("tool_input", {}).get("command", "")
    project_path = hook_input.get(" pathname", str(Path.cwd()))
    
    if not command:
        sys.exit(0)
    
    # Check against blocked patterns
    for rule in BLOCKED_PATTERNS:
        if re.search(rule["pattern"], command):
            log_blocked_attempt(command, project_path)
            print(f"🚫 BLOCKED: This command was prevented from running.", file=sys.stderr)
            print(f"   Reason: {rule['description']}", file=sys.stderr)
            print(f"   Command: {command}", file=sys.stderr)
            print(f"   If you need to run this, please review the command and use a safer alternative.", file=sys.stderr)
            sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()