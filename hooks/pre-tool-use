#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

This hook intercepts dangerous bash commands before they are executed
by Claude Code, preventing accidental data loss or destructive operations.
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


# Patterns that are always blocked (no exceptions)
ALWAYS_BLOCKED = [
    r'\brm\s+-rf?\b',
    r'\brm\s+-fr?\b',
    r'\bDROP\s+TABLE\b',
    r'\bTRUNCATE\b',
]

# Patterns that require a WHERE clause
REQUIRES_WHERE = [
    r'\bDELETE\s+FROM\b',
]

# Patterns that are blocked with specific flags
FLAG_BLOCKED = [
    (r'\bgit\s+push\b', r'--force'),
]


def get_log_path() -> Path:
    """Get the path to the blocked log file."""
    hooks_dir = Path.home() / '.claude' / 'hooks'
    hooks_dir.mkdir(parents=True, exist_ok=True)
    return hooks_dir / 'blocked.log'


def log_blocked(command: str, reason: str) -> None:
    """Log a blocked command attempt with timestamp and project path."""
    log_path = get_log_path()
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"{timestamp} | {reason} | {command} | {project_path}\n"
    
    with open(log_path, 'a') as f:
        f.write(log_entry)


def is_blocked(command: str) -> tuple[bool, str]:
    """Check if a command should be blocked. Returns (is_blocked, reason)."""
    command_upper = command.upper()
    
    # Check always blocked patterns
    for pattern in ALWAYS_BLOCKED:
        if re.search(pattern, command, re.IGNORECASE):
            return True, f"Destructive command blocked: matches pattern '{pattern}'"
    
    # Check DELETE FROM without WHERE
    for pattern in REQUIRES_WHERE:
        if re.search(pattern, command, re.IGNORECASE):
            if not re.search(r'\bWHERE\b', command_upper):
                return True, "DELETE FROM without WHERE clause is not allowed"
    
    # Check git push --force patterns
    for base_pattern, flag in FLAG_BLOCKED:
        if re.search(base_pattern, command, re.IGNORECASE):
            if re.search(flag, command):
                return True, f"git push with {flag} is not allowed"
    
    return False, ""


def main() -> None:
    """Main entry point for the hook."""
    # Read the tool use data from stdin (Claude Code hook protocol)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a JSON input, pass through
        sys.exit(0)
    
    # Check if this is a bash tool
    if data.get('tool_name') == 'bash':
        command = data.get('tool_input', {}).get('command', '')
        
        blocked, reason = is_blocked(command)
        if blocked:
            log_blocked(command, reason)
            print(f"\n🚫 BLOCKED: {reason}", file=sys.stderr)
            print(f"   Command: {command}", file=sys.stderr)
            print("   This destructive command has been prevented for your safety.\n", file=sys.stderr)
            sys.exit(1)


if __name__ == '__main__':
    main()
# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code/) that intercepts and blocks dangerous bash commands before they can execute.

## What It Blocks

| Pattern | Example | Why |
|---------|---------|-----|
| `rm -rf` | `rm -rf /important` | Irreversible deletion |
| `DROP TABLE` | `DROP TABLE users` | Database destruction |
| `TRUNCATE` | `TRUNCATE TABLE orders` | Mass data deletion |
| `DELETE FROM` (no WHERE) | `DELETE FROM users` | Accidental full-table delete |
| `git push --force` | `git push --force origin main` | Overwrites remote history |

