#!/bin/bash

# Check for destructive commands
dangerous_patterns=("rm -rf" "DROP TABLE" "git push --force" "TRUNCATE" "DELETE FROM")
for pattern in "${dangerous_patterns[@]}"; do
    if [[ $* == *"$pattern"* ]]; then
        echo "CLAUDE: Blocked dangerous command detected: $pattern"
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Blocked: $*" >> ~/.claude/hooks/blocked.log
        exit 1
    fi
done

echo "CLAUDE: No destructive commands detected. Command allowed: $*"
exit 0