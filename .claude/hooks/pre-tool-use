#!/usr/bin/env python3
"""
Pre-tool-use hook for Claude Code that blocks destructive bash commands.

Installation:
    mkdir -p ~/.claude/hooks
    cp pre-tool-use ~/.claude/hooks/
    chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path


# Patterns that should be blocked
DANGEROUS_PATTERNS = [
    # rm -rf (remove recursively and force)
    {
        "pattern": r"rm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?(-[a-zA-Z]*r[a-zA-Z]*\s+)?\s*-?rf?\s",
        "name": "rm -rf (recursive force delete)",
    },
    # DROP TABLE
    {
        "pattern": r"(?i)\bDROP\s+TABLE\b",
        "name": "DROP TABLE (delete database table)",
    },
    # git push --force
    {
        "pattern": r"(?i)git\s+push\s+.*(--force|-f)",
        "name": "git push --force (force push)",
    },
    # TRUNCATE
    {
        "pattern": r"(?i)\bTRUNCATE\b",
        "name": "TRUNCATE (delete all table data)",
    },
    # DELETE FROM without WHERE
    {
        "pattern": r"(?i)\bDELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b)",
        "name": "DELETE FROM without WHERE (unconditional delete)",
    },
]


def get_log_path() -> Path:
    """Get the path to the blocked log file."""
    hooks_dir = Path(os.environ.get("CLAUDE_HOOKS_DIR", Path.home() / ".claude" / "hooks"))
    return hooks_dir / "blocked.log"


def log_blocked_attempt(command: str, reason: str) -> None:
    """Log a blocked attempt to the log file."""
    log_path = get_log_path()
    log_path.parent.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason}\n  Command: {command}\n  Project: {project_path}\n\n"
    
    with open(log_path, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """Check if a command is dangerous. Returns (is_blocked, reason)."""
    for rule in DANGEROUS_PATTERNS:
        if re.search(rule["pattern"], command):
            return True, rule["name"]
    return False, ""


def main() -> int:
    """Main entry point for the hook."""
    # Read the tool use data from stdin (Claude Code hook protocol)
    try:
        data = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        return 0  # Allow if we can't parse
    
    # Only check bash tool
    if data.get("tool_name") != "bash":
        return 0
    
    command = data.get("command", "")
    
    is_blocked, reason = check_command(command)
    if is_blocked:
        log_blocked_attempt(command, reason)
        print(f"\n🛡️  SECURITY BLOCK: This command was prevented from running.\n\nReason: {reason}\nCommand: {command}\n\nThis destructive operation has been logged. If you need to run this command, please do so manually outside of Claude Code.\n", file=sys.stderr)
        return 1  # Block the command
    
    return 0  # Allow the command


if __name__ == "__main__":
    sys.exit(main())

# Pre-Tool-Use Hook: Block Destructive Bash Commands

A Claude Code `pre-tool-use` hook that intercepts and blocks dangerous bash commands before they can be executed.

## Blocked Patterns

| Pattern | Description |
|---------|-------------|
| `rm -rf` | Recursive force deletion |
| `DROP TABLE` | SQL table deletion |
| `git push --force` | Force git push |
| `TRUNCATE` | Unconditional table data deletion |
| `DELETE FROM` without `WHERE` | Unconditional row deletion |

