#!/usr/bin/env python3
"""
Pre-tool-use hook for Claude Code that blocks destructive bash commands.
"""

import json
import os
import re
import sys
from datetime import datetime


BLOCKED_PATTERNS = [
    # rm -rf / rm -r / rm -f (destructive recursive/force removal)
    (r'\brm\s+-(?:[a-zA-Z]*[rf])', 'rm -rf / recursive force removal'),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', 'DROP TABLE (database destruction)'),
    # git push --force / git push -f
    (r'\bgit\s+push\s+(?:--force|-f)\b', 'git push --force (destructive force push)'),
    # TRUNCATE
    (r'\bTRUNCATE\b', 'TRUNCATE (table data destruction)'),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\w+\s*$', 'DELETE FROM without WHERE clause'),
]

LOG_FILE = os.path.expanduser('~/.claude/hooks/blocked.log')


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked command attempt with timestamp and project path."""
    timestamp = datetime.utcnow().isoformat() + 'Z'
    project_path = os.getcwd()
    
    log_entry = f"[{timestamp}] BLOCKED: {reason} | Command: {command} | Project: {project_path}\n"
    
    # Ensure the hooks directory exists
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    
    with open(LOG_FILE, 'a') as f:
        f.write(log_entry)


def main():
    # Read the hook input from stdin (Claude Code passes tool use info as JSON)
    try:
        hook_input = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        # Not a valid JSON input, allow to proceed
        sys.exit(0)
    
    # Check if this is a bash tool use
    tool_name = hook_input.get('tool_name', '')
    if tool_name != 'Bash':
        sys.exit(0)
    
    # Get the command being executed
    command = hook_input.get('tool_input', {}).get('command', '')
    if not command:
        sys.exit(0)
    
    # Check against blocked patterns
    for pattern, reason in BLOCKED_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            log_blocked_attempt(command, reason)
            print(f"🚫 BLOCKED: This command was prevented from running for security reasons.", file=sys.stderr)
            print(f"   Reason: {reason}", file=sys.stderr)
            print(f"   Command: {command}", file=sys.stderr)
            print(f"   If you need to run this command, please do so manually outside of Claude Code.", file=sys.stderr)
            sys.exit(1)
    
    sys.exit(0)


if __name__ == '__main__':
    main()