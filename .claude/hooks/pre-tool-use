#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.

Installation:
    mkdir -p ~/.claude/hooks
    cp pre-tool-use ~/.claude/hooks/pre-tool-use
    chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime

# Path to the log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
# Each tuple: (pattern, description)
DESTRUCTIVE_PATTERNS = [
    # rm -rf (and variants like rm -rf /, rm -rf ., etc.)
    (r'\brm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?-[a-zA-Z]*r[a-zA-Z]*\s+', "rm -rf: recursively and forcefully removes files/directories"),
    
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', "DROP TABLE: permanently deletes a database table"),
    
    # git push --force (and variants)
    (r'\bgit\s+push\s+.*--force\b', "git push --force: overwrites remote history, potentially losing work"),
    (r'\bgit\s+push\s+.*-f\b', "git push -f: overwrites remote history, potentially losing work"),
    
    # TRUNCATE
    (r'\bTRUNCATE\s+TABLE?\b', "TRUNCATE: quickly removes all rows from a table (cannot be rolled back in some DBs)"),
    (r'\bTRUNCATE\b', "TRUNCATE: quickly removes all rows from a table (cannot be rolled back in some DBs)"),
    
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\s+\S+\s*;?\s*$', "DELETE FROM without WHERE: deletes all rows from a table"),
    (r'\bDELETE\s+FROM\s+\S+\s*(?!.*\bWHERE\b).*$', "DELETE FROM without WHERE: deletes all rows from a table"),
]


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now().isoformat()
    project_path = os.getcwd()
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(f"[{timestamp}] BLOCKED: {reason}\n")
        f.write(f"  Command: {command}\n")
        f.write(f"  Project: {project_path}\n")
        f.write("-" * 60 + "\n")


def main():
    # Read the tool use request from stdin (JSON)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not JSON, allow through
        sys.exit(0)
    
    # Only check bash tool
    if data.get("tool_name") != "bash":
        sys.exit(0)
    
    command = data.get("command", "")
    
    for pattern, description in DESTRUCTIVE_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            log_blocked_attempt(command, description)
            print(f"\n🛡️  BLOCKED: Destructive command detected!\n\nReason: {description}\nCommand: {command}\n\nThis command has been blocked to prevent accidental data loss. If you need to run this command, please do so manually outside of Claude Code.", file=sys.stderr)
            sys.exit(1)


if __name__ == "__main__":
    main()
# Pre-Tool-Use Hook: Block Destructive Bash Commands

A Claude Code `pre-tool-use` hook that intercepts and blocks dangerous bash commands before they are executed.

## What It Blocks

- `rm -rf` — recursively and forcefully removes files/directories
- `DROP TABLE` — permanently deletes database tables
- `git push --force` / `git push -f` — overwrites remote history
- `TRUNCATE` — quickly removes all rows from a table
- `DELETE FROM` without a `WHERE` clause — deletes all rows from a table

