#!/bin/bash

# This is a pre-tool-use hook that blocks destructive bash commands in Claude Code
# Save this file as: ~/.claude/hooks/pre-tool-use

# What it blocks:
# - rm -rf commands
# - SQL DROP TABLE statements  
# - git push --force commands
# - SQL TRUNCATE commands
# - SQL DELETE statements without WHERE clauses

set -euo pipefail

# Read input from Claude Code (first argument is the command, second is project path)
command_to_check="${1:-}"
project_path="${2:-}"

# Define dangerous patterns to block
blocked_patterns=(
    "rm -rf"
    "DROP TABLE"
    "git push --force"
    "TRUNCATE"
    "DELETE FROM"
)

# Check if command contains any blocked patterns
for pattern in "${blocked_patterns[@]}"; do
    if [[ "$command_to_check" == *"$pattern"* ]]; then
        timestamp=$(date -Iseconds)
        echo "[$timestamp] BLOCKED: $command_to_check (Project: $project_path)" >> ~/.claude/hooks/blocked.log 2>&1
        echo "This command has been blocked as it contains potentially destructive operations." >&2
        exit 1
    fi
done

# Log allowed commands
echo "[$(date -Iseconds)] ALLOWED: $command_to_check (Project: $project_path)" >> ~/.claude/hooks/allowed.log 2>&1