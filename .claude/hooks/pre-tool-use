#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: Blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from datetime import datetime, timezone

# Path to the blocked log file
BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

# Destructive patterns to block
DANGEROUS_PATTERNS = [
    # rm -rf / rm -r / rm -f (destructive recursive/force remove)
    (r'\brm\s+(-[a-zA-Z]*[rf]|[rf])\b', "rm -rf / recursive force delete"),
    # DROP TABLE
    (r'\bDROP\s+TABLE\b', "DROP TABLE"),
    # git push --force / git push -f
    (r'\bgit\s+push\s+.*(--force\b|-f\b)', "git push --force"),
    # TRUNCATE
    (r'\bTRUNCATE\b', "TRUNCATE"),
    # DELETE FROM without WHERE
    (r'\bDELETE\s+FROM\b', "DELETE FROM without WHERE"),
]


def log_blocked(command: str, reason: str, project_path: str):
    """Log a blocked command attempt to the log file."""
    os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
    timestamp = datetime.now(timezone.utc).isoformat()
    log_entry = f"[{timestamp}] BLOCKED: {reason} | Command: {command!r} | Project: {project_path}\n"
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def main():
    # Read the hook input from stdin (JSON)
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        # Not a valid JSON, pass through
        sys.exit(0)

    tool_name = data.get("tool_name", "")
    tool_input = data.get("tool_input", {})

    # Only intercept bash tool
    if tool_name != "bash":
        sys.exit(0)

    command = tool_input.get("command", "")
    if not command:
        sys.exit(0)

    project_path = data.get("project_path", os.getcwd())

    # Check against dangerous patterns
    for pattern, description in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            log_blocked(command, description, project_path)
            print(
                f"\n🚫 BLOCKED: This command was prevented from running.\n"
                f"   Reason: {description}\n"
                f"   Command: {command}\n\n"
                f"   If you believe this is safe, please review the command manually.\n"
                f"   For assistance, check the blocked log at: {BLOCKED_LOG}\n",
                file=sys.stderr,
            )
            sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()