#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook: blocks destructive bash commands.

Place this file at: ~/.claude/hooks/pre-tool-use
Make it executable: chmod +x ~/.claude/hooks/pre-tool-use

Blocks these patterns:
- rm -rf
- DROP TABLE
- git push --force
- TRUNCATE
- DELETE FROM without WHERE clause
"""

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path

# Path to the log file for blocked attempts
BLOCKED_LOG = Path.home() / ".claude" / "hooks" / "blocked.log"

# Destructive patterns to block
# Each pattern is a tuple: (regex, description)
DESTRUCTIVE_PATTERNS = [
    # rm -rf (and variants like rm -rf /, rm -rf *)
    (r"\brm\s+(-[a-zA-Z]*\s+)*-rf?\b|\brm\s+-[a-zA-Z]*f[a-zA-Z]*r", "rm -rf (recursive force delete)"),
    # DROP TABLE
    (r"\bDROP\s+TABLE\b", "DROP TABLE (deletes database table)"),
    # git push --force (and -f)
    (r"\bgit\s+push\s+.*--force\b|\bgit\s+push\s+.*\s-f\b", "git push --force (force overwrite remote)"),
    # TRUNCATE
    (r"\bTRUNCATE\b", "TRUNCATE (removes all table data)"),
    # DELETE FROM without WHERE
    (r"\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b).*", "DELETE FROM without WHERE (deletes all rows)"),
]


def log_blocked_attempt(command: str, reason: str):
    """Log a blocked attempt to the log file."""
    BLOCKED_LOG.parent.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.utcnow().isoformat() + "Z"
    project_path = os.getcwd()
    
    log_entry = (
        f"[{timestamp}] BLOCKED: {reason}\n"
        f"  Command: {command}\n"
        f"  Project: {project_path}\n"
        f"{'=' * 60}\n"
    )
    
    with open(BLOCKED_LOG, "a") as f:
        f.write(log_entry)


def check_command(command: str) -> tuple[bool, str]:
    """
    Check if a command matches any destructive pattern.
    Returns (is_blocked, reason).
    """
    for pattern, description in DESTRUCTIVE_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, description
    return False, ""


def main():
    # Read the hook input from stdin (JSON)
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        # If we can't parse, let it through (fail open for safety)
        sys.exit(0)
    
    # Extract the tool use details
    tool_name = hook_input.get("tool_name", "")
    tool_input = hook_input.get("tool_input", {})
    
    # We only intercept bash tool
    if tool_name != "bash":
        sys.exit(0)
    
    command = tool_input.get("command", "")
    
    is_blocked, reason = check_command(command)
    
    if is_blocked:
        log_blocked_attempt(command, reason)
        print(f"\n🛡️  SECURITY HOOK BLOCKED this command:\n   {command}\n", file=sys.stderr)
        print(f"   Reason: {reason}\n", file=sys.stderr)
        print("   This destructive operation was prevented for your safety.\n", file=sys.stderr)
        print("   If you believe this is a mistake, review the command and try a safer alternative.\n", file=sys.stderr)
        sys.exit(1)  # Non-zero exit blocks the tool use
    
    sys.exit(0)


if __name__ == "__main__":
    main()
# Claude Code Pre-Tool-Use Hook: Block Destructive Commands

A security hook for [Claude Code](https://docs.anthropic.com/claude-code) that intercepts and blocks dangerous bash commands before they execute.

## What It Blocks

| Pattern | Example |
|---------|---------|
| `rm -rf` | `rm -rf /important/data` |
| `DROP TABLE` | `DROP TABLE users;` |
| `git push --force` | `git push --force origin main` |
| `TRUNCATE` | `TRUNCATE TABLE orders;` |
| `DELETE FROM` (no `WHERE`) | `DELETE FROM users;` |

