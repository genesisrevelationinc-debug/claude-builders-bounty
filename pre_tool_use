#!/bin/bash

set -e

# Log file location
LOG_FILE="$HOME/.claude/hooks/blocked.log"

# Ensure log directory exists
mkdir -p "$(dirname "$LOG_FILE")"

# Get the command being executed
TOOL_NAME="$1"
shift
TOOL_ARGS="$*"

# Only intercept bash commands
if [ "$TOOL_NAME" = "bash" ]; then
    # Check for destructive patterns in the bash command
    COMMAND_LINE="$*"
    
    # Define dangerous patterns (case insensitive)
    DANGEROUS_PATTERNS=(
        "rm -rf"
        "DROP TABLE"
        "git push --force"
        "TRUNCATE"
        "DELETE FROM"
    )
    
    # Check if any dangerous pattern exists in command
    for PATTERN in "${DANGEROUS_PATTERNS[@]}"; do
        if echo "$COMMAND_LINE" | grep -qi "$PATTERN"; then
            TIMESTAMP=$(date -Iseconds)
            PROJECT_PATH=$(pwd)
            BLOCKED_COMMAND="$TOOL_NAME $TOOL_ARGS"
            
            # Log the blocked command
            echo "[$TIMESTAMP] Blocked command: $BLOCKED_COMMAND in project: $PROJECT_PATH" >> "$LOG_FILE"
            
            # Display message to Claude
            echo "⚠️  BLOCKED: The command '$COMMAND_LINE' has been blocked for security reasons."
            echo "Reason: Potentially destructive command detected ($PATTERN)"
            echo "Blocked commands are logged in $LOG_FILE"
            
            # Exit with error to prevent execution
            exit 1
        fi
    done
    
    # If we get here, no dangerous patterns were found
    echo "Command passed security check: $TOOL_NAME $TOOL_ARGS"
fi

# If not a bash command or not blocked, proceed normally
exec "$TOOL_NAME" $TOOL_ARGS