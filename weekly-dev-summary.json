{
  "versionId": "11.0.0",
  "name": "Weekly Dev Summary Generator",
  "nodes": [
    {
      "id": "1",
      "name": "Start",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "cron": "0 17 * * 5"
      },
      "webhookId": "XXXX"
    },
    {
      "id": "2",
      "name": "Get Repository Data",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "parameters": {
        "owner": "claude-builders-bounty",
      "repository": "claude-builders-bounty",
      "operation": "getAll",
      "fields": [
        "commits",
        "issues",
        "pullRequests"
      ]
      },
      "position": [
        300,
        300
      ]
    },
    {
      "id": "3",
      "name": "Format Data for Claude",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 1,
      "position": [
        500,
        300
      ],
      "parameters": {
        "options": {
          "field": "commits",
          "value": "[]"
        }
      }
    },
    {
      "id": "4",
      "name": "Send to Claude",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [
        700,
        300
      ],
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "options": {
          "max_tokens": 1024,
          "temperature": 0.7
        }
      }
    },
    {
      "id": "5",
      "name": "Send Summary",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "parameters": {
        "to": "user@example.com",
        "subject": "Weekly Dev Summary",
        "message": "={{$input.json}}"
      }
    }
  ],
  "connections": [
    {
      "source": "1",
      "target": "2",
      "type": "main",
      "typeInfo": "all"
    },
    {
      "source": "2",
      "target": "3",
      "type": "main",
      "typeInfo": "all"
    },
    {
      "source": "3",
      "target": "4",
      "type": "main",
      "typeInfo": "all"
    },
    {
      "source": "4",
      "target": "5",
      "type": "main",
      "typeInfo": "all"
    }
  ],
  "settings": {
    "timezone": "UTC",
    "saveData": true,
    "saveManualExecutions": true
  },
  "variables": {
    "githubOwner": "claude-builders-bounty",
    "githubRepo": "claude-builders-bounty",
    "cron": "0 17 * * 5",
    "emailTo": "team@example.com",
    "language": "EN"
  }
}