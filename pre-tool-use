#!/bin/bash

# Pre-tool-use hook that blocks destructive bash commands
# Logs blocked attempts to ~/.claude/hooks/blocked.log

BLOCKED_LOG="$HOME/.claude/hooks/blocked.log"
PROJECT_PATH="$(pwd)"

# Function to log blocked commands
log_blocked() {
    local command="$1"
    local timestamp=$(date -Iseconds)
    echo "[$timestamp] Blocked command: $command (in project: $PROJECT_PATH)" >> "$BLOCKED_LOG"
}

# Check if the command is bash
if [ "$TOOL_NAME" = "bash" ]; then
    # List of destructive patterns to check
    declare -a patterns=(
        "rm -rf"
        "DROP TABLE"
        "git push --force"
        "TRUNCATE"
        "DELETE FROM"
    )
    
    # Check each pattern
    for pattern in "${patterns[@]}"; do
        if [[ "$INPUT" == *"$pattern"* ]]; then
            # Special handling for DELETE FROM to check for WHERE clause
            if [[ "$pattern" == "DELETE FROM" ]]; then
                # Check if DELETE FROM has a WHERE clause
                if [[ ! "$INPUT" =~ DELETE[[:space:]]+FROM[[:space:]]+.*WHERE[[:space:]]+.* ]]; then
                    log_blocked "$INPUT"
                    echo "ERROR: Blocked destructive command: $INPUT"
                    echo "REASON: DELETE statements without WHERE clause are not allowed"
                    exit 1
                fi
            else
                # For all other patterns, block them
                log_blocked "$INPUT"
                echo "ERROR: Blocked destructive command: $INPUT"
                case "$pattern" in
                    "DROP TABLE")
                        echo "REASON: DROP TABLE commands are not allowed"
                        ;;
                    "git push --force")
                        echo "REASON: Force pushes are not allowed"
                        ;;
                    "TRUNCATE")
                        echo "REASON: TRUNCATE commands are not allowed"
                        ;;
                    "rm -rf")
                        echo "REASON: rm -rf commands are not allowed"
                        ;;
                esac
                exit 1
            fi
        fi
    done
fi

exit 0