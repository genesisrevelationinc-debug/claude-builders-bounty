#!/bin/bash

# Claude Code pre-tool-use hook to block destructive bash commands
# Blocks: rm -rf, DROP TABLE, git push --force, TRUNCATE, DELETE FROM without WHERE

set -euo pipefail

# Get the command being executed
command_input="$1"

# Get project path from Claude environment variable or default to current directory
project_path="${CLAUDE_PROJECT_PATH:-$(pwd)}"

# Log file location
log_file="$HOME/.claude/hooks/blocked.log"

# Function to log blocked commands
log_blocked() {
    local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    echo "[$timestamp] BLOCKED: $command_input | PROJECT: $project_path" >> "$log_file"
}

# Function to check for destructive patterns
is_destructive() {
    local cmd="$1"
    
    # Check for rm -rf
    if [[ "$cmd" == *"rm -rf"* ]]; then
        return 0
    fi
    
    # Check for SQL DROP TABLE
    if [[ "$cmd" == *"DROP TABLE"* ]]; then
        return 0
    fi
    
    # Check for git push --force
    if [[ "$cmd" == *"git push --force"* ]] || [[ "$cmd" == *"git push -f"* ]]; then
        return 0
    fi
    
    # Check for TRUNCATE
    if [[ "$cmd" == *"TRUNCATE"* ]] || [[ "$cmd" == *"truncate"* ]]; then
        return 0
    fi
    
    # Check for DELETE FROM without WHERE clause
    if echo "$cmd" | grep -Eiq "delete from [a-zA-Z_][a-zA-Z0-9_]* *[;]*$"; then
        return 0
    fi
    
    return 1
}

# Check if command is destructive
if is_destructive "$command_input"; then
    log_blocked
    echo "BLOCKED: Dangerous command detected. This command has been prevented for your safety."
    exit 1
fi

# If we get here, the command is safe to execute
exit 0