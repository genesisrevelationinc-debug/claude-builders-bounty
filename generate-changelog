#!/usr/bin/env bash
#
# generate-changelog
# Automatically generates a structured CHANGELOG.md from git history.
# Fetches commits since the last git tag and categorizes them.
#
# Usage:
#   ./generate-changelog              # Generate CHANGELOG.md
#   ./generate-changelog --dry-run    # Preview without writing

set -euo pipefail

# ── Configuration ──────────────────────────────────────────────────────────

CATEGORIES="Added Fixed Changed Removed"
OUTPUT_FILE="CHANGELOG.md"
DRY_RUN=false

# ── Parse flags ──────────────────────────────────────────────────────────────

if [[ "${1:-}" == "--dry-run" ]]; then
    DRY_RUN=true
fi

# ── Helpers ──────────────────────────────────────────────────────────────────

get_last_tag() {
    git describe --tags --abbrev=0 2>/dev/null || echo ""
}

get_commits_since() {
    local tag="$1"
    if [[ -n "$tag" ]]; then
        git log "${tag}..HEAD" --pretty=format:"%s" 2>/dev/null || true
    else
        git log --pretty=format:"%s" 2>/dev/null || true
    fi
}

categorize_commit() {
    local msg="$1"
    local lower
    lower=$(echo "$msg" | tr '[:upper:]' '[:lower:]')
    
    if [[ "$lower" =~ ^(feat|add|create|introduce|implement|new) ]]; then
        echo "Added"
    elif [[ "$lower" =~ ^(fix|bugfix|hotfix|patch|resolve|correct) ]]; then
        echo "Fixed"
    elif [[ "$lower" =~ ^(remove|delete|drop|revert|clean) ]]; then
        echo "Removed"
    elif [[ "$lower" =~ ^(update|change|modify|refactor|improve|enhance|upgrade|rework) ]]; then
        echo "Changed"
    else
        echo "Changed"
    fi
}

# ── Main ─────────────────────────────────────────────────────────────────────

main() {
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        echo "Error: Not a git repository." >&2
        exit 1
    fi

    local last_tag
    last_tag=$(get_last_tag)

    local version_info
    if [[ -n "$last_tag" ]]; then
        version_info="since $last_tag"
    else
        version_info="(all commits)"
    fi

    local commits
    commits=$(get_commits_since "$last_tag")

    if [[ -z "$commits" ]]; then
        echo "No commits found $version_info."
        exit 0
    fi

    # Build changelog content
    local changelog=""
    changelog+="# Changelog\n\n"
    changelog+="## Unreleased $version_info\n\n"

    for category in $CATEGORIES; do
        local section=""
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            local cat
            cat=$(categorize_commit "$line")
            if [[ "$cat" == "$category" ]]; then
                section+="- $line\n"
            fi
        done <<< "$commits"

        if [[ -n "$section" ]]; then
            changelog+="### $category\n\n$section\n"
        fi
    done

    if $DRY_RUN; then
        echo -e "$changelog"
    else
        echo -e "$changelog" > "$OUTPUT_FILE"
        echo "CHANGELOG.md generated successfully."
    fi
}

main "$@"