#!/usr/bin/env bash
#
# generate-changelog
# A script to generate a structured CHANGELOG.md from git history.
# Usage: ./generate-changelog
#

set -euo pipefail

# Get the directory where the script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Check if we're in a git repo
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Error: Not a git repository." >&2
    exit 1
fi

# Get the latest tag, or use empty if none
LATEST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || true)

if [ -z "$LATEST_TAG" ]; then
    echo "No tags found. Using all commits." >&2
    COMMIT_RANGE=""
else
    echo "Generating changelog since tag: $LATEST_TAG" >&2
    COMMIT_RANGE="${LATEST_TAG}..HEAD"
fi

# Get commits since last tag (or all commits if no tag)
# Format: hash|subject
if [ -z "$COMMIT_RANGE" ]; then
    COMMITS=$(git log --pretty=format:"%H|%s" --no-merges)
else
    COMMITS=$(git log "${COMMIT_RANGE}" --pretty=format:"%H|%s" --no-merges)
fi

# Initialize changelog sections
ADDED=""
FIXED=""
CHANGED=""
REMOVED=""

# Categorize commits
while IFS= read -r line; do
    [ -z "$line" ] && continue
    
    HASH=$(echo "$line" | cut -d'|' -f1)
    SUBJECT=$(echo "$line" | cut -d'|' -f2-)
    SHORT_HASH=$(echo "$HASH" | cut -c1-7)
    
    # Categorize based on commit message prefixes or keywords
    if echo "$SUBJECT" | grep -qiE '^(feat|add|create|introduce|implement)|\b(add|adds|added|adding)\b'; then
        ADDED="${ADDED}- ${SUBJECT} (${SHORT_HASH})"$'\n'
    elif echo "$SUBJECT" | grep -qiE '^(fix|bugfix|hotfix|patch)|\b(fix|fixes|fixed|fixing|bug|bugs|resolve|resolves|resolved)\b'; then
        FIXED="${FIXED}- ${SUBJECT} (${SHORT_HASH})"$'\n'
    elif echo "$SUBJECT" | grep -qiE '^(remove|delete|drop|revert)|\b(remove|removes|removed|removing|delete|deletes|deleted|deleting|drop|dropped)\b'; then
        REMOVED="${REMOVED}- ${SUBJECT} (${SHORT_HASH})"$'\n'
    else
        # Default to Changed
        CHANGED="${CHANGED}- ${SUBJECT} (${SHORT_HASH})"$'\n'
    fi
done <<< "$COMMITS"

# Generate CHANGELOG.md
{
    echo "# Changelog"
    echo ""
    echo "All notable changes to this project will be documented in this file."
    echo ""
    echo "## [Unreleased]$( [ -n "$LATEST_TAG" ] && echo " - since ${LATEST_TAG}" || echo "")"
    echo ""
    
    [ -n "$ADDED" ] && echo "### Added" && echo "" && echo -n "$ADDED" && echo ""
    [ -n "$CHANGED" ] && echo "### Changed" && echo "" && echo -n "$CHANGED" && echo ""
    [ -n "$FIXED" ] && echo "### Fixed" && echo "" && echo -n "$FIXED" && echo ""
    [ -n "$REMOVED" ] && echo "### Removed" && echo "" && echo -n "$REMOVED" && echo ""
} > CHANGELOG.md

echo "CHANGELOG.md generated successfully!"