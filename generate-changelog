#!/usr/bin/env bash
#
# generate-changelog
# Automatically generates a structured CHANGELOG.md from git history.
# Usage: ./generate-changelog [output_file]
#

set -euo pipefail

OUTPUT_FILE="${1:-CHANGELOG.md}"

# Get the latest git tag, or empty if none exists
get_latest_tag() {
    git describe --tags --abbrev=0 2>/dev/null || echo ""
}

# Get commits since the last tag (or all commits if no tag)
get_commits_since_tag() {
    local tag
    tag=$(get_latest_tag)
    if [ -n "$tag" ]; then
        git log "${tag}..HEAD" --pretty=format:"%s" 2>/dev/null || true
    else
        git log --pretty=format:"%s" 2>/dev/null || true
    fi
}

# Categorize a single commit message
categorize_commit() {
    local msg="$1"
    local lower_msg
    lower_msg=$(echo "$msg" | tr '[:upper:]' '[:lower:]')

    case "$lower_msg" in
        *"fix"* | *"bugfix"* | *"patch"* | *"resolve"* | *"hotfix"*)
            echo "fixed"
            ;;
        *"add"* | *"feat"* | *"feature"* | *"implement"* | *"introduce"* | *"new "*)
            echo "added"
            ;;
        *"remove"* | *"delete"* | *"drop"* | *"deprecate"*)
            echo "removed"
            ;;
        *"update"* | *"change"* | *"refactor"* | *"improve"* | *"modify"* | *"rework"* | *"enhance"*)
            echo "changed"
            ;;
        *)
            echo "changed"
            ;;
    esac
}

# Main generation logic
generate_changelog() {
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        echo "Error: Not a git repository." >&2
        exit 1
    fi

    local tag
    tag=$(get_latest_tag)
    local since_text
    if [ -n "$tag" ]; then
        since_text="since ${tag}"
    else
        since_text="(all commits)"
    fi

    {
        echo "# Changelog"
        echo ""
        echo "## Unreleased ${since_text}"
        echo ""

        local commits
        commits=$(get_commits_since_tag)

        if [ -z "$commits" ]; then
            echo "No new commits found."
            exit 0
        fi

        echo "$commits" | while IFS= read -r line; do
            local category
            category=$(categorize_commit "$line")
            echo "- **[$category]** $line"
        done
    } > "$OUTPUT_FILE"

    echo "CHANGELOG generated at $OUTPUT_FILE"
}

generate_changelog