#!/usr/bin/env bash
#
# generate-changelog
# Automatically generates a structured CHANGELOG.md from git history.
# Fetches commits since the last git tag and auto-categorizes them.
#
# Usage: ./generate-changelog [--output FILE] [--since TAG]
#

set -euo pipefail

# Configuration
OUTPUT_FILE="CHANGELOG.md"
SINCE_TAG=""

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --output)
      OUTPUT_FILE="$2"
      shift 2
      ;;
    --since)
      SINCE_TAG="$2"
      shift 2
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

# Determine the range of commits to include
if [[ -z "$SINCE_TAG" ]]; then
  # Find the latest tag
  LATEST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "")
  if [[ -z "$LATEST_TAG" ]]; then
    echo "Warning: No tags found. Using all commits." >&2
    COMMIT_RANGE="HEAD"
  else
    echo "Generating changelog since tag: $LATEST_TAG" >&2
    COMMIT_RANGE="${LATEST_TAG}..HEAD"
  fi
else
  COMMIT_RANGE="${SINCE_TAG}..HEAD"
fi

# Get commits with their messages
if [[ "$COMMIT_RANGE" == "HEAD" ]]; then
  COMMITS=$(git log --pretty=format:"%s" --no-merges)
else
  COMMITS=$(git log --pretty=format:"%s" --no-merges "$COMMIT_RANGE")
fi

if [[ -z "$COMMITS" ]]; then
  echo "No commits found in the specified range." >&2
  exit 0
fi

# Categorize commits
declare -a ADDED
declare -a FIXED
declare -a CHANGED
declare -a REMOVED
declare -a OTHER

while IFS= read -r line; do
  [[ -z "$line" ]] && continue

  # Normalize for matching
  lower=$(echo "$line" | tr '[:upper:]' '[:lower:]')

  if [[ "$lower" =~ ^(feat|add|introduce|implement|create|new) ]] || [[ "$lower" =~ added ]]; then
    ADDED+=("$line")
  elif [[ "$lower" =~ ^(fix|bugfix|hotfix|resolve|patch) ]] || [[ "$lower" =~ fixed ]]; then
    FIXED+=("$line")
  elif [[ "$lower" =~ ^(remove|delete|drop|revert|deprecate|cleanup) ]] || [[ "$lower" =~ removed ]]; then
    REMOVED+=("$line")
  elif [[ "$lower" =~ ^(update|change|modify|refactor|improve|enhance|upgrade|rework) ]] || [[ "$lower" =~ changed ]]; then
    CHANGED+=("$line")
  else
    OTHER+=("$line")
  fi
done <<< "$COMMITS"

# Generate the changelog
{
  echo "# Changelog"
  echo ""
  echo "All notable changes to this project will be documented in this file."
  echo ""
  echo "## [Unreleased] - $(date +%Y-%m-%d)"
  echo ""

  output_section() {
    local title="$1"
    shift
    if [[ $# -gt 0 ]]; then
      echo "### $title"
      echo ""
      for item in "$@"; do
        echo "- $item"
      done
      echo ""
    fi
  }

  output_section "Added" "${ADDED[@]+"${ADDED[@]}"}"
  output_section "Fixed" "${FIXED[@]+"${FIXED[@]}"}"
  output_section "Changed" "${CHANGED[@]+"${CHANGED[@]}"}"
  output_section "Removed" "${REMOVED[@]+"${REMOVED[@]}"}"
  output_section "Other" "${OTHER[@]+"${OTHER[@]}"}"

} > "$OUTPUT_FILE"

echo "CHANGELOG generated at: $OUTPUT_FILE"