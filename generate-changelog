# Run this script to generate a CHANGELOG.md from git history
exec bash "$(dirname "$0")/scripts/changelog.sh" "$@"
#!/usr/bin/env bash
set -euo pipefail

# generate-changelog — create a structured CHANGELOG.md from git history
# Usage: bash scripts/changelog.sh [--output FILE]

OUTPUT="${1:-CHANGELOG.md}"
TMPDIR="$(mktemp -d)"
trap 'rm -rf "$TMPDIR"' EXIT

# ── helpers ─────────────────────────────────────────────────────────

get_last_tag() {
    git describe --tags --abbrev=0 2>/dev/null || echo ""
}

get_commits_since() {
    local since="$1"
    if [[ -n "$since" ]]; then
        git log "${since}..HEAD" --pretty=format:"%s" --no-merges
    else
        git log --pretty=format:"%s" --no-merges
    fi
}

categorize() {
    local msg="$1"
    local lower
    lower="$(echo "$msg" | tr '[:upper:]' '[:lower:]')"

    case "$lower" in
        feat*|add*|introduce*|implement*|new*)
            echo "added" ;;
        fix*|bugfix*|patch*|resolve*|hotfix*)
            echo "fixed" ;;
        remove*|delete*|drop*|deprecate*|clean*)
            echo "removed" ;;
        change*|update*|refactor*|rework*|improve*|modify*|upgrade*|bump*|style*|docs*|test*|chore*|perf*|ci*|build*)
            echo "changed" ;;
        *)
            echo "changed" ;;
    esac
}

format_commit() {
    local msg="$1"
    # Strip common prefixes like "feat:", "fix:", etc.
    echo "$msg" | sed -E 's/^[a-zA-Z]+(\([^)]*\))?:[[:space:]]*//'
}

# ── main ────────────────────────────────────────────────────────────

main() {
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        echo "Error: Not a git repository." >&2
        exit 1
    fi

    local last_tag
    last_tag="$(get_last_tag)"

    local range_desc
    if [[ -n "$last_tag" ]]; then
        range_desc="since ${last_tag}"
    else
        range_desc="(all commits)"
    fi

    echo "Generating changelog ${range_desc} → ${OUTPUT}" >&2

    # Collect commits into temp files per category
    while IFS= read -r commit; do
        [[ -z "$commit" ]] && continue
        local cat
        cat="$(categorize "$commit")"
        local formatted
        formatted="$(format_commit "$commit")"
        echo "- ${formatted}" >> CHANGELOG.md >> "${TMPDIR}/${cat}.txt"
    done < <(get_commits_since "$last_tag")

    # Build the changelog
    {
        echo "# Changelog"
        echo ""
        echo "All notable changes to this project are documented in this file."
        echo ""
        echo "## Unreleased ${range_desc}"
        echo ""

        if [[ -s "${TMPDIR}/added.txt" ]]; then
            echo "### Added"
            cat "${TMPDIR}/added.txt"
            echo ""
        fi

        if [[ -s "${TMPDIR}/changed.txt" ]]; then
            echo "### Changed"
            cat "${TMPDIR}/changed.txt"
            echo ""
        fi

        if [[ -s "${TMPDIR}/fixed.txt" ]]; then
            echo "### Fixed"
            cat "${TMPDIR}/fixed.txt"
            echo ""
        fi

        if [[ -s "${TMPDIR}/removed.txt" ]]; then
            echo "### Removed"
            cat "${TMPDIR}/removed.txt"
            echo ""
        fi
    } > "$OUTPUT"

    echo "Done. See ${OUTPUT}" >&2
}

main "$@"
# /generate-changelog

Generate a structured `CHANGELOG.md` from the project's git history.

