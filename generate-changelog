#!/usr/bin/env bash
#
# generate-changelog
# Automatically generates a structured CHANGELOG.md from git history.
#
# Usage:
#   ./generate-changelog [output_file]
#
# Fetches commits since the last git tag and auto-categorizes them into:
#   - Added
#   - Fixed
#   - Changed
#   - Removed
#

set -euo pipefail

OUTPUT_FILE="${1:-CHANGELOG.md}"

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Error: Not a git repository." >&2
    exit 1
fi

# Get the latest tag
LATEST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "")

# Determine the commit range
if [ -z "$LATEST_TAG" ]; then
    echo "No tags found. Using all commits." >&2
    COMMIT_RANGE="HEAD"
else
    echo "Latest tag: $LATEST_TAG" >&2
    COMMIT_RANGE="${LATEST_TAG}..HEAD"
fi

# Get commits since last tag (or all commits)
COMMITS=$(git log "$COMMIT_RANGE" --pretty=format:"%s" 2>/dev/null || true)

if [ -z "$COMMITS" ]; then
    echo "No commits found since last tag." >&2
    exit 0
fi

# Categorize commits
ADDED=""
FIXED=""
CHANGED=""
REMOVED=""
OTHER=""

while IFS= read -r line; do
    # Skip empty lines
    [ -z "$line" ] && continue

    # Categorize based on conventional commit keywords or patterns
    if echo "$line" | grep -qiE "^(feat|add|new|introduce|implement|create)|\b(add|added|adding)\b"; then
        ADDED="${ADDED}- ${line}"$'\n'
    elif echo "$line" | grep -qiE "^(fix|bugfix|patch|hotfix)|\b(fix|fixed|fixing|bug|bugfix|resolve|resolves|resolved|close|closes|closed)\b"; then
        FIXED="${FIXED}- ${line}"$'\n'
    elif echo "$line" | grep -qiE "^(remove|delete|drop|revert)|\b(remove|removed|removing|delete|deleted|deleting|drop|dropped|revert|reverted)\b"; then
        REMOVED="${REMOVED}- ${line}"$'\n'
    elif echo "$line" | grep -qiE "^(change|update|modify|refactor|improve|upgrade|bump)|\b(change|changed|changing|update|updated|updating|modify|modified|modifying|refactor|refactored|improve|improved|upgrade|upgraded|bump|bumped)\b"; then
        CHANGED="${CHANGED}- ${line}"$'\n'
    else
        OTHER="${OTHER}- ${line}"$'\n'
    fi
done <<< "$COMMITS"

# Generate CHANGELOG.md
{
    echo "# Changelog"
    echo ""
    echo "## $(date +%Y-%m-%d)"
    echo ""

    # Output categorized sections
    [ -n "$ADDED" ] && echo "### Added" && echo "" && echo -n "$ADDED" && echo ""
    [ -n "$CHANGED" ] && echo "### Changed" && echo "" && echo -n "$CHANGED" && echo ""
    [ -n "$FIXED" ] && echo "### Fixed" && echo "" && echo -n "$FIXED" && echo ""
    [ -n "$REMOVED" ] && echo "### Removed" && echo "" && echo -n "$REMOVED" && echo ""
    [ -n "$OTHER" ] && echo "### Other" && echo "" && echo -n "$OTHER" && echo ""

} > "$OUTPUT_FILE"

echo "CHANGELOG generated at: $OUTPUT_FILE" >&2
echo "" >&2
echo "Preview:" >&2
head -n 30 "$OUTPUT_FILE" >&2