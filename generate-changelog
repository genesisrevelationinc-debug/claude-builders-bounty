#!/usr/bin/env bash
set -euo pipefail

# generate-changelog.sh
# Generates a structured CHANGELOG.md from git history since the last tag.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OUTPUT_FILE="${1:-CHANGELOG.md}"

# Determine the last tag
LAST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "")

if [ -z "$LAST_TAG" ]; then
    echo "No previous tag found. Using all commits."
    COMMIT_RANGE=""
else
    echo "Last tag: $LAST_TAG"
    COMMIT_RANGE="${LAST_TAG}..HEAD"
fi

# Get commits
if [ -z "$COMMIT_RANGE" ]; then
    COMMITS=$(git log --pretty=format:"%s" --no-merges)
else
    COMMITS=$(git log --pretty=format:"%s" --no-merges "$COMMIT_RANGE")
fi

if [ -z "$COMMITS" ]; then
    echo "No new commits found since last tag."
    exit 0
fi

# Categorization
ADDED=""
FIXED=""
CHANGED=""
REMOVED=""

while IFS= read -r line; do
    [ -z "$line" ] && continue

    lower=$(echo "$line" | tr '[:upper:]' '[:lower:]')

    if echo "$lower" | grep -qE '^(feat|add|new|introduce|implement|create|support)'; then
        ADDED="${ADDED}- ${line}"$'\n'
    elif echo "$lower" | grep -qE '^(fix|bugfix|hotfix|patch|resolve|correct)'; then
        FIXED="${FIXED}- ${line}"$'\n'
    elif echo "$lower" | grep -qE '^(remove|delete|drop|revert|deprecate)'; then
        REMOVED="${REMOVED}- ${line}"$'\n'
    elif echo "$lower" | grep -qE '^(update|change|modify|refactor|improve|enhance|upgrade|bump|style|docs|test|chore)'; then
        CHANGED="${CHANGED}- ${line}"$'\n'
    else
        # Default to Changed if no clear prefix
        CHANGED="${CHANGED}- ${line}"$'\n'
    fi
done <<< "$COMMITS"

# Build changelog
DATE=$(date +%Y-%m-%d)
VERSION="Unreleased"

if [ -n "$LAST_TAG" ]; then
    VERSION="$LAST_TAG → HEAD"
fi

CHANGELOG="# Changelog

All notable changes to this project will be documented in this file.

The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/),
and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html).

## [${VERSION}] - ${DATE}
"

if [ -n "$ADDED" ]; then
    CHANGELOG="${CHANGELOG}
### Added
${ADDED}"
fi

if [ -n "$CHANGED" ]; then
    CHANGELOG="${CHANGELOG}
### Changed
${CHANGED}"
fi

if [ -n "$FIXED" ]; then
    CHANGELOG="${CHANGELOG}
### Fixed
${FIXED}"
fi

if [ -n "$REMOVED" ]; then
    CHANGELOG="${CHANGELOG
### Removed
${REMOVED}}"
fi

# Append existing changelog if present
if [ -f "$OUTPUT_FILE" ]; then
    # Extract header and existing entries (skip our generated header)
    EXISTING=$(tail -n +8 "$OUTPUT_FILE" 2>/dev/null || true)
    if [ -n "$EXISTING" ]; then
        CHANGELOG="${CHANGELOG}
${EXISTING}"
    fi
fi

# Write output
echo "$CHANGELOG" > "$OUTPUT_FILE"
echo "CHANGELOG written to $OUTPUT_FILE"
