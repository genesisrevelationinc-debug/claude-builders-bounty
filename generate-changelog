#!/usr/bin/env bash
#
# generate-changelog
# A script to generate a structured CHANGELOG.md from git history.
# Fetches commits since the last git tag and auto-categorizes them.
#
# Usage:
#   ./generate-changelog
#   ./generate-changelog --output custom.md
#   ./generate-changelog --since "2024-01-01"
#

set -euo pipefail

# Configuration
OUTPUT_FILE="CHANGELOG.md"
SINCE_TAG=""
SINCE_DATE=""

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --output|-o)
            OUTPUT_FILE="$2"
            shift 2
            ;;
        --since)
            SINCE_DATE="$2"
            shift 2
            ;;
        --help|-h)
            echo "Usage: $0 [--output <file>] [--since <date>]"
            echo ""
            echo "Options:"
            echo "  --output, -o <file>  Output file (default: CHANGELOG.md)"
            echo "  --since <date>       Start date (YYYY-MM-DD) or tag"
            echo "  --help, -h           Show this help message"
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
    esac
done

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Error: Not a git repository." >&2
    exit 1
fi

# Determine the starting point
if [[ -n "$SINCE_DATE" ]]; then
    # Check if it's a tag
    if git rev-parse "$SINCE_DATE" > /dev/null 2>&1; then
        SINCE_TAG="$SINCE_DATE"
    else
        # Treat as date
        :
    fi
else
    # Get the latest tag
    SINCE_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "")
fi

# Build the git log command
GIT_LOG_CMD="git log"
if [[ -n "$SINCE_TAG" ]]; then
    GIT_LOG_CMD="$GIT_LOG_CMD $SINCE_TAG..HEAD"
elif [[ -n "$SINCE_DATE" ]]; then
    GIT_LOG_CMD="$GIT_LOG_CMD --since=\"$SINCE_DATE\""
fi

GIT_LOG_CMD="$GIT_LOG_CMD --pretty=format:'%s'"

# Fetch commits
echo "Fetching commits..."
COMMITS=$(eval "$GIT_LOG_CMD" 2>/dev/null || true)

if [[ -z "$COMMITS" ]]; then
    echo "No commits found since the specified point."
    exit 0
fi

# Categorize commits
ADDED=$(echo "$COMMITS" | grep -iE '^(feat|add|create|implement|introduce)' || true)
FIXED=$(echo "$COMMITS" | grep -iE '^(fix|bug|repair|resolve|patch)' || true)
CHANGED=$(echo "$COMMITS" | grep -iE '^(update|change|modify|refactor|improve|enhance|upgrade|rework)' || true)
REMOVED=$(echo "$COMMITS" | grep -iE '^(remove|delete|drop|deprecate|clean)' || true)
OTHER=$(echo "$COMMITS" | grep -ivE '^(feat|add|create|implement|introduce|fix|bug|repair|resolve|patch|update|change|modify|refactor|improve|enhance|upgrade|rework|remove|delete|drop|deprecate|clean)' || true)

# Generate CHANGELOG
{
    echo "# Changelog"
    echo ""
    echo "All notable changes to this project will be documented in this file."
    echo ""
    echo "## [Unreleased] - $(date +%Y-%m-%d)"
    echo ""

    print_section() {
        local title="$1"
        local content="$2"
        if [[ -n "$content" ]]; then
            echo "### $title"
            echo ""
            echo "$content" | sed 's/^/- /'
            echo ""
        fi
    }

    print_section "Added" "$ADDED"
    print_section "Changed" "$CHANGED"
    print_section "Fixed" "$FIXED"
    print_section "Removed" "$REMOVED"
    print_section "Other" "$OTHER"

} > "$OUTPUT_FILE"

echo "✅ CHANGELOG generated: $OUTPUT_FILE"