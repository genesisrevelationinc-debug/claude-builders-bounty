#!/usr/bin/env bash
#
# generate-changelog
# Automatically generates a structured CHANGELOG.md from git history.
# Fetches commits since the last git tag and categorizes them.
#
# Usage:
#   ./generate-changelog          # Generate CHANGELOG.md
#   ./generate-changelog --dry-run  # Preview without writing

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Configuration
OUTPUT_FILE="CHANGELOG.md"
DRY_RUN=false

# Parse arguments
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=true ;;
    esac
done

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo -e "${RED}Error: Not a git repository.${NC}" >&2
    exit 1
fi

# Get the latest tag
LATEST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "")

if [ -z "$LATEST_TAG" ]; then
    echo -e "${YELLOW}Warning: No tags found. Using all commits.${NC}" >&2
    COMMIT_RANGE=""
else
    echo -e "${GREEN}Found latest tag: $LATEST_TAG${NC}" >&2
    COMMIT_RANGE="${LATEST_TAG}..HEAD"
fi

# Get commits since last tag (or all commits)
if [ -z "$COMMIT_RANGE" ]; then
    COMMITS=$(git log --pretty=format:"%s" --no-merges)
else
    COMMITS=$(git log "${COMMIT_RANGE}" --pretty=format:"%s" --no-merges 2>/dev/null || true)
fi

if [ -z "$COMMITS" ]; then
    echo -e "${YELLOW}No commits found since last tag.${NC}" >&2
    exit 0
fi

# Categorize commits
ADDED=""
FIXED=""
CHANGED=""
REMOVED=""
OTHER=""

while IFS= read -r line; do
    # Skip empty lines
    [ -z "$line" ] && continue

    # Categorize based on conventional commit keywords
    if echo "$line" | grep -qiE '^(feat|add|new|introduce|implement|create)'; then
        ADDED="${ADDED}- ${line}"$'\n'
    elif echo "$line" | grep -qiE '^(fix|bugfix|hotfix|patch|resolve|correct)'; then
        FIXED="${FIXED}- ${line}"$'\n'
    elif echo "$line" | grep -qiE '^(change|update|modify|refactor|improve|enhance|upgrade|bump)'; then
        CHANGED="${CHANGED}- ${line}"$'\n'
    elif echo "$line" | grep -qiE '^(remove|delete|drop|revert|deprecate)'; then
        REMOVED="${REMOVED}- ${line}"$'\n'
    else
        OTHER="${OTHER}- ${line}"$'\n'
    fi
done <<< "$COMMITS"

# Build changelog content
DATE=$(date +%Y-%m-%d)
VERSION=${LATEST_TAG:-"Unreleased"}

CHANGELOG="# Changelog\n\n"
CHANGELOG+="## [${VERSION}] - ${DATE}\n\n"

if [ -n "$ADDED" ]; then
    CHANGELOG+="### Added\n\n${ADDED}\n"
fi

if [ -n "$FIXED" ]; then
    CHANGELOG+="### Fixed\n\n${FIXED}\n"
fi

if [ -n "$CHANGED" ]; then
    CHANGELOG+="### Changed\n\n${CHANGED}\n"
fi

if [ -n "$REMOVED" ]; then
    CHANGELOG+="### Removed\n\n${REMOVED}\n"
fi

if [ -n "$OTHER" ]; then
    CHANGELOG+="### Other\n\n${OTHER}\n"
fi

# Output
if [ "$DRY_RUN" = true ]; then
    echo -e "${GREEN}--- DRY RUN ---${NC}"
    echo -e "$CHANGELOG"
else
    echo -e "$CHANGELOG" > "$OUTPUT_FILE"
    echo -e "${GREEN}✓ CHANGELOG.md generated successfully!${NC}"
    echo -e "${GREEN}  Latest tag: ${VERSION}${NC}"
    echo -e "${GREEN}  Output: ${OUTPUT_FILE}${NC}"
fi