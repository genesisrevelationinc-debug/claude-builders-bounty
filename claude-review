#!/usr/bin/env python3
"""
Claude Code PR Reviewer
Reviews a GitHub PR and generates a structured Markdown comment.
"""

import argparse
import json
import os
import re
import sys
from typing import Dict, List, Optional

import requests


def parse_pr_url(url: str) -> tuple:
    """Parse GitHub PR URL and return (owner, repo, pr_number)"""
    pattern = r"github\.com/([^/]+)/([^/]+)/pull/(\d+)"
    match = re.search(pattern, url)
    if not match:
        raise ValueError("Invalid GitHub PR URL")
    return match.group(1), match.group(2), int(match.group(3))


def get_pr_diff(owner: str, repo: str, pr_number: int, token: str) -> str:
    """Fetch the diff of a GitHub PR"""
    headers = {
        "Authorization": f"token {token}",
        "Accept": "application/vnd.github.v3.diff"
    }
    url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_number}"
    response = requests.get(url, headers=headers)
    response.raise_for_status()
    return response.text


def analyze_diff(diff: str) -> Dict:
    """Analyze the diff and return structured review data"""
    # Simple heuristics for demonstration
    # In a real implementation, this would be more sophisticated
    
    lines = diff.split('\n')
    added_lines = [line for line in lines if line.startswith('+') and not line.startswith('+++')]
    removed_lines = [line for line in lines if line.startswith('-') and not line.startswith('---')]
    
    # Summary (simplified)
    summary = "This PR modifies existing functionality with several additions and removals in the codebase."
    if len(added_lines) > len(removed_lines):
        summary = "This PR adds new functionality with several new code additions."
    elif len(removed_lines) > len(added_lines):
        summary = "This PR removes existing functionality, potentially simplifying the codebase."

    # Risks (simplified heuristics)
    risks = []
    if any('delete' in line.lower() or 'remove' in line.lower() for line in removed_lines):
        risks.append("Removal of code may impact existing functionality")
    if any('TODO' in line for line in added_lines):
        risks.append("New code contains TODO comments that should be addressed")
    if any('console.log' in line or 'print' in line for line in added_lines):
        risks.append("Debugging statements found in new code")
    if any('password' in line.lower() or 'secret' in line.lower() for line in added_lines):
        risks.append("Potential security risk: sensitive information in code")

    if not risks:
        risks.append("No significant risks identified")

    # Suggestions (simplified)
    suggestions = []
    if len(added_lines) > 100:
        suggestions.append("Consider breaking large changes into smaller commits for easier review")
    if not any('test' in line.lower() for line in added_lines):
        suggestions.append("Consider adding tests for new functionality")
    if any('TODO' in line for line in added_lines):
        suggestions.append("Address TODO comments before merging")

    if not suggestions:
        suggestions.append("Code changes look good")

    # Confidence (simplified)
    confidence = "Medium"
    if len(risks) <= 1 and len(suggestions) <= 1:
        confidence = "High"
    elif len(risks) > 2 or len(suggestions) > 3:
        confidence = "Low"

    return {
        "summary": summary,
        "risks": risks,
        "suggestions": suggestions,
        "confidence": confidence
    }


def generate_markdown_review(analysis: Dict) -> str:
    """Generate a Markdown formatted review from analysis"""
    md = []
    md.append("## Code Review")
    md.append("")
    md.append(f"**Summary**: {analysis['summary']}")
    md.append("")
    md.append("**Identified Risks**:")
    for risk in analysis['risks']:
        md.append(f"- {risk}")
    md.append("")
    md.append("**Improvement Suggestions**:")
    for suggestion in analysis['suggestions']:
        md.append(f"- {suggestion}")
    md.append("")
    md.append(f"**Confidence**: {analysis['confidence']}")
    md.append("")
    return "\n".join(md)


def main():
    parser = argparse.ArgumentParser(description="Claude Code PR Reviewer")
    parser.add_argument("--pr", required=True, help="GitHub PR URL")
    args = parser.parse_args()

    try:
        # Parse PR URL
        owner, repo, pr_number = parse_pr_url(args.pr)
        
        # Get GitHub token from environment
        token = os.environ.get("GITHUB_TOKEN")
        if not token:
            print("Error: GITHUB_TOKEN environment variable is required")
            sys.exit(1)
        
        # Fetch PR diff
        diff = get_pr_diff(owner, repo, pr_number, token)
        
        # Analyze the diff
        analysis = analyze_diff(diff)
        
        # Generate and print Markdown review
        review = generate_markdown_review(analysis)
        print(review)
        
    except Exception as e:
        print(f"Error: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()