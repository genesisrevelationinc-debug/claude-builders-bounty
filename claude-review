def get_pr_details(pr_url):
    # Parse the PR URL to get owner, repo, and PR number
    parsed = urlparse(pr_url)
    path_parts = parsed.path.strip('/').split('/')
    owner = path_parts[0]
    repo = path_parts[1]
    pull_number = path_parts[3]
    
    return {
        'owner': owner,
        'repo': repo,
