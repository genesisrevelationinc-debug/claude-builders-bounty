#!/usr/bin/env python3

import argparse
import requests
import sys
import json
import re
from urllib.parse import urlparse

def parse_github_url(url):
    """Extract owner, repo, and pull request number from GitHub PR URL"""
    # Handle both HTTPS and SSH URLs
    if "github.com" in url:
        # HTTPS URL: https://github.com/owner/repo/pull/123
        match = re.search(r"github\.com/([^/]+)/([^/]+)/pull/(\d+)", url)
        if match:
            owner, repo, pr_number = match.groups()
            return owner, repo, int(pr_number)
    return None, None, None

def get_pr_diff(owner, repo, pr_number, token):
    """Fetch the diff of a pull request using GitHub API"""
    url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_number}"
    headers = {"Authorization": f"token {token}"} if token else {}
    response = requests.get(url, headers=headers)
    response.raise_for_status()
    return response.json()["diff_url"]

def analyze_diff(diff_content):
    """Analyze the diff content and return structured review"""
    # This is a simplified analysis - in a real implementation,
    # this would involve more sophisticated code review logic
    changes = []
    risks = []
    suggestions = []
    
    # Simple heuristics for demonstration
    if "DELETE" in diff_content or "DROP" in diff_content:
        risks.append("Potential destructive operations detected (DELETE/DROP)")
    if "TODO" in diff_content:
        suggestions.append("Address TODO comments before merging")
    if "+password" in diff_content or "+secret" in diff_content:
        risks.append("Sensitive information (password/secret) found in code")
    
    # Simple change summary
    added_lines = diff_content.count("\n+")
    removed_lines = diff_content.count("\n-")
    changes.append(f"PR modifies {added_lines} lines and removes {removed_lines} lines")
    
    return {
        "summary": " ".join(changes),
        "risks": risks,
        "suggestions": suggestions,
        "confidence": "Medium"
    }

def format_markdown_review(analysis):
    """Format the analysis as a structured Markdown comment"""
    md = []
    md.append("## Code Review")
    md.append("")
    md.append("### Summary of Changes")
    md.append(analysis["summary"])
    md.append("")
    md.append("### Identified Risks")
    if analysis["risks"]:
        for risk in analysis["risks"]:
            md.append(f"- {risk}")
    else:
        md.append("- None identified")
    md.append("")
    md.append("### Improvement Suggestions")
    if analysis["suggestions"]:
        for suggestion in analysis["suggestions"]:
            md.append(f"- {suggestion}")
    else:
        md.append("- None identified")
    md.append("")
    md.append(f"**Confidence Score: {analysis['confidence']}**")
    return "\n".join(md)

def main():
    parser = argparse.ArgumentParser(description="Claude Code PR Reviewer")
    parser.add_argument("--pr", required=True, help="GitHub PR URL")
    parser.add_argument("--token", help="GitHub token for API access")
    args = parser.parse_args()

    # Parse the GitHub URL
    owner, repo, pr_number = parse_github_url(args.pr)
    if not owner or not repo or not pr_number:
        print("Error: Invalid GitHub PR URL")
        sys.exit(1)

    try:
        # Get the diff content
        diff_url = get_pr_diff(owner, repo, pr_number, args.token)
        diff_response = requests.get(diff_url)
        diff_content = diff_response.text
        
        # Analyze the diff
        analysis = analyze_diff(diff_content)
        
        # Format and print the review
        review = format_markdown_review(analysis)
        print(review)
        
    except Exception as e:
        print(f"Error processing PR: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()