    args = parser.parse_args()
    
    # Parse the PR URL
    try:
        pr_url = args.pr
        # Extract owner/repo/pr_number from the URL
        url_parts = pr_url.strip("/").split("/")
        owner, repo, _, pr_number = url_parts[-4], url_parts[-3], url_parts[-2], int(url_parts[-1])
    except Exception as e:
        print(f"Error parsing PR URL: {e}")
        return
    
    # Get PR diff
    try:
        diff = get_pr_diff(owner, repo, pr_number, os.getenv('GITHUB_TOKEN'))
