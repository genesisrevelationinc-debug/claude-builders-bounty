#!/usr/bin/env python3
"""
Claude Code PR Reviewer - A CLI tool that analyzes PR diffs and generates structured review comments.

Usage:
  claude-review --pr https://github.com/owner/repo/pull/123
"""

import argparse
import json
import os
import re
import requests
import sys
from typing import Dict, List, Tuple


def parse_github_url(url: str) -> Tuple[str, str, int]:
    """Parse GitHub PR URL into owner, repo, and PR number."""
    pattern = r"github\.com/([^/]+)/([^/]+)/pull/(\d+)"
    match = re.search(pattern, url)
    if not match:
        raise ValueError("Invalid GitHub PR URL")
    owner, repo, pr_number = match.groups()
    return owner, repo, int(pr_number)


def get_pr_diff(owner: str, repo: str, pr_number: int, token: str = None) -> str:
    """Fetch the diff of a GitHub PR."""
    url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_number}"
    headers = {
        "Accept": "application/vnd.github.v3.diff"
    }
    if token:
        headers["Authorization"] = f"token {token}"
    
    response = requests.get(url, headers=headers)
    response.raise_for_status()
    return response.text


def analyze_diff(diff: str) -> Dict:
    """Analyze the diff and return structured review data."""
    # This is a simplified analysis - in a real implementation,
    # this would be more sophisticated using Claude Code or similar AI
    
    lines = diff.split('\n')
    added_lines = [line for line in lines if line.startswith('+') and not line.startswith('+++')]
    removed_lines = [line for line in lines if line.startswith('-') and not line.startswith('---')]
    
    # Simple heuristics for demonstration
    changes = []
    risks = []
    suggestions = []
    
    # Summary based on file changes
    files_changed = set()
    for line in lines:
        if line.startswith('--- a/'):
            files_changed.add(line[6:])
    
    summary = f"This PR modifies {len(files_changed)} file(s) with {len(added_lines)} additions and {len(removed_lines)} deletions."
    
    # Identify risks based on keywords
    risky_keywords = ['delete', 'remove', 'drop', 'destroy', 'unsafe', 'hack', 'todo', 'fixme']
    for line in added_lines:
        for keyword in risky_keywords:
            if keyword in line.lower():
                risks.append(f"Potentially risky change: '{line.strip()}' contains '{keyword}'")
    
    # Improvement suggestions based on patterns
    if len(added_lines) > 100:
        suggestions.append("Consider breaking this PR into smaller, focused changes for easier review.")
    
    if not risks:
        risks.append("No obvious risks identified in the changes.")
    
    if not suggestions:
        suggestions.append("Code appears well-structured. Consider adding more comments for complex logic.")
    
    # Confidence based on analysis depth
    confidence = "Medium" if len(risks) > 1 else "High"
    
    return {
        "summary": summary,
        "risks": risks,
        "suggestions": suggestions,
        "confidence": confidence
    }


def format_markdown_review(analysis: Dict) -> str:
    """Format the analysis into a structured Markdown comment."""
    md = "## Code Review\n\n"
    md += f"### Summary\n{analysis['summary']}\n\n"
    md += "### Identified Risks\n"
    for risk in analysis['risks']:
        md += f"- {risk}\n"
    md += "\n### Improvement Suggestions\n"
    for suggestion in analysis['suggestions']:
        md += f"- {suggestion}\n"
    md += f"\n### Confidence\n**{analysis['confidence']}**\n"
    return md


def post_comment(owner: str, repo: str, pr_number: int, comment: str, token: str) -> None:
    """Post a comment to the GitHub PR."""
    url = f"https://api.github.com/repos/{owner}/{repo}/issues/{pr_number}/comments"
    headers = {
        "Authorization": f"token {token}",
        "Accept": "application/vnd.github.v3+json"
    }
    data = {
        "body": comment
    }
    response = requests.post(url, headers=headers, json=data)
    response.raise_for_status()


def main():
    parser = argparse.ArgumentParser(description="Claude Code PR Reviewer")
    parser.add_argument("--pr", required=True, help="GitHub PR URL")
    parser.add_argument("--post-comment", action="store_true", help="Post review as comment to PR")
    
    args = parser.parse_args()
    
    try:
        owner, repo, pr_number = parse_github_url(args.pr)
        token = os.environ.get("GITHUB_TOKEN")
        
        # Get PR diff
        diff = get_pr_diff(owner, repo, pr_number, token)
        
        # Analyze the diff
        analysis = analyze_diff(diff)
        
        # Format and print the review
        review = format_markdown_review(analysis)
        print(review)
        
        # Post as comment if requested
        if args.post_comment and token:
            post_comment(owner, repo, pr_number, review, token)
            print("\nReview posted as comment to PR.")
            
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()