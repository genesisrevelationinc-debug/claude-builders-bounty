#!/usr/bin/env python3
"""
Claude Code PR Review Agent

Reviews GitHub PRs and generates structured feedback.
"""

import argparse
import json
import os
import sys
from typing import Dict, List, Optional
import requests
import openai

def get_pr_diff(owner: str, repo: str, pr_number: int, token: str) -> str:
    """Fetch the diff of a pull request."""
    url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_number}"
    headers = {"Authorization": f"token {token}"}
    response = requests.get(url, headers=headers)
    response.raise_for_status()
    return response.json()["diff_url"]

def analyze_diff(diff_content: str) -> Dict:
    """Analyze the diff content using Claude."""
    prompt = f"""
    You are a senior software engineer reviewing a pull request.
    Analyze the following diff and provide a structured review:

    DIFF:
    {diff_content}

    Please provide your review in the following JSON format:
    {{
        "summary": "2-3 sentence summary of the changes",
        "risks": ["risk1", "risk2", ...],
        "suggestions": ["suggestion1", "suggestion2", ...],
        "confidence": "Low/Medium/High"
    }}
    """

    client = openai.OpenAI(api_key=os.environ.get("CLAUDE_API_KEY"))
    response = client.chat.completions.create(
        model="claude-3-sonnet-20240229",
        messages=[{"role": "user", "content": prompt}],
        response_format={"type": "json_object"}
    )
    
    return json.loads(response.choices[0].message.content)

def format_markdown_review(review: Dict) -> str:
    """Format the review as markdown."""
    md = "# PR Review\n\n"
    md += f"## Summary\n{review['summary']}\n\n"
    md += "## Risks\n"
    for risk in review['risks']:
        md += f"- {risk}\n"
    md += "\n## Suggestions\n"
    for suggestion in review['suggestions']:
        md += f"- {suggestion}\n"
    md += f"\n## Confidence\n{review['confidence']}\n"
    return md

def parse_pr_url(url: str) -> tuple:
    """Parse GitHub PR URL into components."""
    # Handle different URL formats
    if "github.com" in url:
        parts = url.split("/")
        owner = parts[3]
        repo = parts[4]
        pr_number = int(parts[6])
        return owner, repo, pr_number
    else:
        raise ValueError("Unsupported URL format")

def main():
    parser = argparse.ArgumentParser(description="Claude PR Reviewer")
    parser.add_argument("--pr", help="PR URL to review")
    parser.add_argument("--output", help="Output file (optional)")
    
    args = parser.parse_args()
    
    # Get GitHub token from environment
    github_token = os.environ.get("GITHUB_TOKEN")
    if not github_token:
        print("Error: GITHUB_TOKEN environment variable required")
        sys.exit(1)
    
    # Parse PR URL
    owner, repo, pr_number = parse_pr_url(args.pr)
    
    # Fetch PR diff
    try:
        diff = get_pr_diff(owner, repo, pr_number, github_token)
    except Exception as e:
        print(f"Error fetching PR diff: {e}")
        sys.exit(1)
    
    # Analyze with Claude
    try:
        review = analyze_diff(diff)
    except Exception as e:
        print(f"Error analyzing diff: {e}")
        sys.exit(1)
    
    # Format and output
    markdown_review = format_markdown_review(review)
    
    if args.output:
        with open(args.output, 'w') as f:
            f.write(markdown_review)
        print(f"Review written to {args.output}")
    else:
        print(markdown_review)

if __name__ == "__main__":
    main()