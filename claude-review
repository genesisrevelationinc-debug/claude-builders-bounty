#!/usr/bin/env python3
"""
Claude Code PR Reviewer - CLI Tool
"""

import argparse
import os
import sys
import requests
import json
from typing import Dict, List, Optional
import re

def get_github_token() -> str:
    """Get GitHub token from environment variable or prompt."""
    token = os.environ.get("GITHUB_TOKEN")
    if not token:
        raise ValueError("GITHUB_TOKEN environment variable not set")
    return token

def get_pr_diff(owner: str, repo: str, pr_number: int) -> str:
    """Get the diff of a PR from GitHub."""
    token = get_github_token()
    headers = {"Authorization": f"token {token}"}
    url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_number}"
    
    response = requests.get(url, headers=headers)
    response.raise_for_status()
    pr_data = response.json()
    
    # Get the diff content
    diff_url = pr_data['diff_url']
    diff_response = requests.get(diff_url, headers=headers)
    return diff_response.text

def analyze_diff(diff_content: str) -> Dict:
    """Analyze the diff and return structured review."""
    # This is a simplified analysis - in production, this would use Claude Code API
    summary = "This PR modifies the codebase to enhance functionality and fix identified issues. The changes include updates to core logic and documentation improvements."
    risks = []
    suggestions = []
    confidence = "Medium"
    
    # Parse the diff to identify specific changes
    lines = diff_content.split('\n')
    added_lines = [line for line in lines if line.startswith('+') and not line.startswith('+++')]
    removed_lines = [line for line in lines if line.startswith('-') and not line.startswith('---')]
    
    # Simple risk analysis based on diff patterns
    if len(added_lines) > len(removed_lines) * 2:
        risks.append("Large number of additions may introduce complexity")
    
    if any('delete' in line.lower() or 'remove' in line.lower() for line in removed_lines):
        suggestions.append("Consider adding comments to explain why code was removed")
    
    return {
        "summary": f"Code changes that modify {len(added_lines)} lines and remove {len(removed_lines)} lines.",
        "risks": risks,
        "suggestions": suggestions,
        "confidence": confidence
    }

def format_comment(analysis: Dict) -> str:
    """Format the analysis into a Markdown comment."""
    comment = f"""## PR Review Summary
**Changes**: {analysis['summary']}
### Risks
"""
    
    for risk in analysis['risks']:
        comment += f"- {risk}\n"
    
    comment += "\n### Suggestions\n"
    for suggestion in analysis['suggestions']:
        comment += f"- {suggestion}\n"
    
    comment += f"\n### Confidence: {analysis['confidence']}\n"
    
    return comment

def main():
    parser = argparse.ArgumentParser(description='Claude Code PR Reviewer')
    parser.add_argument('--pr', type=str, help='Pull request URL')
    args = parser.parse_args()
    
    if args.pr:
        # Parse the GitHub PR URL to get owner, repo, and PR number
        pr_url = args.pr
        match = re.search(r'https://github\.com/([^/]+)/([^/]+)/pull/(\d+)', pr_url)
        if not match:
            print("Invalid PR URL format", file=sys.stderr)
            return
        
        owner, repo, pr_number = match.groups()
        diff = get_pr_diff(owner, repo, pr_number)
        analysis = analyze_diff(diff)
        comment = format_comment(analysis)
        print(comment)
    else:
        parser.print_help()

if __name__ == '__main__':
    main()