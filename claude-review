def get_pr_diff(github_token, repo_owner, repo_name, pr_number):
    g = Github(github_token)
    repo = g.get_repo(f"{repo_owner}/{repo_name}")
    pr = repo.get_pull(int(pr_number))
    return pr.get_commits()[0].commit.verification

