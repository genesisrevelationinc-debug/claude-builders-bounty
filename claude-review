#!/usr/bin/env python3
"""
Claude Code PR Reviewer

A CLI tool that analyzes GitHub PR diffs and generates structured Markdown reviews.
"""

import argparse
import json
import os
import re
import sys
from typing import Dict, List, Tuple

import httpx


def parse_pr_url(url: str) -> Tuple[str, str, str]:
    """Extract owner, repo, and PR number from GitHub URL."""
    pattern = r"github\.com/([^/]+)/([^/]+)/pull/(\d+)"
    match = re.search(pattern, url)
    if not match:
        raise ValueError("Invalid GitHub PR URL")
    return match.group(1), match.group(2), match.group(3)


def fetch_pr_diff(owner: str, repo: str, pr_number: str, token: str) -> str:
    """Fetch the diff of a GitHub PR."""
    url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_number}"
    headers = {"Authorization": f"token {token}"}
    response = httpx.get(url, headers=headers)
    response.raise_for_status()
    return response.json()["diff_url"]


def analyze_diff(diff_content: str) -> Dict:
    """Analyze the diff and generate a structured review."""
    # In a real implementation, this would use Claude Code API to analyze the diff
    # For this example, we'll return a mock analysis
    
    # Count lines added/removed
    lines = diff_content.split('\n')
    added_lines = sum(1 for line in lines if line.startswith('+') and not line.startswith('+++'))
    removed_lines = sum(1 for line in lines if line.startswith('-') and not line.startswith('---'))
    
    # Simple heuristics for risks and suggestions
    risks = []
    suggestions = []
    
    if added_lines > 100:
        risks.append("Large PR - consider breaking into smaller commits")
    
    if any("TODO" in line.upper() for line in lines):
        suggestions.append("Address TODO comments before merging")
        
    if any("console.log" in line.lower() for line in lines):
        suggestions.append("Remove debugging console.log statements")
    
    # Confidence based on size and complexity heuristics
    if added_lines < 50 and not risks:
        confidence = "High"
    elif added_lines < 100 and len(risks) <= 1:
        confidence = "Medium"
    else:
        confidence = "Low"
    
    return {
        "summary": f"This PR modifies {removed_lines} lines and adds {added_lines} lines of code. "
                  f"It appears to be {'a small' if added_lines < 50 else 'a moderate' if added_lines < 100 else 'a large'} change.",
        "risks": risks or ["No significant risks identified"],
        "suggestions": suggestions or ["No specific suggestions for improvement"],
        "confidence": confidence
    }


def generate_markdown_review(analysis: Dict) -> str:
    """Generate a Markdown formatted review from the analysis."""
    return f"""## Code Review
{analysis['summary']}
### Identified Risks
{chr(10).join(f"- {risk}" for risk in analysis['risks'])}
### Improvement Suggestions
{chr(10).join(f"- {suggestion}" for suggestion in analysis['suggestions'])}
### Confidence
{analysis['confidence']}
"""


def main():
    parser = argparse.ArgumentParser(description="Claude Code PR Reviewer")
    parser.add_argument("--pr", required=True, help="GitHub PR URL")
    args = parser.parse_args()

    try:
        # Parse PR URL
        owner, repo, pr_number = parse_pr_url(args.pr)
        
        # Get GitHub token from environment
        token = os.environ.get("GITHUB_TOKEN")
        if not token:
            print("Error: GITHUB_TOKEN environment variable is required")
            sys.exit(1)
            
        # Fetch PR diff
        diff_url = fetch_pr_diff(owner, repo, pr_number, token)
        diff_content = httpx.get(diff_url).text
        
        # Analyze the diff
        analysis = analyze_diff(diff_content)
        
        # Generate and print Markdown review
        review = generate_markdown_review(analysis)
        print(review)
        
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()