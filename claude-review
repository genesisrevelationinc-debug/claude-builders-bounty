#!/usr/bin/env python3

import argparse
import requests
import json
import sys
import os
from typing import Dict, List, Optional


def fetch_pr_diff(repo_owner: str, repo_name: str, pr_number: int, token: Optional[str] = None) -> str:
    """Fetch the diff of a GitHub PR."""
    url = f"https://api.github.com/repos/{repo_owner}/{repo_name}/pulls/{pr_number}"
    headers = {
        "Accept": "application/vnd.github.v3.diff",
    }
    if token:
        headers["Authorization"] = f"token {token}"
    
    response = requests.get(url, headers=headers)
    response.raise_for_status()
    return response.text


def analyze_code(diff_text: str) -> Dict:
    """Analyze the code diff and return structured review results."""
    # This is a simplified analysis - in a real implementation, 
    # this would be replaced with actual code analysis logic
    
    lines = diff_text.split('\n')
    added_lines = [line for line in lines if line.startswith('+') and not line.startswith('+++')]
    removed_lines = [line for line in lines if line.startswith('-') and not line.startswith('---')]
    
    # Simple heuristics for demonstration
    risks = []
    suggestions = []
    
    if len(added_lines) > 100:
        risks.append("Large PR with many additions - may be difficult to review thoroughly")
    
    if any('TODO' in line for line in added_lines):
        suggestions.append("Consider removing TODO comments before merging")
        
    if any('console.log' in line.lower() for line in added_lines):
        suggestions.append("Remove debugging console.log statements")
        
    if any('password' in line.lower() or 'secret' in line.lower() for line in added_lines):
        risks.append("Potential security risk: hardcoded secrets detected")
        
    # Determine confidence based on analysis depth
    if len(risks) == 0 and len(suggestions) == 0:
        confidence = "Low"
    elif len(risks) + len(suggestions) < 3:
        confidence = "Medium"
    else:
        confidence = "High"
        
    return {
        "summary": f"This PR modifies {len(added_lines)} lines and removes {len(removed_lines)} lines. "
                  f"It appears to {'add new functionality' if added_lines else 'refactor existing code'}.",
        "risks": risks or ["No significant risks identified"],
        "suggestions": suggestions or ["No specific suggestions for improvement"],
        "confidence": confidence
    }


def format_markdown_review(review: Dict) -> str:
    """Format the review results as Markdown."""
    md = f"""## Code Review Summary

{review['summary']}

### Identified Risks
"""
    for risk in review['risks']:
        md += f"- {risk}\n"
        
    md += f"""
### Improvement Suggestions
"""
    for suggestion in review['suggestions']:
        md += f"- {suggestion}\n"
        
    md += f"""
### Confidence Score
{review['confidence']}
"""
    return md


def post_comment(repo_owner: str, repo_name: str, pr_number: int, comment: str, token: str) -> None:
    """Post a comment to the GitHub PR."""
    url = f"https://api.github.com/repos/{repo_owner}/{repo_name}/issues/{pr_number}/comments"
    headers = {
        "Authorization": f"token {token}",
        "Accept": "application/vnd.github.v3+json"
    }
    data = {
        "body": comment
    }
    
    response = requests.post(url, headers=headers, json=data)
    response.raise_for_status()


def main():
    parser = argparse.ArgumentParser(description="Claude Code PR Reviewer")
    parser.add_argument("--pr", required=True, help="GitHub PR URL")
    parser.add_argument("--token", help="GitHub personal access token")
    parser.add_argument("--comment", action="store_true", help="Post review as comment on PR")
    
    args = parser.parse_args()
    
    # Parse PR URL
    parts = args.pr.rstrip('/').split('/')
    if len(parts) < 4 or parts[-3] != 'pull':
        print("Invalid PR URL format. Expected: https://github.com/owner/repo/pull/123")
        sys.exit(1)
        
    repo_owner = parts[-4]
    repo_name = parts[-3]
    pr_number = parts[-1]
    
    # Get GitHub token
    token = args.token or os.environ.get('GITHUB_TOKEN')
    
    try:
        # Fetch PR diff
        diff = fetch_pr_diff(repo_owner, repo_name, pr_number, token)
        
        # Analyze code
        review = analyze_code(diff)
        
        # Format output
        markdown_review = format_markdown_review(review)
        
        # Post comment if requested
        if args.comment:
            if not token:
                print("GitHub token required to post comment. Set --token or GITHUB_TOKEN environment variable.")
                sys.exit(1)
            post_comment(repo_owner, repo_name, pr_number, markdown_review, token)
            print("Review comment posted to PR.")
        else:
            print(markdown_review)
            
    except Exception as e:
        print(f"Error: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()