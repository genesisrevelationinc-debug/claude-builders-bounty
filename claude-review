#!/usr/bin/env python3
"""
Claude Code PR Reviewer
Reviews a GitHub PR and generates a structured Markdown comment.
"""

import argparse
import requests
import sys
import os
from typing import Dict, List, Tuple


def fetch_pr_data(pr_url: str) -> Dict:
    """Fetch PR data from GitHub API"""
    # Extract owner, repo, and PR number from URL
    parts = pr_url.rstrip('/').split('/')
    owner, repo, pr_number = parts[-4], parts[-3], parts[-1]
    
    # GitHub API URL
    api_url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_number}"
    
    # Try with GitHub token if available
    headers = {}
    token = os.getenv('GITHUB_TOKEN')
    if token:
        headers['Authorization'] = f'token {token}'
    
    response = requests.get(api_url, headers=headers)
    response.raise_for_status()
    return response.json()


def analyze_diff(diff_text: str) -> Tuple[str, List[str], List[str], str]:
    """Analyze the diff and return structured review"""
    
    # Simple heuristics for demonstration
    lines = diff_text.split('\n')
    added_lines = [line for line in lines if line.startswith('+') and not line.startswith('+++')]
    removed_lines = [line for line in lines if line.startswith('-') and not line.startswith('---')]
    
    # Summary (simplified)
    file_count = diff_text.count('diff --git')
    summary = f"This pull request modifies {file_count} file(s) with {len(added_lines)} additions and {len(removed_lines)} deletions."
    
    # Risks (simplified heuristics)
    risks = []
    if any('delete' in line.lower() or 'remove' in line.lower() for line in added_lines):
        risks.append("Potential data deletion detected - verify this is intentional")
    if any('TODO' in line for line in added_lines):
        risks.append("TODO comment found - should be addressed before merging")
    if any('console.log' in line or 'print(' in line for line in added_lines):
        risks.append("Debugging output detected - consider removing before merge")
        
    # Suggestions (simplified heuristics)
    suggestions = []
    if len(added_lines) > 100:
        suggestions.append("Large PR detected - consider breaking into smaller commits for easier review")
    if not risks and not suggestions:
        suggestions.append("Code appears clean and well-structured")
        
    # Confidence
    confidence = "Medium"  # Default
    if len(added_lines) < 20 and len(removed_lines) < 20:
        confidence = "High"
    elif len(added_lines) > 200 or len(removed_lines) > 200:
        confidence = "Low"
        
    return summary, risks, suggestions, confidence


def generate_markdown_comment(summary: str, risks: List[str], suggestions: List[str], confidence: str) -> str:
    """Generate structured Markdown comment"""
    md = []
    md.append("## Code Review")
    md.append("")
    md.append("### Summary of Changes")
    md.append(summary)
    md.append("")
    
    md.append("### Identified Risks")
    if risks:
        for risk in risks:
            md.append(f"- ⚠️ {risk}")
    else:
        md.append("- None identified")
    md.append("")
    
    md.append("### Improvement Suggestions")
    if suggestions:
        for suggestion in suggestions:
            md.append(f"- 💡 {suggestion}")
    else:
        md.append("- None identified")
    md.append("")
    
    md.append(f"### Confidence Score: {confidence}")
    
    return "\n".join(md)


def main():
    parser = argparse.ArgumentParser(description="Review a GitHub PR and generate structured comment")
    parser.add_argument("--pr", required=True, help="GitHub PR URL")
    
    args = parser.parse_args()
    
    try:
        # Fetch PR data
        pr_data = fetch_pr_data(args.pr)
        
        # Get diff content
        diff_url = pr_data['diff_url']
        token = os.getenv('GITHUB_TOKEN')
        headers = {}
        if token:
            headers['Authorization'] = f'token {token}'
            
        diff_response = requests.get(diff_url, headers=headers)
        diff_response.raise_for_status()
        diff_content = diff_response.text
        
        # Analyze the diff
        summary, risks, suggestions, confidence = analyze_diff(diff_content)
        
        # Generate and print Markdown comment
        comment = generate_markdown_comment(summary, risks, suggestions, confidence)
        print(comment)
        
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()