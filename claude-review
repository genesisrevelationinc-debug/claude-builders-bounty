#!/usr/bin/env node

const { execSync } = require('child_process');
const https = require('https');
const { Octokit } = require('@octokit/rest');

function getDiff(url) {
  const [, owner, repo, , prNumber] = url.split('/');
  const octokit = new Octokit({ auth: process.env.GITHUB_TOKEN });
  return octokit.pulls.get({
    owner,
    repo,
    pull_number: parseInt(prNumber)
  }).then(({ data }) => {
    return data;
  });
}

function analyzeCode(diff) {
  // This is a simplified analysis
  // In a real implementation, you would integrate with Claude Code API
  const changes = diff.split('\n').filter(line => line.startsWith('+') || line.startsWith('-'));
  const addedLines = changes.filter(line => line.startsWith('+'));
  const removedLines = changes.filter(line => line.startsWith('-'));
  
  return {
    summary: `This PR modifies ${addedLines.length} lines and removes ${removedLines.length} lines. The changes appear to be ${addedLines.length > removedLines.length ? 'additive' : 'refactoring'} in nature.`,
    risks: [
      'No critical risks identified in this automated review',
      'Consider if all edge cases are covered by the changes'
    ],
    suggestions: [
      'Consider adding more unit tests to cover the new functionality',
      'Documentation should be updated to reflect these changes'
    ],
    confidence: 'Medium'
  };
}

function formatComment(analysis) {
  return `
## Code Review

### Summary
${analysis.summary}

### Risks
${analysis.risks.map(risk => `- ${risk}`).join('\n')}

### Suggestions
${analysis.suggestions.map(suggestion => `- ${suggestion}`).join('\n')}

### Confidence
${analysis.confidence}
`;
}

async function main() {
  const prUrl = process.argv[2];
  if (!prUrl) {
    console.error('Usage: claude-review <pr-url>');
    process.exit(1);
  }

  try {
    const prData = await getDiff(prUrl);
    const analysis = analyzeCode(prData.patch);
    console.log(formatComment(analysis));
  } catch (error) {
    console.error('Error:', error.message);
    process.exit(1);
  }
}

main();