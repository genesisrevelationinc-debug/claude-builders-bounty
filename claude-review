#!/usr/bin/env python3

import sys
import argparse
import requests
import json
import os

def get_pr_details(pr_url):
    """Extract owner, repo, and pr number from URL"""
    parts = pr_url.rstrip('/').split('/')
    pr_number = parts[-1]
    repo = parts[-3]
    owner = parts[-4]
    return owner, repo, pr_number

def fetch_pr_data(owner, repo, pr_number, token):
    """Fetch PR data from GitHub API"""
    url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_number}"
    headers = {'Authorization': f'token {token}'} if token else {}
    response = requests.get(url, headers=headers)
    response.raise_for_status()
    return response.json()

def get_pr_diff(owner, repo, pr_number, token):
    """Get PR diff from GitHub API"""
    url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_number}"
    headers = {
        'Authorization': f'token {token}',
        'Accept': 'application/vnd.github.v3.diff'
    }
    response = requests.get(url, headers=headers)
    response.raise_for_status()
    return response.text

def analyze_code(diff_content):
    """Analyze the code changes and return structured feedback"""
    # This is a simplified analysis - in a real implementation,
    # this would use Claude Code or another AI model to analyze the code
    
    # Simple keyword-based analysis for demonstration
    risks = []
    suggestions = []
    
    if "TODO" in diff_content:
        risks.append("Contains TODO comments that should be addressed")
    
    if "FIXME" in diff_content:
        risks.append("Contains FIXME comments indicating known issues")
    
    if "console.log" in diff_content:
        suggestions.append("Remove or refactor debugging console.log statements")
    
    if "magic number" in diff_content.lower():
        suggestions.append("Replace magic numbers with named constants for clarity")
    
    # Determine confidence based on content analysis
    if "!" in diff_content or "delete" in diff_content.lower():
        confidence = "Low"
    elif "function" in diff_content.lower() and "var" in diff_content.lower():
        confidence = "Medium"
    else:
        confidence = "High"
    
    return {
        "summary": "This PR modifies core application logic. Changes include feature updates and code refactoring.",
        "risks": risks or ["No significant risks identified"],
        "suggestions": suggestions or ["Consider adding more unit tests for complete coverage"],
        "confidence": confidence
    }

def format_comment(analysis):
    """Format the analysis into a structured Markdown comment"""
    comment = f"""## Code Review Summary

**Summary of Changes:**
{analysis['summary']}

**Identified Risks:**
"""
    
    for risk in analysis['risks']:
        comment += f"- {risk}\n"
    
    comment += "\n**Suggestions:**
"
    
    for suggestion in analysis['suggestions']:
        comment += f"- {suggestion}\n"
    
    comment += f"\n**Confidence Score:** {analysis['confidence']}\n"
    
    return comment

def main():
    parser = argparse.ArgumentParser(description='Claude Code PR Reviewer')
    parser.add_argument('--pr', required=True, help='Pull Request URL')
    parser.add_argument('--token', help='GitHub Personal Access Token')
    args = parser.parse_args()
    
    owner, repo, pr_number = get_pr_details(args.pr)
    diff_content = get_pr_diff(owner, repo, pr_number, args.token)
    analysis = analyze_code(diff_content)
    comment = format_comment(analysis)
    print(comment)

if __name__ == "__main__":
    main()