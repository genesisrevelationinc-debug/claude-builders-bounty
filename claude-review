#!/usr/bin/env python3

import argparse
import requests
import sys
import os
import re
from typing import Dict, List, Tuple


def parse_pr_url(url: str) -> Tuple[str, str, int]:
    """Parse GitHub PR URL to extract owner, repo, and PR number."""
    pattern = r"github\.com/([^/]+)/([^/]+)/pull/(\d+)"
    match = re.search(pattern, url)
    if not match:
        raise ValueError("Invalid GitHub PR URL")
    owner, repo, pr_number = match.groups()
    return owner, repo, int(pr_number)


def get_github_token() -> str:
    """Get GitHub token from environment variable."""
    token = os.environ.get("GITHUB_TOKEN")
    if not token:
        raise ValueError("GITHUB_TOKEN environment variable is required")
    return token


def fetch_pr_diff(owner: str, repo: str, pr_number: int, token: str) -> str:
    """Fetch the diff of a GitHub PR."""
    headers = {"Authorization": f"token {token}"}
    url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_number}"
    response = requests.get(url, headers=headers)
    response.raise_for_status()
    pr_data = response.json()
    return pr_data["diff_url"]


def fetch_diff_content(diff_url: str, token: str) -> str:
    """Fetch the actual diff content."""
    headers = {"Authorization": f"token {token}"}
    response = requests.get(diff_url, headers=headers)
    response.raise_for_status()
    return response.text


def analyze_diff(diff_content: str) -> Dict:
    """Analyze the diff and return structured feedback."""
    # This is a simplified analyzer - in a real implementation,
    # this would contain more sophisticated analysis logic
    changes = []
    risks = []
    suggestions = []
    
    # Split the diff into files and hunks
    files = diff_content.split("diff --git")
    for file in files[1:]:  # Skip the first empty split
        lines = file.strip().split('\n')
        if not lines:
            continue
            
        # Extract file name
        file_header = lines[0]
        file_name_match = re.search(r" b/(.+)", file_header)
        file_name = file_name_match.group(1) if file_name_match else "unknown"
        
        # Look for added/removed lines
        added_lines = [line for line in lines if line.startswith("+") and not line.startswith("+++") and len(line) > 1]
        removed_lines = [line for line in lines if line.startswith("-") and not line.startswith("---") and len(line) > 1]
        
        if added_lines or removed_lines:
            changes.append(f"Changes in {file_name}")
            
        # Simple heuristics for risks and suggestions
        for line in added_lines:
            if "password" in line.lower() or "secret" in line.lower():
                risks.append("Potential exposure of sensitive information")
            if "TODO" in line:
                suggestions.append("Consider removing TODO comments in production code")
                
    # Generate a simple summary
    summary = "This pull request contains changes to multiple files with additions and deletions."
    if len(files) > 2:
        summary = f"This pull request modifies {len(files)-1} files with various additions and deletions."
    
    # Determine confidence based on diff size
    changes_count = diff_content.count("\n+")
    if changes_count > 100:
        confidence = "Low"
    elif changes_count > 20:
        confidence = "Medium"
    else:
        confidence = "High"

    return {
        "summary": summary,
        "risks": risks if risks else ["No significant risks identified"],
        "suggestions": suggestions if suggestions else ["No specific suggestions identified"],
        "confidence": confidence
    }


def generate_markdown_report(analysis: Dict) -> str:
    """Generate a structured Markdown report from the analysis."""
    report = [
        "## Code Review",
        "",
        f"### Summary",
        f"{analysis['summary']}",
        "",
        "### Identified Risks",
        *[f"- {risk}" for risk in analysis['risks']],
        "",
        "### Improvement Suggestions",
        *[f"- {suggestion}" for suggestion in analysis['suggestions']],
        "",
        f"### Confidence Score: {analysis['confidence']}",
        ""
    ]
    return "\n".join(report)


def main():
    parser = argparse.ArgumentParser(description="Claude Code PR Reviewer")
    parser.add_argument("--pr", required=True, help="GitHub PR URL")
    
    args = parser.parse_args()
    
    try:
        owner, repo, pr_number = parse_pr_url(args.pr)
        token = get_github_token()
        diff_url = fetch_pr_diff_diff(owner, repo, pr_number, token)
        diff_content = fetch_diff_content(diff_url, token)
        analysis = analyze_diff(diff_content)
        report = generate_markdown_report(analysis)
        print(report)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()