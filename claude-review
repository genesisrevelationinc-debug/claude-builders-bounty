#!/usr/bin/env python3
"""
Claude Code PR Reviewer

A CLI tool that analyzes GitHub PR diffs and generates structured review comments.
"""

import argparse
import json
import os
import re
import sys
import urllib.parse
from typing import Dict, List, Optional, Tuple

import httpx
import openai
from github import Github


def parse_pr_url(url: str) -> Tuple[str, str, str]:
    """Parse GitHub PR URL into owner, repo, and pull request number."""
    pattern = r"github\.com/([^/]+)/([^/]+)/pull/(\d+)"
    match = re.search(pattern, url)
    if not match:
        raise ValueError("Invalid GitHub PR URL")
    return match.group(1), match.group(2), match.group(3)


def get_pr_diff(github_token: str, owner: str, repo: str, pr_number: str) -> str:
    """Fetch the diff of a pull request."""
    g = Github(github_token)
    repository = g.get_repo(f"{owner}/{repo}")
    pull_request = repository.get_pull(int(pr_number))
    return pull_request.get_files()


def analyze_diff_with_claude(diff: str, claude_api_key: str) -> Dict:
    """Analyze the PR diff using Claude AI and return structured feedback."""
    client = openai.OpenAI(
        api_key=claude_api_key,
        base_url="https://api.anthropic.com/v1",
        default_headers={
            "anthropic-version": "2023-06-01",
            "anthropic-dangerous-direct-browser-access": "true"
        }
    )

    prompt = f"""
    You are an expert software engineer reviewing a pull request.
    Analyze the following code diff and provide a structured review:

    {diff}

    Please provide your review in the following JSON format:
    {{
      "summary": "2-3 sentence summary of the changes",
      "risks": [
        "List of potential risks or issues"
      ],
      "suggestions": [
        "List of improvement suggestions"
      ],
      "confidence": "Low|Medium|High"
    }}
    """

    response = client.chat.completions.create(
        model="claude-3-opus-20240229",
        messages=[{"role": "user", "content": prompt}],
        max_tokens=1000,
        temperature=0.2
    )

    content = response.choices[0].message.content
    try:
        # Extract JSON from the response
        json_start = content.find('{')
        json_end = content.rfind('}') + 1
        json_str = content[json_start:json_end]
        return json.loads(json_str)
    except json.JSONDecodeError:
        raise ValueError("Failed to parse Claude's response as JSON")


def format_markdown_review(review: Dict) -> str:
    """Format the review dictionary as a Markdown comment."""
    md = "# Code Review\n\n"
    md += f"## Summary\n{review['summary']}\n\n"
    md += "## Risks\n"
    for risk in review['risks']:
        md += f"- {risk}\n"
    md += "\n## Suggestions\n"
    for suggestion in review['suggestions']:
        md += f"- {suggestion}\n"
    md += f"\n## Confidence\n**{review['confidence']}**\n"
    return md


def post_comment_to_pr(
    github_token: str,
    owner: str,
    repo: str,
    pr_number: str,
    comment: str
) -> None:
    """Post a comment to the pull request."""
    g = Github(github_token)
    repository = g.get_repo(f"{owner}/{repo}")
    pull_request = repository.get_pull(int(pr_number))
    pull_request.create_issue_comment(comment)


def main():
    parser = argparse.ArgumentParser(description="Claude Code PR Reviewer")
    parser.add_argument(
        "--pr",
        required=True,
        help="GitHub PR URL (e.g., https://github.com/owner/repo/pull/123)"
    )
    parser.add_argument(
        "--post-comment",
        action="store_true",
        help="Post the review as a comment to the PR"
    )
    
    args = parser.parse_args()

    # Get environment variables
    github_token = os.environ.get("GITHUB_TOKEN")
    claude_api_key = os.environ.get("CLAUDE_API_KEY")

    if not github_token:
        print("Error: GITHUB_TOKEN environment variable is required")
        sys.exit(1)

    if not claude_api_key:
        print("Error: CLAUDE_API_KEY environment variable is required")
        sys.exit(1)

    try:
        # Parse PR URL
        owner, repo, pr_number = parse_pr_url(args.pr)

        # Get PR diff
        print("Fetching PR diff...")
        g = Github(github_token)
        repository = g.get_repo(f"{owner}/{repo}")
        pull_request = repository.get_pull(int(pr_number))
        diff = ""
        for file in pull_request.get_files():
            if file.patch:
                diff += f"\n--- {file.filename} ---\n{file.patch}\n"

        if not diff:
            print("No changes found in the PR")
            sys.exit(0)

        # Analyze with Claude
        print("Analyzing with Claude...")
        review = analyze_diff_with_claude(diff, claude_api_key)

        # Format and print the review
        markdown_review = format_markdown_review(review)
        print(markdown_review)

        # Post comment if requested
        if args.post_comment:
            print("Posting comment to PR...")
            post_comment_to_pr(github_token, owner, repo, pr_number, markdown_review)
            print("Comment posted successfully!")

    except Exception as e:
        print(f"Error: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()