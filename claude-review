#!/usr/bin/env node

const { Octokit } = require('@octokit/rest');
const { program } = require('commander');
const chalk = require('chalk');

// Parse command line arguments
program
  .version('1.0.0')
  .option('-p, --pr <url>', 'Pull request URL')
  .parse();

const options = program.opts();

// Validate input
if (!options.pr) {
  console.error('Error: PR URL is required');
  process.exit(1);
}

// Extract owner, repo, and pull_number from URL
const urlParts = options.pr.match(/github\.com\/([^/]+)\/([^/]+)\/pull\/(\d+)/);
if (!urlParts) {
  console.error('Error: Invalid GitHub PR URL format');
  process.exit(1);
}

const owner = urlParts[1];
const repo = urlParts[2];
const pull_number = parseInt(urlParts[3]);

// Initialize Octokit with personal access token
const octokit = new Octokit({
  auth: process.env.GITHUB_TOKEN
});

async function analyzePR() {
  try {
    // Get PR files
    const { data: files } = await octokit.pulls.listFiles({
      owner,
      repo,
      pull_number
    });

    // Get PR details
    const { data: pr } = await octokit.pulls.get({
      owner,
      repo,
      pull_number
    });

    // Generate review comment
    const comment = generateReviewComment(files, pr);
    
    // Post comment to PR
    await octokit.issues.createComment({
      owner,
      repo,
      issue_number: pull_number,
      body: comment
    });
    
    console.log('Successfully posted structured review comment to PR');
  } catch (error) {
    console.error('Error:', error.message);
    process.exit(1);
  }
}

function generateReviewComment(files, pr) {
  // This is a simplified version - in practice, this would be replaced with Claude Code analysis
  const changes = files.map(file => ({
    filename: file.filename,
    patch: file.patch
  }));
  
  // Mock analysis - in a real implementation, Claude Code would analyze the changes
  const summary = `This pull request modifies ${files.length} file(s). Key changes include updates to ${changes.map(c => c.filename).join(', ')}.`;
  
  const risks = [
    "Potential breaking changes in API endpoints",
    "Missing input validation in form handling components",
    "Possible performance implications with new database queries"
  ];
  
  const suggestions = [
    "Consider adding more specific error handling for edge cases",
    "Add unit tests to cover the new functionality",
    "Review the variable naming for consistency across the codebase"
  ];
  
  const confidence = "Medium";
  
  return `## Code Review

### Summary of Changes
${summary}

### Identified Risks
${risks.map(r => `- ${r}`).join('\n')}

### Improvement Suggestions
${suggestions.map(s => `- ${s}`).join('\n')}

### Confidence
${confidence}
`;
}

// Run the analysis
analyzePR();