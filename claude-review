#!/usr/bin/env python3

import argparse
import requests
import json
import sys
import os

def get_pr_details(api_url, token, repo, pr_number):
    headers = {"Authorization": f"token {token}"} if token else {}
    
    # Get PR details
    pr_url = f"{api_url}/repos/{repo}/pulls/{pr_number}"
    pr_response = requests.get(pr_url, headers=headers)
    pr_response.raise_for_status()
    pr_data = pr_response.json()
    
    # Get PR files (for diff)
    files_url = f"{pr_url}/files"
    files_response = requests.get(files_url, headers=headers)
    files_response.raise_for_status()
    files_data = files_response.json()
    
    return {
        "title": pr_data["title"],
        "description": pr_data["body"] or "",
        "files": files_data
    }

def analyze_diff(files):
    changes = []
    risks = []
    suggestions = []
    
    for file in files:
        filename = file["filename"]
        patch = file["patch"] if "patch" in file else ""
        changes.append(f"Modified {filename}")
        
        # Simple risk heuristics
        if "package-lock.json" in filename or "requirements.txt" in filename:
            risks.append("Dependency changes detected - check for unintended version updates")
        if "Dockerfile" in filename:
            risks.append("Docker configuration changes - verify container build process")
        if ".env" in filename:
            risks.append("Environment file changes - check for exposed secrets")
        
        # Simple suggestion heuristics
        if filename.endswith((".js", ".ts", ".py")):
            suggestions.append(f"Consider adding tests for logic changes in {filename}")
        if filename.endswith((".html", ".css")):
            suggestions.append(f"Verify UI changes in {filename} across different browsers")
            
    return changes, risks, suggestions

def generate_review(changes, risks, suggestions):
    change_summary = " ".join(changes[:3]) + ("..." if len(changes) > 3 else "")
    
    # Determine confidence based on complexity
    confidence = "Medium"
    if len(risks) > 3:
        confidence = "Low"
    elif len(risks) == 0 and len(suggestions) == 0:
        confidence = "High"
    
    review = f"""## Code Review

### Summary of Changes
{change_summary}

### Identified Risks
"""
    
    if risks:
        for risk in risks:
            review += f"- {risk}\n"
    else:
        review += "- No significant risks identified\n"
    
    review += """
### Improvement Suggestions
"""
    
    if suggestions:
        for suggestion in suggestions:
            review += f"- {suggestion}\n"
    else:
        review += "- No suggestions at this time\n"
    
    review += f"""
### Confidence Score
{confidence}
"""
    
    return review

def main():
    parser = argparse.ArgumentParser(description="Claude Code PR Reviewer")
    parser.add_argument("--pr", required=True, help="GitHub PR URL")
    args = parser.parse_args()
    
    # Parse PR URL
    parts = args.pr.split("/")
    repo = f"{parts[-3]}/{parts[-2]}"
    pr_number = parts[-1]
    
    # Use GITHUB_TOKEN from environment if available
    token = os.environ.get("GITHUB_TOKEN")
    api_url = "https://api.github.com"
    
    try:
        pr_details = get_pr_details(api_url, token, repo, pr_number)
        changes, risks, suggestions = analyze_diff(pr_details["files"])
        review = generate_review(changes, risks, suggestions)
        print(review)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()