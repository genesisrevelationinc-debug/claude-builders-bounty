def get_pr_diff(github_token, repo_url, pr_number):
    # Parse the repository and PR number from the URL
    parts = repo_url.rstrip('/').split('/')
    repo_name = f"{parts[-2]}/{parts[-1]}"
    pr_number = pr_number
    
    g = Github(github_token)
    repo = g.get_repo(repo_name)
    pr = repo.get_pull(int(pr_number))
    
    return {
        'title': pr.title,
        'body': pr.body,
        'diff': pr.get_files()[0].patch if pr.get_files() else ''
    }

