from github import Github
from typing import Optional
import re

def get_pr_diff(repo_owner: str, repo_name: str, pr_number: int, github_token: Optional[str] = None) -> str:
    """Fetch PR diff from GitHub"""
    g = Github(github_token)
    repo = g.get_repo(f"{repo_owner}/{repo_name}")
    pr = repo.get_pull(int(pr_number))
    return pr.get_commits().reversed[0].get_patch() if pr.commits > 0 else ""

def analyze_code(diff_text: str) -> dict:
    """Analyze code changes using Claude"""
    # In a real implementation, this would call Claude API
    # For this implementation, we'll return a mock analysis
    return {
        "summary": "This PR modifies the authentication system to use JWT tokens instead of session cookies.",
        "risks": [
            "The new JWT implementation may introduce security vulnerabilities if not properly validated",
            "The removal of session-based authentication could break existing client integrations"
        ],
