#!/usr/bin/env node

const { Octokit } = require('@octokit/rest');
const { program } = require('commander');
const fs = require('fs');

// Parse command line arguments
program
  .version('1.0.0')
  .description('Claude Code PR Reviewer - Analyze PRs and generate structured review comments')
  .option('-p, --pr <url>', 'GitHub PR URL to review')
  .option('-t, --token <token>', 'GitHub personal access token')
  .parse();

const options = program.opts();

// Validate required arguments
if (!options.pr) {
  console.error('Error: PR URL is required. Use --pr option to specify a GitHub PR URL');
  process.exit(1);
}

// Extract owner, repo, and pull number from URL
const prUrl = options.pr;
const urlMatch = prUrl.match(/github\.com\/([^/]+)\/([^/]+)\/pull\/(\d+)/);
if (!urlMatch) {
  console.error('Invalid GitHub PR URL format');
  process.exit(1);
}

const owner = urlMatch[1];
const repo = urlMatch[2];
const pullNumber = parseInt(urlMatch[3]);

// Get GitHub token from flag or environment variable
const token = options.token || process.env.GITHUB_TOKEN;
if (!token) {
  console.error('Error: GitHub token is required. Set GITHUB_TOKEN environment variable or use --token option');
  process.exit(1);
}

const octokit = new Octokit({ auth: token });

async function getPRDiff(octokit, owner, repo, pullNumber) {
  const { data: diff } = await octokit.pulls.get({
    owner,
    repo,
    pull_number: pullNumber,
    mediaType: {
      format: "diff",
    },
  });
  return diff.data;
}

function analyzeCode(changes) {
  // This is a simplified analysis
  // In a real implementation, this would be more sophisticated
  const fileChanges = changes.split('diff --git').slice(1);
  
  return {
    summary: `This pull request modifies ${fileChanges.length} file(s) with various code changes.`,
    risks: [
      'Potential security vulnerabilities in user input handling',
      'Performance implications of new algorithms',
      'Breaking changes to existing APIs'
    ],
    suggestions: [
      'Add input validation for user-provided data',
      'Consider caching strategies for improved performance',
      'Add comprehensive tests for new functionality'
    ],
    confidence: 'Medium'
  };
}

function generateMarkdownReport(analysis) {
  return `## Code Review
### Summary of Changes
${analysis.summary}

### Identified Risks
${analysis.risks.map(risk => `- ${risk}`).join('
') || 'None'}

### Improvement Suggestions
${analysis.suggestions.map(suggestion => `- ${suggestion}`).join('
') || 'None'}

### Confidence: ${analysis.confidence}
`;
}

async function postComment(octokit, owner, repo, pullNumber, body) {
  await octokit.issues.createComment({
    owner,
    repo,
    issue_number: pullNumber,
    body
  });
}

async function main() {
  try {
    const diff = await getPRDiff(octokit, owner, repo, pullNumber);
    const analysis = analyzeCode(diff);
    const report = generateMarkdownReport(analysis);
    console.log('Generated review comment:');
    console.log(report);
    await postComment(octokit, owner, repo, pullNumber, report);
    console.log('Comment posted successfully');
  } catch (error) {
    console.error('Error:', error.message);
    process.exit(1);
  }
}

if (require.main === module) {
  main();
}

module.exports = { analyzeCode, generateMarkdownReport };