#!/usr/bin/env python3
"""
Claude Code PR Reviewer

A CLI tool that analyzes GitHub PR diffs and generates structured review comments.
"""

import argparse
import json
import os
import re
import sys
from typing import Dict, List, Optional

import httpx


def parse_pr_url(url: str) -> tuple[str, str, str]:
    """Parse GitHub PR URL into owner, repo, and PR number."""
    pattern = r"github\.com/([^/]+)/([^/]+)/pull/(\d+)"
    match = re.search(pattern, url)
    if not match:
        raise ValueError("Invalid GitHub PR URL")
    return match.group(1), match.group(2), match.group(3)


def fetch_pr_diff(owner: str, repo: str, pr_number: str, token: Optional[str] = None) -> str:
    """Fetch the diff of a GitHub PR."""
    headers = {"Accept": "application/vnd.github.v3.diff"}
    if token:
        headers["Authorization"] = f"token {token}"
        
    url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_number}"
    response = httpx.get(url, headers=headers)
    response.raise_for_status()
    return response.text


def analyze_diff(diff: str) -> Dict:
    """Analyze the diff and return structured review data."""
    # This is a simplified analysis - in a real implementation, 
    # you would integrate with Claude Code API or similar
    
    lines = diff.split('\n')
    added_lines = [line for line in lines if line.startswith('+') and not line.startswith('+++')]
    removed_lines = [line for line in lines if line.startswith('-') and not line.startswith('---')]
    
    # Simple heuristics for demonstration
    changes = []
    risks = []
    suggestions = []
    
    if added_lines:
        changes.append(f"Added {len(added_lines)} lines of code")
    if removed_lines:
        changes.append(f"Removed {len(removed_lines)} lines of code")
        
    # Look for common risk patterns
    if any('TODO' in line or 'FIXME' in line for line in added_lines):
        risks.append("Found TODO/FIXME comments in new code")
        
    if any('console.log' in line or 'print(' in line for line in added_lines):
        risks.append("Found debugging output in new code")
        
    if any('password' in line.lower() or 'secret' in line.lower() for line in added_lines):
        risks.append("Potential hardcoded secrets detected")
        
    # Suggestions based on common patterns
    if not any('test' in line.lower() for line in added_lines):
        suggestions.append("Consider adding unit tests for new functionality")
        
    if any('http:' in line for line in added_lines):
        suggestions.append("Consider using HTTPS instead of HTTP for external connections")

    # Determine confidence based on analysis depth
    confidence = "Medium" if risks or suggestions else "Low"
    
    return {
        "summary": " ".join(changes) if changes else "Modified existing code",
        "risks": risks or ["No significant risks identified"],
        "suggestions": suggestions or ["No specific suggestions"],
        "confidence": confidence
    }


def generate_markdown_review(analysis: Dict) -> str:
    """Generate a structured Markdown review comment."""
    return f"""## Code Review Summary
{analysis['summary']}

### Identified Risks
{''.join(f'- {risk}\n' for risk in analysis['risks'])}

### Improvement Suggestions
{''.join(f'- {suggestion}\n' for suggestion in analysis['suggestions'])}

### Confidence
{analysis['confidence']}
"""


def main():
    parser = argparse.ArgumentParser(description="Claude Code PR Reviewer")
    parser.add_argument("--pr", required=True, help="GitHub PR URL")
    parser.add_argument("--token", help="GitHub token for API access")
    
    args = parser.parse_args()
    
    try:
        # Parse PR URL
        owner, repo, pr_number = parse_pr_url(args.pr)
        
        # Fetch PR diff
        token = args.token or os.environ.get("GITHUB_TOKEN")
        diff = fetch_pr_diff(owner, repo, pr_number, token)
        
        # Analyze the diff
        analysis = analyze_diff(diff)
        
        # Generate and print Markdown review
        review = generate_markdown_review(analysis)
        print(review)
        
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()