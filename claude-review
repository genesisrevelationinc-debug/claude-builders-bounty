def get_pr_diff(owner: str, repo: str, pr_number: int, github_token: str) -> str:
    """Fetch the diff of the pull request"""
    g = Github()
    pull_request = g.get_repo(f"{owner}/{repo}").get_pull(pr_number)
    return pull_request.get_patch()

