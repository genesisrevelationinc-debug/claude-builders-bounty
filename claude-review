#!/usr/bin/env node

const { Octokit } = require('@octokit/rest');
const { program } = require('commander');
const Anthropic = require('@anthropic-ai/sdk');
const fs = require('fs');
const path = require('path');

// Initialize CLI
program
  .name('claude-review')
  .option('-p, --pr <url>', 'GitHub PR URL to review')
  .option('-t, .--token <token>', 'GitHub token')
  .option('-o, --output <file>', 'Output file for the review')
  .parse();

const options = program.opts();

// Extract owner, repo, and pull number from GitHub URL
function parsePRUrl(url) {
  const match = url.match(/github\.com\/([^\/]+)\/([^\/]+)\/pull\/(\d+)/);
  if (!match) {
    throw new Error('Invalid GitHub PR URL');
  }
  return {
    owner: match[1],
    repo: match[2],
    pull_number: parseInt(match[3])
  };
}

// Fetch PR data from GitHub
async function fetchPRData() {
  if (!options.pr) {
    console.error('Please provide a PR URL with --pr');
    process.exit(1);
  }

  const { owner, repo, pull_number } = parsePRUrl(options.pr);
  const token = options.token || process.env.GITHUB_TOKEN;
  
  if (!token) {
    console.error('Please provide a GitHub token via --token or GITHUB_TOKEN environment variable');
    process.exit(1);
  }

  const octokit = new Octokit({ auth: token });
  
  // Get PR data
  const { data: pr } = await octokit.pulls.get({
    owner,
    repo,
    pull_number
  });

  // Get PR files and diff
  const { data: files } = await octokit.pulls.listFiles({
    owner,
    repo,
    pull_number
  });

  return {
    pr,
    files
  };
}

// Generate review using Claude
async function generateReview(prData) {
  const anthropic = new Anthropic({
    apiKey: process.env.ANTHROPIC_API_KEY || 'sk-ant-api-XXXXX' // Replace with your API key
  });

  const diffContent = prData.files.map(file => 
    `--- a/${file.filename}\n+++ b/${file.filename}\n${file.patch}`
  ).join('\n\n');
  
  const prompt = `Human: Here's a GitHub PR diff to review:
${diffContent}

Please provide a structured review with this format:
- Summary: [2-3 sentences summarizing the changes]
- Risks: [list of potential issues]
- Suggestions: [list of improvement suggestions]
- Confidence: [Low/Medium/High]

Assistant:`;

  const response = await anthropic.completions.create({
    model: 'claude-3-sonnet-20240229',
    max_tokens: 1024,
    messages: [{
      role: 'user',
      content: prompt
    }]
  });

  return response.content[0].text;
}

// Post comment back to PR
async function postComment(prData, comment) {
  const { owner, repo, pull_number } = parsePRUrl(options.pr);
  const token = options.token || process.env.GITHUB_TOKEN;
  const octokit = new Octokit({ auth: token });
  
  await octokit.issues.createComment({
    owner,
    repo,
    issue_number: pull_number,
    body: comment
  });
}

// Format the AI response into structured Markdown
function formatComment(response) {
  // This is a simple formatter - in practice, you might want to parse the response more carefully
  return `## Code Review\n\n${response}`;
}

// Main function
async function main() {
  try {
    const prData = await fetchPRData();
    const aiResponse = await generateReview(prData);
    const formattedComment = formatComment(aiResponse);
    
    if (options.output) {
      fs.writeFileSync(options.output, formattedComment);
      console.log(`Review saved to ${options.output}`);
    } else {
      console.log(formattedComment);
    }
    
    // If we have a PR URL and token, post the comment
    if (options.pr && (options.token || process.env.GITHUB_TOKEN)) {
      await postComment(prData, formattedComment);
      console.log('Comment posted to PR');
    }
  } catch (error) {
    console.error('Error:', error.message);
    process.exit(1);
  }
}

main();