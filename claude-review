def main():
    parser = argparse.ArgumentParser(description='Claude Code PR Reviewer')
    parser.add_argument('--pr', required=True, help='Pull request URL')
    args = parser.parse_args()

    # Extract owner, repo, and PR number from URL
    # This is a simplified parser - a real implementation would need more robust URL parsing
    if "github.com/" in args.pr:
        parts = args.pr.split("/")
        owner = parts[parts.index("github.com") + 1]
        repo = parts[parts.index("github.com") + 2]
        pr_number = parts[parts.index("github.com") + 4].split("#")[0]
    else:
        print("Invalid GitHub URL provided")
        sys.exit(1)
    
    # In a real implementation, you would use the GitHub token from environment variables
    token = os.environ.get('GITHUB_TOKEN', '')
    
    try:
        diff = get_pr_diff(owner, repo, pr_number, token)
        analysis = analyze_code(diff)
        
        print("## Summary of Changes")
        print(analysis["summary"])
        print("\n## Identified Risks")
        for risk in analysis["risks"]:
            print(f"- {risk}")
        print("\n## Improvement Suggestions")
        for suggestion in analysis["suggestions"]:
            print(f"- {suggestion}")
        print(f"\n## Confidence Score: {analysis['confidence']}")
        
    except Exception as e:
        print(f"Error: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()