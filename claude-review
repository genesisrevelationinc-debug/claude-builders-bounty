#!/usr/bin/env node

const { Octokit } = require('@octokit/rest');
const { program } = require('commander');
const Anthropic = require('@anthropic-ai/sdk');

program
  .version('1.0.0')
  .option('-p, --pr <url>', 'GitHub PR URL to review')
  .option('-k, --api-key <key>', 'Anthropic API key')
  .parse();

const options = program.opts();

async function main() {
  if (!options.pr) {
    console.error('Error: PR URL is required');
    process.exit(1);
  }
  
  if (!options.apiKey) {
    console.error('Error: API key is required');
    process.exit(1);
  }

  // Parse the PR URL
  const urlMatch = options.pr.match(/https:\/\/github\.com\/([^/]+)\/([^/]+)\/pull\/(\d+)/);
  if (!urlMatch) {
    console.error('Invalid GitHub PR URL');
    process.exit(1);
  }
  
  const [, owner, repo, prNumber] = urlMatch;

  // Initialize GitHub client
  const octokit = new Octokit();
  
  try {
    // Get PR data
    const { data: pr } = await octokit.pulls.get({
      owner,
      repo,
      pull_number: prNumber
    });

    const { data: files } = await octokit.pulls.listFiles({
      owner,
      repo,
      pull_number: prNumber
    });

    // Build the diff content
    let diffContent = '';
    files.forEach(file => {
      diffContent += `--- a/${file.filename}\n`;
      diffContent += `+++ b/${file.filename}\n`;
      diffContent += file.patch;
      diffContent += '\n\n';
    });

    // Initialize Claude
    const anthropic = new Anthropic({
      apiKey: options.apiKey
    });

    const prompt = `Please review this GitHub PR diff and provide a structured analysis:

${diffContent}

Provide a response in this exact Markdown format:
## Summary of Changes
[Provide 2-3 sentences summarizing the main changes]

## Identified Risks
- [List potential risks]

## Improvement Suggestions
- [List improvement suggestions]

## Confidence
[Low|Medium|High]
`;

    const response = await anthropolic.completions.create({
      model: 'claude-3-haiku-20240307',
      max_tokens_to_sample: 1000,
      prompt: prompt
    });

    console.log(response.completion);
  } catch (error) {
    console.error('Error:', error.message);
    process.exit(1);
  }
}

main();