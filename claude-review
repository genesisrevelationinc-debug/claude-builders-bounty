#!/usr/bin/env python3
"""
Claude Code PR Review Agent

Reviews GitHub PRs and generates structured Markdown feedback.
"""

import argparse
import json
import os
import re
import sys
from typing import Dict, List, Optional

import httpx


def parse_pr_url(url: str) -> tuple:
    """Extract owner, repo, and PR number from GitHub URL."""
    pattern = r"github\.com/([^/]+)/([^/]+)/pull/(\d+)"
    match = re.search(pattern, url)
    if not match:
        raise ValueError("Invalid GitHub PR URL")
    return match.group(1), match.group(2), int(match.group(3))


def fetch_pr_diff(owner: str, repo: str, pr_number: int, token: str) -> str:
    """Fetch PR diff using GitHub API."""
    headers = {"Authorization": f"Bearer {token}"} if token else {}
    url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_number}"
    
    response = httpx.get(url, headers=headers)
    response.raise_for_status()
    
    data = response.json()
    return data.get("diff_url", "")


def analyze_diff(diff_content: str) -> Dict:
    """Analyze the diff and generate structured review."""
    # In a real implementation, this would use Claude Code API
    # For this demo, we'll return a sample analysis
    
    # Count lines changed
    lines_added = diff_content.count("\n+")
    lines_removed = diff_content.count("\n-")
    
    return {
        "summary": f"This PR modifies the codebase with {lines_added} additions and {lines_removed} deletions. "
                   f"The changes appear to be focused on feature enhancement and bug fixes.",
        "risks": [
            "Potential performance impact from new database queries",
            "Missing error handling in authentication flow",
            "Possible security vulnerability in input validation"
        ],
        "suggestions": [
            "Consider adding unit tests for the new API endpoints",
            "Implement input sanitization for user-provided data",
            "Add caching mechanism for frequently accessed resources"
        ],
        "confidence": "Medium"
    }


def generate_markdown_report(analysis: Dict) -> str:
    """Generate structured Markdown report from analysis."""
    report = []
    report.append("## Code Review Summary")
    report.append("")
    report.append(analysis["summary"])
    report.append("")
    report.append("## Identified Risks")
    report.append("")
    for risk in analysis["risks"]:
        report.append(f"- {risk}")
    report.append("")
    report.append("## Improvement Suggestions")
    report.append("")
    for suggestion in analysis["suggestions"]:
        report.append(f"- {suggestion}")
    report.append("")
    report.append(f"**Confidence Score: {analysis['confidence']}**")
    
    return "\n".join(report)


def post_comment(owner: str, repo: str, pr_number: int, comment: str, token: str) -> None:
    """Post comment to GitHub PR."""
    headers = {
        "Authorization": f"Bearer {token}",
        "Accept": "application/vnd.github.v3+json"
    }
    
    url = f"https://api.github.com/repos/{owner}/{repo}/issues/{pr_number}/comments"
    data = {"body": comment}
    
    response = httpx.post(url, headers=headers, json=data)
    response.raise_for_status()


def main():
    parser = argparse.ArgumentParser(description="Claude Code PR Review Agent")
    parser.add_argument("--pr", help="GitHub PR URL", required=True)
    parser.add_argument("--comment", help="Post review as comment to PR", action="store_true")
    parser.add_argument("--token", help="GitHub personal access token")
    
    args = parser.parse_args()
    
    try:
        # Parse PR URL
        owner, repo, pr_number = parse_pr_url(args.pr)
        
        # Get GitHub token from args or environment
        token = args.token or os.environ.get("GITHUB_TOKEN")
        
        # Fetch PR diff
        diff_url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_number}"
        headers = {"Authorization": f"Bearer {token}"} if token else {}
        
        response = httpx.get(diff_url, headers=headers)
        response.raise_for_status()
        
        diff_content = response.json().get("patch", "")
        
        # Analyze the diff
        analysis = analyze_diff(diff_content)
        
        # Generate report
        report = generate_markdown_report(analysis)
        print(report)
        
        # Post comment if requested
        if args.comment and token:
            post_comment(owner, repo, pr_number, report, token)
            print("\nComment posted to PR successfully!")
        
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()